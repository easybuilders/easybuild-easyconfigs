easyblock = 'Binary'

name = 'Cytoscape'
version = '3.10.4'
versionsuffix = '-Java-%(javaver)s'

homepage = 'https://cytoscape.org/'
description = """Cytoscape is an open source software platform for visualizing
 complex networks and integrating these with any type of attribute data.
 A lot of Apps are available for various kinds of problem domains,
 including bioinformatics, social network analysis, and semantic web."""

toolchain = SYSTEM

_underscore_version = version.replace('.', '_')
local_installer = '%%(name)s_%s_unix.sh' % _underscore_version

source_urls = ['https://github.com/cytoscape/cytoscape/releases/download/%(version)s/']
sources = [local_installer]
checksums = ['e3208b503b3a153b3b62cfdceb9b9a94dd5f680d4d9093da187c3a6580e66927']

dependencies = [('Java', '17')]

install_cmd = 'chmod +x %s && ./%s -q -dir %%(installdir)s' % (local_installer, local_installer)

sanity_check_paths = {
    'files': ['cytoscape.sh', 'Cytoscape'],
    'dirs': ['framework', 'apps', 'sampleData'],
}

sanity_check_commands = ["%(namelower)s.sh --version | grep '%(version)s'"]

moduleclass = 'bio'
