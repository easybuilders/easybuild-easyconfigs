easyblock = 'ConfigureMake'

name = 'cpio'
version = '2.15'

homepage = 'https://savannah.gnu.org/projects/cpio/'
description = "The cpio package contains tools for archiving."

toolchain = {'name': 'GCCcore', 'version': '15.2.0'}

source_urls = [GNU_SOURCE]
sources = [SOURCE_TAR_BZ2]
patches = ['%(name)s-2.15_c23-conformity.patch']
checksums = [
    {'cpio-2.15.tar.bz2': '937610b97c329a1ec9268553fb780037bcfff0dcffe9725ebc4fd9c1aa9075db'},
    {'cpio-2.15_c23-conformity.patch': 'a85fd7c098b48a3500d98721897f5aaed6cd115e46b46d259fadf2cdf7140d4c'},
]

builddependencies = [
    ('binutils', '2.45'),
    ('makeinfo', '7.3'),
]

postinstallcmds = ['makeinfo --plaintext -o %(installdir)s/doc/%(name)s.txt doc/%(name)s.texi']

sanity_check_paths = {
    'files': ['bin/%(name)s'],
    'dirs': [],
}

sanity_check_commands = ['%(name)s --help']

moduleclass = 'tools'
