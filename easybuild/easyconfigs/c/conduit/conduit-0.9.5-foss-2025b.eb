# Author: J. Saßmannshausen (Imperial College London/UK)
# Author: A. Grund (TU-Dresden) for conduit problem
# Two testjobs fail with MPI related problems: t_blueprint_mpi_mesh_tiled t_blueprint_mpi_mesh_utils
# See: https://github.com/llnl/conduit/issues/1731
# One testjob fails with a Python related problem: 57 - t_python_conduit_node

easyblock = 'CMakeMake'

name = 'conduit'
version = '0.9.5'

homepage = 'https://llnl-conduit.readthedocs.io/en/latest'
description = """
Conduit is an open source project from Lawrence Livermore National Laboratory
that provides an intuitive model for describing hierarchical scientific data
in C++, C, Fortran, and Python. It is used for data coupling between packages
in-core, serialization, and I/O tasks
"""

toolchain = {'name': 'foss', 'version': '2025b'}
toolchainopts = {'usempi': True, 'openmp': True}

source_urls = ['https://github.com/llnl/conduit/releases/download/v%(version)s/']
sources = ['%(name)s-v%(version)s-src-with-blt.tar.gz']

builddependencies = [
    ('binutils', '2.44'),
    ('CMake', '4.0.3'),
    ('pkgconf', '2.4.3'),
    ('git', '2.50.1'),
]

dependencies = [
    ('Python', '3.13.5'),
    ('SciPy-bundle', '2025.07'),
    ('mpi4py', '4.1.0'),
    ('HDF5', '1.14.6'),
    ('h5py', '3.14.0'),
]

# The installation is using Python at one point. In order to make sure we are
# not polluting the user's ~/.local/lib/pythonX.Y, we need to do this dance,
# at least for now. It is probably best to set that in the config/build/install
# steps.
_envvar = 'export PYTHONNOUSERSITE=1; export PIP_REQUIRE_VIRTUALENV=false;'
_envvar += ' export PIP_DISABLE_PIP_VERSION_CHECK=true; export XDG_CACHE_HOME=%(builddir)s/xdg-cache-home &&'

preconfigopts = _envvar
srcdir = 'src'
configopts = '-DENABLE_DOCS=OFF -DENABLE_DOXYGEN=OFF -DENABLE_VALGRIND=OFF '
configopts += '-DENABLE_MPI=ON -DENABLE_OPENMP=ON -DENABLE_PYTHON=ON '
configopts += '-DENABLE_FORTRAN=ON -DHDF5_DIR=$EBROOTHDF5 '
configopts += '-DPYTHON_MODULE_INSTALL_PREFIX=%(installdir)s/lib/python/%(pyshortver)s/ '

prebuildopts = _envvar
preinstallopts = _envvar

# Allow oversubscription of MPI ranks to cores, some tests want to use up to 4 MPI ranks
# even though we might provide more!
# We are also disabling t_blueprint_mpi_mesh_tiled, t_blueprint_mpi_mesh_utils 
# and t_python_conduit_node as they fail at some setups. 
# Note: it appears that t_python_conduit_node has been fixed in 0.9.7!
_excludetests = '"t_blueprint_mpi_mesh_tiled|t_python_conduit_node|t_blueprint_mpi_mesh_utils"'
pretestopts = 'export PRTE_MCA_rmaps_default_mapping_policy=:oversubscribe && '
pretestopts += 'export LD_LIBRARY_PATH=lib:$LD_LIBRARY_PATH && '
test_cmd = 'ctest --output-on-failure -E ' + _excludetests

sanity_check_paths = {
    'files': ['bin/conduit_generate_data', 'bin/conduit_blueprint_verify',
              'lib/libconduit.so', 'lib/libconduit_relay.so', 'lib/libconduit_blueprint.so'],
    'dirs': ['include', 'examples'],
}

sanity_check_commands = [
    'conduit_adjset_validate -help | grep "protocol name" &>/dev/null ',
    'python -c "import conduit" ',
]

modextrapaths = {'PYTHONPATH': '%(installdir)s/lib/python/%(pyshortver)s/'}

moduleclass = 'data'
