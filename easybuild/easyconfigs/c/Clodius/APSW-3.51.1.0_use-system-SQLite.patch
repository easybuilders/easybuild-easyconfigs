Use the external SQLite dependency instead of downloading and compiling an
undeclared SQLite source during Python package metadata generation.
Author: Emik Lin (HKUMed CPOS)
--- a/setup.apsw
+++ b/setup.apsw
@@ -5 +5 @@
-fetch = True
+fetch = False
@@ -7 +7 @@
-enable_all_extensions = True
+enable_all_extensions = False
@@ -11 +11,4 @@
-enable = COLUMN_METADATA
\ No newline at end of file
+enable = COLUMN_METADATA
+
+[build_ext]
+use_system_sqlite_config = True
