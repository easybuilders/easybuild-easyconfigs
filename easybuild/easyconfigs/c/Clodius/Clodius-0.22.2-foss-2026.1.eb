easyblock = 'PythonBundle'

name = 'Clodius'
version = '0.22.2'

homepage = 'https://github.com/higlass/clodius'
description = """Clodius is a tool for breaking up large data sets into smaller tiles that can subsequently be displayed
using an appropriate viewer."""

toolchain = {'name': 'foss', 'version': '2026.1'}

