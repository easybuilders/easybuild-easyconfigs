easyblock = 'MesonNinja'

name = 'CrystFEL'
version = '0.13.0'

homepage = 'http://www.desy.de/~twhite/crystfel/'
description = """CrystFEL is a suite of programs for processing diffraction data acquired "serially" in a "snapshot"
manner, such as when using the technique of Serial Femtosecond Crystallography (SFX) with a free-electron laser
source."""

toolchain = {'name': 'foss', 'version': '2025a'}

source_urls = ['http://www.desy.de/~twhite/crystfel/']
sources = [SOURCELOWER_TAR_GZ]
checksums = ['e85cfb5bc9112a56939a72fedb5b76d148244e3af7a02d3c20ecc018eb1e6905']

builddependencies = [
    ('Meson', '1.6.1'),
    ('Ninja', '1.12.1'),
    ('pkgconf', '2.3.0'),
    ('flex', '2.6.4'),
    ('Bison', '3.8.2'),
]

dependencies = [
    ('HDF5', '1.14.6'),
    ('GSL', '2.8'),
    ('LibTIFF', '4.7.0'),
    ('ncurses', '6.5'),
    ('GLib', '2.85.1'),
    ('GTK3', '3.24.43'),
    ('cairo', '1.18.4'),
    ('Gdk-Pixbuf', '2.42.12'),
    ('FFTW', '3.3.10'),
    ('util-linux', '2.41'),
    ('zlib', '1.3.1'),
]

runtest = 'meson test'

sanity_check_paths = {
    'files': ['bin/crystfel', f'lib64/libcrystfel.{SHLIB_EXT}'],
    'dirs': []
}

moduleclass = 'phys'
