# Author: Jasper Grimm (UoY)

easyblock = 'ConfigureMake'

name = 'cgmlst-dists'
version = '0.6.0'

homepage = 'https://github.com/tseemann/cgmlst-dists'
description = """Calculate distance matrix from cgMLST allele call tables of ChewBBACA"""

toolchain = {'name': 'GCCcore', 'version': '14.2.0'}
toolchainopts = {'openmp': True, 'cstd': 'c99'}

github_account = 'tseemann'
source_urls = [GITHUB_SOURCE]
sources = ['v%(version)s.zip']
checksums = ['8fa0d662345c3a6788d97fc374143e7e507ee7e123ca3536de54ec5b98e4673e']

builddependencies = [
    ('binutils', '2.42'),
]

dependencies = [('zlib', '1.3.1')]

skipsteps = ['configure']

# TODO: handle this path mess better
preinstallopts = ['mkdir %(installdir)s/bin && ']
installopts = ['PREFIX=%(installdir)s']

postinstallcmds = ['mv %(name)s %(installdir)s/bin']
runtest = 'check'

sanity_check_paths = {
    'files': ['bin/%(name)s'],
    'dirs': [],
}
sanity_check_commands = ["%(name)s -v"]

moduleclass = 'bio'
