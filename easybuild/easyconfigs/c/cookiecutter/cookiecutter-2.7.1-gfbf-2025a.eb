easyblock = 'PythonBundle'

name = 'cookiecutter'
version = '2.7.1'

homepage = 'https://github.com/cookiecutter/cookiecutter'
description = """A command-line utility that creates projects from project templates.
E.g. creating a Python package project from a Python package project template."""

toolchain = {'name': 'gfbf', 'version': '2025a'}

builddependencies = [
    ('binutils', '2.42'),
    ('hatchling', '1.27.0'),
]

dependencies = [
    ('Python', '3.13.1'),
    ('Python-bundle-PyPI', '2025.04'),
    ('SciPy-bundle', '2025.06'),
    ('PyYAML', '6.0.2'),
    ('python-slugify', '8.0.4'),
]

exts_list = [
    ('arrow', '1.4.0', {
        'checksums': ['ed0cc050e98001b8779e84d461b0098c4ac597e88704a655582b21d116e526d7'],
    }),
    ('binaryornot', '0.6.0', {
        'checksums': ['cc8d57cfa71d74ff8c28a7726734d53a851d02fad9e3a5581fb807f989f702f0'],
    }),
    (name, version, {
        'checksums': ['ca7bb7bc8c6ff441fbf53921b5537668000e38d56e28d763a1b73975c66c6138'],
    }),
]

moduleclass = 'devel'
