easyblock = 'PythonBundle'

name = 'carm-roofline'
version = '1.6.2'

homepage = 'https://github.com/champ-hub/carm-roofline'
description = 'Cache-Aware Roofline Model benchmarking, profiling and visualization toolkit'

toolchain = {'name': 'gfbf', 'version': '2025a'}

builddependencies = [
    ('flit', '3.10.1'),
    ('hatchling', '1.27.0'),
    ('poetry', '2.1.2'),
    ('setuptools', '80.9.0'),
]

dependencies = [
    ('Python', '3.13.1'),
    ('Python-bundle-PyPI', '2025.04'),
    ('SciPy-bundle', '2025.06'),
    ('matplotlib', '3.10.3'),
    ('plotly.py', '6.3.1'),
    ('Flask', '3.1.1'),
    ('pydantic', '2.11.7'),
    ('PAPI', '7.2.0'),
]

# All dependencies are provided by modules or installed explicitly below.
installopts = '--no-deps --no-build-isolation'

exts_list = [
    ('rich-argparse', '1.8.0', {
        'checksums': ['679df3d832fa94ad6e4bdb07ded088cd7ea2dddc58ae9b2b46346a40b06cbc0c'],
        'sources': ['rich_argparse-%(version)s.tar.gz'],
    }),
    ('argcomplete', '3.7.0', {
        'checksums': ['afde224f753f874807b1dc1414e883ab8fe0cda9c04807b6047dcb8e1ac23913'],
    }),
    ('retrying', '1.4.2', {
        'checksums': ['d102e75d53d8d30b88562d45361d6c6c934da06fab31bd81c0420acb97a8ba39'],
    }),
    ('comm', '0.2.3', {
        'checksums': ['2dc8048c10962d55d7ad693be1e7045d891b7ce8d999c97963a5e3e99c055971'],
    }),
    ('janus', '1.2.0', {
        'checksums': ['c03475c3e10e042f2a08d31a7a894df2a2a95845ff794b7265e7e9c10a425e5d'],
    }),
    ('nest-asyncio', '1.5.9', {
        'checksums': ['d1e1144e9c6e3e6392e0fcf5211cb1c8374b5648a98f1ebe48e5336006b41907'],
        'sources': ['nest_asyncio-%(version)s.tar.gz'],
    }),
    ('dash', '4.4.1', {
        'checksums': ['9356ca7856bc496c12c5b6de5978aaf783e090d07450ee395ade1c0c2cbdf816'],
    }),
    ('dash-bootstrap-components', '2.0.4', {
        'checksums': ['c3206c0923774bbc6a6ddaa7822b8d9aa5326b0d3c1e7cd795cc975025fe2484'],
        'sources': ['dash_bootstrap_components-%(version)s.tar.gz'],
    }),
    (name, version, {
        'source_tmpl': 'v%(version)s.tar.gz',
        'source_urls': ['https://github.com/champ-hub/carm-roofline/archive/refs/tags'],
        'checksums': ['5cbe80851ff3ae5bd43a2d63a40821404bd687304e1c481becd883dacc2a6633'],
        'use_pip_extras': 'gui',
    }),
]

sanity_check_paths = {'files': ['bin/carm'], 'dirs': []}
sanity_check_commands = ['carm --help']
moduleclass = 'perf'
