easyblock = 'PythonBundle'

name = 'carm-roofline'
version = '1.6.3'

homepage = 'https://github.com/champ-hub/carm-roofline'
description = 'Cache-Aware Roofline Model benchmarking, profiling and visualization toolkit'

toolchain = {'name': 'cpeGNU', 'version': '25.03'}

builddependencies = [
    ('buildtools-python', '25.03', '-cray-python3.11', True),
]

dependencies = [
    ('cray-python/3.11.7', EXTERNAL_MODULE),
    ('papi/7.2.0.1', EXTERNAL_MODULE),
]

# Cray Python supplies NumPy, packaging, python-dateutil, pytz, six and click.
# Wheels avoid extra build backends
use_pip = True
use_pip_for_deps = False
pip_no_build_isolation = True
installopts = '--no-deps --no-build-isolation'

exts_default_options = {
    'source_urls': [
        'https://files.pythonhosted.org/packages/py3/%(nameletter)s/%(name)s',
        'https://files.pythonhosted.org/packages/py2.py3/%(nameletter)s/%(name)s',
        'https://files.pythonhosted.org/packages/cp311/%(nameletter)s/%(name)s',
    ],
}

