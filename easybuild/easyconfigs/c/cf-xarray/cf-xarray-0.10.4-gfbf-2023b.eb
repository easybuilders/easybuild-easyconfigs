easyblock = 'PythonBundle'

name = 'cf-xarray'
version = '0.10.4'

homepage = 'https://cf-xarray.readthedocs.io'
description = """A lightweight convenience wrapper for using CF attributes on xarray objects."""

toolchain = {'name': 'gfbf', 'version': '2023b'}

dependencies = [
    ('Python', '3.11.5'),
    ('xarray', '2024.5.0'),
]

exts_list = [
    ('cf_xarray', version, {
        'checksums': ['047dd732cc7f154c7aa9d5c00b77c64e2c538258f0b6e7565a4b2c7715ee8aba'],
    }),
]

moduleclass = 'data'
