easyblock = 'PythonBundle'

name = 'cf-xarray'
version = '0.10.11'

homepage = 'https://cf-xarray.readthedocs.io'
description = """A lightweight convenience wrapper for using CF attributes on xarray objects."""

toolchain = {'name': 'gfbf', 'version': '2025b'}

dependencies = [
    ('Python', '3.13.5'),
    ('xarray', '2025.10.0'),
]

exts_list = [
    ('cf_xarray', version, {
        'checksums': ['e10ee37b0ed3ba36f42346360f2bc070c690ddc73bb9dcdd9463b3a221453be3'],
    }),
]

moduleclass = 'data'
