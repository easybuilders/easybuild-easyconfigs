easyblock = 'PythonBundle'

name = 'climpred'
version = '2.6.0'

homepage = 'https://climpred.readthedocs.io/'
description = """climpred aims to be the primary package used to analyze output from initialized
 dynamical forecast models, ranging from short-term weather forecasts to decadal climate forecasts.
 The code base is driven by the geoscientific prediction community through open source development.
 It leverages xarray to keep track of core prediction ensemble dimensions (e.g., ensemble member,
 initialization date, and lead time) and dask to perform out-of-memory computations on large
 datasets."""

toolchain = {'name': 'foss', 'version': '2025b'}

dependencies = [
    ('Python', '3.13.5'),
    ('Python-bundle-PyPI', '2025.07'),
    ('SciPy-bundle', '2025.07'),
    ('matplotlib', '3.10.5'),
    ('xarray', '2025.10.0'),
    ('dask', '2025.9.1'),
    ('numba', '0.62.0'),
    ('netcdf4-python', '1.7.2'),
    ('xrft', '1.0.1'),
    ('xESMF', '0.9.2'),
    ('eofs', '2.0.0'),
    ('xskillscore', '0.0.29'),
    ('xclim', '0.62.0'),
]

exts_list = [
    ('bias_correction', '0.4', {
        'checksums': ['969c0b77856ffa1dbd9cf5c827b937dd91abe3850b40a2044c994ffc91eeee06'],
    }),
    ('nc-time-axis', '1.4.1', {
        'checksums': ['72d80f492f34bbf59490838d8cb3d92f14e88900b0ee35498b2b33c82795eb81'],
