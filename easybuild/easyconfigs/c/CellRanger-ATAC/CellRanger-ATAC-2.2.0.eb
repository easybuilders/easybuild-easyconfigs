easyblock = 'Tarball'

name = 'CellRanger-ATAC'
version = '2.2.0'

homepage = "https://www.10xgenomics.com/support/software/cell-ranger-atac/latest"
description = """Cell Ranger ATAC is a set of analysis pipelines that process
Chromium Single Cell ATAC data."""

toolchain = SYSTEM

sources = [SOURCELOWER_TAR_GZ]
checksums = ['b71bfe6a9680718797fe9363c9b037984fd154d0d9249d457b7fd2fe6253171e']
download_instructions = """
Download manually from:
https://www.10xgenomics.com/support/software/cell-ranger-atac/downloads
"""

sanity_check_paths = {
    'files': ['bin/cellranger-atac', 'cellranger-atac'],
    'dirs': ['bin/atac', 'lib'],
}

sanity_check_commands = ["cellranger-atac testrun --id=tiny"]

moduleclass = 'bio'
