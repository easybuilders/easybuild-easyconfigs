easyblock = 'CMakeMake'

name = 'camp'
version = '2026.07.2'
versionsuffix = '-CUDA-%(cudaver)s'

homepage = 'https://github.com/LLNL/camp'
description = """
Compiler agnostic metaprogramming library providing concepts, type operations and tuples for C++ and CUDA
"""

toolchain = {'name': 'GCC', 'version': '15.2.0'}
toolchainopts = {'pic': True}

github_account = 'LLNL'
source_urls = [GITHUB_SOURCE]
sources = ['v%(version)s.tar.gz']
checksums = ['f4aa572cdd3c3040143089c3797a8e92ffbe2f4fe95d3f131b66c26fbf879327']

builddependencies = [
    ('binutils', '2.45'),
    ('CMake', '4.2.1'),
    ('llnl-blt', '0.7.2', '', SYSTEM),
]
dependencies = [
    ('CUDA', '13.3.0', '', SYSTEM),
]

configopts = "-DBUILD_SHARED_LIBS=ON "
configopts += "-DBLT_SOURCE_DIR=${EBROOTLLNLMINBLT} "

configopts += "-DENABLE_CUDA=ON "
configopts += "-DENABLE_OPENMP=ON "

runtest = "test"

sanity_check_paths = {
    'files': ['include/camp/camp.hpp'],
    'dirs': ['include', 'lib'],
}

moduleclass = 'lib'
