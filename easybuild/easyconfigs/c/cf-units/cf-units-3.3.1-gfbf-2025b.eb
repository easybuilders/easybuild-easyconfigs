# Author: Stamen Miroslavov <stamen.miroslavov@bsc.es>
# Barcelona Supercomputing Center 2026
# Not to be confused with "cfunits" distribution!

easyblock = 'PythonBundle'

name = 'cf-units'
version = '3.3.1'

homepage = 'https://cf-units.readthedocs.io/en/latest'
description = """Units of measure as required by the Climate and Forecast (CF) Metadata Conventions."""

toolchain = {'name': 'gfbf', 'version': '2025b'}

dependencies = [
    ('Python', '3.13.5'),
    ('UDUNITS', '2.2.28'),
    ('SciPy-bundle', '2025.07'),
    ('cftime', '1.6.4.post1'),
]

preinstallopts = 'export UDUNITS2_XML_PATH="$EBROOTUDUNITS/share/udunits/udunits2.xml" && '

exts_list = [
    ('cf_units', version, {
        'checksums': ['84339f582994ae32ca5c472075c1e603a89f6c6f5a96cc1031bb5da700a14f3a'],
        'preinstallopts': 'UDUNITS2_XML_PATH=$EBROOTUDUNITS/share/udunits/udunits2.xml ',
    }),
]

moduleclass = 'geo'
