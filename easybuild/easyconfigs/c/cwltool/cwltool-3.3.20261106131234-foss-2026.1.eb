easyblock = 'PythonBundle'

name = 'cwltool'
version = '3.3.20261106131234'

homepage = 'https://cwltool.readthedocs.io/'
description = """
This is the reference implementation of the Common Workflow Language open
standards. It is intended to be feature complete and provide comprehensive
validation of CWL files as well as provide other tools related to working with
CWL.
"""

toolchain = {'name': 'foss', 'version': '2026.1'}

builddependencies = [
    ('poetry', '2.3.4'),  # pytest-httpserver
    ('hatchling', '1.33.0'),  # argcomplete
]
# Based on https://github.com/common-workflow-language/cwltool/blob/3.3.20261106131234/pyproject.toml
dependencies = [
    ('nodejs', '24.16.0'),
    ('Python', '3.14.2'),  # and provides setuptools
    ('Python-bundle-PyPI', '2026.04'),  # pytest, pytest-cov, psutil, mock, toml, requests, pytest-mock, pathspec
    ('lxml', '6.1.1'),
    ('networkx', '3.6.1'),
    ('pydantic', '2.13.4'),  # for optional dependency galaxy-tool-util
    ('PyYAML', '6.0.3'),  # for optional dependency galaxy-tool-util
    ('schema-salad', '8.10.20261106141337'),
    ('ruamel.yaml', '0.19.1'),
    ('RDFlib', '7.6.0'),
    ('pydot', '4.0.1'),
    ('Pygments', '2.20.0'),
]

