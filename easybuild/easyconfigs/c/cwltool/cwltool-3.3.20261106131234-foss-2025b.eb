easyblock = 'PythonBundle'

name = 'cwltool'
version = '3.3.20261106131234'

homepage = 'https://cwltool.readthedocs.io/'
description = """
This is the reference implementation of the Common Workflow Language open
standards. It is intended to be feature complete and provide comprehensive
validation of CWL files as well as provide other tools related to working with
CWL.
"""

toolchain = {'name': 'foss', 'version': '2025b'}

builddependencies = [
    ('setuptools', '80.10.1'),
    ('hatchling', '1.27.0'),  # schema-salad
    ('poetry', '2.1.3'),  # pytest-httpserver
]
# Based on https://github.com/common-workflow-language/cwltool/blob/3.1.20250110105449/pyproject.toml
dependencies = [
    ('nodejs', '22.17.1'),
    ('Python', '3.13.5'),
    ('Python-bundle-PyPI', '2025.07'),  # pytest, pytest-cov, psutil, mock, toml, requests
    ('RDFlib', '7.1.4'),
    ('lxml', '6.0.0'),
    ('networkx', '3.5'),
    ('pydot', '4.0.1'),
    ('pydantic', '2.11.9'),  # for optional dependency galaxy-tool-util
    ('PyYAML', '6.0.2'),  # for optional dependency galaxy-tool-util
]

