easyblock = 'BinariesTarball'

name = 'Claude'
version = '2.1.291'

homepage = 'https://github.com/anthropics/claude-code'
description = """Anthropic's Claude Code CLI, a terminal-based coding assistant.
"""

toolchain = {'name': 'system', 'version': 'system'}

source_urls = ['https://github.com/anthropics/claude-code/releases/download/v%(version)s/']
sources = ['claude-linux-x64.tar.gz']
checksums = ['aa196be551bf50e484ae662c5ccecd5ef15fe5b169a1325d64802dcc6755f9bb']

sanity_check_paths = {
    'files': ['bin/claude'],
    'dirs': [],
}

sanity_check_commands = ['claude --version']

modextravars = {
    'DISABLE_UPDATES': '1',
    'CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC': '1',
    'CLAUDE_CODE_DISABLE_OFFICIAL_MARKETPLACE_AUTOINSTALL': '1',
}

moduleclass = 'tools'