# Author: Ehsan Moravveji (VSC - KU Leuven)

easyblock = 'CargoPythonBundle'

name = 'cbor2'
version = '6.2.1'

homepage = 'https://github.com/agronholm/cbor2'
description = """
CBOR (Concise Binary Object Representation) provides encoding and decoding
for the Concise Binary Object Representation (CBOR) (RFC 8949) serialization
format. The specification is fully compatible with the original RFC 7049.
"""

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}

builddependencies = [
    ('binutils', '2.44'),
    ('Rust', '1.91.1', '', ('GCCcore', '14.3.0')),
    ('setuptools-rust', '1.11.0', '', ('GCCcore', '14.3.0')),
]

dependencies = [
    ('Python', '3.13.5'),
]

sources = [
    {
        'download_filename': '6.2.1.tar.gz',
        'filename': '%(name)s-%(version)s.tar.gz',
        'source_urls': ['https://github.com/agronholm/%(name)s/archive/refs/tags/'],
    }
]
