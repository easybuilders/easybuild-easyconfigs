Replace dynamic versioning with a plain static version string. PyPI source
tarballs lack the Git repository data required by setuptools-git-versioning.
Author: Emik Lin (HKUMed CPOS)
diff --git a/pyproject.toml b/pyproject.toml
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -3,12 +3,11 @@
 requires = [
   "setuptools >=77",
   "cython >=0.29",
-  "setuptools-git-versioning >=2.0",
 ]

 [project]
 name = "cytoolz"
-dynamic = ["version"]
+version = "1.1.0"
 description = "Cython implementation of Toolz: High performance functional utilities"
 readme = "README.rst"
 requires-python = ">=3.9"
@@ -83,11 +82,6 @@
   "cytoolz.tests",
 ]

-[tool.setuptools-git-versioning]
-enabled = true
-dev_template = "{tag}+{ccount}.g{sha}"
-dirty_template = "{tag}+{ccount}.g{sha}.dirty"
-
 [tool.cibuildwheel]
 test-requires = ["pytest", "toolz"]
 test-command = "python -m pytest --pyargs cytoolz"
