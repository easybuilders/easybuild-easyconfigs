easyblock = 'PythonPackage'

name = 'cytoolz'
version = '1.1.0'

homepage = 'https://github.com/pytoolz/cytoolz'
description = "Cython implementation of Toolz: High performance functional utilities"

toolchain = {'name': 'GCCcore', 'version': '15.2.0'}

sources = [SOURCE_TAR_GZ]
patches = ['cytoolz-1.1.0_use-static-version.patch']
checksums = [
    {'cytoolz-1.1.0.tar.gz': '13a7bf254c3c0d28b12e2290b82aed0f0977a4c2a2bf84854fcdc7796a29f3b0'},
    {'cytoolz-1.1.0_use-static-version.patch':
     'f9cc1024aa4217056d210d771740193a1e49e3b823ff7061f816e1e9a74ca6cb'},
]

builddependencies = [
    ('binutils', '2.45'),
    ('Cython', '3.2.4'),
]

dependencies = [
    ('Python', '3.14.2'),
    ('toolz', '1.1.0'),
]

moduleclass = 'lib'
