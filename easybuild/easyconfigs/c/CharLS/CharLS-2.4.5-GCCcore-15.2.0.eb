easyblock = 'CMakeMake'

name = 'CharLS'
version = '2.4.5'

homepage = 'https://github.com/team-charls/charls'
description = """CharLS is a C++ implementation of the JPEG-LS standard for lossless and near-lossless image
compression and decompression. JPEG-LS is a low-complexity image compression standard that matches JPEG 2000
compression ratios."""

toolchain = {'name': 'GCCcore', 'version': '15.2.0'}
toolchainopts = {'pic': True}

source_urls = ['https://github.com/team-charls/charls/archive/']
sources = [VERSION_TAR_GZ]
checksums = ['b55c742ef96b5e9d63f813a75d0ba29944302abb5a6ab59756ad61fa017b1dd3']

builddependencies = [
    ('binutils', '2.45'),
    ('CMake', '4.2.1'),
]

configopts = '-DBUILD_SHARED_LIBS=ON '

sanity_check_paths = {
    'files': [f'lib/libcharls.{SHLIB_EXT}'],
    'dirs': ['include'],
}

moduleclass = 'lib'
