easyblock = 'PythonBundle'

name = 'Cactus'
version = '3.3.0'
versionsuffix = '-CUDA-%(cudaver)s'

homepage = 'https://github.com/ComparativeGenomicsToolkit/cactus'
description = """Cactus is a reference-free whole-genome alignment program,
as well as a pangenome graph construction toolkit."""

toolchain = {'name': 'foss', 'version': '2025a'}

builddependencies = [
    ('CMake', '3.31.3'),
    ('Autotools', '20240712'),
]
dependencies = [
    ('CUDA', '12.8.0', '', SYSTEM),
    ('Python', '3.13.1'),
    ('SciPy-bundle', '2025.06'),
    ('Biopython', '1.85'),
    ('Pysam', '0.23.3'),
    ('matplotlib', '3.10.3'),
    ('HDF5', '1.14.6'),
    ('jemalloc', '5.3.0'),
    ('networkx', '3.5'),
    ('toil', '9.5.0', '-aws'),
    ('Boost', '1.88.0'),
    ('zlib', '1.3.1'),
    ('Kent_tools', '487'),
    ('SAMtools', '1.22.1'),
]

# commit from cactus/build-tools/KegAlign.commit
local_kegalign_commit = 'eaf02cf8bb25161bf1338f98b6b987aa4e3d12df'
# KegAlign requires this exact tbb version (scripts/make-conda-env.bash)
local_tbb_version = '2020.2'
local_mbuffer_version = '20260511'
components = [
    ('tbb', local_tbb_version, {
        'easyblock': 'EB_tbb',
        'source_urls': ['https://github.com/oneapi-src/oneTBB/archive/'],
        'sources': [{
            'download_filename': f'v{local_tbb_version}.tar.gz',
            'filename': f'tbb-{local_tbb_version}.tar.gz',
        }],
        'start_dir': f'oneTBB-{local_tbb_version}',
        # Fix compilation of TBB 2020.x with GCC 13 and newer.
        'prebuildopts': (
            "sed -i 's/task[*] next_offloaded;/tbb::task* next_offloaded;/' include/tbb/task.h && "
        ),
        # KegAlign requires tbb_preview, which is enabled by tbb_cpf=1.
        # EB_tbb assumes a standalone TBB build layout, so stage the build tree,
        # headers, and CMake helper files where its install step expects them.
        # The trailing ':' absorbs the compiler="gcc" argument appended by EB_tbb.
        'buildopts': (
            'tbb_cpf=1 compiler="gcc" && '
            'mkdir -p %(installdir)s/build %(installdir)s/include && '
            'cp -a build/. %(installdir)s/build/ && '
            'cp -a include/. %(installdir)s/include/ && '
            'rm -rf %(builddir)s/cmake && '
            'cp -a cmake %(builddir)s/ && '
            ':'
        ),
        'checksums': ['4804320e1e6cbe3a5421997b52199e3c1a3829b2ecb6489641da4b8e32faf500'],
    }),
    ('mbuffer', local_mbuffer_version, {
        'easyblock': 'ConfigureMake',
        'source_urls': ['https://www.maier-komor.de/software/mbuffer/'],
        'sources': [f'mbuffer-{local_mbuffer_version}.tgz'],
        'start_dir': f'mbuffer-{local_mbuffer_version}',
        # KegAlign only uses mbuffer for stream buffering; hash support is not needed.
        'configopts': '--disable-md5',
        'checksums': ['13bab36f39408f7a08fb368913290ad0f117c934bab602094e18fcc123ec5783'],
    }),
    ('KegAlign', local_kegalign_commit, {
        'easyblock': 'CMakeMake',
        'source_urls': ['https://github.com/galaxyproject/KegAlign/archive/'],
        'sources': [{
            'download_filename': f'{local_kegalign_commit}.tar.gz',
            'filename': f'KegAlign-{local_kegalign_commit}.tar.gz',
        }],
        'start_dir': f'KegAlign-{local_kegalign_commit}',
        # Cactus GPU mode invokes run_kegalign rather than the KegAlign binary
        # directly, so install both the native binary and its required wrapper
        # and diagonal-partitioning script.
        'install_cmd': (
            'mkdir -p %(installdir)s/bin && '
            'install -m 755 kegalign %(installdir)s/bin/ && '
            'install -m 755 %(start_dir)s/scripts/run_kegalign %(installdir)s/bin/ && '
            'install -m 755 %(start_dir)s/scripts/diagonal_partition.py %(installdir)s/bin/ && '
            "sed -i 's/\\r$//' %(installdir)s/bin/run_kegalign %(installdir)s/bin/diagonal_partition.py && "
            'rm -rf %(installdir)s/build'
        ),
        'checksums': ['28027939eea0fc566a2b00f86e3da5186cecbdf6094732372408c2127bb11de3'],
    }),
]

local_cactus_source_url = f'https://github.com/ComparativeGenomicsToolkit/cactus/releases/download/v{version}'
local_cactus_download_filename = f'cactus-v{version}.tar.gz'
local_cactus_source = f'cactus-{version}.tar.gz'
local_cactus_checksum = 'b3253a324ee96721f287262070454a8ef0d23444d7a1403aece98141eea014d1'

exts_list = [
    ('sonLib', '2.0', {
        'modulename': '%(name)s',
        'source_urls': [local_cactus_source_url],
        'sources': [{'download_filename': local_cactus_download_filename, 'filename': local_cactus_source}],
        'start_dir': 'submodules/%(name)s',
        'checksums': [local_cactus_checksum],
    }),
    ('%(namelower)s', version, {
        'source_urls': [local_cactus_source_url],
        'sources': [{'download_filename': local_cactus_download_filename, 'filename': local_cactus_source}],
        'preinstallopts': (
            # Cactus pins NetworkX to <2.8.1, although later NetworkX 2.x releases
            # remain API-compatible for the functionality used by Cactus.
            "sed -i 's/networkx>=2,<2.8.1/networkx>=2/' setup.py && "
            # Build the native Cactus tools and bundled third-party components before installing the Python package
            'make -j %(parallel)s && '
            # Cactus overwrites PYTHONPATH in its Makefile when running the test suite, which
            # hides Python packages provided by loaded EasyBuild dependencies (including pytest).
            # Preserve the existing PYTHONPATH while prepending the Cactus and bundled sonLib
            # source directories. Force local binaries to avoid Docker during the test suite,
            # and expose test output directly rather than redirecting it to per-test log files.
            'CACTUS_BINARIES_MODE=local CACTUS_DOCKER_MODE=0 SONLIB_TEST_LENGTH=SHORT '
            'make PYTHONPATH="$PWD/submodules/sonLib/src:$PWD/submodules:$PWD/src:$PYTHONPATH" '
            'test testErrOut= && '
            # The Cactus build does not provide a conventional "make install": its Makefile
            # assembles the native runtime executables and libraries in the source-tree bin/
            # and lib/ directories. Copy these into the EasyBuild installation prefix.
            'mkdir -p %(installdir)s/bin %(installdir)s/lib && '
            'cp -a bin/. %(installdir)s/bin/ && '
            'cp -a lib/. %(installdir)s/lib/ && '
            # Some bundled HAL scripts are deliberately made non-writable during the build.
            # Restore owner write permission so EasyBuild can perform its installation post-processing.
            'chmod -R u+w %(installdir)s/bin %(installdir)s/lib && '
        ),
        'checksums': [local_cactus_checksum],
    }),
]

sanity_check_paths = {
    'files': [
        'bin/cactus', 'bin/cactus_consolidated', 'bin/halStats', 'bin/halValidate',
        'bin/lastz', 'bin/kegalign', 'bin/run_kegalign', 'bin/diagonal_partition.py',
        'bin/mbuffer',
        'lib/libtbbmalloc.so.2', 'lib/libtbbmalloc_proxy.so.2', 'lib/libtbb_preview.so.2',
    ],
    'dirs': ['lib/python%(pyshortver)s/site-packages'],
}

sanity_check_commands = [
    'cactus --help',
    'command -v cactus_consolidated',
    'command -v halStats',
    'command -v lastz',
    'command -v kegalign',
    'command -v mbuffer',
    'command -v faToTwoBit',
    'run_kegalign --help',
]

moduleclass = 'bio'
