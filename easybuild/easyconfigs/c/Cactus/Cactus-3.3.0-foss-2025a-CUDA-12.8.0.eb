]

# commit from cactus/build-tools/KegAlign.commit
local_kegalign_commit = 'eaf02cf8bb25161bf1338f98b6b987aa4e3d12df'
# KegAlign requires this exact tbb version (scripts/make-conda-env.bash)
local_tbb_version = '2020.2'
local_mbuffer_version = '20260511'
components = [
    ('tbb', local_tbb_version, {
        'easyblock': 'EB_tbb',
        'source_urls': ['https://github.com/oneapi-src/oneTBB/archive/'],
        'sources': [{
            'download_filename': f'v{local_tbb_version}.tar.gz',
            'filename': f'tbb-{local_tbb_version}.tar.gz',
        }],
        'start_dir': f'oneTBB-{local_tbb_version}',
        # Fix compilation of TBB 2020.x with GCC 13 and newer.
        'prebuildopts': (
            "sed -i 's/task[*] next_offloaded;/tbb::task* next_offloaded;/' include/tbb/task.h && "
        ),
        # KegAlign requires tbb_preview, which is enabled by tbb_cpf=1.
        # EB_tbb assumes a standalone TBB build layout, so stage the build tree,
        # headers, and CMake helper files where its install step expects them.
        # The trailing ':' absorbs the compiler="gcc" argument appended by EB_tbb.
        'buildopts': (
            'tbb_cpf=1 compiler="gcc" && '
            'mkdir -p %(installdir)s/build %(installdir)s/include && '
            'cp -a build/. %(installdir)s/build/ && '
            'cp -a include/. %(installdir)s/include/ && '
            'rm -rf %(builddir)s/cmake && '
            'cp -a cmake %(builddir)s/ && '
            ':'
        ),
        'checksums': ['4804320e1e6cbe3a5421997b52199e3c1a3829b2ecb6489641da4b8e32faf500'],
    }),
    ('mbuffer', local_mbuffer_version, {
        'easyblock': 'ConfigureMake',
        'source_urls': ['https://www.maier-komor.de/software/mbuffer/'],
        'sources': [f'mbuffer-{local_mbuffer_version}.tgz'],
        'start_dir': f'mbuffer-{local_mbuffer_version}',
        # KegAlign only uses mbuffer for stream buffering; hash support is not needed.
        'configopts': '--disable-md5',
        'checksums': ['13bab36f39408f7a08fb368913290ad0f117c934bab602094e18fcc123ec5783'],
    }),
    ('KegAlign', local_kegalign_commit, {
        'easyblock': 'CMakeMake',
        'source_urls': ['https://github.com/galaxyproject/KegAlign/archive/'],
        'sources': [{
            'download_filename': f'{local_kegalign_commit}.tar.gz',
            'filename': f'KegAlign-{local_kegalign_commit}.tar.gz',
        }],
        'start_dir': f'KegAlign-{local_kegalign_commit}',
        # Cactus GPU mode invokes run_kegalign rather than the KegAlign binary
        # directly, so install both the native binary and its required wrapper
        # and diagonal-partitioning script.
        'install_cmd': (
            'mkdir -p %(installdir)s/bin && '
            'install -m 755 kegalign %(installdir)s/bin/ && '
            'install -m 755 %(start_dir)s/scripts/run_kegalign %(installdir)s/bin/ && '
            'install -m 755 %(start_dir)s/scripts/diagonal_partition.py %(installdir)s/bin/ && '
            "sed -i 's/\\r$//' %(installdir)s/bin/run_kegalign %(installdir)s/bin/diagonal_partition.py && "
            'rm -rf %(installdir)s/build'
        ),
        'checksums': ['28027939eea0fc566a2b00f86e3da5186cecbdf6094732372408c2127bb11de3'],
    }),
]

