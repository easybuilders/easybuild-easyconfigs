easyblock = 'PythonBundle'

name = 'Cactus'
version = '3.3.0'
versionsuffix = '-CUDA-%(cudaver)s'

homepage = 'https://github.com/ComparativeGenomicsToolkit/cactus'
description = """Cactus is a reference-free whole-genome alignment program,
as well as a pangenome graph construction toolkit."""

toolchain = {'name': 'foss', 'version': '2025a'}

builddependencies = [
    ('hatchling', '1.27.0'),
    ('CMake', '3.31.3'),
    ('Autotools', '20240712'),
]
dependencies = [
    ('CUDA', '12.8.0', '', SYSTEM),
    ('Python', '3.13.1'),
    ('SciPy-bundle', '2025.06'),
    ('Biopython', '1.85'),
    ('Pysam', '0.23.3'),
    ('matplotlib', '3.10.3'),
    ('HDF5', '1.14.6'),
    ('jemalloc', '5.3.0'),
    ('dill', '0.4.0'),
    ('ruamel.yaml', '0.18.14'),
    ('PyYAML', '6.0.2'),
    ('prompt-toolkit', '3.0.52'),
    ('boto3', '1.38.27'),
    ('cryptography', '44.0.2'),
    ('Boost', '1.88.0'),
    ('zlib', '1.3.1'),
    ('Kent_tools', '487'),
    ('SAMtools', '1.22.1'),
