easyblock = 'PythonBundle'

name = 'cooler'
version = '0.10.4'

homepage = 'https://open2c.github.io/cooler/'
description = """Cooler is a support library for a sparse, compressed, binary persistent storage format, also called
cooler, used to store genomic interaction data, such as Hi-C contact matrices."""

toolchain = {'name': 'foss', 'version': '2026.1'}

builddependencies = [
    ('hatchling', '1.29.0'),
    ('Cython', '3.2.4'),
]

dependencies = [
    ('Python', '3.14.2'),
    ('Python-bundle-PyPI', '2026.04'),
    ('SciPy-bundle', '2026.05'),
    ('h5py', '3.16.0'),
    ('PyYAML', '6.0.3'),
    ('pyfaidx', '0.9.0.4'),
    ('dill', '0.4.1'),
    ('multiprocess', '0.70.19'),
    ('cytoolz', '1.1.0'),
]

exts_list = [
    ('asciitree', '0.3.3', {
        'checksums': ['4aa4b9b649f85e3fcb343363d97564aa1fb62e249677f2e18a96765145cc0f6e'],
    }),
    (name, version, {
        'checksums': ['1c25626d5970cedd1ff651966c36d97073a697a7830d369b43b2d0e59ce405ba'],
    }),
]

sanity_check_commands = ['cooler --help']

moduleclass = 'bio'
