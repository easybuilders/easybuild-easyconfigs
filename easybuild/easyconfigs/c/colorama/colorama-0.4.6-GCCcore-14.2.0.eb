easyblock = 'PythonPackage'

name = 'colorama'
version = '0.4.6'

homepage = 'https://github.com/tartley/colorama'
description = "Cross-platform colored terminal text."

toolchain = {'name': 'GCCcore', 'version': '14.2.0'}

sources = [SOURCE_TAR_GZ]
