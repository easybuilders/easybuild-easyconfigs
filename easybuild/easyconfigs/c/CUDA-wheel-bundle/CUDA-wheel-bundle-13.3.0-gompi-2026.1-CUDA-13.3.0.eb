easyblock = 'PythonBundle'

name = 'CUDA-wheel-bundle'
version = '13.3.0'
versionsuffix = '-CUDA-%(cudaver)s'

homepage = 'https://developer.nvidia.com/cuda'
description = "Repackaging of NVIDIA CUDA libraries as Python packages"

toolchain = {'name': 'gompi', 'version': '2026.1'}

dependencies = [
    ('CUDA', version, '', SYSTEM),
    ('cuDNN', '9.23.0.39', versionsuffix, SYSTEM),
    ('cuSPARSELt', '0.9.1.1', versionsuffix, SYSTEM),
    ('NCCL', '2.30.4', versionsuffix),
    ('NVSHMEM', '3.8.0', versionsuffix),
    ('Python', '3.14.2'),
]

dummy_package = True

# The following package list is based on the requirements of PyTorch 2.14.1
# It can be expanded with any other package versions needed, including multiple
# versions of the same package

exts_list = [
    # provided by CUDA
    ('nvidia_cublas', '13.1.1.3'),
    ('nvidia_cuda_cupti', '13.0.85'),
    ('nvidia_cuda_nvrtc', '13.0.88'),
    ('nvidia_cufft', '12.0.0.61'),
    ('nvidia_cufile', '1.15.1.6'),
    ('nvidia_curand', '10.4.0.35'),
    ('nvidia_cusolver', '12.0.4.66'),
    ('nvidia_cusparse', '12.6.3.3'),
    ('nvidia_nvjitlink', '13.4.92'),
    ('nvidia_nvtx', '13.0.85'),
    # provided by cuDNN
    ('nvidia_cudnn_cu13', '9.24.0.43'),
    # provided by cuSPARSELt
    ('nvidia_cusparselt_cu13', '0.8.1'),
    # provided by NCCL
    ('nvidia_nccl_cu13', '2.30.7'),
    # provided by NVSHMEM
    ('nvidia_nvshmem_cu13', '3.4.5'),
]

moduleclass = 'lib'
