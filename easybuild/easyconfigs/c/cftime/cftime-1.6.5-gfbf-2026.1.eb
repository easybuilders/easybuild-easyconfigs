easyblock = 'PythonBundle'

name = 'cftime'
version = '1.6.5'

homepage = 'https://unidata.github.io/cftime'
description = """Python library for decoding time units and variable values in a netCDF file
 conforming to the Climate and Forecasting (CF) netCDF conventions."""

toolchain = {'name': 'gfbf', 'version': '2026.1'}

builddependencies = [
    ('Cython', '3.2.4'),
]

dependencies = [
    ('Python', '3.14.2'),
    ('SciPy-bundle', '2026.05'),
]

exts_list = [
    (name, version, {
        'checksums': ['8225fed6b9b43fb87683ebab52130450fc1730011150d3092096a90e54d1e81e'],
    }),
]

moduleclass = 'lib'
