easyblock = 'PythonPackage'

name = 'complexPyTorch'
version = '0.4'
versionsuffix = '-CUDA-12.6.0'

homepage = 'https://github.com/wavefrontshaping/complexPyTorch'
description = """A high-level toolbox for using complex valued neural networks in PyTorch."""

toolchain = {'name': 'foss', 'version': '2024a'}

source_urls = ['https://files.pythonhosted.org/packages/source/c/complexPyTorch/']
sources = [SOURCE_TAR_GZ]
checksums = ['cbe3d3a54e20f88a1aa2ef0f3ac7e1c6de7080d39319a5fc602871ed3b6cb92c']

dependencies = [
    ('Python', '3.12.3'),
    ('PyTorch', '2.7.1', '-CUDA-12.6.0'),
]

options = {
    'modulename': 'complexPyTorch',
}

sanity_check_commands = [
    "python -c 'from complexPyTorch.complexLayers import ComplexLinear, ComplexConv2d'",
    "python -c 'from complexPyTorch.complexFunctions import complex_relu'",
]

moduleclass = 'lib'
