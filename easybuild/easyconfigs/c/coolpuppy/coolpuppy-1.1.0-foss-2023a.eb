easyblock = 'PythonBundle'

name = 'coolpuppy'
version = '1.1.0'

homepage = 'https://coolpuppy.readthedocs.io/en/latest/index.html'
description = """
A versatile tool to perform pile-up analysis on Hi-C data in .cool format
 (https://github.com/mirnylab/cooler).
"""

toolchain = {'name': 'foss', 'version': '2023a'}

builddependencies = [
    ('binutils', '2.40'),
]

dependencies = [
    ('Python', '3.11.3'),
    ('SciPy-bundle', '2023.07'),
    ('cooltools', '0.7.1'),
    ('Seaborn', '0.13.2'),
    ('scikit-bio', '0.6.0'),  # for natsort
]

exts_list = [
    ('h5sparse', '0.1.0', {
        'checksums': ['b7e6fbfa2f2f61adaa169a3a0a52bc6f2178f5daff8fa6d972a8dcaa7f3cc8f7'],
    }),
    ('mistune', '0.8.4', {
        'checksums': ['59a3429db53c50b5c6bcc8a07f8848cb00d7dc8bdb431a4ab41920d201d4756e'],
    }),
    ('m2r2', '0.3.4', {
        'checksums': ['e278f5f337e9aa7b2080fcc3e94b051bda9615b02e36c6fb3f23ff019872f043'],
    }),
    ('multiprocessing_logging', '0.3.4', {
        'source_tmpl': '%(name)s-%(version)s-py2.py3-none-any.whl',
        'checksums': ['8a5be02b02edbd6fa6e3e89499af7680db69db9e2d8707fcd28d445fa248f23e'],
    }),
    (name, version, {
        'checksums': ['b40a551cf29bc6b7b377ecd68bccbb5923cbe5cae4d0426673461f3b1ff12141'],
    }),
]

moduleclass = 'bio'
