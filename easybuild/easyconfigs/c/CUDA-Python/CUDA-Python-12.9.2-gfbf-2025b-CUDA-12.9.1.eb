easyblock = 'PythonBundle'

name = 'CUDA-Python'
# Warning: major and minor versions of CUDA and CUDA-Python are tied
version = '12.9.2'
versionsuffix = '-CUDA-%(cudaver)s'

homepage = 'https://nvidia.github.io/cuda-python/'
description = "Python bindings for CUDA"
github_account = 'NVIDIA'

toolchain = {'name': 'gfbf', 'version': '2025b'}

builddependencies = [
    ('Cython', '3.1.2'),
]
dependencies = [
    ('CUDA', '%(version_major)s.%(version_minor)s.1', '', SYSTEM),
    ('Python', '3.13.5'),
    ('SciPy-bundle', '2025.07'),
]

exts_default_options = {
    'source_urls': ['https://github.com/%(github_account)s/cuda-python/archive/refs/tags'],
    'sources': ['%(name)s-v%(version)s.tar.gz'],
}
exts_list = [
    ('pyclibrary', '0.2.2', {
        'source_urls': [PYPI_SOURCE],
        'sources': [SOURCE_TAR_GZ],
        'checksums': ['9902fffe361bb86f57ab62aa4195ec4dd382b63c5c6892be6d9784ec0a3575f7'],
    }),
    ('cuda-bindings', version, {
        'source_urls': [f'https://github.com/{github_account}/cuda-python/archive'],
        'sources': [{
            'download_filename': V_VERSION_TAR_GZ,
            'filename': SOURCE_TAR_GZ,
        }],
        'modulename': 'cuda.bindings',
        'start_dir': 'cuda_bindings',
        'checksums': ['14ed346e848f796929516ebce1e3b33567c4f285abf44aa767ec8e9542ca6a68']
    }),
    ('cuda-core', '0.3.1', {
        'modulename': 'cuda.core',
        'start_dir': 'cuda_core',
        'checksums': ['8cf994d974fd7461ecc51acfefe103092a57d27e0afb5c47d20714a69a81177e']
    }),
    ('cuda-pathfinder', '1.1.0', {
        'modulename': 'cuda.pathfinder',
        'start_dir': 'cuda_pathfinder',
        'checksums': ['e58043a44ee70f0469483904c30c4e0d1d815a6db87ac31d002419e59d6e5c68']
    }),
    ('cuda-python', version, {
        'source_urls': [PYPI_SOURCE],
        'sources': ['cuda_python-%(version)s-py3-none-any.whl'],
        'modulename': False,  # cuda-python is just a meta-package
        'checksums': ['b504d773d6f1589486143e0e4984680f78f46ba6726ce2a957ac32897305264a']
    }),
]

sanity_check_commands = [
    "python -sc 'from cuda import cuda, nvrtc'",
    "python -sc 'from cuda.bindings import driver, nvrtc'",
]

moduleclass = 'lib'
