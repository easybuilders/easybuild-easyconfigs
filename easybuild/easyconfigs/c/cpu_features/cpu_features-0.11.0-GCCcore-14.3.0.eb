# This file is an EasyBuild reciPY as per https://github.com/easybuilders/easybuild
# Author: Denis Kristak, update: Pavel Tomanek
# update: J. Saßmannshausen (Imperial College London/UK)

easyblock = 'CMakeMake'

name = 'cpu_features'
version = '0.11.0'

homepage = 'https://github.com/google/cpu_features'
description = """A cross-platform C library to retrieve CPU features
(such as available instructions) at runtime."""

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}
toolchainopts = {'pic': True}

source_urls = ['https://github.com/google/cpu_features/archive/']
sources = ['v%(version)s.tar.gz']
checksums = ['ab2463f2d38fcaff1ce806be8e4c91333449931f5e02009d543b2569a3fa471a']

builddependencies = [
    ('CMake', '4.0.3'),
    ('binutils', '2.44'),
]

modextrapaths = {MODULE_LOAD_ENV_HEADERS: 'include/cpu_features'}

sanity_check_paths = {
    'files': ['bin/list_cpu_features', 'lib/libcpu_features.a'],
    'dirs': ['include/cpu_features/']
}

sanity_check_commands = ['list_cpu_features']

moduleclass = 'tools'
