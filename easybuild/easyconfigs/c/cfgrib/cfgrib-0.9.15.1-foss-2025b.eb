easyblock = 'PythonBundle'

name = 'cfgrib'
version = '0.9.15.1'

homepage = 'https://github.com/ecmwf/cfgrib/'
description = """A Python interface to map GRIB files to the NetCDF Common Data Model following
the CF Convention using ecCodes."""

toolchain = {'name': 'foss', 'version': '2025b'}

builddependencies = [
    ('poetry', '2.1.3'),
]

dependencies = [
    ('Python', '3.13.5'),
    ('SciPy-bundle', '2025.07'),
    ('eccodes-python', '2.43.0'),
    ('xarray', '2025.10.0'),  # extra
]

exts_list = [
    (name, version, {
        'checksums': ['d959d8b97e55a63646fa86686b297905ff7f2918a91e3a11d6292dab09598e4d'],
    }),
]

sanity_check_commands = ['python -s -m cfgrib selfcheck']

moduleclass = 'tools'
