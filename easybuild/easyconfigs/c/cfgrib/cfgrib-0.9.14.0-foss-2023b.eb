easyblock = 'PythonBundle'

name = 'cfgrib'
version = '0.9.14.0'

homepage = 'https://github.com/ecmwf/cfgrib/'
description = """A Python interface to map GRIB files to the NetCDF Common Data Model following
the CF Convention using ecCodes."""

toolchain = {'name': 'foss', 'version': '2023b'}

builddependencies = [
    ('poetry', '1.7.1'),
]

dependencies = [
    ('Python', '3.11.5'),
    ('SciPy-bundle', '2023.11'),
    ('eccodes-python', '1.7.0'),
]

exts_list = [
    (name, version, {
        'checksums': ['2b9a1e6bd47397e585f878ffd8aaac5969f6c9a448da767c700917b89c275bb2'],
    }),
]

sanity_check_commands = ['python -s -m cfgrib selfcheck']

moduleclass = 'tools'
