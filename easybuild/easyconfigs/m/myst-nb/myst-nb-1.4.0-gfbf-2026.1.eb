easyblock = 'PythonBundle'

name = 'myst-nb'
version = '1.4.0'

homepage = 'https://github.com/executablebooks/MyST-NB'
description = """The primary tool this package provides is a Sphinx parser for ipynb files.
This allows you to directly convert Jupyter Notebooks into Sphinx documents."""

toolchain = {'name': 'GCCcore', 'version': '15.2.0'}

dependencies = [
    ('Python', '3.14.2'),
    ('Python-bundle-PyPI', '2026.04'),
    ('IPython', '9.14.0'),
    ('PyYAML', '6.0.3'),
    ('SQLAlchemy', '2.0.51'),
    ('jupyter-server', '2.19.0'),  # for nbclient, nbformat, ipykernel
]

exts_list = [
    ('jupyter-cache', '1.0.1', {
        'checksums': ['16e808eb19e3fb67a223db906e131ea6e01f03aa27f49a7214ce6a5fec186fb9'],
    }),
    ('myst-parser', '5.1.0', {
        'checksums': ['ab69322dc6719dcc7f296479dbb70181b66df6ed315064f92dbc85c0e1bf2f02'],
    }),
    (name, version, {
        'checksums': ['c145598de62446a6fd009773dd071a40d3b76106ace780de1abdfc6961f614c2'],
    }),
]

moduleclass = 'tools'
