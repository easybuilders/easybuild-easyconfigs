easyblock = 'CMakeNinja'

name = 'metatensor-torch'
version = '0.10.7'

homepage = 'https://docs.metatensor.org/'
description = """metatensor-torch is the TorchScript (libtorch) binding of metatensor,
 the storage format for sparse, labelled data in atomistic machine learning."""

toolchain = {'name': 'foss', 'version': '2026.1'}
toolchainopts = {'pic': True}

source_urls = ['https://github.com/metatensor/metatensor/releases/download/metatensor-torch-v%(version)s/']
sources = ['metatensor-torch-cxx-%(version)s.tar.gz']
checksums = ['c4ea32d3bc383cf3fe684b5ffd510965a90c36c27dabb97a7075490a614dcabc']

builddependencies = [
    ('CMake', '4.2.1'),
    ('Ninja', '1.13.2'),
]

dependencies = [
    ('Python', '3.14.2'),
    ('PyTorch', '2.9.1'),
    ('metatensor', '0.2.6'),
]

configopts = '-DBUILD_SHARED_LIBS=ON '
configopts += '-DTorch_DIR=$EBROOTPYTORCH/lib/python%(pyshortver)s/site-packages/torch/share/cmake/Torch'

sanity_check_paths = {
    'files': ['include/metatensor/torch.hpp', 'lib/libmetatensor_torch.%s' % SHLIB_EXT],
    'dirs': ['lib/cmake/metatensor_torch'],
}

moduleclass = 'lib'
