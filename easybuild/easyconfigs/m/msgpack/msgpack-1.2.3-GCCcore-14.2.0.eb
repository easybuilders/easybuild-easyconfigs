easyblock = 'PythonPackage'

name = 'msgpack'
version = '1.2.3'

homepage = 'https://msgpack.org/'
description = """MessagePack is an efficient binary serialization format. It lets you
exchange data among multiple languages like JSON. But it's faster and smaller."""

toolchain = {'name': 'GCCcore', 'version': '14.2.0'}

sources = [SOURCE_TAR_GZ]
checksums = ['32edb81a2b5eb7cd7c9d941b2bfbbb082fd2cd09e0e725930316af6b708db186']

builddependencies = [
    ('binutils', '2.42'),
    ('setuptools', '80.9.0'),
]

dependencies = [
    ('Python', '3.13.1'),
]

moduleclass = 'tools'
