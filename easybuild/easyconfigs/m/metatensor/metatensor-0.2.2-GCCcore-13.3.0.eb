# Companion: metatensor-core C library for eOn / metatensor-torch.
# metatensor-torch 0.10.0 requires metatensor >= 0.2.2 (CMake CONFIG).
easyblock = 'CMakeMake'

name = 'metatensor'
version = '0.2.2'

homepage = 'https://docs.metatensor.org/'
description = """Metatensor core C library: sparse storage for atomistic
machine learning. Built from the metatensor-core CXX release tarball."""

toolchain = {'name': 'GCCcore', 'version': '13.3.0'}
toolchainopts = {'pic': True}

# Official CXX release asset: ships cmake/git_version_info + a baked VERSION,
# extracts to a single self-named top dir. No git checkout, no start_dir or
# git_version_info printf hack needed (unlike the archive/refs/tags tarball).
source_urls = ['https://github.com/metatensor/metatensor/releases/download/metatensor-core-v%(version)s/']
sources = ['metatensor-core-cxx-%(version)s.tar.gz']
checksums = ['a104512516c8761080075e3ba7c023fcc1bb3430df7c67b25bded359a729e2ff']

builddependencies = [
    ('binutils', '2.42'),
    ('CMake', '3.29.3'),
    ('pkgconf', '2.2.0'),
    # cargo edition2024 / rustc >= 1.85; companion Rust 1.88 on GCCcore-13.3.0
    ('Rust', '1.88.0'),
]

# Scrub host mold/sccache wrappers for the vendored cargo build.
preconfigopts = 'unset RUSTFLAGS CARGO_ENCODED_RUSTFLAGS RUSTC_WRAPPER CARGO_BUILD_RUSTC_WRAPPER; '
prebuildopts = 'unset RUSTFLAGS CARGO_ENCODED_RUSTFLAGS RUSTC_WRAPPER CARGO_BUILD_RUSTC_WRAPPER; '
configopts = '-DBUILD_SHARED_LIBS=ON -DCMAKE_BUILD_TYPE=Release '

sanity_check_paths = {
    'files': ['include/metatensor.h', 'lib/libmetatensor.%s' % SHLIB_EXT],
    'dirs': ['include', 'lib', 'lib/cmake'],
}

moduleclass = 'lib'
