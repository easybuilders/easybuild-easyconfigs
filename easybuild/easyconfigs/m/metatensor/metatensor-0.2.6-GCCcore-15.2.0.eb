easyblock = 'CargoCMakeMake'

name = 'metatensor'
version = '0.2.6'

homepage = 'https://docs.metatensor.org/'
description = """metatensor-core is the C/C++ library under metatensor, a storage
 format for sparse, labelled data in atomistic machine learning."""

toolchain = {'name': 'GCCcore', 'version': '15.2.0'}
toolchainopts = {'pic': True}

