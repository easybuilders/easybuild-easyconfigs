easyblock = 'Tarball'

name = 'mlst'
version = '2.35.0'

homepage = "https://github.com/tseemann/mlst"
description = "Scan contig files against PubMLST typing schemes"

toolchain = {'name': 'foss', 'version': '2025a'}

source_urls = ['https://github.com/tseemann/mlst/archive/refs/tags/']
sources = ['v%(version)s.tar.gz']
checksums = ['9f1291ed02494b7a862e0d56d8f501f500d7a4a207fe4244962b743df1c3dcc4']

dependencies = [
    ('Perl', '5.40.0'),
    ('Perl-bundle-CPAN', '5.40.0'),
    ('any2fasta', '0.8.1'),
    ('BLAST+', '2.17.0'),
]

sanity_check_paths = {
    'files': ['bin/%(name)s'],
    'dirs': ['scripts', 'db'],
}

sanity_check_commands = [
    "mlst --help",
]

moduleclass = 'bio'
