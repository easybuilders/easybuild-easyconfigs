# Author: J. Sassmannshausen (Imperial College London/UK)

easyblock = 'Tarball'

name = 'MOSEK'
version = '11.2.2'

homepage = 'https://www.mosek.com'
description = """
MOSEK is a package for large-scale convex and mixed-integer optimization,
including LP, QP, SOCP, exponential and power cone problems, SDP, QCQP and MIP.
Documentation and examples can be found at the MOSEK website
MOSEK requires a license. Free of charge trial licenses as well as licenses
for non-commercial academic use can be obtained from the MOSEK website.
This is the full distribution package!
"""

toolchain = SYSTEM

download_instructions = """
Download manually from:
https://www.mosek.com/downloads/
"""

sources = ['mosektoolslinux64x86.tar.bz2']
checksums = ['0d5499fbc82098aec4ca2687602523c50ff7998e467149605d545f45e881922c']

sanity_check_paths = {
    'files': ["tools/platform/linux64x86/bin/mosek"],
    'dirs': ["toolbox"],
}

moduleclass = 'data'
