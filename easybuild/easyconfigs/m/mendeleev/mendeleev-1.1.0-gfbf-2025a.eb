easyblock = 'PythonPackage'

name = 'mendeleev'
version = '1.1.0'

homepage = 'https://github.com/lmmentel/mendeleev'
description = """Pythonic periodic table of elements. A package with a convenient python API
for accessing various properties of elements, ions and isotopes in the periodic table of
elements."""

toolchain = {'name': 'gfbf', 'version': '2025a'}

sources = [SOURCE_TAR_GZ]
checksums = ['34081dd9ae58823287382e8defde8276003d8c2784367bb1271e8e32e7fd07e8']

builddependencies = [
    ('poetry', '2.1.2'),
]

dependencies = [
    ('Python', '3.13.1'),
    ('SciPy-bundle', '2025.06'),
    ('SQLAlchemy', '2.0.41'),
    ('Deprecated', '1.2.18'),
    ('pydantic', '2.11.7'),
    ('pyfiglet', '0.8.post1'),
    ('Pygments', '2.21.0'),
    ('colorama', '0.4.6'),
]

moduleclass = 'tools'
