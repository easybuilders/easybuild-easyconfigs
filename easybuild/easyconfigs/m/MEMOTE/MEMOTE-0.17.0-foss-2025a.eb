        'checksums': ['1ad89d14cdccefd81265bb619f9f9c351556e2e38fafc7a57b1319ded086f8e9'],
        # workaround for: ValueError: invalid pyproject.toml config: project.license
        'preinstallopts': "sed -i '/^license  *=/d; /^license-files *=/d' pyproject.toml && ",
    }),
    ('memote', version, {
        'checksums': ['b61b222c6fe7719f0f916f01a5c68679567bad8884ed36eb634311ddbc565f19'],
    }),
