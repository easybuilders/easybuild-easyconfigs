easyblock = 'PythonBundle'

name = 'MoviePy'
version = '2.2.1'

homepage = "https://zulko.github.io/moviepy/"
description = """MoviePy (full documentation) is a Python library for video editing: cutting, concatenations,
 title insertions, video compositing (a.k.a. non-linear editing), video processing, and creation of custom effects."""

toolchain = {'name': 'foss', 'version': '2024a'}

dependencies = [
    ('Python', '3.12.3'),
    ('Python-bundle-PyPI', '2024.06'),
    ('SciPy-bundle', '2024.05'),
    ('FFmpeg', '7.0.2'),
    ('Pillow', '10.4.0'),
    ('tqdm', '4.66.5'),
    ('imageio', '2.36.1'),
]

exts_list = [
    ('python_dotenv', '1.2.1', {
        'preinstallopts': "sed -i '/^license = /d' pyproject.toml && ",
        'modulename': 'dotenv',
        'checksums': ['42667e897e16ab0d66954af0e60a9caa94f0fd4ecf3aaf6d2d260eec1aa36ad6'],
    }),
    ('imageio_ffmpeg', '0.6.0', {
        'checksums': ['e2556bed8e005564a9f925bb7afa4002d82770d6b08825078b7697ab88ba1755'],
    }),
    ('proglog', '0.1.12', {
        'preinstallopts': "sed -i '/^license = /d' pyproject.toml && ",
