# Thomas Hoffmann, EMBL Heidelberg, structures-it@embl.de, 2025/01
easyblock = 'CMakeMake'

name = 'mrc'
version = '1.3.17'

homepage = 'https://github.com/mhekkel/mrc'
description = """Maartens Resource Compiler to store resources in the static section of an ELF binary."""

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}

github_account = 'mhekkel'
source_urls = [GITHUB_SOURCE]
sources = ['v%(version)s.tar.gz']
checksums = ['9182e33805a85bb42369a675a6602684aa037587cfc81b40154dfa8440a1737e']

configopts = (
    '-DCPM_LOCAL_PACKAGES_ONLY=ON '
    '-DFETCHCONTENT_FULLY_DISCONNECTED=ON '
)

builddependencies = [
    ('binutils', '2.44'),
    ('CMake', '3.31.8'),
    ('Catch2', '3.11.0'),  # req. 3.5.2 or newer
    ('libmcfp', '1.4.2'),
]

runtest = True

sanity_check_paths = {
    'files': ['bin/mrc'],
    'dirs': ['']
}
sanity_check_commands = ['mrc -h']

moduleclass = 'tools'
