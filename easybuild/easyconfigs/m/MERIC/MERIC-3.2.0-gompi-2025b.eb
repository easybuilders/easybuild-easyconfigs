easyblock = 'Waf'

name = 'MERIC'
version = '3.2.0'

homepage = 'https://code.it4i.cz/energy-efficiency/meric-suite/meric'
description = """MERIC runtime system for parallel applications energy consumption measurement,
dynamic behavior detection, and dynamic power-management knobs tuning according to the READEX approach."""

toolchain = {'name': 'gompi', 'version': '2025b'}

source_urls = [
    (
        'https://code.it4i.cz/api/v4/projects/'
        'energy-efficiency%2Fmeric-suite%2Fmeric/uploads/0c7a7ee86192d79d19331fab9b5d82f0'
    )
]
sources = [SOURCELOWER_TAR_GZ]
checksums = ['9bd7bf67ee8ce78fb2c0a962b77684862b18d33bc91fb095c3b0bf3005a9538b']

runtest = 'MERIC_SANITY_PATH_TO_BINARIES=build test/test-power-monitoring.sh'

sanity_check_paths = {
    'dirs': ['bin', 'include', 'lib'],
    'files': [
        'bin/systemInfo', 'bin/mericStatic', 'bin/wrapper',
        'include/meric.h', 'include/meric_ext.h', 'include/timeprof.h',
        'include/meric_fortran_interface.h90', 'include/meric_mod.F90', 'include/meric.mod',
        'lib/libmeric_ext.a', 'lib/libmeric.a',  'lib/libmeric.so', 'lib/libmericmpi.a', 'lib/libmericmpi.so',
        'lib/libtimeprof.a', 'lib/libtimeprof.so', 'lib/libtimeprofmpi.a', 'lib/libtimeprofmpi.so'
    ]
}

moduleclass = 'perf'
