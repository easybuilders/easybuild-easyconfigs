# Author: Emik Lin (HKUMed CPOS)

easyblock = 'PythonPackage'

name = 'metaMIC'
version = '20220221'
local_commit = 'd397bb6c230b01c53450c0fd098aa0f353097ca0'

homepage = 'https://github.com/ZhaoXM-Lab/metaMIC'
description = "Reference-free misassembly identification and correction of metagenomic assemblies."

toolchain = {'name': 'foss', 'version': '2023b'}

source_urls = ['https://github.com/ZhaoXM-Lab/metaMIC/archive/']
sources = [{'download_filename': '%s.tar.gz' % local_commit, 'filename': SOURCE_TAR_GZ}]
patches = ['%(name)s-%(version)s_compatibility.patch']
checksums = [
    'c471b9610e85246b0348f3b1d19b7faf500da04b1dd8571e503d145334c7ad08',  # metaMIC-20220221.tar.gz
    '3eafa0b86491d405217ebcdec1a326eb12ae1aba98b522b2f26e6f9dff5a9c82',  # metaMIC-20220221_compatibility.patch
]

dependencies = [
    ('Python', '3.11.5'),
    ('Python-bundle-PyPI', '2023.10'),
    ('SciPy-bundle', '2023.11'),
    ('scikit-learn', '1.4.0'),
    ('Biopython', '1.84'),
    ('Pysam', '0.22.0'),
    ('BWA', '0.7.18'),
    ('SAMtools', '1.19.2'),
    ('Jellyfish', '2.3.1'),
]

options = {'modulename': 'metaMIC.metaMIC'}

sanity_check_paths = {
    'files': ['bin/metaMIC'],
    'dirs': [],
}

sanity_check_commands = [
    "metaMIC --help",
]

moduleclass = 'bio'
