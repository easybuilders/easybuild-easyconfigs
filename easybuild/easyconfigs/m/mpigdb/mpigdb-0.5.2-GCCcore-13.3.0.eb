easyblock = 'Cargo'

name = 'mpigdb'
version = '0.5.2'

homepage = "https://github.com/robertu94/mpigdb"
description = """
mpigdb is a wrapper around mpiexec, gdbserver, and gdb that makes debugging MPI programs
easier with a moderate number of processes.
"""

toolchain = {'name': 'GCCcore', 'version': '13.3.0'}

builddependencies = [
    ('binutils', '2.42'),
    ('Rust', '1.83.0'),
]

dependencies = [
    ('GDB', '14.2'),
]

source_urls = ['https://github.com/robertu94/mpigdb/archive/refs/tags']
sources = [{'download_filename': '%(version)s.tar.gz', 'filename': SOURCE_TAR_GZ}]
crates = [
    ('anyhow', '1.0.66'),
    ('bitflags', '2.6.0'),
    ('either', '1.13.0'),
