sanity_check_paths = {
    'files': ['bin/mpigdb', 'bin/mpigdb_helper'],
    'dirs': []
}

# mpigdb --help exits with status 1, so check the output instead of the exit code
sanity_check_commands = ["%(namelower)s --help | grep -q mpigdb"]

moduleclass = 'tools'
