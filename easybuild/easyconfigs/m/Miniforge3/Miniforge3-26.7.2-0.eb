easyblock = 'EB_Mamba'

name = 'Miniforge3'
version = '26.7.2-0'

homepage = 'https://github.com/conda-forge/miniforge'
description = """Miniforge is a free minimal installer for conda and Mamba specific
 to conda-forge."""

toolchain = SYSTEM

source_urls = ['https://github.com/conda-forge/miniforge/releases/download/%(version)s']
local_arch = {'arm64': 'aarch64'}.get(ARCH, ARCH)
sources = ['%%(name)s-%%(version)s-Linux-%s.sh' % local_arch]
checksums = [
    {
        '%(name)s-%(version)s-Linux-x86_64.sh':
            '281b0ac7d550802efc81af633225a5e6116d29ae72f3ab4eae7168c3931a4c05',
        '%(name)s-%(version)s-Linux-ppc64le.sh':
            '466e6af6766fe3d9aea18a7a6431d480f3a64995d53e8cbd438ca5a064b2c945',
        '%(name)s-%(version)s-Linux-aarch64.sh':
            '89b786c8d2c8b0fda7553914c1314ae4ddaa094503802f279377b19ac4463cb2',
        '%(name)s-%(version)s-Linux-riscv64.sh':
            'a82efd1197849cd6755c080bd883ed376eda09080f52bfe9051912afdd05c281',
    }
]


moduleclass = 'lang'
