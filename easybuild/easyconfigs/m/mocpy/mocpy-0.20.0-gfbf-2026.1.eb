easyblock = 'CargoPythonPackage'

name = 'mocpy'
version = '0.20.0'

homepage = 'https://cds-astro.github.io/mocpy/'
description = """MOCPy is a Python library allowing easy creation, parsing and manipulation of
Multi-Order Coverage maps (MOCs), as defined by the IVOA MOC standard."""

# New easyconfig: mocpy is a new dependency of LSMTool 1.9 (builds a Rust extension, hence the crates below)
toolchain = {'name': 'gfbf', 'version': '2026.1'}

