easyblock = 'PythonBundle'

name = 'MetPy'
version = '1.7.1'

homepage = 'https://github.com/Unidata/MetPy'
description = """MetPy is a collection of tools in Python for reading, visualizing
 and performing calculations with weather data."""

toolchain = {'name': 'gfbf', 'version': '2025b'}

dependencies = [
    ('Python', '3.13.5'),
    ('Python-bundle-PyPI', '2025.07'),
    ('SciPy-bundle', '2025.07'),
    ('matplotlib', '3.10.5'),
    ('IPython', '9.4.0'),
    ('pyproj', '3.7.1'),
    ('xarray', '2025.10.0'),
    ('Pint', '0.25'),
]

exts_list = [
    ('metpy', version, {
        'checksums': ['cdfd8fdab58bc092a1974c016f2ea3a7715ffdf6a4660b28b0de7049328bce75'],
    }),
]

moduleclass = 'geo'
