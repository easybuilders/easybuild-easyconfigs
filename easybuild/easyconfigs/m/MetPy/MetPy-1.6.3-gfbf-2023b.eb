easyblock = 'PythonBundle'

name = 'MetPy'
version = '1.6.3'

homepage = 'https://github.com/Unidata/MetPy'
description = """MetPy is a collection of tools in Python for reading, visualizing
 and performing calculations with weather data."""

toolchain = {'name': 'gfbf', 'version': '2023b'}

dependencies = [
    ('Python', '3.11.5'),
    ('Python-bundle-PyPI', '2023.10'),
    ('matplotlib', '3.8.2'),
    ('SciPy-bundle', '2023.11'),
    ('IPython', '8.17.2'),
    ('pyproj', '3.6.1'),
    ('xarray', '2024.5.0'),
    ('Pint', '0.24'),
]

exts_list = [
    ('metpy', version, {
        'checksums': ['23df14a9a67206fd1ffe6d5d3208587941d6abf9778c04dc7a3a1dc7a9a60766'],
    }),
]

moduleclass = 'geo'
