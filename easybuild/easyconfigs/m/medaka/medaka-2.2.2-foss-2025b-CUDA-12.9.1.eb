# Author: Ehsan Moravveji (VSC - KU Leuven)
# Disclaimer: This easyconfig just an in-place version adaptation of
#             the one in https://github.com/easybuilders/easybuild-easyconfigs/pull/26621

easyblock = 'PythonBundle'

name = 'medaka'
version = '2.2.2'
versionsuffix = '-CUDA-%(cudaver)s'

homepage = 'https://github.com/nanoporetech/medaka'
description = "medaka is a tool to create a consensus sequence from nanopore sequencing data."

toolchain = {'name': 'foss', 'version': '2025b'}
toolchainopts = {'pic': True}

builddependencies = [
    ('Autotools', '20250527'),
    ('Cython', '3.2.4'),
    ('CMake', '4.0.3'),
    ('setuptools', '80.10.1'),
    ('poetry', '2.1.3'),
]

_minimap_ver = '2.30'
dependencies = [
    ('CUDA', '12.9.1', '', SYSTEM),
    ('Python', '3.13.5'),
    ('Python-bundle-PyPI', '2025.07'),  # includes cffi
    ('Pysam', '0.23.3'),
    ('SAMtools', '1.22.1'),
    ('minimap2', _minimap_ver),
    ('HTSlib', '1.22.1'),  # for tabix and bgzip
    ('edlib', '1.3.9.post1'),
    ('pyspoa', '0.2.1'),
    ('python-parasail', '1.3.4'),
    ('ont-fast5-api', '4.1.3'),
    ('WhatsHap', '2.8'),
    ('intervaltree-python', '3.2.1'),
    ('BCFtools', '1.22'),
    ('h5py', '3.14.0'),
    ('PyTorch', '2.9.1', f'{versionsuffix}'),
    ('PyTorch-bundle', '2.9.1', f'{versionsuffix}'),  # provides tensordict
    ('tqdm', '4.67.1'),
    ('wurlitzer', '3.1.1'),
]

exts_list = [
    ('mappy', '2.30', {
        'checksums': ['a25448004558a28cb0d74fb1e55b6ffe9a78aa15dd6b2763630fbbabbaa97a27'],
    }),
    ('pyabpoa', '1.5.7.1', {
        'preinstallopts': """sed -i 's/license = "MIT"/license = {text = "MIT"}/' pyproject.toml && SSE2=1 """,
        'checksums': ['765643c522032cac957c5c8b057e021599ffa01bcace39ba893aa31448e7a428'],
    }),
    (name, version, {
        'patches': ['medaka-2.2.1_use-system-htslib.patch'],
        'preinstallopts': ' && '.join([
            "sed -i 's/ont-parasail/parasail/g' requirements.txt",
            "sed -i 's/ont-mappy/mappy/g' requirements.txt",
            "sed -i 's/pysam>=0.16.0.1,<=0.23.0/pysam>=0.16.0.1/g' requirements.txt",
        ]) + ' && ',
        'use_pip_extras': 'abpoa',
        'checksums': [
            {'medaka-2.2.2.tar.gz': '28ed7402af5c82aa5d62c28325c1b1d6961b69d3ee16b624f44a5dbc34edf44e'},
            {'medaka-2.2.1_use-system-htslib.patch':
             '2d3d43c912d4d238032781df2b4e30c8e7bbd09c05ac2fee3cdb96edb09f8419'},
        ],
    }),
]

sanity_check_paths = {
    'files': [
        'bin/medaka',
        'bin/medaka_consensus',
        'bin/medaka_consensus_joint',
        'bin/medaka_counts',
        'bin/medaka_data_path',
        'bin/medaka_variant',
        'bin/medaka_version_report',
        'bin/mini_align',
    ],
    'dirs': ['lib/python%(pyshortver)s/site-packages/medaka'],
}

sanity_check_commands = [
    'medaka --help',
    'medaka_version_report',
]

moduleclass = 'bio'
