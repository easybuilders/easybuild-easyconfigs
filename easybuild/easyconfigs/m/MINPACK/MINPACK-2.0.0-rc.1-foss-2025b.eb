easyblock = 'MesonNinja'

name = 'MINPACK'
version = '2.0.0-rc.1'

homepage = 'https://github.com/fortran-lang/minpack'
description = """Modernized Minpack: a Fortran 2008 library for solving systems of nonlinear
 equations and nonlinear least squares problems, maintained by the fortran-lang
 community. Provides the classic Minpack algorithms (hybrd, hybrj, lmder, lmdif,
 lmstr, chkder) through a Fortran module interface and a C API."""

toolchain = {'name': 'foss', 'version': '2025b'}
toolchainopts = {'pic': True}

github_account = 'fortran-lang'
source_urls = [GITHUB_SOURCE]
sources = [{'download_filename': 'v%(version)s.tar.gz', 'filename': SOURCELOWER_TAR_GZ}]
checksums = ['5dfe8182f1e85e1e93bad09a90d802982562b2eac906c28d59e18ec34751c685']

builddependencies = [
    ('Meson', '1.8.2'),
    ('Ninja', '1.13.0'),
]

configopts = '-Dapi=true -Dpython=false'

# test_lmdif/test_lmstr fail with gfortran >= 13 on ill-conditioned problems (Meyer, Brown-Dennis): results differ
# from the hard-coded references by 1e-4..3e-3 relative, see https://github.com/fortran-lang/minpack/issues/84
# -> run all other tests (lmdif/lmstr stay covered by the lmdif1 example and the C API test)
runtest = 'meson test --print-errorlogs hybrd hybrd1 lmder1 lmdif1 primes chkder hybrj lmder c-api'

sanity_check_paths = {
    'files': ['include/minpack.h', 'include/minpack/minpack_module.mod', 'include/minpack/minpack_capi.mod',
              'lib/libminpack.a', f'lib/libminpack.{SHLIB_EXT}', 'lib/pkgconfig/minpack.pc'],
    'dirs': [],
}

moduleclass = 'numlib'
