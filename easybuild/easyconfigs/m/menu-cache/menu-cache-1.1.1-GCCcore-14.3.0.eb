easyblock = 'Bundle'

name = 'menu-cache'
version = '1.1.1'

homepage = 'https://github.com/lxde/menu-cache'
description = """(Lib)menu-cache is a library creating and utilizing caches to speed up
the manipulation for freedesktop.org defined application menus.
It can be used as a replacement of libgnome-menu of gnome-menus.
"""

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}

builddependencies = [
    ('binutils', '2.44'),
    ('Autotools', '20250527'),
    ('gtk-doc', '1.35.1'),
    ('pkgconf', '2.4.3'),
    ('intltool', '0.51.0'),
]

dependencies = [
    ('GLib', '2.85.3'),
]

default_easyblock = 'ConfigureMake'

default_component_specs = {
    'start_dir': '%(namelower)s-%(version)s',
}

components = [
    ('libfm', '1.3.2', {  # Circular dependency on libfm; libmenu-cache needs "extras" tools from here.
        'source_urls': ['https://downloads.sourceforge.net/pcmanfm/'],
        'sources': [SOURCE_TAR_XZ],
        'configopts': '--with-extra-only',
    }),
    (name, version, {
        'source_urls': ['https://github.com/lxde/menu-cache/archive/refs/tags/'],
        'sources': [VERSION_TAR_GZ],
        #'checksums': ['e8af90467df271c3c8700c840ca470ca2915699c6f213c502a87d74608748f08'],
        'preconfigopts': './autogen.sh && ',
    }),
]


sanity_check_paths = {
    'files': [f'lib/libmenu-cache.{SHLIB_EXT}', f'lib/libfm-extra.{SHLIB_EXT}'],
    'dirs': ['include/menu-cache', 'include/libfm'],
}

moduleclass = 'lib'
