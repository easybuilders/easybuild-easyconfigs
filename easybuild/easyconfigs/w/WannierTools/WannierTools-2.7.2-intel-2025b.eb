easyblock = 'ConfigureMake'

name = 'WannierTools'
version = '2.7.2'

homepage = 'http://www.wanniertools.org'
description = 'An open-source software package for novel topological materials.'

toolchain = {'name': 'intel', 'version': '2025b'}

source_urls = ['https://github.com/quanshengwu/wannier_tools/archive/refs/tags/']
sources = [V_VERSION_TAR_GZ]
patches = [
    'https://github.com/quanshengwu/wannier_tools/pull/179.patch',
    'WannierTools-2.7.2_pr180.patch'
]
checksums = [
    {'v2.7.2.tar.gz': '7232d017c13bd638dff89aad5f4a496d44c917b30c6b7aa17f6486a44d854253'},
    {'179.patch': '1a70fcf348733f13e61dae035ec452ac43fbeb9b5ad10223e1ec946f3d5b8429'},
    {'WannierTools-2.7.2_pr180.patch': '995483bcb46af2bb551e0f1573e49df7bf803f16fab7ecf669031f3418394134'},
]

dependencies = [
    ('arpack-ng', '3.9.1'),
]

start_dir = 'src'
skipsteps = ['configure', 'install']
prebuildopts = 'cp Makefile.intel-mpi Makefile && sed -i "s/ARPACK=.*/ARPACK=-larpack/" Makefile && '
postinstallcmds = ['mkdir %(installdir)s/bin', 'cp ../bin/wt.x %(installdir)s/bin']
maxparallel = 1

sanity_check_paths = {
    'files': ['bin/wt.x'],
    'dirs': [],
}

sanity_check_commands = ['wt.x -h']

moduleclass = 'tools'
