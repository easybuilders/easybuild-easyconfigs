easyblock = 'Bundle'

name = 'Weston'
version = '16.0.0'

homepage = 'https://www.hjdskes.nl/projects/cage/'
description = 'Weston is a Wayland compositor designed for correctness, reliability, predictability, and performance.'

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}

builddependencies = [
    ('binutils', '2.44'),
    ('Meson', '1.8.2'),
    ('Ninja', '1.13.0'),
    ('pkgconf', '2.4.3'),
    ('Python', '3.13.5'),
    ('hwdata', '0.403'),  # for old libdisplay-info
]

dependencies = [
    ('Wayland', '1.24.0'),
    ('libevdev', '1.13.6'),
    ('GnuTLS', '3.8.10'),
    ('nettle', '3.10.2'),
    ('Xwayland', '24.1.9'),
    ('OpenGL', '2025.09'),
    ('Vulkan', '1.4.328'),
    ('glslang-SPIRV', '15.4.0'),
    ('X11', '20250608'),
    ('pixman', '0.46.4'),
    ('LittleCMS', '2.17'),
    ('libdrm', '2.4.125'),
    ('libinput', '1.30.1'),
    ('seatd', '0.9.2'),
    ('GLib', '2.85.3'),
    ('cairo', '1.18.4'),
    ('libpng', '1.6.50'),
    ('Pango', '1.57.0'),
    ('fontconfig', '2.17.0'),
    ('libjpeg-turbo', '3.1.1'),
    ('libwebp', '1.5.0'),
    ('FreeRDP-server3', '3.25.0'),
]

osdependencies = [('pam-devel')]

default_easyblock = 'MesonNinja'

default_component_specs = {
    'start_dir': '%(namelower)s-%(version)s',
}

_configopts = ' '.join([
    '-Dbackend-pipewire=false',
    '-Dsystemd=false',
    '-Dshell-lua=false',
])


components = [
    ('aml', '1.0.0', {
        'source_urls': ['https://github.com/any1/%(name)s/archive/refs/tags/'],
        'sources': [{'download_filename': V_VERSION_TAR_GZ, 'filename': SOURCE_TAR_GZ}],
        'start_dir': '%(namelower)s-%(version)s',
        'configopts': '-Ddefault_library=static',
        'checksums': ['b2b8f743213af39f40e8bc611147d69e2ea9e010b9b19cb65246582338f28d96'],
    }),
    ('neatvnc', '1.0.0', {
        'source_urls': ['https://github.com/any1/%(name)s/archive/refs/tags/'],
        'sources': [{'download_filename': V_VERSION_TAR_GZ, 'filename': SOURCE_TAR_GZ}],
        'patches': ['%(name)s-0.9.6-v4l2_check.patch'],
        'start_dir': '%(namelower)s-%(version)s',
        'configopts': '-Ddefault_library=static -Dtls=enabled',
        'checksums': [
            '993dedc30e72981650770c04438e9759537e4677010e2dab5e792c39afe74601',
            '4ea18c1892f352e48182b8bb2ecc2f21c2e03af3bd2a16496e99aa98c36d0ac8',
        ],
    }),
    ('libdisplay-info', '0.2.0', {
        'source_urls': ['https://gitlab.freedesktop.org/emersion/libdisplay-info/-/releases/%(version)s/downloads/'],
        'sources': [SOURCELOWER_TAR_XZ],
        'configopts': '-Ddefault_library=static',
        'checksums': ['5a2f002a16f42dd3540c8846f80a90b8f4bdcd067a94b9d2087bc2feae974176'],
    }),
    (name, version, {
        'source_urls': ['https://gitlab.freedesktop.org/wayland/weston/-/releases/%(version)s/downloads/'],
        'sources': [SOURCELOWER_TAR_XZ],
        'ndebug': False,  # libweston relies on asserts
        'configopts': _configopts,
        'checksums': ['dfb32e2bccabda957b94a8d0ec6075acd18c71c87ebc543ee3e618d294ca0f7f'],
    }),
]

sanity_check_paths = {
    'files': ['bin/weston', 'bin/weston-terminal', f'lib/libweston-%(version_major)s.{SHLIB_EXT}'],
    'dirs': ['include', 'share'],
}

sanity_check_commands = ['weston --version']

moduleclass = 'vis'
