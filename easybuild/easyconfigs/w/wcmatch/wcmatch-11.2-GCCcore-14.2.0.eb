easyblock = 'PythonPackage'

name = 'wcmatch'
version = '11.2'

homepage = 'https://github.com/facelessuser/wcmatch'
description = "Wildcard/glob file name matcher."

toolchain = {'name': 'GCCcore', 'version': '14.2.0'}

sources = [SOURCE_TAR_GZ]
checksums = ['1605bde546fbde4c063628c7d89eda486909fd4337e51d73a873987fbcb2554c']

builddependencies = [
    ('binutils', '2.42'),
    ('hatchling', '1.27.0'),
    ('trove-classifiers', '2026.1.14.14'),  # has the 3.15 classifier
]

dependencies = [
    ('Python', '3.13.1'),
    ('bracex', '3.2'),
]

moduleclass = 'tools'
