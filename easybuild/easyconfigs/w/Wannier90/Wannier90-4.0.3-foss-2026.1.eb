# Updated to CMake as that is now available
# Author: J. Saßmannshausen (Imperial College London/UK)

easyblock = 'CMakeMake'

name = 'Wannier90'
version = '4.0.3'

homepage = 'http://www.wannier.org'
description = """A tool for obtaining maximally-localised Wannier functions"""

toolchain = {'name': 'foss', 'version': '2026.1'}
toolchainopts = {'usempi': True, 'strict': True}

github_account = 'wannier-developers'
source_urls = [GITHUB_LOWER_SOURCE]
sources = [{'download_filename': 'v%(version)s.tar.gz', 'filename': SOURCELOWER_TAR_GZ}]
patches = ['wannier90-4.0.3_cmake.patch']
checksums = [
    {'wannier90-4.0.3.tar.gz': '8f6577939eecba6f07ea6946b8ed09b7a86beec20159b32a5d8278e7223d58ad'},
    {'wannier90-4.0.3_cmake.patch': '043d08e5158fd804c757b39f076fe65993f94ae9145d152df1370855382ffef0'},
]

builddependencies = [
    ('CMake', '4.2.1'),
    ('Python-bundle-PyPI', '2026.04'),
    ('PyYAML', '6.0.3'),
]

citing = """
G. Pizzi, V. Vitale, R. Arita, S. Blügel, F. Freimuth, G. Géranton, M. Gibertini, D. Gresch,
C. Johnson, T. Koretsune, J Ibañez-Azpiroz, H. Lee, J.M. Lihm, D. Marchand, A. Marrazzo,
Y. Mokrousov, J.I. Mustafa, Y. Nohara, Y. Nomura, L. Paulatto, S. Poncé, T. Ponweiser,
J. Qiao, F. Thöle, S.S. Tsirkin, M. Wierzbowska, N. Marzari, D. Vanderbilt, I. Souza,
A.A. Mostofi, J.R. Yates,
Wannier90 as a community code: new features and applications, J. Phys. Cond. Matt. 32, 165902 (2020)
"""

# The default is not to build shared libraries, so we need to set
# -DWANNIER90_SHARED_LIBS=ON
# We build it in 3 rounds:
# with and without MPI and with and without shared libraries.
# In all three cases we are adding the -DWANNIER90_WITH_C=ON as well.
# It appears that static libraries and MPI does not work.
configopts = [
    '-DWANNIER90_MPI=ON -DWANNIER90_MPIH=ON -DWANNIER90_WITH_C=ON -DWANNIER90_SHARED_LIBS=ON',
    '-DWANNIER90_MPI=OFF -DWANNIER90_MPIH=OFF -DWANNIER90_WITH_C=ON -DWANNIER90_SHARED_LIBS=ON',
    '-DWANNIER90_WITH_C=ON -DWANNIER90_SHARED_LIBS=OFF'
]

local_executables = ['wannier90.x', 'postw90.x', 'w90chk2chk.x', 'w90spn2spn.x']
postinstallcmds = [' && '.join([
    "cp %(builddir)s/easybuild_obj/w90chk2chk.x %(installdir)s/bin",
    "cp %(builddir)s/easybuild_obj/w90spn2spn.x %(installdir)s/bin",
])]

# We need to exclude testw90_graphene_dis_proj_auto as the test fails with:
# abs err 1.086000e-06 (limit 1.000e-06); rel err 5.992088e-06 (limit 5.000e-06)
pretestopts = 'cp -R ../%(namelower)s-%(version)s/test-suite/ . && '
test_cmd = 'OMP_NUM_THREADS=1 pytest -v -n auto -k "not testw90_graphene_dis_proj_auto"'

sanity_check_paths = {
    'files': ['bin/%s' % x for x in local_executables] +
             ['lib/libwannier90.a',
              'lib/libwannier90.%s' % SHLIB_EXT, 'lib/libwannier90_mpi.%s' % SHLIB_EXT],
    'dirs': []
}

moduleclass = 'chem'
