easyblock = 'MakeCp'

name = 'wally'
version = '0.9.2'

homepage = 'https://github.com/tobiasrausch/wally'
description = """Wally is a command-line application for plotting aligned sequencing
 reads in BAM/CRAM format and for the visualization of genomic variants."""

toolchain = {'name': 'GCC', 'version': '14.3.0'}
toolchainopts = {'pic': True}

# wally requires a static build of blend2d
local_blend2d_commit = '6dbc2cefbc996379e07104e34519a440b49b15d7'

sources = [
    {
        'source_urls': ['https://github.com/tobiasrausch/%(name)s/archive/'],
        'download_filename': 'v%(version)s.tar.gz',
        'filename': SOURCE_TAR_GZ,
    },
    {
        'source_urls': ['https://github.com/blend2d/blend2d/archive/'],
        'download_filename': '%s.tar.gz' % local_blend2d_commit,
        'filename': 'blend2d-%s.tar.gz' % local_blend2d_commit,
        'extract_cmd': "tar -xzf %s -C %(builddir)s/%(name)s-%(version)s/src/blend2d/ --strip-components 1",
    },
]
checksums = [
    {'wally-0.9.2.tar.gz': 'f3a8884039c7f67430b3c13f8b915fcf6bb53f3cfe9fc5d938045fcdd54422db'},
    {'blend2d-6dbc2cefbc996379e07104e34519a440b49b15d7.tar.gz':
     '212a77ceebf8c37ad5ca7e7eac1757ce7aa911b88085b076a9ed24f6de6e36fa'},
]

builddependencies = [
    ('CMake', '4.0.3'),
]

dependencies = [
    ('Boost', '1.88.0'),
    ('bzip2', '1.0.8'),
    ('HTSlib', '1.22.1'),
    ('XZ', '5.8.1'),
    ('zlib', '1.3.1'),
]

start_dir = '%(name)s-%(version)s'

build_cmd = 'make HTSLIBINCDIR=$EBROOTHTSLIB/include HTSLIBLIBDIR=$EBROOTHTSLIB/lib -B src/%(name)s'

files_to_copy = [(['src/%(name)s'], 'bin')]

sanity_check_paths = {
    'files': ['bin/%(name)s'],
    'dirs': [],
}

sanity_check_commands = ['%(name)s --version']

moduleclass = 'bio'
