easyblock = 'MesonNinja'

name = 'FAAC'
version = '1.50'

homepage = 'https://github.com/knik0/faac'
description = """Freeware Advanced Audio Coder faac (AAC encoder)."""

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}

source_urls = ['https://github.com/knik0/faac/archive/refs/tags/']
sources = [SOURCELOWER_TAR_GZ]
checksums = ['e6876cba00cbd786a7f984d9aaada4d5bcb08d2582100366c70f6164d5c89214']

builddependencies = [
    ('binutils', '2.44'),
    ('Meson', '1.8.2'),
    ('Ninja', '1.13.0'),
]

configopts = '-Ddefault_library=both'

sanity_check_paths = {
    'files': ['bin/faac', f'lib/libfaac.{SHLIB_EXT}', 'lib/libfaac.a'],
    'dirs': [],
}

moduleclass = 'lib'
