easyblock = 'MesonNinja'

name = 'freebayes'
version = '1.3.10'
versionsuffix = '-R-%(rver)s'

homepage = 'https://github.com/freebayes/freebayes'
description = "Bayesian haplotype-based genetic polymorphism discovery and genotyping."

toolchain = {'name': 'gfbf', 'version': '2025a'}

source_urls = [GITHUB_SOURCE]
sources = ['v%(version)s.tar.gz']
patches = [
    '%(name)s-1.3.10_find-external-libs.patch',
    '%(name)s-1.3.10_install-libs-headers.patch',
]
checksums = [
    {'v1.3.10.tar.gz': '31900e4ad23f471310838f0ae6f6020b159bf5fa3d9826de285c4c91bfe0eeb2'},
    {'freebayes-1.3.10_find-external-libs.patch': '49220eb5c80ec1f8076ad992d8bf4a35d4de18f8cdf38fe5d0a70bb7788bbb15'},
    {'freebayes-1.3.10_install-libs-headers.patch': '07c10de64ca5e51c322693e26f08c8b180af65e0502c9a78af0a88173f6052a6'},
]

builddependencies = [
    ('CMake', '3.31.3'),
    ('Meson', '1.6.1'),
    ('Ninja', '1.12.1'),
    ('pkgconf', '2.3.0')
]

dependencies = [
    ('Python', '3.13.1'),
    ('R', '4.5.1'),
    ('parallel', '20250722'),
    ('libffi', '3.4.5'),
    ('VCFtools', '0.1.17'),
    ('vcflib', '1.0.15', versionsuffix),
    ('SeqLib', '1.2.0'),
]

configopts = "-Dprefer_system_deps=true"

sanity_check_paths = {
    'files': ['bin/freebayes', 'bin/bamleftalign', 'scripts/freebayes-parallel'],
    'dirs': [],
}

sanity_check_commands = ["freebayes --help"]

modextrapaths = {'PATH': ['scripts']}

moduleclass = 'bio'
