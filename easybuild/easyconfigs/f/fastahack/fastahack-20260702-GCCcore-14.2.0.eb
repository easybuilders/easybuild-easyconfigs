# Updated: Denis Kristak (INUITS)
# Updated: Petr Král (INUITS)

easyblock = 'ConfigureMake'

name = 'fastahack'
version = '20260702'
local_commit = '629c271'

homepage = 'https://github.com/ekg/fastahack'
description = """Utilities for indexing and sequence extraction from FASTA files."""

toolchain = {'name': 'GCCcore', 'version': '14.2.0'}

github_account = 'ekg'
source_urls = [GITHUB_SOURCE]
sources = ['%s.tar.gz' % local_commit]
patches = ['%(name)s-1.0.0_build-libs.patch']
checksums = [
    {'%s.tar.gz' % local_commit:
     '5c004614273bcbb5fbce4308b4a9ee35bc6928eeb922b9a8117413a29d9fc527'},
    {'%(name)s-1.0.0_build-libs.patch':
     '7f804486c6bafd9b1572cb5f86ff28dbebb4d6da551bde1091d6ff8f82748bf4'},
]

builddependencies = [('binutils', '2.42')]

skipsteps = ['configure']

installopts = 'PREFIX=%(installdir)s '

sanity_check_paths = {
    'files': ['bin/%(name)s', f'lib/libfastahack.{SHLIB_EXT}'],
    'dirs': [],
}

sanity_check_commands = ['%(name)s --help']

moduleclass = 'bio'
