easyblock = 'PythonBundle'

name = 'Fastaq'
version = '3.18.0'

homepage = 'https://github.com/sanger-pathogens/Fastaq'
description = "Python3 scripts to manipulate FASTA and FASTQ files."

toolchain = {'name': 'GCC', 'version': '14.3.0'}

builddependencies = [
    ('hatchling', '1.27.0'),
]

dependencies = [
    ('Python', '3.13.5'),
    ('SAMtools', '1.22.1'),
    ('gzip', '1.14'),
]

exts_list = [
    ('pyfastaq', version, {
        'patches': ['Fastaq-3.18.0-python3-exec.patch'],
        'checksums': [
            {'pyfastaq-3.18.0.tar.gz': 'f7372cf53c93365750671bce4b75a7688cdd46740d6245706a3b33220b5d7d69'},
            {'Fastaq-3.18.0-python3-exec.patch': 'b66c9dcedce33b6bd5392823b2da057b4a6eb846f46355b2bc4deb9b1ec0c8fd'},
        ],
    }),
]

sanity_check_commands = ['fastaq version']

moduleclass = 'bio'
