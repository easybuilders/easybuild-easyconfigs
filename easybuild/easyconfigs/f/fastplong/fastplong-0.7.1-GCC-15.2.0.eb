easyblock = 'ConfigureMake'

name = 'fastplong'
version = '0.7.1'

homepage = 'https://github.com/OpenGene/fastplong'
description = """Ultra-fast preprocessing and quality control for long-read sequencing data."""

toolchain = {'name': 'GCC', 'version': '15.2.0'}

github_account = 'OpenGene'
source_urls = [GITHUB_SOURCE]
sources = [V_VERSION_TAR_GZ]
checksums = ['29cd6545d0db00e4a53989088dcdb7b0f0dcbc4442574fb1b5f67b594df7cb5b']

dependencies = [
    ('libdeflate', '1.25'),
    ('ISA-L', '2.32.0'),
    ('Highway', '1.4.0'),
]

skipsteps = ['configure']

buildopts = 'CXX=${CXX}'

installopts = 'PREFIX=%(installdir)s'

sanity_check_paths = {
    'files': ['bin/fastplong'],
    'dirs': [],
}

sanity_check_commands = [
    'fastplong --help',
    'fastplong --version',
]

moduleclass = 'bio'
