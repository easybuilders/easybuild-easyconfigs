# This easyconfig was created by the BEAR Software team at the University of Birmingham.
# updated: Robin Verschoren (Universiteit Antwerpen)
easyblock = 'MakeCp'

name = 'fastplong'
version = '0.5.0'

homepage = "https://github.com/OpenGene/fastplong"
description = """Ultrafast preprocessing and quality control for long reads (Nanopore, PacBio, Cyclone, etc.)."""

toolchain = {'name': 'GCCcore', 'version': '15.2.0'}
toolchainopts = {'cstd': 'c++17'}

github_account = 'OpenGene'
source_urls = [GITHUB_SOURCE]
sources = ['v%(version)s.tar.gz']
checksums = ['6e1937a10107cb500c6bc62aa6df796890fb31aadad2fdc54cb84f8efaf7bf96']

builddependencies = [
    ('binutils', '2.45'),
    ('googletest', '1.17.0'),
]

dependencies = [
    ('ISA-L', '2.32.0'),
    ('libdeflate', '1.25'),
    ('Highway', '1.4.0'),
]

runtest = 'test'
files_to_copy = [(['%(name)s'], 'bin')]

sanity_check_paths = {
    'files': ['bin/%(name)s'],
    'dirs': [],
}

sanity_check_commands = ["%(name)s --help"]

moduleclass = 'bio'
