easyblock = 'PythonBundle'

name = 'flatbuffers-python'
version = '25.2.10'

homepage = 'https://github.com/google/flatbuffers/'
description = """Python Flatbuffers runtime library."""

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}

dependencies = [
    ('binutils', '2.44'),
    ('Python', '3.13.5'),
]

exts_list = [
    ('flatbuffers', version, {
        'preinstallopts': "VERSION=%(version)s ",
        'source_urls': ['https://github.com/google/flatbuffers/archive/'],
        'sources': [{'download_filename': 'v%(version)s.tar.gz', 'filename': '%(name)s-%(version)s.tar.gz'}],
        'start_dir': 'python',
        'checksums': ['b9c2df49707c57a48fc0923d52b8c73beb72d675f9d44b2211e4569be40a7421'],
    }),
]

moduleclass = 'devel'
