easyblock = 'ConfigureMake'

name = 'fuse-archive'
version = '1.26'

homepage = 'https://github.com/fdegros/mount-archive'
description = 'FUSE file system for archives and compressed files (ZIP, RAR, 7Z, ISO, TGZ, XZ...)'

toolchain = {'name': 'GCC', 'version': '14.3.0'}

source_urls = ['https://github.com/fdegros/mount-archive/archive/refs/tags']
sources = [V_VERSION_TAR_GZ]
checksums = ['8e0b318ee8adfcd0f1e33ab54e67727b7d20886be5ab6b20d6aea23e656f2a92']

dependencies = [
    ('FUSE', '3.17.4'),
    ('libarchive', '3.8.1'),
    ('Boost', '1.88.0'),
]

skipsteps = ['configure']

installopts = 'PREFIX=%(installdir)s'

# Testing is difficult due to requiring fuse permissions on host.
# Would still work in unshare/apptainer even without fuse-mount setuid.

sanity_check_paths = {
    'files': ['bin/fuse-archive'],
    'dirs': ['share/man'],
}

sanity_check_commands = ['fuse-archive -h']

moduleclass = 'tools'
