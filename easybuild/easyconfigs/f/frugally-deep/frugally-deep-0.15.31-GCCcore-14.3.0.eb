# Author: sreenivasamurthy kolam <sreenivasamurthy.kolam@amd.com>

easyblock = 'CMakeMake'

name = 'frugally-deep'
version = '0.15.31'

homepage = 'https://github.com/Dobiasd/frugally-deep'
description = """frugally-deep is a header-only library written in modern C++ that allows you to use
Keras models in C++ with ease. It can load a Keras model exported from Python and generate predictions."""

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}
toolchainopts = {'pic': True}

source_urls = ['https://github.com/Dobiasd/frugally-deep/archive']
sources = [{
    'download_filename': 'v%(version)s.tar.gz',
    'filename': SOURCE_TAR_GZ,
}]
checksums = ['49bf5e30ad2d33e464433afbc8b6fe8536fc959474004a1ce2ac03d7c54bc8ba']

builddependencies = [
    ('binutils', '2.44'),
    ('CMake', '3.31.8'),
]

dependencies = [
    ('Eigen', '3.4.0'),
    ('FunctionalPlus', '0.2.28'),
    ('nlohmann_json', '3.12.0'),
]

# Header-only library
configopts = '-DFDEEP_BUILD_UNITTEST=OFF '

sanity_check_paths = {
    'files': ['include/fdeep/fdeep.hpp'],
    'dirs': ['include/fdeep'],
}

moduleclass = 'lib'
