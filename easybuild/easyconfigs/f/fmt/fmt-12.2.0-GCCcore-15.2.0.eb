easyblock = 'CMakeMake'

name = 'fmt'
version = '12.2.0'

homepage = 'http://fmtlib.net/'
description = "fmt (formerly cppformat) is an open-source formatting library."

toolchain = {'name': 'GCCcore', 'version': '15.2.0'}
toolchainopts = {'pic': True}

source_urls = ['https://github.com/fmtlib/fmt/releases/download/%(version)s/']
sources = ['fmt-%(version)s.zip']
patches = ['fmt-%(version)s_pr4813.patch']
checksums = [
    {'fmt-12.2.0.zip': 'a2f4a8d51178f954e4c339007f77edd76ba0cb2e36f87a48e5a5403d9be5878f'},
    {'fmt-12.2.0_pr4813.patch': '1d6178c5c9a412ac10eac3562df8e665e97b796ea2b059aa5cafac3e8c20cbfc'},
]

builddependencies = [
    ('binutils', '2.45'),
    ('CMake', '4.2.1'),
]

configopts = ['-DBUILD_SHARED_LIBS=ON', '-DBUILD_SHARED_LIBS=OFF']

sanity_check_paths = {
    'files': [f'lib/libfmt.{ext}' for ext in ['a', SHLIB_EXT]],
    'dirs': ['include/fmt', 'lib/cmake'],
}

moduleclass = 'lib'
