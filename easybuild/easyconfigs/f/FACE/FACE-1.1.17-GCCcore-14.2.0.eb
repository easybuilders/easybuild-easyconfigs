easyblock = 'MakeCp'

name = 'FACE'
version = '1.1.17'

homepage = 'https://github.com/szaghi/FACE'
description = """Fortran Ansi Colors and Styles Environment.
A KISS pure Fortran 2008+ library for easy colorizing and stylizing strings with ANSI escape
codes - one function, zero dependencies."""

toolchain = {'name': 'GCCcore', 'version': '14.2.0'}

github_account = 'szaghi'
source_urls = [GITHUB_RELEASE]
sources = ['%(name)s-v%(version)s.tar.gz']
checksums = ['3fee0f5090319e4ae25c7d7c1bc3800e67aed26e6f0429c581f9048e7c3b4288']

builddependencies = [
    ('binutils', '2.42'),
    ('FoBiS', '3.16.0'),
]

build_cmd = 'FoBiS.py build'
buildopts = '-mode face-shared-gnu'

files_to_copy = [(['lib/mod/*.mod'], 'include'), ([f'lib/libface.{SHLIB_EXT}'], 'lib')]

sanity_check_paths = {
    'files': ['include/face.mod', f'lib/libface.{SHLIB_EXT}'],
    'dirs': [],
}

moduleclass = 'tools'
