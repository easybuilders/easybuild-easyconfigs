# Author: sreenivasamurthy kolam <sreenivasamurthy.kolam@amd.com>

easyblock = 'CMakeMake'

name = 'FunctionalPlus'
version = '0.2.28'

homepage = 'https://github.com/Dobiasd/FunctionalPlus'
description = """FunctionalPlus is a small header-only library supporting convenient functional
programming in C++. It helps you write concise and readable C++ code."""

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}
toolchainopts = {'pic': True}

source_urls = ['https://github.com/Dobiasd/FunctionalPlus/archive']
sources = [{
    'download_filename': 'v%(version)s.tar.gz',
    'filename': SOURCE_TAR_GZ,
}]
checksums = ['8864a3e9bebde6ebed71b49ac2a036cedf9ae0f02ce758bc28c21e6a2ae15803']

builddependencies = [
    ('binutils', '2.44'),
    ('CMake', '3.31.8'),
]

sanity_check_paths = {
    'files': ['include/fplus/fplus.hpp'],
    'dirs': ['include/fplus'],
}

moduleclass = 'lib'
