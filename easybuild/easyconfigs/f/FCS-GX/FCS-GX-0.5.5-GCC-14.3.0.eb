easyblock = 'CMakeMake'

name = 'FCS-GX'
version = '0.5.5'

homepage = 'https://github.com/ncbi/fcs-gx/'
description = """FCS-GX detects contamination from foreign organisms in genome sequences.
This tool is one module within the NCBI Foreign Contamination Screening (FCS) program suite."""

toolchain = {'name': 'GCC', 'version': '14.3.0'}

source_urls = ['https://github.com/ncbi/fcs-gx/archive/refs/tags/']
sources = [V_VERSION_TAR_GZ]
patches = [
    '%(name)s-%(version)s_sqlite3.patch',
    '%(name)s-%(version)s_script_path.patch',
    '%(name)s-%(version)s_license_blob.patch',
    '%(name)s-%(version)s_install.patch',
]
checksums = [
    {'v0.5.5.tar.gz': 'b4caefa7d5861a8b069f19e4d1c6679f8c3cda11454636957e80e751935dddcd'},
    {'FCS-GX-0.5.5_sqlite3.patch': '64b733ee097f867416980813a356d2ef7c3160e7ccc29332a5c58cf255d440fc'},
    {'FCS-GX-0.5.5_script_path.patch': '606e555505027993459fde8ceee565642881be7743732e573efaa99d00563bb4'},
    {'FCS-GX-0.5.5_license_blob.patch': '2e969cf71ce45d2e9a37fc6341845bc45c03dfbb2a26eeb6e864b399bc9fc61f'},
    {'FCS-GX-0.5.5_install.patch': '0158063ab20cf605f539535d32d6fde287a92bc524933e4b6c682d27bb487e2f'},
]

builddependencies = [
    ('CMake', '4.0.3'),
]

dependencies = [
    ('Python', '3.13.5'),
    ('SQLite', '3.50.1'),
]

configopts = '-DCMAKE_POLICY_VERSION_MINIMUM=3.5'

sanity_check_paths = {
    'files': ['bin/gx'],
    'dirs': ['scripts', 'make_gxdb'],
}

sanity_check_commands = ['gx -h']

moduleclass = 'tools'
