easyblock = 'PythonBundle'

name = 'ipympl'
version = '0.10.0'

homepage = 'https://matplotlib.org/ipympl'
description = """Leveraging the Jupyter interactive widgets framework, ipympl enables the
interactive features of matplotlib in the Jupyter notebook and in JupyterLab.
Besides, the figure canvas element is a proper Jupyter interactive widget which
can be positioned in interactive widget layouts.
"""

toolchain = {'name': 'gfbf', 'version': '2026.1'}

builddependencies = [
    ('hatch-jupyter-builder', '0.9.1'),  # hatch-nodejs-version
    ('nodejs', '24.16.0'),
]
dependencies = [
    ('Python', '3.14.2'),
    ('Python-bundle-PyPI', '2026.04'),
    ('SciPy-bundle', '2026.05'),
    ('JupyterLab', '4.5.8'),
    ('IPython', '9.14.0'),
    ('matplotlib', '3.10.9'),
    ('Pillow', '12.2.0'),
]

exts_list = [
    ('nbval', '0.11.0', {
        'checksums': ['77c95797607b0a968babd2597ee3494102d25c3ad37435debbdac0e46e379094'],
    }),
    (name, version, {
        'runtest': 'pytest -v',
        'testinstall': True,
        'checksums': ['eda69602a010af2a42e8ebd069b0ee0dbe8df7fc69d7c1e8b99fece0a2fe613f'],
    }),
]

moduleclass = 'tools'
