    },
    {
        'source_urls': [
            'https://registrationcenter-download.intel.com/akdlm/IRC_NAS/87bd1c07-e474-4f38-9492-e44e15ea7a52/',
        ],
        'filename': 'intel-fortran-compiler-%(version)s.104_offline.sh',
    },
]
checksums = [
    {'intel-dpcpp-cpp-compiler-2026.1.0.118_offline.sh':
     '65d81ec1f249fb2cb7267fc787b21cf618b4f553c06b9e19d0981b30f25ae227'},
    {'intel-fortran-compiler-2026.1.0.104_offline.sh':
     '3779081508ebc099e99717eccd9de615c57fde292dc4f93e18955a103835f58d'},
]

