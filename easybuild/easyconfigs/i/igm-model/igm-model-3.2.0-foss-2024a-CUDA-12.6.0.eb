easyblock = 'PythonBundle'

name = 'igm-model'
version = '3.2.0'
versionsuffix = '-CUDA-12.6.0'

homepage = 'https://igm-model.org/'
description = """IGM is an accessible, differentiable, modular, and GPU-accelerated ice flow model."""

toolchain = {'name': 'foss', 'version': '2024a'}

builddependencies = [
    ('Cython', '3.0.10'),
    ('Java', '17', '', SYSTEM),
]

dependencies = [
    ('Python', '3.12.3'),
    ('TensorFlow', '2.18.1', '-CUDA-12.6.0'),
    ('SciPy-bundle', '2024.05'),
    ('geopandas', '1.0.1'),
    ('netcdf4-python', '1.7.1.post2'),
    ('xarray', '2024.11.0'),
    ('PyYAML', '6.0.2'),
    ('Optuna', '4.1.0'),
    ('OGGM', '1.6.2'),
    ('rasterio', '1.4.3'),
    ('typeguard', '2.13.3'),
]


exts_list = [
    ('antlr4-python3-runtime', '4.9', {
        'modulename': 'antlr4',
        'checksums': ['02d9afb720c13c52b336234286966cdf5aff704f230a513e635adb0d94de97ae'],
    }),
    ('omegaconf', '2.3.0', {
        'checksums': ['d5d4b6d29955cc50ad50c46dc269bcd92c6e00f5f90d23ab5fee7bfca4ba4cc7'],
    }),
    ('hydra-core', '1.3.2', {
        'modulename': 'hydra',
        'checksums': ['8a878ed67216997c3e9d88a8e72e7b4767e81af37afb4ea3334b269a4390a824'],
    }),
    ('nvtx', '0.2.13', {
        'checksums': ['9db7ba135168e14e1f038866100bf8ed42d3e00b404e9bc7b6280ee3af828b92'],
    }),
    # Use the GitHub source archive because the PyPI source distribution does not
    # include the pretrained Keras emulator models required at runtime.
    (name, version, {
        'modulename': 'igm',
        'source_urls': ['https://github.com/instructed-glacier-model/igm/archive/refs/tags/'],
        'sources': ['v%s.tar.gz' % version],
        'checksums': ['4824a9fb637f5a708ca8da94bd6854978f73af1f6ae9955ca5bf6d92220b1ede'],
        'preinstallopts': r"sed -i 's/tensorflow\[and-cuda\]==2\.17\.0/tensorflow[and-cuda]>=2.17.0/' setup.py && ",
    }),
]

# The pretrained Keras emulator models are included in the GitHub source,
# but are not installed into site-packages, so copy them explicitly.
postinstallcmds = [
    "cp -a %(builddir)s/igmmodel/igm-3.2.0/igm/processes/iceflow/emulate/emulators/*.keras "
    "%(installdir)s/lib/python%(pyshortver)s/site-packages/igm/processes/iceflow/emulate/emulators/"
]

sanity_check_paths = {
    'files': ['bin/igm_run'],
    'dirs': [],
}

sanity_check_commands = [
    "python -c 'import igm'",
    "igm_run --help",
]

moduleclass = 'geo'
