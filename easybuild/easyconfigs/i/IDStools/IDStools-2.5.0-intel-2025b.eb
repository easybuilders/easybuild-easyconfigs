easyblock = 'PythonBundle'

name = 'IDStools'
version = '2.5.0'

homepage = 'https://github.com/iterorganization/IDStools'
description = """A comprehensive Python toolset for working with
  Integrated Modelling and Analysis Suite (IMAS) Interface Data
  Structures (IDS) in fusion research."""

toolchain = {'name': 'intel', 'version': '2025b'}

builddependencies = [
    ('hatchling', '1.27.0'),
    ('poetry', '2.1.3'),
]

dependencies = [
    ('Python', '3.13.5'),
    ('SciPy-bundle', '2025.07'),
    ('matplotlib', '3.10.5'),
    ('PyYAML', '6.0.2'),
    ('IMAS-Python', '2.3.0'),
]

exts_list = [
    ('cerberus', '1.3.8', {
        'checksums': ['579554887ffd189226774b87570f4a76db75cf0efcbaffcacd5e98b8ee877f61'],
    }),
    ('fortranformat', '2.0.3', {
        'checksums': ['1e765c01a66208d54d75cae140ba9f1adda0548aaad8538cba8da39e69ac178c'],
    }),
    ('packaging', '26.3', {
        'checksums': ['94edc256424af38762eb31306eed28beb9f0efc50a8837492c9d6fd6004aed79'],
    }),
    # IDStools requires plotext >= 5.0, < 6.0
    ('plotext', '5.3.2', {
        'checksums': ['52d1e932e67c177bf357a3f0fe6ce14d1a96f7f7d5679d7b455b929df517068e'],
    }),
    ('pyparsing', '3.3.2', {
        'checksums': ['c777f4d763f140633dcb6d8a3eda953bf7a214dc4eff598413c070bcdc117cbc'],
    }),
    ('rich_argparse', '1.8.0', {
