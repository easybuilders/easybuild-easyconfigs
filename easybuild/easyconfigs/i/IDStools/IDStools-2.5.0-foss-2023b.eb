easyblock = 'PythonBundle'

name = 'IDStools'
version = '2.5.0'

homepage = 'https://github.com/iterorganization/IDStools'
description = """A comprehensive Python toolset for working with
  Integrated Modelling and Analysis Suite (IMAS) Interface Data
  Structures (IDS) in fusion research."""

toolchain = {'name': 'foss', 'version': '2023b'}

builddependencies = [
    ('hatchling', '1.18.0'),
]

dependencies = [
    ('Python', '3.11.5'),
    ('SciPy-bundle', '2023.11'),
    ('matplotlib', '3.8.2'),
    ('PyYAML', '6.0.1'),
    ('IMAS-Python', '2.3.0'),
]

exts_list = [
    ('cerberus', '1.3.7', {
        'checksums': ['ecf249665400a0b7a9d5e4ee1ffc234fd5d003186d3e1904f70bc14038642c13'],
    }),
    ('fortranformat', '2.0.0', {
        'checksums': ['52473831d6f6bad7c2de0f26ad51856ea5d0ef097bcba5af3b855b871b815b0d'],
    }),
    ('packaging', '25.0', {
        'checksums': ['d443872c98d677bf60f6a1f2f8c1cb748e8fe762d2bf9d3148b5599295b0fc4f'],
    }),
    # IDStools requires plotext >= 5.0, < 6.0
    ('plotext', '5.3.2', {
        'checksums': ['52d1e932e67c177bf357a3f0fe6ce14d1a96f7f7d5679d7b455b929df517068e'],
    }),
    ('pyparsing', '3.2.0', {
        'checksums': ['cbf74e27246d595d9a74b186b810f6fbb86726dbf3b9532efb343f6d7294fe9c'],
    }),
    ('rich_argparse', '1.6.0', {
        'checksums': ['092083c30da186f25bcdff8b1d47fdfb571288510fb051e0488a72cc3128de13'],
    }),
    ('tabulate', '0.9.0', {
        'checksums': ['0095b12bf5966de529c0feb1fa08671671b3368eec77d7ef7ab114be2c068b3c'],
    }),
    # distribution name is 'imas_idstools', but it installs the 'idstools' module
    ('imas_idstools', version, {
        'modulename': 'idstools',
        'checksums': ['6e5c2a6a7f7936f5155779ed97a306caf098c806b8d9d113aaede5992e48a611'],
    }),
]

moduleclass = 'data'
