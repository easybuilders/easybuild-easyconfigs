easyblock = 'PythonBundle'

name = 'IMAS-Validator'
version = '1.0.0'
description = """A pure-python library to handle IDSs"""
homepage = "https://github.com/iterorganization/IMAS-Python"

toolchain = {'name': 'foss', 'version': '2025b'}

dependencies = [
    ('Python', '3.13.5'),
    ('SciPy-bundle', '2025.07'),
    ('netcdf4-python', '1.7.2'),
    ('h5py', '3.14.0'),
    ('IMAS-Python', '2.3.0'),
]

exts_list = [
    ('junit2html', '31.1.4', {
        'modulename': False,
        'sources': ['%(name)s-%(version)s-py3-none-any.whl'],
        'checksums': ['dfd100dfdc0ee91e1ffbd1774669b209dec115b285e06af9e31d8743db8931e6'],
    }),
    ('imas_validator', version, {
        'modulename': False,
        'sources': ['%(name)s-%(version)s.tar.gz'],
        'checksums': ['132d73b7b7f24628e8e12a60381fc8c65bf1ed996f817c442a0a4d1124e8c63b'],
    }),
]

moduleclass = 'tools'
