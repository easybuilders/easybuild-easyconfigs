easyblock = 'PythonBundle'

name = 'ipywidgets'
version = '8.1.8'

homepage = 'https://jupyter.org/'
description = """Jupyter Widgets are interactive browser controls for Jupyter notebooks"""

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}

builddependencies = [
    ('binutils', '2.44'),
    ('hatchling', '1.27.0'),
    ('jupyter_packaging', '0.12.3'),
    ('hatch-jupyter-builder', '0.9.1'),
]
dependencies = [
    ('Python', '3.13.5'),
    ('IPython', '9.4.0'),
]

# WARNING: the versions of ipywidgets, widgetsnbextension and jupyterlab_widgets are tied between them
# use the versions published in a single release commit instead of blindly pushing to last available version,
# see for instance https://github.com/jupyter-widgets/ipywidgets/commit/ffd754bf329c0e2b1e6a1d96f28df149478c5717
exts_list = [
    ('jupyterlab_widgets', '3.0.16', {
        'checksums': ['423da05071d55cf27a9e602216d35a3a65a3e41cdf9c5d3b643b814ce38c19e0'],
    }),
    ('widgetsnbextension', '4.0.15', {
        'checksums': ['de8610639996f1567952d763a5a41af8af37f2575a41f9852a38f947eb82a3b9'],
    }),
    ('comm', '0.2.3', {
        'checksums': ['2dc8048c10962d55d7ad693be1e7045d891b7ce8d999c97963a5e3e99c055971'],
    }),
    (name, version, {
        'checksums': ['61f969306b95f85fba6b6986b7fe45d73124d1d9e3023a8068710d47a22ea668'],
    }),
]

moduleclass = 'tools'
