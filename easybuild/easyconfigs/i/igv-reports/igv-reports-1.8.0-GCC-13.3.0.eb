easyblock = 'PythonPackage'

name = 'igv-reports'
version = '1.8.0'

homepage = 'https://github.com/igvteam/igv-reports'
description = """Python application to generate self-contained igv.js pages that can be opened
within a browser with the file protocol."""

toolchain = {'name': 'GCC', 'version': '13.3.0'}

sources = [SOURCE_TAR_GZ]
checksums = ['9d7793668da65a02907aacefe031615cb632e7c5621b903a7aec2b4096eaf302']

dependencies = [
    ('Python', '3.12.3'),
    ('Python-bundle-PyPI', '2024.06'),
    ('Pysam', '0.22.1'),
]

sanity_check_commands = [
    'create_datauri --help',
    'create_report --help',
]

options = {'modulename': 'igv_reports'}

moduleclass = 'vis'
