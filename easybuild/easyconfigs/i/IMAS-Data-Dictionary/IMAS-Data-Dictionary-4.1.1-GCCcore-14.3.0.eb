easyblock = 'PythonBundle'

name = 'IMAS-Data-Dictionary'
version = '4.1.1'

description = """IMAS Data Dictionary definitions"""
homepage = "https://github.com/iterorganization/imas-data-dictionary"

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}

builddependencies = [
    ('binutils', '2.44'),
    ('setuptools', '80.10.1'),
]

dependencies = [('Python', '3.13.5')]

exts_list = [
    ('saxonche', '12.9.0', {
        'sources': ['%(name)s-%(version)s-cp313-cp313-manylinux_2_24_x86_64.whl'],
        'checksums': ['b7d295ddeae3e7c355cf53035ec47a1db301a8b9bc917636f893b56a31a48187'],
    }),
    ('imas_data_dictionary', version, {
        'checksums': ['a184970b8bd87885861de3096a5c63b7f35dfd6e1d212b4bd9090e54897386dc'],
    }),
]

modextravars = {'IMAS_VERSION': version}

moduleclass = 'data'
