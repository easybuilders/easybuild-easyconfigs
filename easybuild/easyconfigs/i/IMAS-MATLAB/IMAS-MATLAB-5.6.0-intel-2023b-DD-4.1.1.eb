easyblock = 'CMakeMake'

name = 'IMAS-MATLAB'
version = '5.6.0'
local_dd_version = '4.1.1'
versionsuffix = f'-DD-{local_dd_version}'

github_account = 'iterorganization'

description = 'IMAS Access Layer MATLAB High Level Interface'
homepage = 'https://github.com/iterorganization/IMAS-MATLAB'

toolchain = {'name': 'intel', 'version': '2023b'}

builddependencies = [
    ('CMake', '3.27.6'),
    ('IMAS-Data-Dictionary', local_dd_version),
]

dependencies = [
    ('MATLAB', '2023b-r5'),
    ('IMAS-Core', '5.7.1'),
    ('IMAS-MDSplus-models', '5.7.1', versionsuffix),
]

source_urls = [GITHUB_SOURCE]
sources = [{'download_filename': '%(version)s.tar.gz', 'filename': SOURCE_TAR_GZ}]
checksums = ['920d6f4969126b5cd41628736ae771e72c564813c7914d814dbb86279cc55817']

build_type = 'RelWithDebInfo'
configopts = ('-D AL_DOWNLOAD_DEPENDENCIES=OFF -D AL_TESTS=ON ')

sanity_check_paths = {
    'dirs': ['lib', 'mex'],
    'files': [],
}

modextrapaths = {
    'MATLABPATH': 'mex',
}

moduleclass = 'tools'
