easyblock = 'PythonBundle'

name = 'iWrap'
version = '2.0.1'

homepage = 'https://github.com/iterorganization/iWrap'
description = """A modular component generator, implemented in Python,
used for creating IMAS actors from physics models."""

toolchain = {'name': 'foss', 'version': '2025b'}

dependencies = [
    ('Python', '3.13.5'),
    ('Python-bundle-PyPI', '2025.07'),
    ('lxml', '6.0.0'),
    ('PyYAML', '6.0.2'),
    ('f90nml', '1.5'),
    ('JPype', '1.7.1'),
    ('IMAS-Python', '2.3.0'),
    ('MUSCLE3', '0.11.0'),
]

exts_list = [
    (name, version, {
        'source_urls': [PYPI_LOWER_SOURCE],
        'sources': [SOURCELOWER_TAR_GZ],
        'checksums': ['75524285a49f87bb2f5e37c51026fa1c0602622e0eeaa0e7396b42959f2b7f0b'],
    }),
]

sanity_check_paths = {
    'files': ['bin/iwrap'],
    'dirs': ['lib/python%(pyshortver)s/site-packages/iwrap'],
}

sanity_check_commands = [
    "iwrap --help",
    "python -s -c 'import libmuscle, ymmsl'",
]

moduleclass = 'tools'
