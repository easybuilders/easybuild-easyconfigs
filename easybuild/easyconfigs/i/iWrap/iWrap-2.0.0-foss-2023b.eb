easyblock = 'PythonBundle'

name = 'iWrap'
version = '2.0.0'

homepage = 'https://github.com/iterorganization/iWrap'
description = """A modular component generator, implemented in Python,
used for creating IMAS actors from physics models."""

toolchain = {'name': 'foss', 'version': '2023b'}

dependencies = [
    ('Python', '3.11.5'),
    ('Python-bundle-PyPI', '2023.10'),
    ('lxml', '4.9.3'),
    ('PyYAML', '6.0.1'),
    ('f90nml', '1.4.4'),
    ('JPype', '1.5.0'),
    ('IMAS-Python', '2.3.0'),
]

exts_list = [
    (name, version, {
        'source_urls': [PYPI_LOWER_SOURCE],
        'sources': [SOURCELOWER_TAR_GZ],
        'checksums': ['9298a3249f1c122a59011d8bcb6cebc3ec42e8adc83c12bd93fe14ad1940ed19'],
    }),
]

sanity_check_paths = {
    'files': ['bin/iwrap'],
    'dirs': ['lib/python%(pyshortver)s/site-packages/iwrap'],
}

sanity_check_commands = [
    "iwrap --help",
]

moduleclass = 'tools'
