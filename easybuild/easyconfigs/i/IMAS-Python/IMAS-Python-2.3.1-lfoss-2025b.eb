easyblock = 'PythonBundle'

name = 'IMAS-Python'
version = '2.3.1'

description = """IMAS-Python is a pure-Python library to handle arbitrarily nested data structures.
It is designed for, but not necessarily bound to, interacting with Interface Data Structures (IDSs)
as defined by the Integrated Modelling & Analysis Suite (IMAS) Data Model."""
homepage = "https://github.com/iterorganization/IMAS-Python"

toolchain = {'name': 'lfoss', 'version': '2025b'}

dependencies = [
    ('Python', '3.13.5'),
    ('SciPy-bundle', '2025.07'),
    ('python-xxhash', '3.6.0'),
    ('netcdf4-python', '1.7.2'),
    ('h5py', '3.14.0'),
    ('xarray', '2025.10.0'),
    ('IMAS-Core', '5.7.1'),
]

exts_list = [
    ('saxonche', '13.1.1', {
        'sources': ['%(name)s-%(version)s-cp313-cp313-manylinux_2_24_x86_64.whl'],
        'checksums': ['4764f64e4c964ecf47193eda67f4f66d3ab27f7c41a8147e540bc86c9dda811d'],
    }),
    ('imas_data_dictionaries', '4.1.1', {
        'sources': ['%(name)s-%(version)s-py3-none-any.whl'],
        'checksums': ['46b492c81f344f8097cc6ef00614cd524a174f2d5dc4d16772052adf16533777'],
    }),
    ('imas_python', version, {
        'modulename': 'imas',
        'checksums': ['092dd149639e29aaa16367a55ebbc1586821c97b5893d7465143b4d0b71a04b3'],
    }),
]

sanity_check_commands = ['imas --help']

moduleclass = 'tools'
