easyblock = 'PythonBundle'

name = 'JPype'
version = '1.7.1'

homepage = 'https://www.jpype.org'
description = "A Python module to provide full access to Java from within Python"

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}

builddependencies = [
    ('binutils', '2.44'),
    ('CMake', '4.0.3'),
    ('scikit-build-core', '0.11.5'),
    ('Ninja', '1.13.0'),
    ('ant', '1.10.17', '-Java-%(javaver)s', SYSTEM),
]

dependencies = [
    ('Python', '3.13.5'),
    ('Java', '25', '', SYSTEM),
]

exts_list = [
    ('JPype1', version, {
        'modulename': 'jpype',
        'sources': [SOURCELOWER_TAR_GZ],
        'checksums': ['3cd88838dc3d2d546f7eaeadaaff864e590010c15f2b6a44b6f37e60796a14b2'],
    }),
]

moduleclass = 'tools'
