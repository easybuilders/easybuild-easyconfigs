easyblock = 'MesonNinja'

name = 'JSON-GLib'
version = '1.10.8'

homepage = 'https://gitlab.gnome.org/GNOME/json-glib/'
description = """JSON-GLib implements a full JSON parser and generator using GLib and GObject, and integrates JSON with
GLib data types."""

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}

#source_urls = ['https://download.gnome.org/sources/json-glib/%(version_major_minor)s']
source_urls = [FTPGNOME_SOURCE]
sources = [SOURCELOWER_TAR_XZ]
checksums = ['55c5c141a564245b8f8fbe7698663c87a45a7333c2a2c56f06f811ab73b212dd']

#'https://download.gnome.org/sources/json-glib/%(version_major_minor)s']
builddependencies = [
    ('binutils', '2.44'),
    ('Meson', '1.8.2'),
    ('Ninja', '1.13.0'),
]

dependencies = [
    ('GLib', '2.85.3'),
]

sanity_check_paths = {
    'files': ['bin/json-glib-format', 'bin/json-glib-validate'] +
             [f'lib/libjson-glib-1.0.{SHLIB_EXT}'],
    'dirs': ['include/json-glib-1.0/'],
}

sanity_check_commands = [
    'json-glib-format -h',
    'json-glib-validate -h',
]

moduleclass = 'lib'
