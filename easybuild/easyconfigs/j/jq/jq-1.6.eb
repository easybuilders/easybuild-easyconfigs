name = 'jq'
version = '1.6'

homepage = 'https://stedolan.github.io/jq/'
description = """jq is a lightweight and flexible command-line JSON processor. """

toolchain = {'name': 'system', 'version': ''}
easyblock = 'PackedBinary'

#
# Example URL: https://github.com/molgenis/ngs-utils/archive/15.12.2.tar.gz
#

source_urls = [('https://github.com/stedolan/jq/releases/download/jq-%s/' % (version)) ]
sources = [('jq-%s.tar.gz' % (version))]

checksums = ['5de8c8e29aaa3fb9cc6b47bb27299f271354ebb72514e3accadc7d38b5bbaa72']

builddependencies = []

sanity_check_paths = {
    'files': ['jq.spec'],
    'dirs': ['tests/']
}

moduleclass = 'bio'
