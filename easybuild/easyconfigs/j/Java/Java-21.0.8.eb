name = 'Java'
_java_version = '21'
_patch_version = '8'
_build_version = '9'
version = f'{_java_version}.0.{_patch_version}'

homepage = 'https://openjdk.org'
description = """Java Platform, Standard Edition (Java SE) lets you develop and deploy
Java applications on desktops and servers."""

toolchain = SYSTEM

_tarball_tmpl = f'OpenJDK{_java_version}U-jdk_{{}}_linux_hotspot_{version}_{_build_version}.tar.gz'

# Using the Adoptium Eclipse Temurin builds, recommended by https://whichjdk.com/#distributions
source_urls = [f'https://github.com/adoptium/temurin{_java_version}-binaries/releases/download/'
               f'jdk-{version}+{_build_version}/']
sources = [
    _tarball_tmpl.format('%(jdkarch)s'),
    {'filename': 'Java_blocked-certs-eMudhra-CVE-2026-91403.txt',
     'extract_cmd': "cp %s %(builddir)s/"},
]
checksums = [
    {
        _tarball_tmpl.format('x64'):
            'f2dc5418092c43003db8f9005c4a286e1c0104fea96ccdd49e8ebd037cac9219',
        _tarball_tmpl.format('aarch64'):
            'e5c41a1ab0865ea5de9b4529bf8526005f1d4593090845387d14fe450ce39c33',
        _tarball_tmpl.format('ppc64le'):
            'a24e869b8e563fd7b9f7776f6686ca5d737c8d1c3c33c9b72836935709b44a34',
        _tarball_tmpl.format('riscv64'):
            '8171d95189e675e297b5cb96c7ac6247ab4e9f48da82b13f491fc46ef5d97836',
    },
    {'Java_blocked-certs-eMudhra-CVE-2026-91403.txt':
     '8a11b84b894e7986af1131c10fcff168fb38987bedb4fd7a0d8a7a120288d521'},
]

postinstallcmds = [
    # see https://glaforge.dev/posts/2026/10/21/the-emudhra-ca-compromise-why-your-jvm-is-vulnerable-and-how-to-fix-it
    "cat %(builddir)s/Java_blocked-certs-eMudhra-CVE-2026-91403.txt >> %(installdir)s/lib/security/blocked.certs",
]

moduleclass = 'lang'
