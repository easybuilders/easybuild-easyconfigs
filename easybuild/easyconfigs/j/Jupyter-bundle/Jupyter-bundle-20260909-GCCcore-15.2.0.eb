easyblock = 'Bundle'

name = 'Jupyter-bundle'
version = '20260909'

homepage = "https://jupyter.org/"

description = """
This bundle collects a range of Jupyter interfaces (Lab, Notebook and nbclassic),
extensions (Jupyter Server Proxy, Jupyter Resource Monitor, Jupyter Lmod) and
the JupyterHub.
"""

toolchain = {'name': 'GCCcore', 'version': '15.2.0'}

dependencies = [
    ('JupyterHub', '5.5.0'),
    ('JupyterLab', '4.5.8'),
    ('JupyterNotebook', '7.5.7'),
    ('nbclassic', '1.3.3'),
    ('jupyter-server-proxy', '4.5.0'),
    ('jupyterlmod', '5.3.2'),
    ('jupyter-resource-usage', '1.3.0'),
]

moduleclass = 'tools'
