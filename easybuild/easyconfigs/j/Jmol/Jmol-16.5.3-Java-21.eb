easyblock = 'PackedBinary'

name = 'Jmol'
version = '16.5.3'
versionsuffix = '-Java-%(javaver)s'

homepage = 'http://jmol.sourceforge.net/'
description = """Jmol: an open-source Java viewer for chemical structures in 3D"""

toolchain = SYSTEM

source_urls = ['https://sourceforge.net/projects/jmol/files/Jmol/Version%20%(version_major_minor)s/Jmol%20%(version)s/']
sources = ['%(name)s-%(version)s-binary.tar.gz']
checksums = ['e024e7a312a52ae56526f7c1f7d49af90002926f49c8f884db40aa0a6bc1d94f']

dependencies = [('Java', '21')]

sanity_check_paths = {
    'files': ['jmol', 'Jmol.jar'],
    'dirs': [],
}

modextrapaths = {
    'JMOL_HOME': ''
}

moduleclass = 'tools'
