# Author: J. Sassmannshausen (Imperial College London/UK)

easyblock = 'PythonPackage'

name = 'brkraw'
version = '0.5.7'

homepage = 'https://github.com/BrkRaw/brkraw'
description = """
A modular toolkit for Bruker MRI raw-data handling.

BrkRaw (v0.6.1rc2) converts raw data into standardized,
neuroimaging-ready datasets, with extensible rules/specs
and plugin hooks.
"""

citing = '''
  author = Lee, Sung-Ho and Devenyi, Gabriel A. and Ban, Woomi and Shih, Yen-Yu Ian,
  title = BrkRaw: A modular toolkit for Bruker MRI raw-data handling,
  version = 0.5.7.
  doi = 10.5281/zenodo.3818614,
  url = https://github.com/BrkRaw/brkraw,
  note = Documentation: https://brkraw.github.io,
  license = GPL-3.0-only
}
'''

toolchain = {'name': 'gfbf', 'version': '2026.1'}

source_urls = [GITHUB_SOURCE]
sources = ['%(version)s.tar.gz']
checksums = ['1e92a3cbe4b39f81ba936e9a56ab820a03d3838a33be63a567b06a1d494716c2']

builddependencies = [
    ('hatchling', '1.29.0'),
]

dependencies = [
    ('Python', '3.14.2'),
    ('Python-bundle-PyPI', '2026.04'),
    ('SciPy-bundle', '2026.05'),
    ('PyYAML', '6.0.3'),
    ('Pillow', '12.2.0'),
    ('NiBabel', '5.4.2'),
]

moduleclass = 'vis'
