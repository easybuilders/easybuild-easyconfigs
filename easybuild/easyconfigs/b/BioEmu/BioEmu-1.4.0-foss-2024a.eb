easyblock = 'PythonBundle'

name = 'BioEmu'
version = '1.4.0'

homepage = 'https://github.com/microsoft/bioemu'
description = """
Biomolecular Emulator (BioEmu for short) is a model that samples from the
approximated equilibrium distribution of structures for a protein monomer,
given its amino acid sequence.
"""

toolchain = {'name': 'foss', 'version': '2024a'}

builddependencies = [
    ('PDM', '2.18.2'),
    ('hatchling', '1.27.0'),
]
dependencies = [
    ('Python', '3.12.3'),
    ('SciPy-bundle', '2024.05'),
    ('PyTorch-Geometric', '2.6.1'),
    ('PyTorch-bundle', '2.6.0'),
    ('jax', '0.6.2'),
    ('TensorFlow', '2.18.1'),
    ('matplotlib', '3.9.2'),
    ('Biopython', '1.84'),
    ('dm-tree', '0.1.9'),
    ('dm-haiku', '0.0.16'),
    ('MDTraj', '1.10.3'),
    ('mygene', '3.2.2'),
    ('tqdm', '4.66.5'),
    ('HF-Datasets', '4.0.0'),
    ('Hydra', '1.3.2'),
    ('einops', '0.8.1'),
    ('ml-collections', '1.1.0'),
    ('absl-py', '2.1.0'),
]

exts_list = [
    ('typer', '0.20.0', {
        'checksums': ['1aaf6494031793e4876fb0bacfa6a912b551cf43c1e63c800df8b1a866720c37'],
    }),
    ('fire', '0.7.1', {
        'checksums': ['3b208f05c736de98fb343310d090dcc4d8c78b2a89ea4f32b837c586270a9cbf'],
    }),
    ('ihm', '2.8', {
        'checksums': ['528a6efe9c6576ace3b33cfde531f177a17e791ff365039582620b6ad9fbe441'],
    }),
    ('modelcif', '1.6', {
        'checksums': ['b1bf0751f0e2d1ea6da7a0a8a92efd2754428ae50bc3bfbff8e015183e978b19'],
    }),
    ('stackprinter', '0.2.12', {
        'checksums': ['271efc75ebdcc1554e58168ea7779f98066d54a325f57c7dc19f10fa998ef01e'],
    }),
    ('gprofiler-official', '1.0.0', {
        'modulename': 'gprofiler',
        'checksums': ['5015b47f10fbdcb59c57e342e815c9c07afbe57cd3984154f75b845ddef2445d'],
    }),
    ('bio', '1.8.1', {
        'modulename': False,  # just a 'bio' executable
        'checksums': ['be516bd9fe4dfee562a521d22ffa4b94ee662b9f2a53a4dd52a0a00d93521354'],
    }),
    ('bioemu', version, {
        'source_urls': ['https://github.com/microsoft/bioemu/archive'],
        'sources': [{'download_filename': 'v%(version)s.tar.gz', 'filename': SOURCE_TAR_GZ}],
        'preinstallopts': (
            # unpin matplotlib version and fix tensorflow moduel name
            "sed -i -e 's/matplotlib>=3.10.7/matplotlib/' "
            "-e 's/tensorflow-cpu>=2.12.0/tensorflow>=2.12.0/' pyproject.toml && "
            # https://github.com/microsoft/bioemu/issues/266
            "sed -i 's/1.4.1/%(version)s/' src/bioemu/__init__.py && "
        ),
        'testinstall': True,
        'runtest': (
            'mkdir -p .bioemu-test-home && '
            'HOME="$PWD/.bioemu-test-home" JAX_PLATFORMS=cpu pytest -vv tests/'
            ' --ignore=tests/test_colabfold_inline/test_regression.py'
            ' --ignore=tests/test_mdrelax.py'  # requires OpenMM
            # End-to-end tests require downloading large model weights
            ' --ignore=tests/steering/test_chignolin_e2e.py'
            ' --ignore=tests/test_integration.py'
        ),
        'checksums': ['c0743022b677af4d89780fdad27c612202d976350791f383af933489cfc7f20e'],
    }),
]

postinstallcmds = [
    # copy notebooks to installation directory
    "cp -r notebooks %(installdir)s/",
]

sanity_check_paths = {
    'files': ['bin/bio', 'bin/typer'],
    'dirs': ['lib/python%(pyshortver)s/site-packages/', 'notebooks'],
}

sanity_check_commands = [
    "python -m bioemu.sample --help",
]

modloadmsg = """
%(name)s notebooks are located in $EBROOTBIOEMU/notebooks
"""

moduleclass = 'bio'
