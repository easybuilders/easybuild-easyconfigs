easyblock = 'PythonPackage'

name = 'bracex'
version = '3.2'

homepage = 'https://github.com/facelessuser/bracex'
description = "Bash style brace expander."

toolchain = {'name': 'GCCcore', 'version': '14.2.0'}

sources = [SOURCE_TAR_GZ]
checksums = ['0a3d40bfae4caae4d3bfd0ea715874799fab711c38fd4012cc35343e815405cd']

builddependencies = [
    ('binutils', '2.42'),
    ('hatchling', '1.27.0'),
    ('trove-classifiers', '2026.1.14.14'),  # has the 3.15 classifier
]

dependencies = [
    ('Python', '3.13.1'),
]

moduleclass = 'tools'
