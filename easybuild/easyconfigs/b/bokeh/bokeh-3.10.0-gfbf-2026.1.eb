easyblock = 'PythonBundle'

name = 'bokeh'
version = '3.10.0'

homepage = 'https://bokeh.org/'
description = "Interactive plots and applications in the browser from Python"

toolchain = {'name': 'gfbf', 'version': '2026.1'}

builddependencies = [
    ('meson-python', '0.19.0'),
    ('hatchling', '1.29.0'),
    ('pybind11', '3.0.4'),
]

dependencies = [
    ('Python', '3.14.2'),
    ('Python-bundle-PyPI', '2026.04'),
    ('SciPy-bundle', '2026.05'),
    ('matplotlib', '3.10.9'),
    ('PyYAML', '6.0.3'),
    ('Pillow', '12.2.0'),
    ('tornado', '6.5.6'),
]

exts_list = [
    ('xyzservices', '2025.4.0', {
        'checksums': ['6fe764713648fac53450fbc61a3c366cb6ae5335a1b2ae0c3796b495de3709d8'],
    }),
    ('narwhals', '2.0.1', {
        'checksums': ['235e61ca807bc21110ca36a4d53888ecc22c42dcdf50a7c886e10dde3fd7f38c'],
    }),
    (name, version, {
        'preinstallopts': r"sed -i 's/dynamic = \[\"version\"\]/version = \"%(version)s\"/' pyproject.toml && ",
        'checksums': ['73f0b0c06d7925ca2b6d52b2dc51c2533a11f667cc6944f1f06c039ccc57c5ce'],
    }),
]

sanity_check_paths = {
    'files': ['bin/bokeh'],
    'dirs': ['lib/python%(pyshortver)s/site-packages'],
}

sanity_check_commands = ["bokeh --help"]

moduleclass = 'tools'
