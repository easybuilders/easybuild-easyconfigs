easyblock = 'PythonBundle'

name = 'bamdam'
version = '0.4.3'

homepage = 'https://github.com/bdesanctis/bamdam'
description = 'A post-mapping authentication toolkit for ancient metagenomics'

toolchain = {'name': 'gfbf', 'version': '2026.1'}

builddependencies = [
    ('hatchling', '1.29.0'),
]

dependencies = [
    ('Python', '3.14.2'),
    ('Pysam', '0.24.0'),
    ('matplotlib', '3.10.9'),
    ('tqdm', '4.67.3'),
]

exts_list = [
    ('hyperloglog', '0.1.8', {
        'checksums': ['919864a909e7de0168ee8de2d01a0ab6cad38806d5d2e5ad71128b32449154dc'],
    }),
    (name, version, {
        'checksums': ['099de3d14d9578c3929bc6d5ab8dd1b96ff702f17a7613036a2081b3a2c49c68'],
    }),
]

sanity_check_paths = {
    'files': ['bin/bamdam'],
    'dirs': ['lib/python%(pyshortver)s/site-packages'],
}

sanity_check_commands = ["bamdam --help"]

moduleclass = 'bio'
