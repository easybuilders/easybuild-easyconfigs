easyblock = 'RPackage'

name = 'BPCells'
version = '0.3.1'
versionsuffix = '-R-%(rver)s'

homepage = 'https://bnprks.github.io/BPCells'
description = """BPCells is a package for high performance single cell analysis of large RNA-seq and ATAC-seq
 datasets."""

toolchain = {'name': 'foss', 'version': '2026.1'}

github_account = 'bnprks'
source_urls = ['https://github.com/%(github_account)s/%(name)s/archive/refs/tags']
sources = [{'download_filename': 'v%(version)s.tar.gz', 'filename': SOURCE_TAR_GZ}]
checksums = ['76f55ec77c9784d4b4ad80e7a0fc5c8139fa8101857edd5772ece70cbd8ae584']

builddependencies = [('pkgconf', '2.5.1')]

dependencies = [
    ('R', '4.6.1'),
    ('R-bundle-CRAN', '2026.07'),
    ('R-bundle-Bioconductor', '3.23', versionsuffix),
    ('HDF5', '2.1.1'),
    ('Highway', '1.4.0'),
]

start_dir = 'r'

sanity_check_paths = {
    'files': [],
    'dirs': [name],
}

moduleclass = 'bio'
