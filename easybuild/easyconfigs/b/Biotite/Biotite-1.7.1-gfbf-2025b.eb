    ('hatchling', '1.27.0'),
    ('Cython', '3.2.4'),
    ('setuptools-rust', '1.11.0'),
    ('Rust', '1.88.0'),
]

dependencies = [
    ('Python', '3.13.5'),
    ('SciPy-bundle', '2025.07'),
    ('networkx', '3.5'),
    ('HTTPX', '0.28.1'),
    ('tqdm', '4.67.1'),
]

