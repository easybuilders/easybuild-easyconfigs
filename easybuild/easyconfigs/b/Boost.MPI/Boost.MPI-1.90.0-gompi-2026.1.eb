easyblock = 'EB_Boost'

name = 'Boost.MPI'
version = '1.90.0'

homepage = 'https://www.boost.org/'
description = """Boost provides free peer-reviewed portable C++ source libraries."""

toolchain = {'name': 'gompi', 'version': '2026.1'}
toolchainopts = {'pic': True, 'usempi': True}

source_urls = ['https://archives.boost.io/release/%(version)s/source/']
sources = ['boost_%s.tar.gz' % '_'.join(version.split('.'))]
checksums = ['5e93d582aff26868d581a52ae78c7d8edf3f3064742c6e77901a1f18a437eea9']

dependencies = [
    ('bzip2', '1.0.8'),
    ('zlib', '2.3.2'),
    ('XZ', '5.8.2'),
    ('zstd', '1.5.7'),
    ('ICU', '78.3'),
]

configopts = '--without-libraries=python'

boost_mpi = True
tagged_layout = True

moduleclass = 'devel'
