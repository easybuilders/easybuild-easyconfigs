easyblock = 'PythonBundle'

name = 'AITW-material_optimization'
version = '0.1.0'

homepage = 'https://www.ai-transpwood-project.eu/'
description = """AI-TranspWood - Optimize microscopic biocomposite parameters using the bundled stiffness surrogate
and batched differential evolution. Match selected output targets, or minimize and maximize selected quantities
subject to confidence and uncertainty constraints.
"""

toolchain = {'name': 'foss', 'version': '2023a'}

dependencies = [
    ('Python', '3.11.3'),
    ('Python-bundle-PyPI', '2023.06'),
    ('SciPy-bundle', '2023.07'),
    ('h5py', '3.9.0'),
    ('TensorFlow', '2.13.0'),
    ('tensorflow-probability', '0.20.0'),
]

exts_list = [
    ('AITW_material_optimization', version, {
        'modulename': 'aitw_material_optimization',
        'source_urls': ['https://github.com/AI-TranspWood/surrogate-optimization-dev/archive/refs/tags'],
        'sources': [{
            'filename': SOURCE_TAR_GZ,
            'download_filename': 'v%(version)s.tar.gz'
        }],
        # 'checksums': ['5f708e9bdef6679d8db096068b1a62558b74d40caf6f686e942aeba7bfc3a413'],
        'testinstall': True,
        'runtest': 'pytest -sv --disable-warnings',
        'click_autocomplete_bins': ['aitw-material-optimization'],
    }),
]

sanity_check_commands = [
    'aitw-material-optimization --help',
]

moduleclass = 'chem'
