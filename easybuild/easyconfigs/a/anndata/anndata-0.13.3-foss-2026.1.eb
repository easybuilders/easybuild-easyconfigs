easyblock = 'PythonBundle'

name = 'anndata'
version = '0.13.3'

homepage = 'https://github.com/scverse/anndata'
description = """anndata is a Python package for handling annotated data matrices in memory and on disk,
 positioned between pandas and xarray"""

toolchain = {'name': 'foss', 'version': '2026.1'}

builddependencies = [
    ('hatchling', '1.29.0'),
    ('meson-python', '0.19.0'),
]

dependencies = [
    ('Python', '3.14.2'),
    ('Python-bundle-PyPI', '2026.04'),
    ('SciPy-bundle', '2026.05'),
    ('h5py', '3.16.0'),
    ('zarr', '3.2.1'),
    ('pydantic', '2.13.4'),
]

exts_list = [
    ('typing_extensions', '4.16.0', {
        'checksums': ['dc983d19a509c94dba722ee6abd33940f7c05a89e243c47e907eb4db6f1a43e5'],
    }),
    ('python-dotenv', '1.2.3', {
        'modulename': 'dotenv',
        'checksums': ['a20a594dabeaa385725aa239d5244871c143ecb356add8a20fcf23773a6c3a35'],
    }),
    ('pydantic-settings', '2.15.0', {
        'checksums': ['694b793e84f766ba76a90ebdefc01d0a9a045dab0382bee70393da93712ad117'],
    }),
    ('session-info2', '0.4.2', {
        'checksums': ['d85d730621d6f75df60e15dad21258f2750f04c0c0ee5958a7bf92342c039d76'],
    }),
    ('scverse-misc', '0.1.6', {
        'checksums': ['2310c2a0d2159311f1b44759cbd2f83b543362556396d93cb70cff01647ec835'],
    }),
    ('array_api_compat', '1.15.0', {
        'checksums': ['53c5f922491bf15f62847afafc4e39eedfae57d218988fefb8cce39c2a9b3dea'],
    }),
    ('legacy_api_wrap', '1.5', {
        'checksums': ['b41ba6532f3ebfe3a897a35a7f97dec3be04b92a450f6c2bcf89f1b91c9cadf2'],
    }),
    ('natsort', '8.4.0', {
        'checksums': ['45312c4a0e5507593da193dedd04abb1469253b601ecaf63445ad80f0a1ea581'],
    }),
    (name, version, {
        'source_urls': ['https://github.com/scverse/anndata/archive/refs/tags/'],
        'source_tmpl': '%(version)s.tar.gz',
        'preinstallopts': 'export SETUPTOOLS_SCM_PRETEND_VERSION=%(version)s && ',
        'checksums': ['340692dcc07fb386592030fb943950e8f073fc681517f920d2810aceae995a6b'],
    }),
]

sanity_check_paths = {
    'files': ['bin/natsort'],
    'dirs': ['lib/python%(pyshortver)s/site-packages'],
}

sanity_check_commands = ['natsort --help']

moduleclass = 'bio'
