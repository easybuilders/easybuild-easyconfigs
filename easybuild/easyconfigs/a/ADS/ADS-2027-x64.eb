easyblock = 'PackedBinary'

name = 'ADS'
version = '2027'
versionsuffix = '-x64'

homepage = 'https://www.keysight.com/us/en/products/software/pathwave-design-software/' + \
           'pathwave-advanced-design-system.html'
description = """Keysight ADS is the premier electronic design automation (EDA) platform for the design of
high-frequency and high-speed digital physical layer components from single purpose amplifiers to complex RF modules
and high-speed digital boards."""

toolchain = SYSTEM

download_instructions = 'Download sources from:\nhttps://www.keysight.com/us/en/lib/software-detail/' + \
    'computer-software/pathwave-advanced-design-system-ads-software-2212036.html'

sources = ['ads_%(version)s_shp_linux_x64.tar']
checksums = ['ee4d8034451999155997c27782f584b1b2b5018bb47d9aec48508a7679597838']

install_cmd = 'IATEMPDIR="%(builddir)s" ./SETUP.SH -i silent -DUSER_INSTALL_DIR="%(installdir)s"'

sanity_check_paths = {
    'files': ['bin/ads'],
    'dirs': [],
}

moduleclass = 'phys'
