easyblock = 'PythonPackage'

name = 'astor'
version = '0.8.1'

homepage = 'https://github.com/berkerpeksag/astor'
description = """Read/rewrite/write Python ASTs"""

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}

sources = [SOURCE_TAR_GZ]
