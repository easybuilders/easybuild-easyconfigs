easyblock = 'PythonBundle'

name = 'AITW-wood_stiffness_homegenization'
version = '1.0.0'

homepage = 'https://www.ai-transpwood-project.eu/'
description = """AI-TranspWood - This code computes the multiscale stiffness of native, polymer-infiltrated, and
delignified + infiltrated wood.
"""

toolchain = {'name': 'gfbf', 'version': '2025b'}

builddependencies = [
    ('poetry', '2.1.3'),  # Needed to install textual
]

dependencies = [
    ('Python', '3.13.5'),
    ('SciPy-bundle', '2025.07'),
    ('matplotlib', '3.10.5'),
    ('Tkinter', '3.13.5'),
]

exts_list = [
    ('textual', '0.61.0', {
        'checksums': ['91c83a659da40b227eced4fa749026a236b493cc5911a9bedd990ad5f0786be2'],
    }),
    ('trogon', '0.6.0', {
        'checksums': ['fd1abfeb7b15d79d6e6cfc9e724aad2a2728812e4713a744d975f133e7ec73a4'],
    }),
    ('rich-click', '1.9.7', {  # Needs new panel feature introduced in 1.9.0 (Python-bundle has 1.8.7)
        'sources': ['rich_click-%(version)s.tar.gz'],
        'checksums': ['022997c1e30731995bdbc8ec2f82819340d42543237f033a003c7b1f843fc5dc'],
    }),
    ('wood_stiffness_homogenization', version, {
        'click_autocomplete_bins': ['aitw-wood-stiffness-homogenization'],
        'modulename': 'wood_stiffness_homogenization',
        'runtest': 'pytest -sv --disable-warnings',
        'source_urls': ['https://github.com/AI-TranspWood/Wood_Stiffness_Homogenization/archive/refs/tags'],
        'checksums': ['b8a1ac28c4c548962bef0162336bf00e7dc125db9068fc19e05b80daad448a2c'],
        'sources': [{'filename': '%(name)s-%(version)s.tar.gz', 'download_filename': 'v%(version)s.tar.gz'}],
        'testinstall': True,
    }),
]

sanity_check_commands = [
    'aitw-wood-stiffness-homogenization --help',
]

moduleclass = 'chem'
