easyblock = 'CMakeMake'

name = 'AFLOW'
version = '4.1'

homepage = 'https://github.com/aflow-org/aflow'
description = """The Automatic-Flow (AFLOW) framework is a class of interconnected software tools designed for
high-throughput materials discovery, leveraging both first-principles quantum mechanical calculations using
density functional theory (DFT), and data informatics as a screening strategy."""

toolchain = {'name': 'GCC', 'version': '14.3.0'}

source_urls = ['https://github.com/aflow-org/aflow/releases/download/v%(version)s/']
sources = ['%(namelower)s_%(version)s_orig.tar.gz']
patches = [
    '%(name)s-%(version)s_external_deps.patch',
    '%(name)s-%(version)s_linker_flag.patch',
]
checksums = [
    {'aflow_4.1_orig.tar.gz': '3711ed521e97c8a005d89720a4d990930ab3d928f5d2bf718a713c0d0e0f3d0a'},
    {'AFLOW-4.1_external_deps.patch': '1ddf4d5187904263691768158e2faa53f7d2d3779bf08ee852c757fc0cb50925'},
    {'AFLOW-4.1_linker_flag.patch': 'd6c53705136bc28f81fb513c9c5de34ba6f59d2a751608de52d3859c5a4fd103'},
]

builddependencies = [
    ('CMake', '4.0.3'),
]

dependencies = [
    ('Qhull', '2020.2'),
    ('SQLite', '3.50.1'),
    ('gnuplot', '6.0.3'),
    ('ImageMagick', '7.1.2-7'),
]

start_dir = 'src'

sanity_check_paths = {
    'files': ['bin/aflow'],
    'dirs': [],
}

sanity_check_commands = ['aflow -h']

moduleclass = 'phys'
