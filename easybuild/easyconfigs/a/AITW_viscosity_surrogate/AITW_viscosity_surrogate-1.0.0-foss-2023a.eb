easyblock = 'PythonBundle'

name = 'AITW_viscosity_surrogate'
version = '1.0.0'

homepage = 'https://www.ai-transpwood-project.eu/'
description = """AI-TranspWood - Four approaches used to predict the viscosity of chemical compounds from
their SMILES representations. Together they span classical machine learning, pure deep learning on molecular
language, a hybrid architecture combining both, and a final ensemble that unifies all three.
"""

toolchain = {'name': 'foss', 'version': '2023a'}

builddependencies = [
    ('poetry', '1.7.1'),  # Needed to install textual
]

dependencies = [
    ('Python', '3.11.3'),
    ('SciPy-bundle', '2023.07'),
    ('PyTorch', '2.1.2'),
    ('scikit-learn', '1.3.1'),
    ('RDKit', '2024.03.3'),
    ('matplotlib', '3.7.2'),
    ('XGBoost', '2.0.2'),
    ('Transformers', '4.39.3'),
]

exts_list = [
    ('textual', '0.61.0', {
        'checksums': ['91c83a659da40b227eced4fa749026a236b493cc5911a9bedd990ad5f0786be2'],
    }),
    ('trogon', '0.6.0', {
        'checksums': ['fd1abfeb7b15d79d6e6cfc9e724aad2a2728812e4713a744d975f133e7ec73a4'],
    }),
    (name, version, {
        'modulename': 'aitw_viscosity_surrogate',
        'source_urls': ['https://github.com/AI-TranspWood/viscosity-surrogate/archive/refs/tags/'],
        'sources': [{
            'download_filename': 'v%(version)s.tar.gz',
            'filename': '%(name)s-%(version)s.tar.gz',
        }],
        'checksums': ['f5c8a4f1ac87deaabd201e1e71e4ce460dc05c13da95a01d3a629fcf946006c7'],
        'testinstall': True,
        'runtest': 'pytest -sv --disable-warnings',
        'click_autocomplete_bins': ['aitw-viscosity-surrogate'],
    }),
]

sanity_check_commands = [
    'aitw-viscosity-surrogate --help',
]

moduleclass = 'chem'
