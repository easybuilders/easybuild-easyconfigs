easyblock = 'PythonBundle'

name = 'AITW-aiida-wood-permeability'
version = '0.3.0'

homepage = 'https://www.ai-transpwood-project.eu/'
description = """AI-TranspWood - AAiiDA workflow for automated calculation of the wood permeability using the
lattice Boltzmann method (LBM) implemented in OpenLB.
"""

toolchain = {'name': 'foss', 'version': '2026.1'}

builddependencies = [
    ('poetry', '2.3.4'),  # Needed to install textual
]

dependencies = [
    ('Python', '3.14.2'),
    ('Python-bundle-PyPI', '2026.04'),
    ('SciPy-bundle', '2026.05'),
    ('aiida-core', '2.9.2'),
    ('aiida-shell', '0.9.0'),
]

exts_list = [
    ('textual', '0.61.0', {
        'checksums': ['91c83a659da40b227eced4fa749026a236b493cc5911a9bedd990ad5f0786be2'],
    }),
    ('trogon', '0.6.0', {
        'checksums': ['fd1abfeb7b15d79d6e6cfc9e724aad2a2728812e4713a744d975f133e7ec73a4'],
    }),
    ('aiida-wood-permeability', version, {
        'click_autocomplete_bins': ['aitw-permeability'],
        'modulename': 'aiida_wood_permeability',
        'source_urls': ['https://github.com/AI-TranspWood/aiida_wood_permeability/archive/refs/tags'],
        'sources': [{'filename': '%(name)s-%(version)s.tar.gz', 'download_filename': 'v%(version)s.tar.gz'}],
        'checksums': ['634f307bb39530433f0cf4f33fa1877113775a599107c8cf9c250e31910c8761'],
    }),
]

sanity_check_commands = [
    'aitw-permeability --help',
]

moduleclass = 'chem'
