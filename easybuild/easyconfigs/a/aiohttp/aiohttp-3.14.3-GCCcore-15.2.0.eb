    ('binutils', '2.45'),
    ('hatchling', '1.29.0'),
    ('poetry', '2.3.4'),
    ('Cython', '3.2.4'),
]

dependencies = [
    ('Python', '3.14.2'),
    ('Python-bundle-PyPI', '2026.04'),
    ('boto3', '1.43.34'),
    ('wrapt', '2.2.1'),
]

