    ('binutils', '2.45'),
    ('poetry', '2.3.4'),
    ('Cython', '3.2.4'),
    ('hatchling', '1.29.0'),
]

dependencies = [
    ('Python', '3.14.2'),
    ('Python-bundle-PyPI', '2026.04'),
]

