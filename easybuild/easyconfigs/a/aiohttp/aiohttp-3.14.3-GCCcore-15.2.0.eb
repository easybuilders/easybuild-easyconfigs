easyblock = 'PythonBundle'

name = 'aiohttp'
version = '3.14.3'

homepage = 'https://github.com/aio-libs/aiohttp'
description = "Asynchronous HTTP client/server framework for asyncio and Python."

toolchain = {'name': 'GCCcore', 'version': '15.2.0'}

