easyblock = 'ConfigureMake'

name = 'AdmixTools'
version = '8.0.2'

homepage = 'https://github.com/DReichLab/AdmixTools'
description = """The ADMIXTOOLS package implements 5 methods described in Patterson et al. (2012) Ancient Admixture in
Human History. Details of the methods and algorithm can be found in this paper."""

toolchain = {'name': 'gfbf', 'version': '2025b'}

source_urls = ['https://github.com/DReichLab/AdmixTools/archive/refs/tags/']
sources = [V_VERSION_TAR_GZ]
checksums = ['fea3eaabc5c47aa85dbc4346b6be0c377249064ccba087c246cbc7bec4b18777']

dependencies = [
    ('GSL', '2.8'),
    ('Perl', '5.40.2'),
]

skipsteps = ['configure']

start_dir = 'src'

prebuildopts = 'sed -i "s/openblas/flexiblas/" Makefile && '
prebuildopts += 'sed -i "s|TOP=.*|TOP=%(installdir)s/bin|" Makefile && '
prebuildopts += 'sed -i "s|BIN=.*|BIN=%(installdir)s/bin|" Makefile && '

maxparallel = 1

_binaries = [
    'qp3Pop',
    'qp4diff',
    'qpAdm',
    'qpBound',
    'qpDpart',
    'qpDstat',
    'qpF4ratio',
    'qpWave',
    'qpff3base',
    'qpfmv',
    'qpfstats',
    'qpreroot',
    'convertf',
    'dowtjack',
    'easycheck',
    'easylite',
    'easystats',
    'multimerge',
    'mergeit',
    'merge_transpose',
    'grabpars',
    'geno_single',
    'qpGraph',
    'qpmix',
    'simpjack2',
    'snpunion',
    'transpose',
]

_perl_scripts = [
    'wtjack.pl',
    'xtractcol',
    'xtractcoltab',
    'xtractcolv',
    'xtractcolx',
    'dof4',
    'dof4a',
    'fxtract',
    'getresult',
    'jackdiff',
    'mkpretty',
    'numlines',
]

fix_perl_shebang_for = _perl_scripts

sanity_check_paths = {
    'files': [f'bin/{x}' for x in _binaries + _perl_scripts],
    'dirs': [],
}

# Sanity checks commands that accept the -h flag
sanity_check_commands = [f'{x} -h'  for x in _binaries[:12]]

moduleclass = 'bio'
