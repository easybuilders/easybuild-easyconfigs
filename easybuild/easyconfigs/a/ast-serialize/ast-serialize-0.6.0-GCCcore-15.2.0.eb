easyblock = 'CargoPythonPackage'

name = 'ast-serialize'
version = '0.6.0'

homepage = 'https://github.com/mypyc/ast_serialize'
description = """Fast Python extension based on the Ruff parser for parsing Python
files and serializing the AST in the binary format used by mypy."""

