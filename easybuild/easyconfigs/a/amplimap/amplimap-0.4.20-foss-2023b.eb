# This easyconfig was created by the BEAR Software team at the University of Birmingham.
# Updated for foss/2023b by Emik Lin (HKUMed CPOS).

easyblock = 'PythonBundle'

name = 'amplimap'
version = '0.4.20'

homepage = 'https://amplimap.readthedocs.io/en/latest/'
description = """amplimap is a command-line tool to automate the processing and analysis of data from targeted
next-generation sequencing experiments with PCR-based amplicons or capture-based enrichment systems."""

toolchain = {'name': 'foss', 'version': '2023b'}

builddependencies = [
    ('binutils', '2.40'),
    ('Cython', '3.0.10'),
]

dependencies = [
    ('Python', '3.11.5'),
    ('Python-bundle-PyPI', '2023.10'),
    ('SciPy-bundle', '2023.11'),
    ('Biopython', '1.84'),
    ('PyYAML', '6.0.1'),
    ('matplotlib', '3.8.2'),
    ('snakemake', '7.32.4'),
    ('Pysam', '0.22.0'),
    ('UMI-tools', '1.1.5'),
    ('pyfaidx', '0.8.1.1'),
]

use_pip = True

exts_list = [
    ('Distance', '0.1.3', {
        'checksums': ['60807584f5b6003f5c521aa73f39f51f631de3be5cccc5a1d67166fcbf0d4551'],
    }),
    ('interlap', '0.2.6', {
        'checksums': ['a8585a165bf7e94d4d262811b4cb00674059414c50afc7561c949b0feb78fa09'],
    }),
    (name, version, {
        'patches': ['%(name)s-%(version)s_modern-Python-stack.patch'],
        'checksums': [
            '34f8e4f26554cde8200cec52b28b01ed27e9991734a73921880360f58efe5b7f',  # amplimap-0.4.20.tar.gz
            # amplimap-0.4.20_modern-Python-stack.patch
            'c9838350588f04b29b34bbf6e70c90ba4f0626f5687589403c0d196da4f04906',
        ],
    }),
]

sanity_pip_check = True

sanity_check_paths = {
    'files': ['bin/amplimap', 'bin/amplimap_merge', 'bin/amplimap_setup'],
    'dirs': [],
}

sanity_check_commands = ['amplimap --help']

moduleclass = 'bio'
