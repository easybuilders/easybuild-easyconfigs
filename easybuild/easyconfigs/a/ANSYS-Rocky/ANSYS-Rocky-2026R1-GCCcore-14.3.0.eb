easyblock = 'EB_FLUENT'

name = 'ANSYS-Rocky'
version = '2026R1'

homepage = 'https://www.ansys.com/products/fluids/ansys-rocky'
description = """
Ansys Rocky is the industry-leading discrete element method (DEM) software that quickly and
accurately simulates particle flow behavior.
"""

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}

dependencies = [
    ('X11', '20250608'),  # for xcb-util-cursor
]

download_instructions = 'Manually obtain (ROCKY_2026R1_LINX64.tgz) from your ANSYS vendor'

sources = ['ROCKY_%(version)s_LINX64.tgz']
checksums = ['6d5b15c8ca4b93c401299b498f046d959c5b48f1073c6feda1472b98ab8c781a']

installopts = '-nochecks'  # avoid check for xcb-util-cursor (in X11)

modextrapaths = {
    'PATH': 'v261/rocky',
    'ROCKY_PLUGINS_PATH': 'v261/rocky/Modules',
}

postinstallcmds = [
    r"""sed -i 's|temp_desktop_file="\$HOME/`basename \$desktop_file`"|"""
    r"""temp_desktop_file="/tmp/\$(basename "\$desktop_file")"|' """
    r"""%(installdir)s/v261/rocky/Rocky"""
]

sanity_check_paths = {
    'files': ['v261/rocky/Rocky'],
    'dirs': ['v261/rocky/bin/lib'],
}

moduleclass = 'cae'
