easyblock = 'RPackage'

name = 'autoplotly'
version = '0.1.7'
versionsuffix = '-R-%(rver)s'

homepage = 'https://cran.r-project.org/web/packages/autoplotly'
description = "Automatic Generation of Interactive Visualizations for Statistical Results."

toolchain = {'name': 'foss', 'version': '2025b'}

source_urls = [
    'https://cran.r-project.org/src/contrib/Archive/%(name)s',  # package archive
    'https://cran.r-project.org/src/contrib/',  # current version of packages
    'https://cran.freestatistics.org/src/contrib',  # mirror alternative for current packages
]
sources = ['%(name)s_%(version)s.tar.gz']
checksums = ['99b531cb2887acd735528e01e0cc8f8f15697628e2332ff0de81398233f18460']

dependencies = [
    ('R', '4.5.2'),
    ('R-bundle-CRAN', '2025.11'),
    ('ggfortify', '0.4.22', versionsuffix),
]

sanity_check_paths = {
    'files': [],
    'dirs': [name],
}

moduleclass = 'vis'
