easyblock = 'JuliaBundle'

name = 'AITW-Clearwood_stiffness_model'
version = '0.1.0'
_julia_ver = '1.12.2'
versionsuffix = "-Julia-%s" % _julia_ver

homepage = 'https://github.com/AI-TranspWood/Clearwood_share'
description = "This repository contains a neural network model for clearwood unit cell analysis."

toolchain = SYSTEM

dependencies = [
    ('Julia', _julia_ver),
]

exts_default_options = {
    'easyblock': 'JuliaPackage',
}

# Order is important as all dependencies of a package must be installed before the package itself
