easyblock = 'RPackage'

name = 'Azimuth'
local_commit = 'ad5929686e005ae91d8452187a3a1d8c0563fdd5'
version = '0.5.1-20260522'
versionsuffix = '-R-%(rver)s'

homepage = 'https://satijalab.org/azimuth/'
description = """Azimuth is a web application that uses an annotated reference dataset to automate the processing,
 analysis, and interpretation of a new single-cell RNA-seq experiment."""

toolchain = {'name': 'foss', 'version': '2026.1'}

source_urls = ['https://github.com/satijalab/azimuth/archive/']
sources = [{'download_filename': '%s.tar.gz' % local_commit, 'filename': SOURCE_TAR_GZ}]
checksums = ['0feba58dd134cf64299cce4497c9978703e15928adbb9d28b1f10e19fdde607c']

dependencies = [
    ('R', '4.6.1'),
    ('R-bundle-Bioconductor', '3.23', versionsuffix),
    ('SeuratData', '0.2.2.9002-20250304', versionsuffix),
    ('SeuratDisk', '0.0.0.9021-20231104', versionsuffix),
    ('presto', '1.1.0-20260920', versionsuffix),
]

sanity_check_paths = {
    'files': [],
    'dirs': [name],
}

moduleclass = 'bio'
