easyblock = 'PythonBundle'

name = 'aiida-core'
version = '2.9.2'

homepage = 'https://www.aiida.net/'
description = """Bundle of Python packages required to run AiiDA.
An open-source Python infrastructure to help researchers with automating, managing, persisting,
sharing and reproducing the complex workflows associated with modern computational science and all associated data.
"""

toolchain = {'name': 'foss', 'version': '2026.1'}
toolchainopts = {'pic': True}

# The comments after a dependency represent a list of extension or packages brought in by the dependency that are
# required for aiida-core.
builddependencies = [
    ('poetry', '2.3.4'),  # Poetry, importlib-metadata
    ('hatchling', '1.29.0'),
]

dependencies = [
    ('Python', '3.14.2'),
    ('Python-bundle-PyPI', '2026.04'),
    ('SciPy-bundle', '2026.05'),
    ('pydantic', '2.13.4'),  # pydantic_core, pydantic
    ('paramiko', '4.0.0'),  # paramiko
    ('SQLAlchemy', '2.0.51'),  # greenlet, alembic, SQLAlchemy
    ('graphviz-python', '0.21'),  # graphviz
    ('matplotlib', '3.10.9'),
    ('jupyter-server', '2.19.0'),  # PyYAML, tornado, ipython, ipywidgets, jupyter_server
    ('jedi', '0.20.0'),  # jedi
    ('wrapt', '2.2.1'),  # wrapt
    ('aiohttp', '3.14.3'),  # multidict, yarl
    ('psycopg', '3.3.4'),  # PostgreSQL, psycopg2
    ('plumpy', '0.26.1'),  # plumpy kiwipy aio-pika
    ('ASE', '3.28.0'),  # Needed for spglib -> seekpath -> [rest]
    ('pymatgen', '2026.5.4'),  # pymatgen
    ('Flask', '3.1.3'),  # Used to enable the `verdi restapi` command
    ('tqdm', '4.67.3'),
    ('psutil', '7.2.1'),
]

