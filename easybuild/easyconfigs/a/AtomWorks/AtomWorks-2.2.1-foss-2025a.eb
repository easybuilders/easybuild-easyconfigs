easyblock = 'PythonBundle'

name = 'AtomWorks'
version = '2.2.1'

homepage = 'https://github.com/RosettaCommons/atomworks'
description = """AtomWorks is a computational framework for biomolecular
modeling, providing tools for structural data processing and machine-learning
workflows."""

toolchain = {'name': 'foss', 'version': '2025a'}

builddependencies = [
    ('hatchling', '1.27.0'),
]

dependencies = [
    ('Cython', '3.1.1'),
    ('Python', '3.13.1'),
    ('SciPy-bundle', '2025.06'),  # for pandas
    ('PyTorch', '2.9.1', '-whl'),
    ('Biotite', '1.4.0'),
    ('py3Dmol', '2.5.3'),
    ('RDKit', '2025.03.4'),
    ('Arrow', '22.0.0'),
    ('PDM', '2.25.5'),
]

exts_list = [
    ('toolz', '1.1.0', {
        'source_tmpl': '%(name)s-%(version)s-py3-none-any.whl',
        'checksums': ['15ccc861ac51c53696de0a5d6d4607f99c210739caf987b5d2054f3efed429d8'],
    }),
    ('cytoolz', '0.12.3', {
        'checksums': ['4503dc59f4ced53a54643272c61dc305d1dbbfbd7d6bdf296948de9f34c3a282'],
    }),
    ('tqdm', '4.67.1', {
        'checksums': ['f8aef9c52c08c13a65f30ea34f4e5aac3fd1a34959879d7e59e63027286627f2'],
    }),
    ('typer', '0.20.0', {
        'checksums': ['1aaf6494031793e4876fb0bacfa6a912b551cf43c1e63c800df8b1a866720c37'],
    }),
    ('zstandard', '0.24.0', {
        'checksums': ['fe3198b81c00032326342d973e526803f183f97aa9e9a98e3f897ebafe21178f'],
    }),
    ('pymol-remote', '0.1.0', {
        'checksums': ['b18639a34a64404b7d29c06d418c12ca1e473e0d8803f5a9172c2ee84995853d'],
    }),
    ('hydride', '1.2.3', {
        'checksums': ['d1d06dcfb4c4957f109bd2445a115021cf69ff7c1639cb3f96961c58b38c6453'],
    }),
    ('einops', '0.8.1', {
        'checksums': ['de5d960a7a761225532e0f1959e5315ebeafc0cd43394732f103ca44b9837e84'],
    }),
    ('wadler_lindig', '0.1.7', {
        'checksums': ['81d14d3fe77d441acf3ebd7f4aefac20c74128bf460e84b512806dccf7b2cd55'],
    }),
    ('jaxtyping', '0.3.2', {
        'checksums': ['f30483fac4b42e915db8ad2414a85c3b63284aa7d3c100b96b59f755cf4a86ad'],
    }),
    ('beartype', '0.21.0', {
        'checksums': ['f9a5078f5ce87261c2d22851d19b050b64f6a805439e8793aecf01ce660d3244'],
    }),
    ('atomworks', version, {
        'source_tmpl': 'v%(version)s.tar.gz',
        'source_urls': ['https://github.com/RosettaCommons/atomworks/archive/'],
        'use_pip_extras': 'ml',
        'checksums': ['96e812f9484265ff395b58300eae88f28bd5b4bfeec47dae1eff45fc956718c2'],
    }),
]

sanity_check_paths = {
    'files': [
        'bin/atomworks',
        'bin/aw',
    ],
    'dirs': [
        'lib/python%(pyshortver)s/site-packages/atomworks',
    ],
}

sanity_check_commands = [
    'python -c "import atomworks"',
    'python -c "import atomworks.io"',
    'python -c "import atomworks.ml"',
    'atomworks --help',
]

moduleclass = 'bio'
