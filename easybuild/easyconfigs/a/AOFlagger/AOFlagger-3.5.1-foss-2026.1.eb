easyblock = 'CMakeMake'

name = 'AOFlagger'
version = '3.5.1'

homepage = 'https://aoflagger.readthedocs.io/'
description = """The AOFlagger is a tool that can find and remove radio-frequency interference (RFI)
in radio astronomical observations. It can make use of Lua scripts to make flagging strategies flexible,
and the tools are applicable to a wide set of telescopes."""

toolchain = {'name': 'foss', 'version': '2026.1'}

# Regular source tarballs don't include the git submodules. The release tarball that does is a GitLab package file;
# its numeric id in the URL changes with every release, look it up at
# https://gitlab.com/aroffringa/aoflagger/-/packages/
sources = [
    {
        'source_urls': ['https://gitlab.com/aroffringa/%(namelower)s/-/package_files/264635245/'],
        'filename': '%(namelower)s-v%(version)s.tar.bz2',
        'download_filename': 'download',
    },
]
checksums = ['4caf3e9ab0b998c59061836745778e9ea65e020700750d899da66a2ece092367']

builddependencies = [
    ('CMake', '4.4.5'),  # Needs to be CMake >=4.3 to detect Lua 5.5
]
dependencies = [
    ('casacore', '3.8.1'),  # was 3.5.0
    ('Boost', '1.90.0'),
    ('CFITSIO', '4.6.4'),
    ('GSL', '2.8'),
    ('HDF5', '2.1.1'),
    ('Python', '3.14.2'),
    ('pybind11', '3.0.4'),  # new dependency since 3.4 (Python bindings)
    ('Lua', '5.5.0'),  # see preconfigopts below
    ('libpng', '1.6.56'),
    ('libxml2', '2.15.1'),
    ('gtkmm4', '4.20.0'),
]

sanity_check_paths = {
    'files': ['include/%(namelower)s.h', 'bin/%(namelower)s'],
    'dirs': ['bin'],
}

sanity_check_commands = [('%(namelower)s', '-v')]

moduleclass = 'lib'
