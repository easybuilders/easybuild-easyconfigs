easyblock = 'ROCmComponent'

name = 'aqlprofile'
_rocm_version = '7.2.3'
version = _rocm_version

homepage = 'https://github.com/ROCm/rocm-systems'
description = """
aqlprofile is part of the ROCm software stack. It provides profiling capabilities
for AMD GPU applications using the AQL (Architected Queuing Language) interface.
"""

toolchain = {'name': 'rocm-compilers', 'version': f'22.0.0-ROCm-{_rocm_version}'}

source_urls = ['https://github.com/ROCm/rocm-systems/archive/']
sources = [{
    'download_filename': f'rocm-{_rocm_version}.tar.gz',
    'filename': f'rocm-systems-rocm-{_rocm_version}.tar.gz',
}]
checksums = ['e90cfd8694af28a56433c8827a581ee12a4ba835f0d952436741d9e0f3f8685b']

builddependencies = [
    ('CMake', '3.31.8'),
]

dependencies = [
    ('Python', '3.13.5'),
]

# aqlprofile is located in projects/aqlprofile within rocm-systems archive
srcdir = 'projects/aqlprofile'

sanity_check_paths = {
    'files': ['lib/libhsa-amd-aqlprofile64.%s' % SHLIB_EXT,
              'include/aqlprofile-sdk/aql_profile_v2.h',
              'include/aqlprofile-sdk/version.h'],
    'dirs': ['include/aqlprofile-sdk'],
}

moduleclass = 'lib'
