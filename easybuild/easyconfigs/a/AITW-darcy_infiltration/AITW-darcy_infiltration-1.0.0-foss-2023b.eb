easyblock = 'PythonBundle'

name = 'AITW-darcy_infiltration'
version = '1.0.0'

homepage = 'https://www.ai-transpwood-project.eu/'
description = """AI-TranspWood - This project contains code for simulating infiltration processes in
porous materials using the FEniCSx finite element framework.
"""

toolchain = {'name': 'foss', 'version': '2023b'}

dependencies = [
    ('tqdm', '4.66.2'),
    ('Python', '3.11.5'),
    ('SciPy-bundle', '2023.11'),
    ('FEniCS-DOLFINx-Python', '0.9.0'),
]

exts_list = [
    ('rich-click', '1.9.7', {  # Needs new panel feature introduced in 1.9.0 (Python-bundle has 1.7.0)
        'sources': ['rich_click-%(version)s.tar.gz'],
        'checksums': ['022997c1e30731995bdbc8ec2f82819340d42543237f033a003c7b1f843fc5dc'],
    }),
    (name, version, {
        'modulename': 'aitw_darcy',
        'source_urls': ['https://github.com/AI-TranspWood/AITW-Darcy-Infiltration-Model/archive/'],
        'sources': [{
            'filename': SOURCE_TAR_GZ,
            'download_filename': 'v%(version)s.tar.gz'
        }],
        'checksums': ['ba395371f0ddac7c1fd196587ba6014edf85c6626056238b21a98f078de23ea3'],
        'testinstall': True,
        'runtest': 'pytest -sv --disable-warnings',
        'click_autocomplete_bins': ['aitw-darcy'],
    }),
]

sanity_check_commands = [
    'aitw-darcy --help',
]

moduleclass = 'chem'
