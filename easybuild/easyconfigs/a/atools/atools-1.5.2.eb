easyblock = 'ConfigureMake'

name = 'atools'
version = '1.5.2'

homepage = 'https://github.com/gjbex/atools'
description = """Tools to make using job arrays a lot more convenient."""

toolchain = SYSTEM

source_urls = ['https://github.com/gjbex/atools/archive']
sources = [SOURCE_TAR_GZ]
checksums = ['734308b58956525b8c519c4a4f76e00b96400566cc87d0dd1870e299980be032']

# to enable SLURM integration (site-specific) (options are torque, moab, sge, slurm)
configopts = '--with-batchsystem=slurm'

# Disable Python's automatic site initialization (-S) to prevent system-installed
# vsc namespace .pth files from shadowing the bundled vsc package.
postinstallcmds = ["sed -i 's/^${PYTHON}/${PYTHON} -S/' %(installdir)s/bin/*"]

sanity_check_paths = {
    'files': ['bin/%s' % x for x in ['acreate', 'aenv', 'aload', 'alog', 'arange', 'areduce']],
    'dirs': ['lib/vsc/atools']
}

sanity_check_commands = [
    'acreate -h',
    'aenv -h',
    'aload -h',
    'alog -h',
    'arange -h',
    'areduce -h',
]

moduleclass = 'tools'
