# Author: Ehsan Moravveji (VSC - KU Leuven)

easyblock = 'PythonBundle'

name = 'Appmode'
version = '1.2.0'

homepage = 'https://github.com/oschuett/appmode'
description = """
A Jupyter extensions that turns notebooks into web applications.
"""

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}

builddependencies = [
    ('binutils', '2.44'),
]

dependencies = [
    ('Python', '3.13.5'),
    ('jupyter-server', '2.17.0'),
    ('nbclassic', '1.3.3'),
]

exts_list = [
    ('appmode', version, {
        'source_urls': ['https://github.com/oschuett/%(namelower)s'],
        'sources': ['%(name)s-%(version)s.tar.gz'],
        'checksums': ['6d2c690f8ac255e614019ea38a156ee145de815c0359a90606dfdeb53dd9a1b5'],
    }),
]

modextrapaths = {
    'JUPYTER_PATH': 'share/jupyter',
    'JUPYTER_CONFIG_PATH': 'etc/jupyter',
}

moduleclass = 'tools'
