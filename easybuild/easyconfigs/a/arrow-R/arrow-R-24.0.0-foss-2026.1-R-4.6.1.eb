easyblock = 'RPackage'

name = 'arrow-R'
version = '24.0.0'
versionsuffix = '-R-%(rver)s'

homepage = 'https://cran.r-project.org/web/packages/arrow'
description = "R interface to the Apache Arrow C++ library"

toolchain = {'name': 'foss', 'version': '2026.1'}

source_urls = [
    'https://cran.r-project.org/src/contrib/Archive/arrow',  # package archive
    'https://cran.r-project.org/src/contrib/',  # current version of packages
    'https://cran.freestatistics.org/src/contrib',  # mirror alternative for current packages
]
sources = ['arrow_%(version)s.tar.gz']
checksums = ['632ba889554539d684b2f036ba1fa0f1c8c7994fdbcd5b5135e5717ad0d973e7']

builddependencies = [
    ('pkgconf', '2.5.1'),
]

dependencies = [
    ('R', '4.6.1'),
    ('R-bundle-CRAN', '2026.07'),
    ('Arrow', '24.0.0'),  # arrow-R x.y.z[.N] only works with Arrow x.y.z
]

preinstallopts = "export LIBARROW_BUILD=false && "

sanity_check_paths = {
    'files': [],
    'dirs': ['arrow'],
}

options = {'modulename': 'arrow'}

moduleclass = 'tools'
