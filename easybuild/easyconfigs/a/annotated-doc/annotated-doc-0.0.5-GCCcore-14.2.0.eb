easyblock = 'PythonPackage'

name = 'annotated-doc'
version = '0.0.5'

homepage = 'https://github.com/fastapi/annotated-doc'
description = """Document parameters, class attributes, return types, and variables inline,
with Annotated."""

toolchain = {'name': 'GCCcore', 'version': '14.2.0'}

sources = ['annotated_doc-%(version)s.tar.gz']
checksums = ['c7e58ce09192557605d8bbd92836d7e1d520ac9580096042c0bfd197efacf1bb']

builddependencies = [
    ('binutils', '2.42'),
    ('PDM', '2.25.5'),
]

dependencies = [
    ('Python', '3.13.1'),
]

moduleclass = 'lib'
