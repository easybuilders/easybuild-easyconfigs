easyblock = 'PythonBundle'

name = 'PyCO2SYS'
version = '2.0.0b9'
local_commit = 'v2-beta-release'

homepage = 'https://github.com/mvdh7/PyCO2SYS'
description = """PyCO2SYS is a Python implementation of CO2SYS, based on the MATLAB v2.0.5 but also
 including the updates made for MATLAB CO2SYS v3 as well as some additional related calculations.
 PyCO2SYS solves the full marine carbonate system from the values of any two of its parameters."""

toolchain = {'name': 'gfbf', 'version': '2025b'}

builddependencies = [
    ('pytest', '9.1.1'),
    ('matplotlib', '3.10.5'),  # for testing
    ('xarray', '2025.10.0'),  # for testing
    ('pygraphviz', '2.0'),  # for testing
]

dependencies = [
    ('Python', '3.13.5'),
    ('SciPy-bundle', '2025.07'),
    ('networkx', '3.5'),
    ('jax', '0.10.0'),
]

exts_list = [
    (name, version, {
        'sources': [{
            'filename': '%(name)s-%(version)s.tar.xz',
            'git_config': {
                'url': 'https://github.com/mvdh7',
                'repo_name': name,
                'commit': local_commit,
            },
        }],
        'checksums': [None],
        'runtest': 'pytest tests',
        'modulename': name,
    }),
]

moduleclass = 'geo'
