# Author: Jose Munoz (ARCCA, Cardiff University)
easyblock = 'Cargo'

name = 'ProteinView'
version = '0.3.0'

homepage = 'https://github.com/001TMF/ProteinView/'
description = """Terminal protein structure viewer — interactive 3D visualization of
PDB/mmCIF structures with cartoon ribbons, braille rendering, and Sixel/Kitty graphics"""

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}

github_account = 'ProteinView'
source_urls = ['https://github.com/001TMF/ProteinView/archive/refs/tags']
