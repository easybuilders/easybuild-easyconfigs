easyblock = 'PythonBundle'

name = 'phonopy'
version = '4.5.0'

homepage = 'https://phonopy.github.io/phonopy/'
description = """Phonopy is an open source package of phonon calculations based on the supercell approach."""

toolchain = {'name': 'foss', 'version': '2026.1'}

builddependencies = [
    ('scikit-build-core', '0.12.2'),
    ('nanobind', '2.13.0'),
    ('maturin', '1.13.1'),
]

dependencies = [
    ('Python', '3.14.2'),
    ('Python-bundle-PyPI', '2026.04'),
    ('SciPy-bundle', '2026.05'),
    ('matplotlib', '3.10.9'),
    ('PyYAML', '6.0.3'),
    ('h5py', '3.16.0'),
    ('spglib-python', '2.7.0'),
]

exts_list = [
    ('symfc', '1.7.3', {
        'checksums': ['b0072d16439e424186c698fd28eed05f962f8716b6d5daeafb0ee14f06571f51'],
    }),
    ('phonors', '0.3.0', {
        'checksums': ['10d8111c1ce509235b9154b861a193a21559d6da0b0363ef9e41ffa9746f3599'],
    }),
    (name, version, {
        'runtest': "pytest -vvvs test",
        'testinstall': True,
        'checksums': ['22be8655ae9604169039a4f26fcee3d4f190d40bb9405dec7bae711ed5d90176'],
    }),
]

sanity_check_paths = {
    'files': ['bin/phonopy'],
    'dirs': ['lib/python%(pyshortver)s/site-packages'],
}

sanity_check_commands = ["phonopy --help"]

moduleclass = 'lib'
