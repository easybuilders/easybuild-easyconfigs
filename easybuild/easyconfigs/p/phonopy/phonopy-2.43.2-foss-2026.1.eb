easyblock = 'PythonBundle'

name = 'phonopy'
version = '4.5.0'

homepage = 'https://phonopy.github.io/phonopy/'
description = """Phonopy is an open source package of phonon calculations based on the supercell approach."""

toolchain = {'name': 'foss', 'version': '2026.1'}

builddependencies = [
    ('scikit-build-core', '0.12.2'),
    ('nanobind', '2.13.0'),
    ('maturin', '1.13.1'),
]

dependencies = [
    ('Python', '3.14.2'),
    ('Python-bundle-PyPI', '2026.04'),
    ('SciPy-bundle', '2026.05'),
    ('matplotlib', '3.10.9'),
    ('PyYAML', '6.0.3'),
    ('h5py', '3.16.0'),
    ('spglib-python', '2.7.0'),
]

exts_list = [
    ('symfc', '1.7.3', {
        # 'checksums': ['7877ba2e7bfaf54d1da0184b45714e873f5e61297270478d49c28c6b0ae063a1'],
    }),
    ('phonors', '0.3.0', {
        # 'checksums': ['7877ba2e7bfaf54d1da0184b45714e873f5e61297270478d49c28c6b0ae063a1'],
    }),
    (name, version, {
        'runtest': "pytest -vvvs test",
        'testinstall': True,
        # 'checksums': ['91da896808838be0cd0c02f82543ca2f6627816cfdae224843dd59ff65ca58dd'],
    }),
]

sanity_check_paths = {
    'files': ['bin/phonopy'],
    'dirs': ['lib/python%(pyshortver)s/site-packages'],
}

sanity_check_commands = ["phonopy --help"]

moduleclass = 'lib'
