easyblock = 'PythonBundle'

name = 'python-casacore'
version = '3.8.1'

homepage = 'https://casacore.github.io/python-casacore/#'
description = """Python-casacore is a set of Python bindings for casacore,
a c++ library used in radio astronomy. Python-casacore replaces the old pyrap."""

toolchain = {'name': 'foss', 'version': '2026.1'}

builddependencies = [
    ('CMake', '3.31.11'),
    ('Ninja', '1.13.2'),
    ('scikit-build-core', '0.12.2'),
]
dependencies = [
    ('Python', '3.14.2'),
    ('casacore', '3.8.1'),
    ('Boost.Python', '1.90.0'),
    ('SciPy-bundle', '2026.05'),
    ('CFITSIO', '4.6.4'),
]

exts_list = [
    (name, version, {
        # the sdist on PyPI is named python_casacore (underscore)
        'source_tmpl': 'python_casacore-%(version)s.tar.gz',
        'checksums': ['757763cbf5bcb8e98b6809308de107bcb9b41982779b17f163ef20ca0ec18322'],
        'modulename': 'casacore',
    }),
]

sanity_check_commands = [('python', "-s -c 'import casacore'")]

moduleclass = 'astro'
