    ('Python', '3.13.1'),
    ('CD-HIT', '4.8.1'),
    ('PRANK', '251117'),
    ('Biopython', '1.85'),
    ('SciPy-bundle', '2025.06'),
    ('networkx', '3.5'),
    ('edlib', '1.3.9.post1'),
    ('tqdm', '4.67.1'),
    ('matplotlib', '3.10.3'),
    ('scikit-learn', '1.7.0'),
    ('plotly.py', '6.3.1'),
    ('DendroPy', '5.0.8'),
    ('pyfaidx', '0.9.0.3'),
    ('prokka', '1.15.6'),
    ('python-igraph', '0.11.9'),
]


