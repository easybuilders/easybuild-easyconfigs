    ('biocode', '0.11.0', {'preinstallopts': 'sed -i "s/python-igraph/igraph/" setup.py &&', 'checksums': ['5c0df506d07e6b073b56da360bba4dad8e0b90e4ceb6f62009ae51c56a83b162']}),
