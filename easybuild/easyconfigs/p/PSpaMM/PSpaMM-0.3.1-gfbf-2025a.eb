easyblock = 'PythonPackage'

name = 'PSpaMM'
version = '0.3.1'

homepage = 'https://github.com/SeisSol/PSpaMM'
description = "Code generator for sparse matrix multiplications used by SeisSol."

toolchain = {'name': 'gfbf', 'version': '2025a'}

github_account = 'SeisSol'
source_urls = ['https://github.com/%(github_account)s/%(name)s/archive/refs/tags/']
sources = ['v%(version)s.tar.gz']
checksums = ['7d677e1a81897f42daeb9d89cdc596f7ab97b5b829dc4afd4e86804bbaf2af6c']

dependencies = [
    ('Python', '3.13.1'),
    ('SciPy-bundle', '2025.06'),
]

# Import path is pypspamm, not the EasyBuild default pspamm.
options = {'modulename': 'pypspamm'}

sanity_check_paths = {
    'files': ['bin/pspamm-generator'],
    'dirs': ['lib/python%(pyshortver)s/site-packages'],
}

sanity_check_commands = ['pspamm-generator --help']

moduleclass = 'tools'
