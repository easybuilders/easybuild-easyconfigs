# Barcelona Supercomputing Center 2025

easyblock = 'PythonPackage'

name = 'pyinterp'
version = '2024.6.0'

homepage = 'https://cnes.github.io/pangeo-pyinterp'
description = """Python library for optimized geo-referenced interpolation."""

toolchain = {'name': 'gfbf', 'version': '2023b'}

sources = [SOURCE_TAR_GZ]
checksums = ['aa6e0c309a74b8f5494b611618e0c8a377991e57c382e119af2d1c17bd293ace']

builddependencies = [
    ('binutils', '2.40'),
    ('CMake', '3.27.6'),
    ('Boost', '1.83.0'),
    # Eigen is used only for the headers so included as a builddep
    ('Eigen', '3.4.0'),
    ('pybind11', '2.11.1'),
]

dependencies = [
    ('Python', '3.11.5'),
    ('SciPy-bundle', '2023.11'),
    ('xarray', '2024.5.0'),
    ('dask', '2024.5.1'),
]

# To control memory consumption
maxparallel = 2

moduleclass = 'geo'
