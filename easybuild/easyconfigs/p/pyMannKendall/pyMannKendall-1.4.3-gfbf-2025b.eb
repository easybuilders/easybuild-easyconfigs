easyblock = 'PythonBundle'

name = 'pyMannKendall'
version = '1.4.3'

homepage = 'https://github.com/mmhs013/pymannkendall'
description = "A python package for non parametric Mann Kendall family of trend tests."

toolchain = {'name': 'gfbf', 'version': '2025b'}

dependencies = [
    ('Python', '3.13.5'),
    ('SciPy-bundle', '2025.07'),
]

exts_list = [
    ('pymannkendall', version, {
        'checksums': ['f9e3bbbb583b5285d15082aa0007825e5bea4dde9858d2e7ca81ee6f1e378e82'],
        # Fix for Python 3.12+
        'preinstallopts': r"sed -i -e 's/configparser\.SafeConfigParser()/configparser.ConfigParser()/' "
                          r"-e 's/\.readfp(/.read_file(/' versioneer.py && ",
    }),
]

moduleclass = 'math'
