easyblock = 'PythonBundle'

name = 'pyzstd'
version = '0.19.1'

homepage = 'https://github.com/Rogdham/pyzstd'
description = """Pyzstd module provides classes and functions for compressing and decompressing data,
using Facebook's Zstandard (or zstd as short name) algorithm.

The API style is similar to Python's bz2/lzma/zlib modules."""

toolchain = {'name': 'GCCcore', 'version': '15.2.0'}

builddependencies = [
    ('binutils', '2.45'),
    ('hatchling', '1.29.0'),
]
dependencies = [
    ('Python', '3.14.2'),
    ('zstd', '1.5.7'),
]

exts_list = [
    (name, version, {
        'installopts': '--config-settings="--build-option=--dynamic-link-zstd"',
        'checksums': ['36723d3c915b3981de9198d0a2c82b2f5fe3eaa36e4d8d586937830a8afc7d72'],
    }),
]

moduleclass = 'tools'
