easyblock = 'CMakeMake'

name = 'ParaView-Catalyst'
version = '2.1.0'

homepage = 'https://docs.paraview.org/en/latest/Catalyst/'
description = """ParaView Catalyst provides a small, easy-to-use, API that any simulation developed in C++, C, Fortran
or Python can use to do in situ analysis without developing its own custom data analysis code.
"""

toolchain = {'name': 'foss', 'version': '2026.1'}
toolchainopts = {'pic': True, 'usempi': True}

source_urls = ['https://gitlab.kitware.com/api/v4/projects/5912/packages/generic/catalyst/v%(version)s']
sources = ["catalyst-v%(version)s.tar.gz"]
checksums = ['1db07593c2f0203f53dfa39445d6f9d7a7fff78e0ce024b17af66ca7bce78abc']

builddependencies = [('CMake', '4.2.1')]
dependencies = [
    ('Python', '3.14.2'),
    ('SciPy-bundle', '2026.05'),
]

_copts = [
    '-DCATALYST_USE_MPI=ON',
    '-DCATALYST_WRAP_PYTHON=ON',
    '-DCATALYST_WRAP_FORTRAN=ON',
]

configopts = ' '.join(_copts)

sanity_check_paths = {
    'files': ['include/catalyst-%(version_major_minor)s/catalyst.hpp'],
    'dirs': ['include/catalyst-%(version_major_minor)s', 'lib/python%(pyshortver)s/site-packages', 'lib/catalyst'],
}

sanity_check_commands = ['python -s -c "import catalyst"']

moduleclass = 'vis'
