easyblock = 'PythonBundle'

name = 'PyTorch-bundle'
version = '2.9.1'
versionsuffix = '-CUDA-%(cudaver)s'

homepage = 'https://pytorch.org/'
description = """PyTorch with compatible versions of official Torch extensions."""

toolchain = {'name': 'foss', 'version': '2025b'}

builddependencies = [
    ('CMake', '3.31.8'),
    ('git', '2.50.1'),
    ('RE2', '2025-07-22'),  # for torchtext
    ('NLTK', '3.10.4'),  # for torchtext tests
    ('parameterized', '0.9.0'),  # for torchtext tests
    ('hatchling', '1.27.0'),  # for pytorch-ignite
