    ('scikit-learn', '1.7.1'),  # for pytorch-ignite tests
    ('scikit-image', '0.25.0'),  # for pytorch-ignite tests
    ('visdom', '0.3.0'),  # for pytorch-ignite tests
    ('Java', '17', '', SYSTEM),  # needed by ANTLR runtime
]

dependencies = [
    ('CUDA', '12.9.1', '', SYSTEM),
    ('PyTorch', version, '%(versionsuffix)s'),
    ('double-conversion', '3.3.1'),  # for torchtext
    ('SentencePiece', '0.2.1'),  # for torchtext
    ('tqdm', '4.67.1'),  # for torchtext
    ('utf8proc', '2.10.0'),  # for torchtext
    ('tensorboard', '2.20.0'),  # for torch-tb-profiler
    ('orjson', '3.11.4'),  # for torchrl
    ('lxml', '6.0.0'),  # for torchtune
    ('HF-Datasets', '5.0.1'),  # for torchtune
    ('Safetensors', '0.8.0'),  # for torchtune
    ('tiktoken', '0.12.0'),  # for torchtune
    ('tokenizers', '0.22.2'),  # for torchtune
]

