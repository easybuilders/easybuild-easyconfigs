easyblock = 'PythonBundle'

name = 'pytest-asyncio'
version = '0.16.0'

homepage = 'https://github.com/pytest-dev/pytest-asyncio'
description = """pytest-asyncio is a pytest plugin.
It facilitates testing of code that uses the asyncio library."""

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}

dependencies = [
    ('Python', '3.13.5'),
    ('Python-bundle-PyPI', '2025.07'),
]

exts_list = [
    (name, version, {
        'checksums': ['7496c5977ce88c34379df64a66459fe395cd05543f0a2f837016e7144391fcfb'],
    }),
]

moduleclass = 'tools'
