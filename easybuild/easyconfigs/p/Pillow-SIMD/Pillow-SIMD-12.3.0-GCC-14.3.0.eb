easyblock = 'PythonBundle'

name = 'Pillow-SIMD'
version = '12.3.0'

homepage = 'https://github.com/uploadcare/pillow-simd'
description = """Pillow is the 'friendly PIL fork' by Alex Clark and Contributors.
 PIL is the Python Imaging Library by Fredrik Lundh and Contributors."""

toolchain = {'name': 'GCC', 'version': '14.3.0'}

builddependencies = [
    ('binutils', '2.44'),
    ('pybind11', '3.0.0'),
]

dependencies = [
    ('Python', '3.13.5'),
    ('libjpeg-turbo', '3.1.1'),
    ('libpng', '1.6.50'),
    ('zlib', '1.3.1'),
    ('LibTIFF', '4.7.0'),
    ('freetype', '2.13.3'),
    ('libwebp', '1.5.0'),
    ('OpenJPEG', '2.5.3'),
    ('LittleCMS', '2.17'),
]

exts_list = [
    ('pillow', version, {
        'source_urls': ['https://github.com/uploadcare/pillow-simd/archive/'],
        'sources': ['%(version)s.tar.gz'],
        'checksums': ['9dd8253265dca7c8ed2984ef8bd65b7e618d3c471f1f8cebd9152b248a25a380'],
        'modulename': 'PIL',
    }),
]

moduleclass = 'vis'
