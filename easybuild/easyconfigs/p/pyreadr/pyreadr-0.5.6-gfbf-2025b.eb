easyblock = "PythonBundle"

name = 'pyreadr'
version = '0.5.6'

homepage = 'https://github.com/ofajardo/pyreadr'
description = """Python package to read and write R RData and Rds files into/from pandas
 dataframes. No R or other external dependencies required."""

toolchain = {'name': 'gfbf', 'version': '2025b'}

builddependencies = [
    ('Cython', '3.1.2'),
]

dependencies = [
    ('Python', '3.13.5'),
    ('SciPy-bundle', '2025.07'),
]

exts_list = [
    (name, version, {
        'checksums': ['ec10bef1798a4d9e91ff75ab69fbcd009a3fad2250c79f5377e19e787c949b8f'],
    }),
]

moduleclass = 'data'
