easyblock = "PythonBundle"

name = 'pyreadr'
version = '0.5.2'

homepage = 'https://github.com/ofajardo/pyreadr'
description = """Python package to read and write R RData and Rds files into/from pandas
 dataframes. No R or other external dependencies required."""

toolchain = {'name': 'gfbf', 'version': '2023b'}

builddependencies = [
    ('Cython', '3.0.10'),
]

dependencies = [
    ('Python', '3.11.5'),
    ('SciPy-bundle', '2023.11'),
]

exts_list = [
    (name, version, {
        'checksums': ['33d5747fe210d41e4a329afef2232c9d1258847094b87a2a96efffbef223fae8'],
    }),
]

moduleclass = 'data'
