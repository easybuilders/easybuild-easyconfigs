easyblock = 'PythonPackage'

name = 'propka'
version = '3.5.1'

homepage = 'https://github.com/jensengroup/propka'
description = "PROPKA predicts pKa values of ionizable groups in proteins and protein-ligand complexes."

toolchain = {'name': 'GCCcore', 'version': '14.2.0'}

sources = [SOURCE_TAR_GZ]
checksums = ['d8083b58d8c4c553ff8704c706190fe37ff82253adcd6e53b31d8ad7d6d52257']

builddependencies = [
    ('binutils', '2.42'),
]

dependencies = [
    ('Python', '3.13.1'),
]

sanity_check_commands = [
    'propka3 --help',
]

moduleclass = 'bio'
