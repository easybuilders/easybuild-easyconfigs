easyblock = 'PythonBundle'

name = 'plotly.py'
version = '7.0.0'

homepage = 'https://plot.ly/python'
description = "An open-source, interactive graphing library for Python"

toolchain = {'name': 'GCCcore', 'version': '15.2.0'}

builddependencies = [
    ('binutils', '2.45'),
    ('hatchling', '1.29.0'),
    ('uv-build', '0.11.28'),
]
dependencies = [
    ('Python', '3.14.2'),
]

exts_list = [
    ('tenacity', '9.1.4', {
        'patches': ['tenacity-9.0.0_fix_version.patch'],
        'preinstallopts': """sed -i "s/'EB_TENACITY_VERSION'/%(version)s/" setup.cfg && """,
        'checksums': [
            {'tenacity-9.1.4.tar.gz': 'adb31d4c263f2bd041081ab33b498309a57c77f9acf2db65aadf0898179cf93a'},
            {'tenacity-9.0.0_fix_version.patch': '71a533470f03aab802439bda078494ab98804439afdb16f8287337bd3e0c8a82'},
        ],
    }),
    ('narwhals', '2.26.0', {
        'checksums': ['6b9cadca82f375c7e4cf584fdc86ca25da54827307a9c58f94547ee6104b82dd'],
    }),
    ('plotly', version, {
        'checksums': ['08b21f1244a97e7a1a699833c4bb2678475aa108b3f1989886ed0b038ebfd849'],
    }),
]

moduleclass = 'vis'
