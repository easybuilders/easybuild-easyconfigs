easyblock = 'PythonBundle'

name = 'plumpy'
version = '0.26.1'

homepage = 'https://github.com/aiidateam/plumpy'
description = """Bundle of Python packages required to run plumpy:
A python workflows library that supports writing Processes with a well defined set of
inputs and outputs that can be strung together."""

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}
toolchainopts = {'pic': True}

builddependencies = [
    ('binutils', '2.44'),
    ('poetry', '2.1.3'),  # Poetry
    ('uv-build', '0.10.9'),
    ('pytest-cov', '7.1.0'),
    ('pytest-asyncio', '0.16.0'),
]
dependencies = [
    ('Python', '3.13.5'),
    ('Python-bundle-PyPI', '2025.07'),
    ('PyYAML', '6.0.2'),
    ('Greenlet', '3.2.3'),
    ('aiohttp', '3.12.15'),  # multidict, yarl
]

