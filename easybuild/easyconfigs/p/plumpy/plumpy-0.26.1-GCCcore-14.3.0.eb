    (name, version, {
        # Download from github to also have the tests
        'source_urls': ['https://github.com/aiidateam/plumpy/archive/refs/tags'],
        'sources': [{'filename': '%(name)s-%(version)s.tar.gz', 'download_filename': 'v%(version)s.tar.gz'}],
