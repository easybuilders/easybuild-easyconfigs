easyblock = "PythonPackage"

name = 'PyAMG'
version = '5.4.1'

homepage = 'https://pyamg.readthedocs.io/'
description = """PyAMG is a library of Algebraic Multigrid (AMG) solvers with a convenient Python interface."""

toolchain = {'name': 'gfbf', 'version': '2025b'}

sources = [SOURCELOWER_TAR_GZ]
checksums = ['b5829ce39687655ce68db4415c93ee171056bb4e41e7b798ef4e6e9f9f93beae']

builddependencies = [
    ('meson-python', '0.18.0'),
    ('versioningit', '3.3.0'),
]

dependencies = [
    ('Python', '3.13.5'),
    ('SciPy-bundle', '2025.07'),
    ('pybind11', '3.0.0'),
]

options = {'modulename': 'pyamg'}

moduleclass = 'math'
