easyblock = 'Tarball'

name = 'pplacer'
version = '1.1.alpha23'

homepage = 'http://matsen.fhcrc.org/pplacer/'
description = """Pplacer places query sequences on a fixed reference phylogenetic tree to maximize phylogenetic
 likelihood or posterior probability according to a reference alignment. Pplacer is designed to be fast, to give
 useful information about uncertainty, and to offer advanced visualization and downstream analysis."""

toolchain = SYSTEM

# compiling pplacer from source requires an ancient OCaml version,
# which is a huge PITA with recent compilers
# cfr. http://matsen.github.io/pplacer/compiling.html
# so we use the recommended pre-built binaries instead...
source_urls = ['https://github.com/matsen/pplacer/releases/download/v%(version)s/']
sources = {'download_filename': f'pplacer-linux-{ARCH}.zip', 'filename': f'pplacer-linux-{ARCH}-%(version)s.zip'}
checksums = [{
    'pplacer-linux-x86_64-%(version)s.zip': '5d953adbedbbdfe6c65daff669daa3805feafdb8ef30ca8dfce1e68de3893f59',
    'pplacer-linux-arm64-%(version)s.zip': 'ea6b6acaab2610af612f491e9ba2b6e2c06e3f374082571724f3037b5d5ae31e',
}]

postinstallcmds = [
    'cd %(installdir)s; ln -s guppy.exe guppy',
    'cd %(installdir)s; ln -s pplacer.exe pplacer',
    'cd %(installdir)s; ln -s rppr.exe rppr',
]

sanity_check_paths = {
    'files': ['guppy', 'pplacer', 'rppr'],
    'dirs': ['scripts'],
}

sanity_check_commands = [
    "pplacer --version | grep %(version)s",
    "pplacer --help",
]

modextrapaths = {'PATH': ['', 'scripts']}

moduleclass = 'bio'
