easyblock = 'PythonPackage'

name = 'pkgconfig'
version = '1.6.0'
# The -python versionsuffix is used to avoid confusion between
# pkg-config (the tool) and pkgconfig (the Python wrappers)
versionsuffix = '-python'

homepage = 'https://github.com/matze/pkgconfig'
description = """pkgconfig is a Python module to interface with the pkg-config command line tool"""

toolchain = {'name': 'GCCcore', 'version': '15.2.0'}

sources = [SOURCE_TAR_GZ]
checksums = ['4a5a6631ce937fafac457104a40d558785a658bbdca5c49b6295bc3fd651907f']

builddependencies = [
    ('binutils', '2.45'),
    ('poetry', '2.3.4'),
]

dependencies = [
    ('Python', '3.14.2'),
    ('pkgconf', '2.5.1'),
]

moduleclass = 'devel'
