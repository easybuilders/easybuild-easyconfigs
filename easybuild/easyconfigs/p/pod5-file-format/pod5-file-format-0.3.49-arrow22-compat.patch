# Author: Ehsan Moravveji (VSC - KU Leuven)
# Purpose: Arrow 17.x exports DCHECK_EQ macro, but arrow 22.x
#          exports ARROW_DCHECK_EQ instead, which is a breaking change.
# Disclaimer: Using Claude Haiku 4.5

diff -ruN pod5-file-format-0.3.49-orig/c++/pod5_format/types.cpp pod5-file-format-0.3.49/c++/pod5_format/types.cpp
--- pod5-file-format-0.3.49-orig/c++/pod5_format/types.cpp      2026-11-09 21:07:49.000000000 +0100
+++ pod5-file-format-0.3.49/c++/pod5_format/types.cpp   2026-11-09 21:11:13.000000000 +0100
@@ -1,5 +1,13 @@
 #include "pod5_format/types.h"

+// Arrow 22.0.0+ uses ARROW_DCHECK_* instead of DCHECK_*
+#ifndef DCHECK_EQ
+#define DCHECK_EQ ARROW_DCHECK_EQ
+#define DCHECK_NE ARROW_DCHECK_NE
+#define DCHECK_LT ARROW_DCHECK_LT
+#define DCHECK_LE ARROW_DCHECK_LE
+#endif
+
 #include <arrow/array/array_binary.h>
 #include <arrow/array/builder_binary.h>
 #include <arrow/util/logging.h>
