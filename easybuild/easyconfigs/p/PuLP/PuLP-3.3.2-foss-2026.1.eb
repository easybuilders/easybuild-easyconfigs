easyblock = 'PythonPackage'

name = 'PuLP'
version = '3.3.2'

homepage = 'https://github.com/coin-or/pulp'
description = """
PuLP is an LP modeler written in Python. PuLP can generate MPS or LP files and
call GLPK, COIN-OR CLP/CBC, CPLEX, GUROBI, MOSEK, XPRESS, CHOCO, MIPCL, SCIP to
solve linear problems.
"""

toolchain = {'name': 'foss', 'version': '2026.1'}

sources = [SOURCELOWER_TAR_GZ]
checksums = ['d0904700c207ac11e25e3b1213b70eae1d6fb25faa719d75f3f15054901258c0']

dependencies = [
    ('Python', '3.14.2'),
    ('GLPK', '5.0'),
    ('Cbc', '2.10.13'),
    # Gurobi requires a seperate license
    # ('Gurobi', '9.5.0'),
]

moduleclass = 'tools'
