easyblock = 'PythonBundle'

name = 'python-xxhash'
version = '4.0.1'

homepage = 'https://github.com/ifduyue/python-xxhash'
description = 'xxhash is a Python binding for the xxHash library by Yann Collet.'

toolchain = {'name': 'GCCcore', 'version': '15.2.0'}

builddependencies = [
    ('binutils', '2.45'),
]

dependencies = [
    ('Python', '3.14.2'),
    ('xxHash', '0.8.3'),
]

exts_list = [
    ('xxhash', version, {
        'preinstallopts': 'XXHASH_LINK_SO=1',
        'checksums': ['d55bf4ef10eb09b8b6866790e083d26d087d84caa3cc0946ba87c3ca7ecaf7b7'],
    }),
]

moduleclass = 'lib'
