easyblock = 'PythonPackage'

name = 'petsc4py'
version = '3.25.0'

homepage = 'https://gitlab.com/petsc/petsc'
description = "petsc4py are Python bindings for PETSc, the Portable, Extensible Toolchain for Scientific Computation."

toolchain = {'name': 'foss', 'version': '2026.1'}

sources = [SOURCE_TAR_GZ]
checksums = ['8eafd133adbb22a6b7cd963f5eb03f86d959b832c7e5843704caba29b79c5659']

builddependencies = [
    ('Cython', '3.2.4'),
]

dependencies = [
    ('Python', '3.14.2'),
    ('SciPy-bundle', '2026.05'),
    ('PETSc', version),
]

sanity_check_commands = ["mpirun -N 1 python -s -c 'from petsc4py import PETSc'"]

moduleclass = 'tools'
