easyblock = 'PythonBundle'

name = 'pyannote.audio'
version = '4.0.7'
versionsuffix = '-CUDA-%(cudaver)s'
local_pytorch_version = '2.9.1'

homepage = 'https://github.com/pyannote'
description = "pyannote is an open-source toolkit for speaker diarization."

