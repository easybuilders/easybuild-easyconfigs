# Author: Stamen Miroslavov <stamen.miroslavov@bsc.es>
# Barcelona Supercomputing Center 2026

easyblock = 'PythonBundle'

name = 'pyhanami'
version = '0.2.0'

homepage = 'https://github.com/BSC-ES/pyhanami'
description = """Pyhanami: A Python tool for evaluating the replicability and scientific skill of
 Earth System Models (ESMs) through statistical testing and climate diagnostics."""

toolchain = {'name': 'foss', 'version': '2025b'}

dependencies = [
    ('Python', '3.13.5'),
    ('Python-bundle-PyPI', '2025.07'),
    ('SciPy-bundle', '2025.07'),
    ('matplotlib', '3.10.5'),
    ('xarray', '2025.10.0'),
    ('Pint', '0.25'),
    ('PyYAML', '6.0.2'),
    ('BeautifulSoup', '4.14.2'),
    ('Cartopy', '0.25.0'),
    ('cmocean', '4.0.3'),
    ('tqdm', '4.67.1'),
    ('cftime', '1.6.4.post1'),
    ('netcdf4-python', '1.7.2'),
    ('xeofs', '3.0.4'),
    ('xESMF', '0.9.2'),
]

exts_list = [
    (name, version, {
        'source_urls': ['https://github.com/BSC-ES/pyhanami/archive/refs/tags'],
        'source_tmpl': 'v%(version)s.tar.gz',
        'checksums': ['79596d3d727da43afe6369c80022b2af827d85087ad677bba5a2e560e0947618'],
        # Relax dependency restrictions:
        'preinstallopts': 'sed -i "s/,<2025.3.0//;s/,<0.9.0//" pyproject.toml && '
        # Fix a known netCDF4/xarray issue (https://github.com/pydata/xarray/issues/7259):
                          'sed -i "1i import netCDF4" src/pyhanami/__init__.py && ',
    }),
]

sanity_check_commands = ["python -s -c 'import pyhanami'"]

moduleclass = 'geo'
