easyblock = 'PythonBundle'

name = 'PySquashfsImage'
version = '0.9.0'

homepage = 'https://github.com/matteomattei/PySquashfsImage'
description = 'Python library to read Squashfs image files.'

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}

dependencies = [
    ('Python', '3.13.5'),
    ('lz4', '1.10.0'),
    ('LZO', '2.10'),
    ('pyzstd', '0.19.0'),
]

exts_list = [
    ('python-lzo', '1.15', {
        'modulename': 'lzo',
        'preinstallopts': "export PREFIX=$EBROOTLZO && ",
        'checksums': ['a57aaa00c5c3a0515dd9f7426ba2cf601767dc19dc023d8b99d4a13b0a327b49'],
    }),
    ('lz4', '4.4.4', {
        'checksums': ['070fd0627ec4393011251a094e08ed9fdcc78cb4e7ab28f507638eee4e39abda'],
    }),
    (name, version, {
        'modulename': name,
        'checksums': ['d3330ccd111ac2ef2cebf0c392077fe8608e2760862531d960ec9cb6c6d3655f'],
    }),
]

moduleclass = 'lib'
