easyblock = 'RPackage'

name = 'presto'
local_commit = 'b5df6ee6097eb62522f2e557aa93ac21bab2d05f'
# see DESCRIPTION to determine version,
# but also take date of last commit into account (since version isn't always bumped)
version = '1.1.0-20260920'
versionsuffix = '-R-%(rver)s'

homepage = 'https://github.com/immunogenomics/presto'
description = "Presto performs a fast Wilcoxon rank sum test and auROC analysis."

toolchain = {'name': 'foss', 'version': '2026.1'}

source_urls = ['https://github.com/immunogenomics/presto/archive/']
sources = [{'download_filename': '%s.tar.gz' % local_commit, 'filename': SOURCE_TAR_GZ}]
checksums = ['1b686ae74b66578a4b5939c3400c1ef8e10826c52a8485db5ce4ccfa0ae651d1']

dependencies = [
    ('R', '4.6.1'),
    ('R-bundle-Bioconductor', '3.23', versionsuffix),
]

sanity_check_paths = {
    'files': [],
    'dirs': [name],
}

moduleclass = 'math'
