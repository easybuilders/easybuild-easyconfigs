easyblock = 'PythonBundle'

name = 'PCAngsd'
version = '1.36.4'

homepage = "https://www.popgen.dk/software/index.php/PCAngsd"
description = "Framework for analyzing low depth NGS data in heterogeneous populations using PCA."

toolchain = {'name': 'gfbf', 'version': '2026.1'}

dependencies = [
    ('Python', '3.14.2'),
    ('SciPy-bundle', '2026.05'),
    ('Cython', '3.2.9'),
]

exts_list = [
    (name, version, {
        'modulename': False,
        'source_urls': ['https://github.com/Rosemeis/pcangsd/archive/refs/tags/'],
        'sources': [V_VERSION_TAR_GZ],
        'checksums': ['25df22d2816cd651f0cb297e7adcf57a206098daac29499b8e8fdb036ba4713f'],
    }),
]

sanity_check_commands = [
    'pcangsd --help',
]

moduleclass = 'bio'
