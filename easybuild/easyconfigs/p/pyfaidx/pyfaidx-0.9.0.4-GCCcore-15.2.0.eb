easyblock = 'PythonPackage'

name = 'pyfaidx'
version = '0.9.0.4'

homepage = 'https://pypi.python.org/pypi/pyfaidx'
description = "pyfaidx: efficient pythonic random access to fasta subsequences"

toolchain = {'name': 'GCCcore', 'version': '15.2.0'}

sources = [SOURCE_TAR_GZ]
checksums = ['801bdd208b12bff6f4fb2da10a16834158dbb1c6f146e4015c9ff45e509acd65']

builddependencies = [('binutils', '2.45')]

dependencies = [
    ('Python', '3.14.2'),
    ('Python-bundle-PyPI', '2026.04'),
]

sanity_check_paths = {
    'files': ['bin/faidx'],
    'dirs': ['lib/python%(pyshortver)s/site-packages'],
}

sanity_check_commands = ["faidx --help"]

moduleclass = 'bio'
