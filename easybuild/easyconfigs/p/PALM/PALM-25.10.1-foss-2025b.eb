easyblock = 'Binary'

name = 'PALM'
version = '25.10.1'

homepage = 'https://palm.muk.uni-hannover.de'
description = """PALM is an advanced and state-of-the-art meteorological
modeling system for atmospheric and oceanic boundary layer flows."""

toolchain = {'name': 'foss', 'version': '2025b'}

source_urls = ['https://gitlab.palm-model.org/releases/palm_model_system/-/archive/v%(version)s']
sources = ['palm_model_system-v%(version)s.tar.gz']
checksums = ['645338911c86c9f9f31ef389b8b1f25c0e3b77efdb2bae8297c95e551837f608']

builddependencies = [
    ('CMake', '3.31.8'),
    ('Bison', '3.8.2'),
    ('flex', '2.6.4'),
    ('hatchling', '1.27.0'),
    ('poetry', '2.1.3'),
]

# required Python packages: see various requirements.txt files in source directory
dependencies = [
    ('Python', '3.13.5'),
    ('Python-bundle-PyPI', '2025.07'),
    ('SciPy-bundle', '2025.07'),  # for numpy, scipy, pandas
    ('PyQt5', '5.15.11'),
    ('PyYAML', '6.0.2'),
    ('Pint', '0.25'),
    ('matplotlib', '3.10.5'),
    ('tqdm', '4.67.1'),
    ('f90nml', '1.5'),
    ('pyproj', '3.7.1'),
    ('pydantic', '2.11.9'),
    ('pyzstd', '0.19.0'),
    ('rasterio', '1.5.0'),
    ('geopandas', '1.1.3'),
    ('cfgrib', '0.9.15.1'),  # for 'aladin'
    ('MetPy', '1.7.1'),  # for 'vinterp_metpy' and 'geostrophic_wind'
    ('netCDF', '4.9.3'),
    ('netCDF-Fortran', '4.6.2'),
    ('netcdf4-python', '1.7.2'),
    ('Markdown', '3.8.2'),
    ('NCL', '6.6.2'),  # optional
]

buildininstalldir = True

extract_sources = True

install_cmd = "bash install -p %(installdir)s"

exts_defaultclass = 'PythonPackage'

exts_default_options = {
    'source_urls': [PYPI_SOURCE],
}

