easyblock = 'PythonBundle'

name = 'PyAV'
version = '14.4.0'

homepage = 'https://pyav.org'
description = """PyAV is a Pythonic binding for FFmpeg. We aim to provide all of the power and
control of the underlying library, but manage the gritty details as much as possible."""

toolchain = {'name': 'GCCcore', 'version': '13.3.0'}

builddependencies = [
    ('binutils', '2.42'),
]

dependencies = [
    ('Python', '3.12.3'),
    ('Cython', '3.2.4'),
    ('FFmpeg', '7.0.2'),
]

exts_list = [
    ('av', version, {
        'installopts': "--no-binary av",
        'preinstallopts': "sed -i '/^license/d' pyproject.toml && ",
        'checksums': ['3ecbf803a7fdf67229c0edada0830d6bfaea4d10bfb24f0c3f4e607cd1064b42'],
    }),
]

moduleclass = 'vis'
