easyblock = 'PythonPackage'

name = 'pymatgen-analysis-diffusion'
version = '2025.11.15'

homepage = 'https://github.com/materialsvirtuallab/pymatgen-analysis-diffusion'
description = """Pymatgen add-on for diffusion analysis."""

toolchain = {'name': 'foss', 'version': '2025a'}

sources = ['pymatgen_analysis_diffusion-%(version)s.tar.gz']
checksums = ['3bfaf42ddedf8af23277d1b09bbb916bf71d5f8631c49878e2a9ff3124300a09']

builddependencies = [
    ('binutils', '2.42'),
    ('setuptools', '80.9.0'),
]

dependencies = [
    ('Python', '3.13.1'),
    ('SciPy-bundle', '2025.06'),
    ('pymatgen', '2025.10.7'),
    ('ASE', '3.26.0'),
    ('Seaborn', '0.13.2'),
]

options = {'modulename': 'pymatgen.analysis.diffusion'}

moduleclass = 'chem'
