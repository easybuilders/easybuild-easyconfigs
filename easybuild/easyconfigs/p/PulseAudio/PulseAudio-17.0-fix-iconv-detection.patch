Probe iconv_open with the header used by the build. GNU libiconv's header
can map iconv_open to libiconv_open, which requires linking libiconv even
when libc provides its own iconv_open.

Author: Emik Lin (HKUMed CPOS)

--- a/meson.build
+++ b/meson.build
@@ -476,5 +476,5 @@
 have_iconv = false
-if cc.has_function('iconv_open')
+if cc.has_function('iconv_open', prefix : '#include <iconv.h>')
   iconv_dep = dependency('', required : false)
   have_iconv = true
   # tell the libiconv header to pretend to be libc iconv
