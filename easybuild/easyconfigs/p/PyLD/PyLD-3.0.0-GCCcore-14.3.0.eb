easyblock = 'PythonBundle'

name = 'PyLD'
version = '3.0.0'

homepage = 'https://digitalbazaar.github.io/pyld'
description = """PyLD is a Python implementation of the JSON-LD processor API."""

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}

builddependencies = [
    ('binutils', '2.44'),
]

dependencies = [
    ('Python', '3.13.5'),
    ('Python-bundle-PyPI', '2025.07'),
    ('lxml', '6.0.0'),
]

exts_list = [
    ('cachetools', '6.2.4', {
        'checksums': ['82c5c05585e70b6ba2d3ae09ea60b79548872185d2f24ae1f2709d37299fd607'],
    }),
    ('frozendict', '2.4.7', {
        'checksums': ['e478fb2a1391a56c8a6e10cc97c4a9002b410ecd1ac28c18d780661762e271bd'],
    }),
    ('pyld', version, {
        'checksums': ['b1913a06054f35a31e4d9916d184852909b2a3c5fea55c341bd00917cf8b22ef'],
    }),
]

moduleclass = 'data'
