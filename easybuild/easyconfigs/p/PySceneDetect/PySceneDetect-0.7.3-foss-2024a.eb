easyblock = 'PythonBundle'

name = 'PySceneDetect'
version = '0.7.3'

homepage = 'https://www.scenedetect.com'
description = """Detect fast cuts and fades from the command line or Python.
Split videos with ffmpeg or mkvmerge, export timeline files for video editors, or save per-frame metrics."""

toolchain = {'name': 'foss', 'version': '2024a'}

dependencies = [
    ('Python', '3.12.3'),
    ('SciPy-bundle', '2024.05'),
    ('OpenCV', '4.11.0', '-contrib'),
    ('tqdm', '4.66.5'),
    ('MoviePy', '2.2.1'),
    ('PyAV', '14.4.0'),
]

exts_list = [
    ('scenedetect', version, {
        'preinstallopts': """cp packaging/variants/pyproject-scenedetect.toml pyproject.toml && """
                          """sed -i '/^license/d' pyproject.toml && """
                          """sed -i 's/opencv-python/opencv-contrib-python/' pyproject.toml && """,
        'source_urls': ['https://github.com/Breakthrough/%(name)s/archive/'],
        'sources': ['v%(version)s.tar.gz'],
        'checksums': ['36f0ec1866291bc86e041bcae5f2d11adea017e6d4de0c4492b3c22db049cfc2'],
    }),
]

sanity_check_commands = ['scenedetect version', 'scenedetect --help']


moduleclass = 'data'
