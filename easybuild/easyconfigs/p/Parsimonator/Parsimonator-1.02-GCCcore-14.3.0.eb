easyblock = 'MakeCp'

name = 'Parsimonator'
version = '1.02'

homepage = 'https://github.com/stamatak/Parsimonator-1.0.2'
description = "A program for sequential and parallel estimation of phylogenetic trees"


toolchain = {'name': 'GCCcore', 'version': '14.3.0'}

local_commit = '78368c6'

source_urls = ['https://github.com/stamatak/Parsimonator-1.0.2/archive']
sources = [{'download_filename': '%s.tar.gz' % local_commit, 'filename': SOURCE_TAR_GZ}]
checksums = ['1dcab1de341df331e66a75eae82a629e2e9185f473c6a18f9ff18214b56b55db']

builddependencies = [('binutils', '2.44')]

# Select the specific Makefile
buildopts = '-f Makefile.gcc'

# Override hardcoded compiler flags so EasyBuild's architecture flags take effect
buildopts += ' CC="$CC" CFLAGS="$CFLAGS"'

files_to_copy = [(['parsimonator'], 'bin')]

sanity_check_paths = {
    'files': ['bin/parsimonator'],
    'dirs': [],
}

moduleclass = 'bio'
