# Author: Stamen Miroslavov <stamen.miroslavov@bsc.es>
# Barcelona Supercomputing Center 2026

easyblock = 'PythonPackage'

name = 'pyodbc'
version = '5.3.0'

homepage = 'https://github.com/mkleehammer/pyodbc'
description = """pyodbc is an open source Python module that makes accessing ODBC databases simple.
 It implements the DB API 2.0 specification but is packed with even more Pythonic convenience."""

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}

sources = [SOURCE_TAR_GZ]
checksums = ['2fe0e063d8fb66efd0ac6dc39236c4de1a45f17c33eaded0d553d21c199f4d05']

builddependencies = [('binutils', '2.44')]

dependencies = [
    ('Python', '3.13.5'),
    ('Python-bundle-PyPI', '2025.07'),
    ('unixODBC', '2.3.14'),
    ('psqlODBC', '18.00.0001'),
]

sanity_check_commands = [
    'python -c "import pyodbc; print(pyodbc.drivers())" | grep -q PostgreSQL',
]

moduleclass = 'lib'
