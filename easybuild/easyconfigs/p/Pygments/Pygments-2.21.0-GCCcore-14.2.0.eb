easyblock = 'PythonPackage'

name = 'Pygments'
version = '2.21.0'

homepage = 'https://pygments.org/'
description = "Pygments is a syntax highlighting package written in Python."

toolchain = {'name': 'GCCcore', 'version': '14.2.0'}

sources = [SOURCELOWER_TAR_GZ]
checksums = ['610ca751c9bc2492b38eb9a38a7fbc93edbbb2d7182edaf34e66ae493dee5c8c']

builddependencies = [
    ('binutils', '2.42'),
    ('hatchling', '1.27.0'),
    ('trove-classifiers', '2026.1.14.14'),  # has the 3.15 classifier
]

dependencies = [
    ('Python', '3.13.1'),
]

sanity_check_commands = ['pygmentize --help']

moduleclass = 'tools'
