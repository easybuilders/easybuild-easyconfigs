easyblock = 'PythonPackage'

name = 'PyWavelets'
version = '1.10.0'

homepage = 'https://pywavelets.readthedocs.io'
description = "PyWavelets is open source wavelet transform software for Python."

toolchain = {'name': 'foss', 'version': '2026.1'}

sources = [SOURCELOWER_TAR_GZ]
checksums = ['f3cb8640225a8f3fdcbc3f6f3bd112c78927c9407cbfa65a5ff303990a6a3e32']

builddependencies = [
    ('Cython', '3.2.9'),
    ('meson-python', '0.19.0'),
]

dependencies = [
    ('Python', '3.14.2'),
    ('SciPy-bundle', '2026.05'),  # for numpy
]

options = {'modulename': 'pywt'}

moduleclass = 'lib'
