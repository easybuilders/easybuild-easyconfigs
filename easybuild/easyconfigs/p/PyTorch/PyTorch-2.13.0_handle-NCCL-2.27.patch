 load_tests = load_tests  # noqa: PLW0127
 
+requires_symmetric_memory_device_API = requires_nccl_version((2, 28), "NCCL Symmetric Memory support device API from nccl 2.28")
+
 nGPUs = torch.cuda.device_count()
 if not TEST_CUDA:
     print("CUDA not available, skipping tests", file=sys.stderr)
