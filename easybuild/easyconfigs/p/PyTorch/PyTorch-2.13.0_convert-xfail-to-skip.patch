We don't care much about expected failures, so just convert the XFAIL markers to skips.
This avoids unexpected success, e.g. in `test_original_aten_preserved_split_addmm` on L40s

Author: Alexander Grund (TU Dresden)

diff --git a/torch/testing/_internal/common_cuda.py b/torch/testing/_internal/common_cuda.py
--- a/torch/testing/_internal/common_cuda.py
+++ b/torch/testing/_internal/common_cuda.py
@@ -454,7 +454,7 @@ def _create_scaling_case(device="cuda", dtype=torch.float, optimizer_ctor=torch.
 
 
 def xfailIfSM89(func):
-    return func if not IS_SM89 else unittest.expectedFailure(func)
+    return func if not IS_SM89 else unittest.skip("SM8.9")(func)
 
 def xfailIfSM90(func):
     return func if not IS_SM90 else unittest.expectedFailure(func)
@@ -472,18 +472,18 @@ def xfailIfSM100OrLater(func):
     # TEST_WITH_ROCM to keep the xfail NVIDIA-only.
     if TEST_WITH_ROCM:
         return func
-    return func if not SM100OrLater else unittest.expectedFailure(func)
+    return func if not SM100OrLater else unittest.skip("SM10+")(func)
 
 def xfailIfSM120OrLater(func):
     if TEST_WITH_ROCM:
         return func
-    return func if not SM120OrLater else unittest.expectedFailure(func)
+    return func if not SM120OrLater else unittest.skip("SM12.0+")(func)
 
 def xfailIfSM12X(func):
     return func if not IS_SM12X else unittest.expectedFailure(func)
 
 def xfailIfDistributedNotSupported(func):
-    return func if not (IS_MACOS or IS_JETSON) else unittest.expectedFailure(func)
+    return func if not (IS_MACOS or IS_JETSON) else unittest.skip("DistributedNotSupported")(func)
 
 def _xfail_cuda_on_windows_wrapper(test_fn):
     """Wraps a test to xfail when running on a CUDA device.
