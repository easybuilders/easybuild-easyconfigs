osdependencies = [OS_PKG_IBVERBS_DEV]

builddependencies = [
    ('CMake', '3.31.8'),
    ('hypothesis', '6.136.6'),
    # For tests
    ('build', '1.3.0'),
    ('uv', '0.10.9'),
    ('parameterized', '0.9.0'),
