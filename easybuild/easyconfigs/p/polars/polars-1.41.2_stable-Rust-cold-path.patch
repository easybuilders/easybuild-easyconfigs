Remove the unstable std::hint::cold_path call, which is only an optimization
hint and requires Rust 1.95. This keeps Polars compatible with the stable
Rust 1.94.1 version used by the 2026.1 toolchain.

--- a/crates/polars-python/src/utils.rs
+++ b/crates/polars-python/src/utils.rs
@@ -140,7 +140,6 @@ impl EnterPolarsExt for Python<'_> {
     {
         let timeout = if is_timeout_enabled() {
-            std::hint::cold_path();
             schedule_polars_timeout(get_traceback(self).ok())
         } else {
             None
         };
