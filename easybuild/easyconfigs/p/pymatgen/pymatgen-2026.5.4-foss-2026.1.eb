easyblock = 'PythonBundle'

name = 'pymatgen'
version = '2026.5.4'

homepage = 'https://pymatgen.org/'
description = """Python Materials Genomics is a robust materials analysis code that defines core object
 representations for structures and molecules with support for many electronic structure codes."""

toolchain = {'name': 'foss', 'version': '2026.1'}

builddependencies = [
    ('poetry', '2.3.4'),
    ('hatchling', '1.29.0'),
    ('maturin', '1.13.1'),
    ('Cython', '3.2.4'),
    ('PDM', '2.28.0'),
    ('hypothesis', '6.153.2'),
]

dependencies = [
    ('Python', '3.14.2'),
    ('Python-bundle-PyPI', '2026.04'),
    ('SciPy-bundle', '2026.05'),
    ('matplotlib', '3.10.9'),
    ('networkx', '3.6.1'),
    ('plotly.py', '7.0.0'),
    ('ruamel.yaml', '0.19.1'),
    ('spglib-python', '2.7.0'),
    ('sympy', '1.14.0'),
    ('tqdm', '4.67.3'),
    ('uncertainties', '3.2.3'),
    ('orjson', '3.11.8'),
    ('lxml', '6.1.1'),
    # Optional
    ('phonopy', '4.5.0'),
    ('OpenBabel', '3.2.1'),
]

