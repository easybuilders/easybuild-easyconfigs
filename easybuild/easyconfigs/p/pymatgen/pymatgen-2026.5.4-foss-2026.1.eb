        'checksums': ['094dd7d9a5fc1cca4854773e5c1fc6a315b33bd5b3a8f47064928facaf0490a8'],
    }),
    ('monty', '2026.7.16', {
        'checksums': ['2c51224b6715794cfbbb8202b9749077fad8e67b238b0ab6f2abb9bde33c2f86'],
    }),
    ('bibtexparser', '1.4.3', {
        'checksums': ['a9c7ded64bc137720e4df0b1b7f12734edc1361185f1c9097048ff7c35af2b8f'],
    }),
    ('pymatgen-core', '2026.8.30', {
        'modulename': 'pymatgen.core',
        'checksums': ['2a06e4361b9be37b54614ade9eb27786641dd294a0d8096c135a9bc73b0d7597'],
    }),
    (name, version, {
        'patches': ['pymatgen-2026.5.4-fix_tests.patch'],
