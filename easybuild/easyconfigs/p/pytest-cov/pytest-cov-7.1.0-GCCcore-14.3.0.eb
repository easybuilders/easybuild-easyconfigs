easyblock = 'PythonBundle'

name = 'pytest-cov'
version = '7.1.0'

homepage = 'https://github.com/pytest-dev/pytest-cov'
description = """This plugin provides coverage functionality as a pytest plugin."""

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}

builddependencies = [
    ('hatchling', '1.27.0'),
]

dependencies = [
    ('Python', '3.13.5'),
    ('Python-bundle-PyPI', '2025.07'),
    ('coverage', '7.10.7'),
]

exts_list = [
    (name, version, {
        'checksums': ['30674f2b5f6351aa09702a9c8c364f6a01c27aae0c1366ae8016160d1efc56b2'],
    }),
]

moduleclass = 'tools'
