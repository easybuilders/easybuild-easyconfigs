easyblock = 'CMakePythonPackage'

name = 'pivy'
version = '0.6.11'

homepage = 'https://coin3d.github.io'
description = """Python binding for Coin."""

toolchain = {'name': 'GCC', 'version': '14.3.0'}

source_urls = ['https://github.com/coin3d/%(name)s/archive/refs/tags/']
sources = ['%(version)s.tar.gz']
checksums = ['78f79bd7d1ce7e8140ceba4b1220136ea1f14b4403b1e463c59fa892feed961e']

builddependencies = [
    ('CMake', '4.0.3'),
]

dependencies = [
    ('Python', '3.13.5'),
    ('SWIG', '4.3.1'),
    ('SoQt', '1.6.4'),
]

separate_build_dir = False

configopts = ' '.join([
    '-DPIVY_USE_QT6=ON',
    '-DPython_EXECUTABLE="${EBROOTPYTHON}/bin/python"',
    '-DPIVY_Python_SITEARCH="%(installdir)s/lib/python%(pyshortver)s/site-packages"',
    '-DDISABLE_SWIG_WARNINGS=ON',
    '-DCMAKE_VERBOSE_MAKEFILE=ON',
])

# CMake install does not register pip metadata; create a minimal dist-info
# so pivy shows up in 'pip list' (required by the sanity check)
local_distinfodir = '%(installdir)s/lib/python%(pyshortver)s/site-packages/%(name)s-%(version)s.dist-info'
postinstallcmds = [
    'mkdir %s' % local_distinfodir,
    'echo "Name: %%(name)s" > %s/METADATA' % local_distinfodir,
    'echo "Version: %%(version)s" >> %s/METADATA' % local_distinfodir,
]

sanity_check_paths = {
    'files': [
        'lib/python%(pyshortver)s/site-packages/%(name)s/coin.py',
        f'lib/python%(pyshortver)s/site-packages/%(name)s/_coin.{SHLIB_EXT}',
    ],
    'dirs': [
        'lib/python%(pyshortver)s/site-packages/%(name)s',
        'lib/python%(pyshortver)s/site-packages/%(name)s-%(version)s.dist-info',
    ],
}

sanity_check_commands = [
    "python -s -c 'from pivy import coin; va = coin.SbVec3f([0, 0, 0]);'"
]

moduleclass = 'vis'
