easyblock = 'PythonPackage'

name = 'pyEDFlib'
version = '0.1.42'

homepage = 'https://pyedflib.readthedocs.io/'
description = """
pyEDFlib is a python library to read/write EDF+/BDF+ files based on EDFlib.
"""

toolchain = {'name': 'foss', 'version': '2025b'}

sources = [SOURCELOWER_TAR_GZ]
checksums = ['39f35c60ce213f23ee954f89117f79b2adb5ef4894500fd9bf0f9298fb240efc']

builddependencies = [
    ('binutils', '2.44'),
    ('Cython', '3.1.2'),
]

dependencies = [
    ('Python', '3.13.5'),
    ('SciPy-bundle', '2025.07'),
]

moduleclass = 'lib'
