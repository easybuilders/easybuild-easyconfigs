easyblock = 'PythonPackage'

name = 'pyfiglet'
version = '0.8.post1'

homepage = 'https://github.com/pwaller/pyfiglet'
description = "Pure-python FIGlet implementation."

toolchain = {'name': 'GCCcore', 'version': '14.2.0'}

sources = [SOURCE_TAR_GZ]
