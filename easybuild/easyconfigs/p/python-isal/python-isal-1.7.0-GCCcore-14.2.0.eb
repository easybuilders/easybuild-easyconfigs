easyblock = 'PythonPackage'

name = 'python-isal'
extension_name = 'isal'
version = '1.7.0'

homepage = 'https://github.com/pycompression/python-isal'
description = """Faster zlib and gzip compatible compression and decompression
 by providing python bindings for the isa-l library.
"""

toolchain = {'name': 'GCCcore', 'version': '14.2.0'}

source_urls = ['https://pypi.python.org/packages/source/i/isal']
sources = ['isal-1.7.0.tar.gz']
checksums = ['9eb9457ed27fd0a8a7b403a5f4f9e6c8d1a44c2ca28ecd2f2bf3aed90b0a74bf']

builddependencies = [
    ('binutils', '2.42'),
    ('versioningit', '3.2.0'),
]
dependencies = [
    ('Python', '3.13.1'),
    ('ISA-L', '2.31.1'),
]

preinstallopts = 'PYTHON_ISAL_LINK_DYNAMIC=true'

options = {'modulename': 'isal'}

moduleclass = 'lib'
