    ('SciPy-bundle', '2025.07'),
    # This version of sympy does not work, see: https://github.com/stfc/PSyclone/issues/3474
    # ('sympy', '1.14.0'),
    ('Graphviz', '13.1.2'),
    ('graphviz-python', '0.21'),
    ('termcolor', '2.1.0', '', SYSTEM),
    ('gmpy2', '2.2.0'),
]

