# Author: J. Saßmannshausen (Imperial College London/UK)

easyblock = 'PythonBundle'

name = 'PSyclone'
version = '3.3.1'

homepage = 'https://psyclone.readthedocs.io/en/latest/'
description = """
PSyclone is a source-to-source Fortran compiler designed to programmatically
optimise, parallelise and instrument HPC applications via user-provided
transformation scripts. By encapsulating the performance-portability aspects
(e.g. whether to parallelise with OpenMP or OpenACC), these scripts enable a
separation of concerns between the scientific implementation and the optimisation
choices.
"""

toolchain = {'name': 'gfbf', 'version': '2025b'}

builddependencies = [
    ('binutils', '2.44'),
    ('hatchling', '1.27.0'),
    ('hypothesis', '6.136.6')
]

