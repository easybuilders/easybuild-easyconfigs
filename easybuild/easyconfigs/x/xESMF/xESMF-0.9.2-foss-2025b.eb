# Updated: Stamen Miroslavov Minkov <stamen.miroslavov@bsc.es>, BSC 2026

easyblock = 'PythonBundle'

name = 'xESMF'
version = '0.9.2'

homepage = 'https://xesmf.readthedocs.io'
description = "xESMF: Universal Regridder for Geospatial Data"

toolchain = {'name': 'foss', 'version': '2025b'}

builddependencies = [
    ('pytest', '9.1.1'),
]

dependencies = [
    ('Python', '3.13.5'),
    ('SciPy-bundle', '2025.07'),
    ('ESMPy', '8.9.0'),
    ('numba', '0.62.0'),
    ('Shapely', '2.1.1'),
    ('xarray', '2025.10.0'),
    ('dask', '2025.9.1'),
    ('cftime', '1.6.4.post1'),
    ('cf-xarray', '0.10.11'),
    ('sparse', '0.18.0'),
]

exts_list = [
    ('xesmf', version, {
        'checksums': ['c9d597a234a0c4874022cfe6394dcbf7eda10f3401b1a4cfb57ce3e22e76d720'],
        'runtest': 'pytest',
        'testopts': '-v --pyargs xesmf',
        'testinstall': True,
    }),
]

moduleclass = 'geo'
