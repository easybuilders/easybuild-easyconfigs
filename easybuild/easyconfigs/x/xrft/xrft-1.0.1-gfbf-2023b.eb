easyblock = 'PythonBundle'

name = 'xrft'
version = '1.0.1'

homepage = 'https://xrft.readthedocs.io'
description = """xrft is an open-source Python package for taking the discrete
 Fourier transform (DFT) on xarray and dask arrays."""

toolchain = {'name': 'gfbf', 'version': '2023b'}

dependencies = [
    ('Python', '3.11.5'),
    ('SciPy-bundle', '2023.11'),
    ('xarray', '2024.5.0'),
    ('dask', '2024.5.1'),
]

exts_list = [
    (name, version, {
        'checksums': ['5e9c4fa33cf458d951d7cc730283aa63665885c76cc029da6b8fd84757506714'],
    }),
]

moduleclass = 'math'
