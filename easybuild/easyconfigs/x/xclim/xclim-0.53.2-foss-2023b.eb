    ('Python', '3.11.5'),
    ('SciPy-bundle', '2023.11'),
    ('PyYAML', '6.0.1'),
    ('Pint', '0.24'),
    ('Arrow', '16.1.0'),
    ('scikit-learn', '1.4.0'),
    ('xarray', '2024.5.0'),
    ('dask', '2024.5.1'),
    ('clisops', '0.13.0'),  # optional
]

