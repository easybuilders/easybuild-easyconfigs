# Author: Stamen Miroslavov <stamen.miroslavov@bsc.es>
# Barcelona Supercomputing Center 2026

easyblock = 'PythonBundle'

name = 'Yamale'
version = '6.1.0'

homepage = 'https://github.com/23andMe/Yamale'
description = "A schema and validator for YAML."

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}

builddependencies = [
    ('binutils', '2.44'),
]

dependencies = [
    ('Python', '3.13.5'),
    ('PyYAML', '6.0.2'),
    ('ruamel.yaml', '0.18.14'),
]

exts_list = [
    ('%(namelower)s', version, {
        'checksums': ['fd435aa7b830c73e89a9ef548c0ace2d3d8dc3e5e180e6b57ff70b31495672fd'],
    }),
]

moduleclass = 'math'
