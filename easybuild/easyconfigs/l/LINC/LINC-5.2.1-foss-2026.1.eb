easyblock = 'PythonBundle'

name = 'LINC'
version = '5.2.1'

homepage = 'https://linc.readthedocs.io/en/latest/'
description = """
LINC is a pipeline to correct for various instrumental and ionospheric effects in both LOFAR HBA and LOFAR LBA
observations.
"""

toolchain = {'name': 'foss', 'version': '2026.1'}

# CMake and scikit-build are no longer needed: the bdsf extension (the only user) moved to the PyBDSF module
builddependencies = [
    ('wget', '1.25.0'),
    ('Cython', '3.2.4'),  # new: build requirement of the pyregion sdist (not needed by the previous LINC easyconfig)
]

# git-lfs is needed to fetch the LINC sources via git_config (also added to the LINC 5.0 easyconfig upstream)
source_deps = [('git-lfs', '3.7.1', '', SYSTEM)]

# Based on https://git.astron.nl/RD/LINC/-/tree/v5.2.1#software-requirements and the dependencies in pyproject.toml
# Removed compared to LINC 5.0: Boost and Boost.Python-NumPy (only needed by the bdsf extension, now in PyBDSF),
# dysco (now built as part of casacore), RMextract (replaced by spinifex). Versions are those used by LINC 5.2, except
# where noted.
dependencies = [
    ('Python', '3.14.2'),
    ('Python-bundle-PyPI', '2026.04'),  # joblib, pyparsing
    ('SciPy-bundle', '2026.05'),
    ('matplotlib', '3.10.9'),
    ('astropy', '8.0.1'),
    ('h5py', '3.16.0'),
    ('casacore', '3.8.1'),  # now an explicit dependency (also pulled in by DP3 etc.)
    ('python-casacore', '3.8.1'),
    ('DP3', '6.6'),
    ('LoSoTo', '2.7.1'),  # LINC 5.2.1 pins losoto==2.7.1
    ('LSMTool', '1.9.0'),
    ('EveryBeam', '0.8.5'),
    ('SAGECal', '0.8.9'),
    ('spinifex', '1.4.1'),  # LINC requires spinifex<2.0; replaces RMextract
    ('AOFlagger', '3.5.1'),
    ('WSClean', '3.7'),
    ('IDG', '1.3.0'),
    ('LofarStMan', '1.0.1'),
    ('PyBDSF', '1.14.1'),  # was an extension (bdsf) of LINC itself
    ('mocpy', '0.20.0'),  # new, required by LSMTool 1.9
    ('cwltool', '3.3.20261106131234'),
    # Technically there was a version pin for toil < 9.4 in LINC-5.2.1, but an upstream MR confirmed this is no longer
    # needed https://git.astron.nl/RD/LINC/-/merge_requests/343 . See also https://git.astron.nl/RD/LINC/-/work_items/103
    ('toil-cwl', '9.6.0'),
]

modloadmsg = """
Certain components of %(name)s (e.g. DP3) do not support a multithreaded BLAS. You may need to set OMP_NUM_THREADS=1 and
OPENBLAS_NUM_THREADS=1. If you're running the pipeline within a SLURM environment, you may need to clear all SLURM
environment variables from your environment (e.g. using 'for i in $(env | grep SLURM); do unset "${i%=*}"; done').
"""

exts_list = [
    ('pyregion', '2.3.0', {'checksums': ['e8498711421173239689de523bb465245f5551a18a181cb4956d87f9c7464925']}),
    # new requirement of LINC 5.2
    ('scikit-fuzzy', '0.5.0', {
        'modulename': 'skfuzzy',
        'source_tmpl': 'scikit_fuzzy-%(version)s.tar.gz',
        'checksums': ['2ee5340523aa7635ca568b9d8029c7738d05f9ea550fc89d4054b4cb50f34e7f'],
    }),
    ('LINC', '5.2.1', {
        'modulename': False,
        'sources': [{
            'filename': '%(name)s-v%(version)s.tar.xz',
            'git_config': {
                'url': 'https://git.astron.nl/RD/',
                'repo_name': 'LINC',
                'commit': 'v%(version)s',
                'recursive': True,
                'keep_git_dir': True,
            },
        }],
        # LINC's summary step reads $LINC_DATA_ROOT/.versions (new in LINC 5.2): create it for the test, see also
        # postinstallcmds
        'testinstall': True,
        'pretestopts': (
            'mkdir -p data && '
            'wget -nv https://support.astron.nl/software/ci_data/linc/test_data.tar.gz -O test_data.tar.gz && '
            'wget -nv https://support.astron.nl/software/ci_data/linc/results_calibrator.tar.gz '
            '-O results_calibrator.tar.gz && '
            'tar xfz test_data.tar.gz -C data && tar xfz results_calibrator.tar.gz -C data && '
            'sed -i '
            '-e "s|"/usr/local/share/linc/skymodels/A-Team_Midres.skymodel"|'
            '"${EB_PYTHONPACKAGE_TEST_INSTALLDIR}/share/linc/skymodels/A-Team_Midres.skymodel"|" '
            '-e "s|"/usr/local/share/linc/skymodels"|"${EB_PYTHONPACKAGE_TEST_INSTALLDIR}/share/linc/skymodels"|" '
            'test_jobs/HBA_target.json && '
            # the summary step reads the versions file that is created in the LINC container, see postinstallcmds
            'echo "LINC: %(version)s" > $EB_PYTHONPACKAGE_TEST_INSTALLDIR/share/linc/.versions && '
            'python -m pip freeze | sed "s/==/: /g" >> $EB_PYTHONPACKAGE_TEST_INSTALLDIR/share/linc/.versions && '
            'for i in $(env | grep SLURM); do unset "${i%=*}"; done && export OMP_NUM_THREADS=1 && '
            'export OPENBLAS_NUM_THREADS=1 && '
            'export LINC_DATA_ROOT=$EB_PYTHONPACKAGE_TEST_INSTALLDIR/share/linc && '
            'export PYTHONPATH=$PYTHONPATH:$EB_PYTHONPACKAGE_TEST_INSTALLDIR/bin && '
        ),
        'runtest': 'cwltool',
        'testopts': (
            '--no-container --preserve-entire-environment --outdir results --leave-tmpdir '
            '--tmpdir-prefix run_hba_calibrator '
            '$EB_PYTHONPACKAGE_TEST_INSTALLDIR/share/linc/workflows/HBA_target.cwl test_jobs/HBA_target.json'
        ),
    }),
    # We cannot get a reproducible checksum, because we need to do keep_git_dir for
    # setuptools_scm to determine the version
]

# LINC's summary step expects a file listing the used software versions in $LINC_DATA_ROOT/.versions,
# which is created by the LINC container build (see Docker/Dockerfile-linc)
postinstallcmds = [
    'echo "LINC: %(version)s" > %(installdir)s/share/linc/.versions',
    'export PYTHONPATH=%(installdir)s/lib/python%(pyshortver)s/site-packages:$PYTHONPATH && '
    'python -m pip freeze | sed "s/==/: /g" >> %(installdir)s/share/linc/.versions',
]

moduleclass = 'astro'
