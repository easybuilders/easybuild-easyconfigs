easyblock = 'ConfigureMake'

name = 'libconfig'
version = '1.8.1'

homepage = 'https://hyperrealm.github.io/libconfig'
description = "Libconfig is a simple library for processing structured configuration files"

toolchain = {'name': 'GCCcore', 'version': '13.3.0'}

source_urls = ['https://hyperrealm.github.io/libconfig/dist/']
sources = [{'download_filename': SOURCE_TAR_GZ, 'filename': 'libconfig-%(version)s-bis.tar.gz'}]
checksums = ['c73ee3d914ec68c99b61e864832931e9a7112eeabfb449dad217fd83e385cbdf']

# rename source tarball after download to avoid clash with original libconfig-1.8.1.tar.gz,
# since it was re-created in Nov'25, see https://github.com/hyperrealm/libconfig/issues/256
builddependencies = [
    ('binutils', '2.42'),
    ('Bison', '3.8.2'),
    ('flex', '2.6.4'),
]

sanity_check_paths = {
    'files': ['include/libconfig.h', 'include/libconfig.h++', 'lib/libconfig.a', 'lib/libconfig++.a',
              'lib/libconfig.%s' % SHLIB_EXT, 'lib/libconfig++.%s' % SHLIB_EXT],
    'dirs': ['lib/pkgconfig'],
}

moduleclass = 'lib'
