easyblock = 'PythonBundle'

name = 'loompy'
version = '3.0.8'

homepage = 'https://loompy.org/'
description = "Python implementation of the Loom file format, an efficient file format for large omics datasets"

toolchain = {'name': 'foss', 'version': '2026.1'}

builddependencies = [('poetry', '2.3.4'), ]

dependencies = [
    ('Python', '3.14.2'),
    ('Python-bundle-PyPI', '2026.04'),  # for click
    ('SciPy-bundle', '2026.05'),
    ('h5py', '3.16.0'),
    ('numba', '0.65.1'),
]

exts_list = [
    ('numpy_groupies', '0.16.3', {
        'checksums': ['1ebc64b3de8fbfb740421e4120d1a23cd49482e9dc8c456f0670cd7247b676f7'],
    }),
    (name, version, {
        'checksums': ['c1f48d0bf21aa2bbdeee21a0577553cba9609d9435d7c32b687686bbb5869ca7'],
    }),
]

sanity_check_paths = {
    'files': ['bin/loompy'],
    'dirs': ['lib/python%(pyshortver)s/site-packages'],
}

sanity_check_commands = ["loompy --help"]

moduleclass = 'bio'
