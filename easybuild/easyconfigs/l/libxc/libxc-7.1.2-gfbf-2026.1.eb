easyblock = 'CMakeMake'

name = 'libxc'
version = '7.1.2'

homepage = 'https://libxc.gitlab.io'
description = """Libxc is a library of exchange-correlation functionals for density-functional theory.
The aim is to provide a portable, well tested and reliable set of exchange and correlation functionals."""

toolchain = {'name': 'gfbf', 'version': '2026.1'}

source_urls = ['https://gitlab.com/%(name)s/%(name)s/-/archive/%(version)s/']
sources = [SOURCE_TAR_BZ2]
patches = ['libxc-7.1.2_use-env-python.patch']
checksums = [
    {'libxc-7.1.2.tar.bz2': '3915fac94416e4c415534223ea492ad2663f928acf27e98662c861b094a6c306'},
    {'libxc-7.1.2_use-env-python.patch': 'c0e3e983f19f147320fdd7e94aa94a501164ab9d8a8f5649b2205a92622da92f'},
]

builddependencies = [
    ('CMake', '3.31.11'),
    ('Perl', '5.42.0'),
    # Since 7.1 the test suite is configured with pytest & scipy, and fails if any is missing
    ('Python-bundle-PyPI', '2026.04'),
    ('SciPy-bundle', '2026.05'),
]

# Enable building of third and fourth derivatives required by software that depends on libxc (like ABINIT, which
# requires "3rd derivatives of energy").
# See also https://github.com/pyscf/pyscf/issues/1103
local_common_configopts = '-DENABLE_FORTRAN=ON -DMAXORDER=4 '

configopts = [
    local_common_configopts + '-DBUILD_SHARED_LIBS=OFF ',
    local_common_configopts + '-DBUILD_SHARED_LIBS=ON -DENABLE_PYTHON=ON ',
]

# Required to pick up the libraries in Python tests.
# Setting both environment varaibles to cover environments where `LD_LIBRARY_PATH` is filtered.
pretestopts = (
    "export LIBRARY_PATH=%(builddir)s/easybuild_obj:$LIBRARY_PATH && "
    "export LD_LIBRARY_PATH=%(builddir)s/easybuild_obj:$LD_LIBRARY_PATH && "
)

runtest = 'test'

sanity_check_paths = {
    'files': ['bin/xc-info'] + ['lib/libxc%s.%s' % (x, y) for x in ['', 'f03'] for y in ['a', SHLIB_EXT]],
    'dirs': ['include', 'lib/pkgconfig', 'lib/cmake/Libxc'],
}

sanity_check_commands = ['xc-info 1']

moduleclass = 'chem'
