Install Python bindings in the location picked up automatically by EasyBuild

author: Georgios Kafanas (University of Luxembourg) 
diff -ruN libxc-7.1.2.orig/CMakeLists.txt libxc-7.1.2/CMakeLists.txt
--- libxc-7.1.2.orig/CMakeLists.txt	2026-07-20 19:06:57.000000000 +0200
+++ libxc-7.1.2/CMakeLists.txt	2026-10-29 16:07:04.723639974 +0100
@@ -461,12 +461,12 @@
   )
   install(
     FILES ${SOURCE_PYTHON_API}
-    DESTINATION ${CMAKE_INSTALL_LIBDIR}/pylibxc
+    DESTINATION ${CMAKE_INSTALL_LIBDIR}/python${Python3_VERSION_MAJOR}.${Python3_VERSION_MINOR}/site-packages/pylibxc
   )
   if(UNIX)
     install(CODE "execute_process(COMMAND ${CMAKE_COMMAND} -E create_symlink \
       ${CMAKE_INSTALL_PREFIX}/${CMAKE_INSTALL_LIBDIR}/libxc.so.${${PROJECT_NAME}_SOMAJOR} \
-      ${CMAKE_INSTALL_PREFIX}/${CMAKE_INSTALL_LIBDIR}/pylibxc/libxc.so)")
+      ${CMAKE_INSTALL_PREFIX}/${CMAKE_INSTALL_LIBDIR}/python${Python3_VERSION_MAJOR}.${Python3_VERSION_MINOR}/site-packages/pylibxc/libxc.so)")
   endif()
 endif()
 
