easyblock = 'ConfigureMake'

name = 'libcap'
version = '2.25'

homepage = 'https://sites.google.com/site/fullycapable/'
description = """POSIX capabilities library"""

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}

source_urls = ['https://www.kernel.org/pub/linux/libs/security/linux-privs/libcap2/']
sources = [SOURCELOWER_TAR_GZ]
checksums = ['4ca80dc6f9f23d14747e4b619fd9784434c570e24a7346f326c692784ed83a86']

builddependencies = [
    ('binutils', '2.44'),
]

dependencies = [
    ('attr', '2.5.2'),
]

skipsteps = ['configure']

buildopts = 'CC="$CC" CFLAGS="$CFLAGS" lib="lib" prefix=%(installdir)s'
installopts = 'lib="lib" prefix=%(installdir)s'

sanity_check_paths = {
    'files': ['lib/libcap.%s' % SHLIB_EXT, 'lib/libcap.a'],
    'dirs': ['include/sys'],
}

moduleclass = 'system'
