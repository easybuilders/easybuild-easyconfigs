# Author: sreenivasamurthy kolam <sreenivasamurthy.kolam@amd.com>

easyblock = 'MesonNinja'

name = 'libva'
version = '2.24.1'

homepage = 'https://github.com/intel/libva'
description = """Video Acceleration API (VA-API) is a library and API specification which provides
 access to graphics hardware acceleration capabilities for video processing."""

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}

source_urls = ['https://github.com/intel/libva/archive/refs/tags/']
sources = ['%(version)s.tar.gz']
checksums = ['0b4a3649ee8d683b9cce2ef094df4fb039d276c0cef7e49337c43d3b297b9f42']

builddependencies = [
    ('binutils', '2.44'),
    ('Meson', '1.8.2'),
    ('Ninja', '1.13.0'),
    ('pkgconf', '2.4.3'),
]

dependencies = [
    ('libdrm', '2.4.125'),
    ('X11', '20250608'),
]

configopts = '-Dwith_glx=no -Dwith_wayland=no '

sanity_check_paths = {
    'files': ['lib/libva.%s' % SHLIB_EXT, 'lib/libva-drm.%s' % SHLIB_EXT, 'lib/libva-x11.%s' % SHLIB_EXT],
    'dirs': ['include/va', 'lib/pkgconfig'],
}

moduleclass = 'lib'
