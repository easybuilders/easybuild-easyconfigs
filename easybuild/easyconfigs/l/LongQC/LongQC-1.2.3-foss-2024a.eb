easyblock = 'PythonBundle'

name = 'LongQC'
version = '1.2.3'

homepage = 'https://github.com/yfukasawa/LongQC'
description = "LongQC is a tool for the data quality control of the PacBio and ONT long reads."

toolchain = {'name': 'foss', 'version': '2024a'}

dependencies = [
    ('Python', '3.12.3'),
    ('Python-bundle-PyPI', '2024.06'),
    ('SciPy-bundle', '2024.05'),
    ('h5py', '3.12.1'),
    ('matplotlib', '3.9.2'),
    ('scikit-learn', '1.6.1'),
    ('Pysam', '0.22.1'),
    ('edlib', '1.3.9.post1'),
]

components = [
    (name, version, {
        'easyblock': 'MakeCp',
        'source_urls': ['https://github.com/yfukasawa/LongQC/archive/refs/tags/'],
        'sources': [{'download_filename': 'v%(version)s.tar.gz', 'filename': SOURCE_TAR_GZ}],
        'checksums': ['812379c26db5f7ef5664b1d2214b0703136659c7e41332bf5309653fb6360de9'],
        'start_dir': '%(name)s-%(version)s',
        'buildopts': '-C minimap2-coverage',
        'files_to_copy': [
            (['*.py', 'LICENSE', 'README.md', 'mixEM', 'refs', 'web_summary'], 'LongQC'),
            (
                ['minimap2-coverage/minimap2-coverage', 'minimap2-coverage/sdust'],
                'LongQC/minimap2-coverage',
            ),
        ],
    }),
]

local_longqc_dir = '%(installdir)s/LongQC'
local_minimap2_dir = local_longqc_dir + '/minimap2-coverage'
local_wrapper = '%(installdir)s/bin/longqc'

postinstallcmds = [
    'mkdir -p %(installdir)s/bin',
    "echo '#!/bin/sh' > %s" % local_wrapper,
    """echo 'exec python "$EBROOTLONGQC/LongQC/longQC.py" "$@"' >> %s""" % local_wrapper,
    'chmod 755 %s' % local_wrapper,
]

sanity_check_paths = {
    'files': [
        'bin/longqc',
        'LongQC/longQC.py',
        'LongQC/minimap2-coverage/minimap2-coverage',
        'LongQC/minimap2-coverage/sdust',
    ],
    'dirs': [
        'LongQC/mixEM/mixem',
        'LongQC/refs',
        'LongQC/web_summary',
    ],
}

sanity_check_commands = [
    'longqc --version',
    '%s/minimap2-coverage --version' % local_minimap2_dir,
    '%s/sdust %s/refs/Sequel_control_reference.fasta >/dev/null' % (
        local_minimap2_dir,
        local_longqc_dir,
    ),
]

modloadmsg = "To execute LongQC, use: longqc <command> [options]\n"

moduleclass = 'bio'
