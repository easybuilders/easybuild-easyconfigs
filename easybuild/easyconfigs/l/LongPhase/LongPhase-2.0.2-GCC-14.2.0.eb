easyblock = 'ConfigureMake'

name = 'LongPhase'
version = '2.0.2'

homepage = 'https://github.com/twolinin/longphase'
description = """LongPhase is an ultra-fast program for simultaneously
co-phasing SNPs, small indels, large SVs, and (5mC) modifications for Nanopore and
PacBio platforms. It can produce nearly chromosome-scale haplotype blocks by
using Nanpore ultra-long reads without the need for additional trios,
chromosome conformation, and strand-seq data. LongPhase can phase a 30x human genome
in ~1 minute."""

toolchain = {'name': 'GCC', 'version': '14.2.0'}

source_urls = [GITHUB_LOWER_SOURCE]
sources = ['v%(version)s.tar.gz']
patches = ['%(name)s-%(version)s_fix_dependencies.patch']
checksums = [
    'e9936716ab357317c7aea1de3ba397ec015a61a7b03bedb88b4138e94db3f699',  # v2.0.2.tar.gz
    'b40d9dc86915c6e3e1207e84e9145766961ccd60375fc1dbeaa1baa8dedc91f7',  # LongPhase-2.0.2_fix_dependencies.patch
]

builddependencies = [('Autoconf', '2.72')]

dependencies = [
    ('jemalloc', '5.3.0'),
    ('HTSlib', '1.22.1'),
    ('zlib', '1.3.1'),
]

preconfigopts = 'autoreconf -i && '

install_cmd = 'mkdir %(installdir)s/bin && cp %(namelower)s %(installdir)s/bin'

sanity_check_paths = {
    'files': ['bin/longphase'],
    'dirs': ['bin/'],
}

sanity_check_commands = [
    "longphase --help",
]

moduleclass = 'bio'
