easyblock = 'MesonNinja'

name = 'libinput'
version = '1.31.3'

homepage = 'https://gitlab.freedesktop.org/libinput/libinput/'
description = 'Input device management and event handling library'

toolchain = {'name': 'GCCcore', 'version': '15.2.0'}

source_urls = ['https://gitlab.freedesktop.org/libinput/libinput/-/archive/%(version)s/']
sources = [SOURCELOWER_TAR_GZ]
checksums = ['b6749bf6f1890f6631c0a70a027c35fec9d2e096a39f720548896e41474a9854']

builddependencies = [
    ('binutils', '2.45'),
    ('Meson', '1.10.2'),
    ('Ninja', '1.13.2'),
    ('Check', '0.15.2'),
]

dependencies = [
    ('libevdev', '1.13.7'),
    ('libudev-zero', '1.0.5'),
]

ndebug = False  # libinput wants to use asserts

configopts = ' '.join([
    '-Dmtdev=false',
    '-Dlibwacom=false',
    '-Ddebug-gui=false',
])

sanity_check_paths = {
    'files': [f'lib/libinput.{SHLIB_EXT}', 'bin/libinput'],
    'dirs': ['include'],
}

sanity_check_commands = ['libinput -h']

moduleclass = 'tools'
