easyblock = 'ConfigureMake'

name = 'libudev-zero'
version = '1.0.4'

homepage = 'https://github.com/illiliti/libudev-zero'
description = 'Drop-in replacement for libudev intended to work with any device manager'

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}

source_urls = ['https://github.com/illiliti/libudev-zero/archive/refs/tags/']
sources = [VERSION_TAR_GZ]
checksums = ['10148cfd6047d387bf71eca72cd19c177084224d96434a118d8def6e0a3d6316']

builddependencies = [
    ('binutils', '2.44'),
#    ('Meson', '1.8.2'),
#    ('Ninja', '1.13.0'),
]

skipsteps = ['configure']

installopts = 'PREFIX=%(installdir)s'

sanity_check_paths = {
    'files': ['include/libudev.h', f'lib/libudev.{SHLIB_EXT}', f'lib/libudev.a'],
    'dirs': [],
}

moduleclass = 'lib'
