easyblock = 'MesonNinja'

name = 'libudev-zero'
version = '1.0.5'

homepage = 'https://github.com/illiliti/libudev-zero'
description = 'Drop-in replacement for libudev intended to work with any device manager'

toolchain = {'name': 'GCCcore', 'version': '15.2.0'}

source_urls = ['https://github.com/illiliti/libudev-zero/archive/refs/tags/']
sources = [VERSION_TAR_GZ]
checksums = ['bf4372f79ddbe6b0e266a3d2994ffac7018a7edf4f87632aecb5176565d96138']

builddependencies = [
    ('binutils', '2.45'),
    ('Meson', '1.10.2'),
    ('Ninja', '1.13.2'),
]

sanity_check_paths = {
    'files': ['include/libudev.h', f'lib/libudev.{SHLIB_EXT}', 'lib/libudev.a'],
    'dirs': [],
}

moduleclass = 'lib'
