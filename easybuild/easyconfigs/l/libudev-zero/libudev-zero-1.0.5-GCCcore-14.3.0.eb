easyblock = 'MesonNinja'

name = 'libudev-zero'
version = '1.0.5'

homepage = 'https://github.com/illiliti/libudev-zero'
description = 'Drop-in replacement for libudev intended to work with any device manager'

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}

source_urls = ['https://github.com/illiliti/libudev-zero/archive/refs/heads/']
sources = ['master.zip']
checksums = ['cfef700d661ba3a21b87e9a622c728500a243a8b7779ea27832fe540c5d7eeb2']

builddependencies = [
    ('binutils', '2.44'),
    ('Meson', '1.8.2'),
    ('Ninja', '1.13.0'),
]

sanity_check_paths = {
    'files': ['include/libudev.h', f'lib/libudev.{SHLIB_EXT}', 'lib/libudev.a'],
    'dirs': [],
}

moduleclass = 'lib'
