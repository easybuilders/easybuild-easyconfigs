easyblock = 'PythonBundle'

name = 'LSMTool'
version = '1.9.0'

homepage = 'https://lsmtool.readthedocs.io/en/latest/'
description = """
LSMTool is a Python package which allows for the manipulation of LOFAR sky models in the makesourcedb format.
"""

toolchain = {'name': 'foss', 'version': '2026.1'}

# LSMTool 1.9 has a compiled (C++/pybind11) part built with scikit-build-core, hence these builddependencies
builddependencies = [
    ('CMake', '3.31.11'),
    ('scikit-build-core', '0.12.2'),
    ('pybind11', '3.0.4'),
]
# Based on https://git.astron.nl/RD/LSMTool/-/tree/v1.9.0?ref_type=tags#dependencies
dependencies = [
    ('EveryBeam', '0.8.5'),  # was 0.6.1; LSMTool 1.9 uses EveryBeam (kept at 0.8.5, the version LINC 5.2 uses)
    ('Python', '3.14.2'),
    ('SciPy-bundle', '2026.05'),
    ('matplotlib', '3.10.9'),
    ('astropy', '8.0.1'),
    ('python-casacore', '3.8.1'),
    ('PyVO', '1.9.1'),  # no longer marked optional: listed as a dependency of LSMTool 1.9
    # new dependencies since LSMTool 1.7:
    ('lofar-parameterset', '1.1'),
    ('mocpy', '0.20.0'),
    ('Shapely', '2.1.2'),
    ('Pillow', '12.2.0'),
    ('PyBDSF', '1.14.1'),
]

exts_list = [
    ('lsmtool', '1.9.0', {'checksums': ['281243b0f82263ca7bf5332728c84813da46ce85fa1a6a510d6597f762eb4d10']}),
]

moduleclass = 'astro'
