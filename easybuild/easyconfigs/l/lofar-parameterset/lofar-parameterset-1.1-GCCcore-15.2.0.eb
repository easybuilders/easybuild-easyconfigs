easyblock = 'PythonBundle'

name = 'lofar-parameterset'
version = '1.1'

homepage = 'https://git.astron.nl/lofar2.0/lofar_pyparameterset'
description = "Python library to read and write LOFAR parameter sets (parsets), as used by e.g. DP3 and LoSoTo."

# New easyconfig: new dependency of LSMTool 1.9 and LoSoTo 2.7
toolchain = {'name': 'GCCcore', 'version': '15.2.0'}

builddependencies = [
    ('binutils', '2.45'),
]
dependencies = [
    ('Python', '3.14.2'),
]

exts_list = [
    ('lofar-parameterset', version, {
        'modulename': 'lofar_parameterset',
        'source_tmpl': 'lofar_parameterset-%(version)s.tar.gz',
        'checksums': ['d0022f4bc7c6f052d7775b8a53003c1dcda130cab996c3ae0dcf65b0f74c3315'],
    }),
]

moduleclass = 'astro'
