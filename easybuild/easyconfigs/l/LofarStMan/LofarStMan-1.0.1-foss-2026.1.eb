easyblock = 'CMakeMake'

name = 'LofarStMan'
version = '1.0.1'

homepage = 'https://github.com/lofar-astron/LofarStMan'
description = """
This package provides a casacore storage manager to read raw correlator output of the LOFAR telescope.
"""

toolchain = {'name': 'foss', 'version': '2026.1'}

# 1.0.1 is what LINC 5.2 uses (was 1.0)
source_urls = [GITHUB_LOWER_SOURCE]
sources = [V_VERSION_TAR_GZ]
checksums = ['9e5d287a5437b9ad807ed43c2763c1f2c3d81eb9477e6bc4c4dd9affaecd6b20']

builddependencies = [
    ('binutils', '2.45'),
    ('CMake', '3.31.11'),
]
dependencies = [
    ('casacore', '3.8.1'),
]

github_account = 'lofar-astron'

sanity_check_paths = {
    'files': ['lib/liblofarstman.so'],
    'dirs': ['lib'],
}

moduleclass = 'astro'
