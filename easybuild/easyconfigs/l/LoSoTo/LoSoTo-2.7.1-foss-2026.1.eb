easyblock = 'PythonBundle'

name = 'LoSoTo'
version = '2.7.1'

homepage = 'https://revoltek.github.io/losoto/'
description = """
LoSoTo: LOFAR solutions tool
"""

toolchain = {'name': 'foss', 'version': '2026.1'}

# The Cython builddependency was dropped: not needed to build LoSoTo 2.7
dependencies = [
    ('HDF5', '2.1.1'),
    ('Python', '3.14.2'),
    ('PyTables', '3.11.1'),
    ('SciPy-bundle', '2026.05'),
    ('matplotlib', '3.10.9'),
    ('python-casacore', '3.8.1'),
    ('lofar-parameterset', '1.1'),  # new requirement of LoSoTo 2.7
]

# The 'configparser' extension is dropped (not needed), and LoSoTo is now installed from the PyPI sdist instead of a
# GitHub archive (so no github_account / custom source_urls needed anymore)
exts_list = [
    # new requirement of LoSoTo 2.7
    ('progressbar', '2.5', {
        'checksums': ['5d81cb529da2e223b53962afd6c8ca0f05c6670e40309a7219eacc36af9b6c63'],
    }),
    ('losoto', version, {
        'checksums': ['60503f11d4c17a8c2b6c740e3a2cc916b98b31d36fd447242671f52c10133adf'],
    }),
]

moduleclass = 'astro'
