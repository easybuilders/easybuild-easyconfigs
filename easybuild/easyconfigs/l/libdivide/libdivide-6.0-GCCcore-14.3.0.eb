# Author: sreenivasamurthy kolam <sreenivasamurthy.kolam@amd.com>

easyblock = 'CMakeMake'

name = 'libdivide'
version = '6.0'
local_commit = 'af7be6946c7a217023611e877cdf6ba93e880e30'

homepage = 'https://libdivide.com'
description = """libdivide is a header-only C/C++ library for optimizing integer division.
Integer division is one of the slowest instructions on most CPUs. libdivide allows you to
replace expensive integer divisions with comparably cheap multiplication and bitshifts."""

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}

source_urls = ['https://github.com/ridiculousfish/libdivide/archive/']
sources = [{
    'download_filename': '%s.tar.gz' % local_commit,
    'filename': '%(name)s-%(version)s.tar.gz',
}]
checksums = ['78ce9ff24a17d37aa9bb994f05222da877e741d7840d9fadb270bc4eb37619a3']

builddependencies = [
    ('CMake', '3.31.8'),
    ('binutils', '2.44'),
]

configopts = '-DBUILD_TESTS=OFF '

sanity_check_paths = {
    'files': ['include/libdivide.h'],
    'dirs': ['include'],
}

moduleclass = 'lib'
