easyblock = 'CMakeMake'

name = 'libSRTP'
version = '2.8.0'

homepage = 'https://github.com/cisco/libsrtp'
description = 'Library for SRTP (Secure Realtime Transport Protocol)'

toolchain = {'name': 'GCCcore', 'version': '15.2.0'}

source_urls = ['https://github.com/cisco/libsrtp/archive/refs/tags/']
sources = [{'filename': SOURCE_TAR_GZ, 'download_filename': 'v%(version)s.tar.gz'}]
checksums = ['d123dcff5c56d4f1a9006f2b311ea99a85016cbf3bb24b1007885d422237db85']

builddependencies = [
    ('binutils', '2.45'),
    ('CMake', '4.2.1'),
]

dependencies = [('OpenSSL', '3', '', SYSTEM)]

configopts = '-DBUILD_SHARED_LIBS=ON -DENABLE_OPENSSL=ON'

sanity_check_paths = {
    'files': ['include/srtp2/srtp.h', f'lib/libsrtp2.{SHLIB_EXT}'],
    'dirs': [],
}

moduleclass = 'lib'
