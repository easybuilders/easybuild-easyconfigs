easyblock = 'PythonBundle'

name = 'Geneformer'
version = '0.1.0-20260526'
local_commit = '04c2b2e'

homepage = 'https://huggingface.co/ctheodoris/Geneformer'
description = """Geneformer is a foundational transformer model pretrained on a large-scale
corpus of single cell transcriptomes to enable context-aware predictions in settings
with limited data in network biology."""

toolchain = {'name': 'foss', 'version': '2024a'}

source_deps = [('git-lfs', '3.7.1', '', SYSTEM)]
builddependencies = [('Cython', '3.0.10')]
dependencies = [
    ('Python', '3.12.3'),
    ('PyTorch', '2.6.0'),
    ('SciPy-bundle', '2024.05'),
    ('bitsandbytes', '0.46.1'),
    ('HF-Datasets', '4.0.0'),
    ('loompy', '3.0.8'),
    ('matplotlib', '3.9.2'),
    ('Optuna', '4.1.0'),
    ('Arrow', '17.0.0'),
    ('Ray-project', '2.37.0'),
    ('scanpy', '1.10.4'),
    ('scikit-learn', '1.5.2'),
    ('Seaborn', '0.13.2'),
    ('statsmodels', '0.14.4'),
    ('tensorboard', '2.18.0'),
    ('tqdm', '4.66.5'),
    ('Transformers', '4.57.1'),
    ('accelerate', '1.10.0'),
    ('anndata', '0.11.4'),
]

# Required Geneformer Git LFS data files; pretrained model checkpoints are excluded
local_lfs_files = [
    'geneformer/gene_median_dictionary_gc104M.pkl',
    'geneformer/gene_name_id_dict_gc104M.pkl',
    'geneformer/ensembl_mapping_dict_gc104M.pkl',
    'geneformer/token_dictionary_gc104M.pkl',
    'geneformer/gene_dictionaries_30m/gene_median_dictionary_gc30M.pkl',
    'geneformer/gene_dictionaries_30m/gene_name_id_dict_gc30M.pkl',
    'geneformer/gene_dictionaries_30m/ensembl_mapping_dict_gc30M.pkl',
    'geneformer/gene_dictionaries_30m/token_dictionary_gc30M.pkl',
]

exts_list = [
    ('optuna-integration', '4.1.0', {
        'checksums': ['86201502fab9c3bba8aa6ffaac0f465b0bcdb75ec75fd157eda8b96352fb3cf3'],
    }),
    ('peft', '0.15.2', {
        'checksums': ['7059029f4d42a092ded1aa117dd366a46084aef638bdd593f6ab0195d5427fcd'],
    }),
    ('accumulation_tree', '0.6.4', {
        'checksums': ['5f907667e4106b5ba140b6b871e1902eb2a93d429b92f8a9f7ddb2bee7704334'],
    }),
    ('pyudorandom', '1.0.0', {
        'checksums': ['f30a093a0170c15f9c7f87eb29f71f0f5fde995528b7c6dc4606d389e8c37755'],
    }),
    ('tdigest', '0.5.2.2', {
        'source_tmpl': SOURCE_PY3_WHL,
        'checksums': ['dd25f8d6e6be002192bba9e4b8c16491d36c10b389f50637818603d1f67c6fb2'],
    }),
    (name, '0.1.0', {
        'sources': [{
            'filename': '%(name)s-%(version)s.tar.xz',
            'git_config': {
                'url': 'https://huggingface.co/ctheodoris',
                'repo_name': name,
                'commit': local_commit,
                'extra_config_params': [
                    'lfs.fetchinclude=' + ','.join(local_lfs_files),
                ],
            },
        }],
        'patches': ['Geneformer-0.1.0-20260526_fix-Transformers-Trainer-API.patch'],
        'checksums': [
            {'Geneformer-0.1.0.tar.xz': 'ca35414b87607a7e2a7ca8d49accac1c6eec813c66476b50acee9bcc8a9906cc'},
            {'Geneformer-0.1.0-20260526_fix-Transformers-Trainer-API.patch':
             '2a35ebebfce71615863ec8af598cff7bf319dfe828e94153f5b295feb75b7653'},
        ],
    }),
]

moduleclass = 'bio'
