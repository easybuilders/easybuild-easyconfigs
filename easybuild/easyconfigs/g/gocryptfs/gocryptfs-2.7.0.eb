easyblock = 'GoPackage'

name = 'gocryptfs'
version = '2.7.0'

homepage = 'https://nuetzlich.net/gocryptfs/'
description = """"gocryptfs uses file-based encryption that is implemented as a mountable FUSE filesystem.
Each file in gocryptfs is stored one corresponding encrypted file on the hard disk."""

toolchain = SYSTEM

source_urls = ['https://github.com/rfjakob/gocryptfs/releases/download/v%(version)s/']
sources = ['%(name)s_v%(version)s_src-deps.tar.gz']
checksums = ['52a271a12bcab3b2e51c0e7baa53a2beeebc9f811d8b28d6b23662a2b70e5680']

builddependencies = [
    ('Go', '1.26.10'),
]

sanity_check_paths = {
    'files': ['bin/%(name)s'],
    'dirs': []
}

sanity_check_commands = ['%(name)s --version']

moduleclass = 'tools'
