easyblock = 'MesonNinja'

name = 'GLibmm'
version = '2.90.0'

homepage = 'https://www.gtk.org/'
description = "C++ bindings for Glib"

toolchain = {'name': 'GCCcore', 'version': '15.2.0'}
toolchainopts = {'pic': True}

source_urls = ['https://ftp.gnome.org/pub/gnome/sources/%(namelower)s/%(version_major_minor)s/']
sources = [SOURCELOWER_TAR_XZ]
checksums = ['e2efa45643f16b9fea2d6299f2f403d672eaeacddf0ff7f8094e1af9b0f5980b']

builddependencies = [
    ('binutils', '2.45'),
    ('pkgconf', '2.5.1'),
    ('Meson', '1.10.2'),
    ('Ninja', '1.13.2'),
]
dependencies = [
    ('GLib', '2.89.0'),
    ('libsigc++', '3.8.1'),
]

configopts = '-Ddefault_library=both'


sanity_check_paths = {
    'files': ['lib/libglibmm-2.68.so', 'lib/libgiomm-2.68.so', 'include/%(namelower)s-2.68/%(namelower)s.h', 'include/giomm-2.68/giomm.h'],
    'dirs': ['lib/pkgconfig'],
}

moduleclass = 'vis'
