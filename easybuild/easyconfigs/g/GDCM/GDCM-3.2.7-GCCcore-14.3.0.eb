easyblock = 'CMakeMake'

name = 'GDCM'
version = '3.2.7'

homepage = 'https://sourceforge.net/projects/gdcm'
description = "Grassroots DICOM: Cross-platform DICOM implementation"

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}
toolchainopts = {'pic': True}

source_urls = ['https://github.com/malaterre/GDCM/archive/refs/tags/']
sources = [V_VERSION_TAR_GZ]
checksums = ['b7b17b70c009677cf244cc7837b88386441e097f8861fdeee83aa27d1bc1b090']

builddependencies = [
    ('binutils', '2.44'),
    ('CMake', '4.0.3'),
]

configopts = "-DGDCM_BUILD_DOCBOOK_MANPAGES=0"

sanity_check_paths = {
    'files': ['lib/libgdcmCommon.a', 'lib/libgdcmDICT.a'],
    'dirs': ['include/gdcm-%(version_major_minor)s', 'lib/gdcm-%(version_major_minor)s'],
}

moduleclass = 'tools'
