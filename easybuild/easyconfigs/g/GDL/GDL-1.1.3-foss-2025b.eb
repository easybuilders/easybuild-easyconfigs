easyblock = 'CMakeMake'

name = 'GDL'
version = '1.1.3'

homepage = 'https://github.com/gnudatalanguage/gdl/'
description = """GDL is a free/libre/open source incremental compiler compatible with IDL (Interactive Data Language)"""

toolchain = {'name': 'foss', 'version': '2025b'}
toolchainopts = {'openmp': True, 'usempi': True}

source_urls = ['https://github.com/gnudatalanguage/gdl/releases/download/v%(version)s/']
sources = ['%(namelower)s-v%(version)s.tar.gz']
checksums = ['7f2b39cec13d7589e7d810ca2197ffb080f80d3de0de440a8cba26e21cadf8a1']

builddependencies = [
    ('binutils', '2.44'),
    ('CMake', '4.0.3'),
]

dependencies = [
    ('libreadline', '8.2'),
    ('GSL', '2.8'),
    ('GraphicsMagick', '1.3.45'),
    ('wxWidgets', '3.3.1'),
    ('X11', '20250608'),
    ('netCDF', '4.9.3'),
    ('HDF', '4.3.1'),
    ('HDF5', '1.14.6'),
    ('shapelib', '1.6.3'),
    ('expat', '2.7.1'),
    ('Python', '3.13.5'),
    ('SciPy-bundle', '2025.07'),
    ('UDUNITS', '2.2.28'),
    ('Eigen', '3.4.0'),
    ('ecCodes', '2.43.0'),
    ('GLPK', '5.0'),
    ('libgeotiff', '1.7.4'),
    ('Qhull', '2020.2'),
]

configopts = ' '.join([
    '-DX11=ON',
    '-DMPI=ON',
])

sanity_check_paths = {
    'files': ['bin/gdl'],
    'dirs': ['bin', 'share'],
}

sanity_check_commands = ['gdl -h']

moduleclass = 'lang'
