easyblock = 'Tarball'

name = 'Go'
version = '1.23.6'

homepage = 'https://www.golang.org'
description = """Go is an open source programming language that makes it easy to build
 simple, reliable, and efficient software."""

toolchain = SYSTEM

source_urls = ['https://go.dev/dl/']
local_arch = {'aarch64': 'arm64', 'x86_64': 'amd64'}.get(ARCH, ARCH)
sources = ['go%%(version)s.linux-%s.tar.gz' % local_arch]
# note: checksums can be found at https://go.dev/dl/?mode=json
checksums = [{
    'go%(version)s.linux-amd64.tar.gz': '9379441ea310de000f33a4dc767bd966e72ab2826270e038e78b2c53c2e7802d',
    'go%(version)s.linux-arm64.tar.gz': '561c780e8f4a8955d32bf72e46af0b5ee5e0debe1e4633df9a03781878219202',
    'go%(version)s.linux-riscv64.tar.gz': 'f95f7f817ab22ecab4503d0704d6449ea1aa26a595f57bf9b9f94ddf2aa7c1f3',
}]

sanity_check_paths = {
    'files': ['bin/go', 'bin/gofmt'],
    'dirs': ['api', 'doc', 'lib', 'pkg'],
}

sanity_check_commands = ["go help"]

modextravars = {'GOROOT': '%(installdir)s'}

moduleclass = 'compiler'
