easyblock = 'Tarball'

name = 'GPUMDkit'
version = '1.5.9'
versionsuffix = '-CUDA-%(cudaver)s'

homepage = 'https://github.com/zhyan0603/GPUMDkit'
description = """GPUMDkit is a toolkit for the GPUMD (Graphics Processing Units Molecular Dynamics)
 and NEP (neuroevolution potential) programs. It provides a unified command-line entry point for
 common scripts, format conversion, structure sampling, NEP data preparation, analysis, and
 visualization."""

toolchain = {'name': 'foss', 'version': '2025a'}

github_account = 'zhyan0603'
source_urls = [GITHUB_LOWER_SOURCE]
sources = [V_VERSION_TAR_GZ]
checksums = ['536fa538cf0afc80db4197d87bbf292279337e24de4399698f6ec87b4b70ab6b']

dependencies = [
    ('CUDA', '12.8.0', '', SYSTEM),
    ('GPUMD', '5.9.1', versionsuffix),
    ('Python', '3.13.1'),
    ('SciPy-bundle', '2025.06'),
    ('matplotlib', '3.10.3'),
    ('ASE', '3.26.0'),
    ('scikit-learn', '1.7.0'),
    ('Seaborn', '0.13.2'),
    ('umap-learn', '0.5.9.post2'),
    ('tqdm', '4.67.1'),
    ('pymatgen', '2025.10.7'),
    ('pymatgen-analysis-diffusion', '2025.11.15'),
    ('dpdata', '1.1.0'),
]

# gpumdkit.sh locates Scripts/ and src/ via $GPUMDkit_path
modextravars = {'GPUMDkit_path': '%(installdir)s'}

# binaries are in installdir
modextrapaths = {'PATH': ''}

sanity_check_paths = {
    'files': ['gpumdkit.sh'],
    'dirs': ['Scripts', 'src'],
}

sanity_check_commands = ['gpumdkit.sh -h']

moduleclass = 'chem'
