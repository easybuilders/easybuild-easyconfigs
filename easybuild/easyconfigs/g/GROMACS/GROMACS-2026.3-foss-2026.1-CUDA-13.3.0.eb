name = 'GROMACS'
version = '2026.3'
versionsuffix = '-CUDA-%(cudaver)s'

homepage = 'https://www.gromacs.org'
description = """
GROMACS is a versatile package to perform molecular dynamics, i.e. simulate the
Newtonian equations of motion for systems with hundreds to millions of
particles.

This is a GPU enabled build, containing both MPI and threadMPI binaries.

It also contains the gmxapi extension for the single precision MPI build.
"""

toolchain = {'name': 'foss', 'version': '2026.1'}
toolchainopts = {'openmp': True, 'usempi': True}

source_urls = [
    'https://ftp.gromacs.org/pub/gromacs/',
    'ftp://ftp.gromacs.org/pub/gromacs/',
]
sources = [SOURCELOWER_TAR_GZ]
patches = [
    'GROMACS-2023.1_set_omp_num_threads_env_for_ntomp_tests.patch',
    'GROMACS-2023.1_fix_tests_for_gmx_thread_mpi.patch',
]
checksums = [
    {'gromacs-2026.3.tar.gz': '1094b7bbc6a3960223827114626657110b40096cdf9598a727935fc84ebf8aa0'},
    {'GROMACS-2023.1_set_omp_num_threads_env_for_ntomp_tests.patch':
     '7f41bda16c9c2837624265dda4be252f655d1288ddc4486b1a2422af30d5d199'},
    {'GROMACS-2023.1_fix_tests_for_gmx_thread_mpi.patch':
     '6df844bb3bbc51180446a3595c61a4ef195e5f975533a04cef76841aa763aec1'},
]

builddependencies = [
    ('CMake', '4.2.1'),
    ('scikit-build-core', '0.12.2'),
    ('pybind11', '3.0.4'),
]

dependencies = [
    ('CUDA', '13.3.0', '', SYSTEM),
    ('UCX-CUDA', '1.20.0', versionsuffix),
    ('hwloc-CUDA', '2.13.0', versionsuffix),
    ('Python', '3.14.2'),
    ('SciPy-bundle', '2026.05'),
    ('networkx', '3.6.1'),
    ('mpi4py', '4.1.2'),
]

# be a bit more forgiving w.r.t. timeouts for GROMACS test suite,
# see also https://gitlab.com/gromacs/gromacs/-/issues/5062
configopts = "-DGMX_TEST_TIMEOUT_FACTOR=3"

# prevent a HardwareTests issue on Grace Hopper systems,
# see https://gitlab.com/gromacs/gromacs/-/work_items/5623
pretestopts = 'export HWLOC_KEEP_NVIDIA_GPU_NUMA_NODES=0 && '

exts_defaultclass = 'PythonPackage'

_gmxapi_source_version = version

exts_list = [
    ('gmxapi', '0.5.0a1', {
        'patches': [
            'GROMACS-2024.1-fix-gmxapi-version.patch',
            'GROMACS-2026.2_gmxapi-find-OpenMP-CUDA-target.patch',
        ],
        'preinstallopts': 'export CMAKE_ARGS="-Dgmxapi_ROOT=%(installdir)s -C %(installdir)s/share/cmake/gromacs_mpi/gromacs-hints_mpi.cmake" && ',
        'source_tmpl': 'gromacs-2026.3.tar.gz',
        'start_dir': 'python_packaging/gmxapi',
        'checksums': [
            {'gromacs-2026.3.tar.gz': '1094b7bbc6a3960223827114626657110b40096cdf9598a727935fc84ebf8aa0'},
            {'GROMACS-2024.1-fix-gmxapi-version.patch':
             'df30b21352a26d8e01d693e2822db0ea45015c23f900a6ceb68522d44e6e790c'},
            {'GROMACS-2026.2_gmxapi-find-OpenMP-CUDA-target.patch':
             '40f80e3ac7b9c575affc89326a44765ce497ab6fea551ea3d47bba15b4103063'},
        ],
    }),
]

moduleclass = 'bio'
