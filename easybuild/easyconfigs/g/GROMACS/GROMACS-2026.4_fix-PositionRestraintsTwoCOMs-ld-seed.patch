             "ref-t            = 298\n"
             "tau-t            = 0.5\n"
+            "ld-seed          = 4\n"
             "deform           = 0 0 0 0 2.5 0\n"
             "deform-init-flow = yes\n";
 
@@ -213,7 +214,7 @@ TEST_F(PositionRestraintCommTest, PositionRestraintsTwoCOMs)
     {
         CommandLine mdrunCaller;
         ASSERT_EQ(0, runner_.callMdrun(mdrunCaller));
