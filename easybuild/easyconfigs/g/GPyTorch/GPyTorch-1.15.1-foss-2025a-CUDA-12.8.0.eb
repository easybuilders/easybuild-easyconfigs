easyblock = 'PythonBundle'

name = 'GPyTorch'
version = '1.15.1'
versionsuffix = '-CUDA-%(cudaver)s'

homepage = 'https://gpytorch.ai'
description = "GPyTorch is a Gaussian process library implemented using PyTorch."

toolchain = {'name': 'foss', 'version': '2025a'}

builddependencies = [('hatchling', '1.27.0')]
dependencies = [
    ('CUDA', '12.8.0', '', SYSTEM),
    ('Python', '3.13.1'),
    ('SciPy-bundle', '2025.06'),
    ('PyTorch', '2.9.1', versionsuffix),
    ('scikit-learn', '1.7.0'),
    ('PyKeOps', '2.3', versionsuffix),
    ('pyro-ppl', '1.9.1', versionsuffix),
]

exts_list = [
    ('wadler_lindig', '0.1.7', {
        'checksums': ['81d14d3fe77d441acf3ebd7f4aefac20c74128bf460e84b512806dccf7b2cd55'],
    }),
    ('jaxtyping', '0.3.7', {
        'checksums': ['3bd7d9beb7d3cb01a89f93f90581c6f4fff3e5c5dc3c9307e8f8687a040d10c4'],
    }),
    ('linear_operator', '0.6', {
        'checksums': ['a9e2663879f1a2b28631bf7ef34892c4e5749893e711c8ef0ab0a39aff70a654'],
    }),
    (name, version, {
        'sources': ['%(namelower)s-%(version)s.tar.gz'],
        'checksums': ['76d84d4ec5c4c3e99785f1b36043dbac2ff2d867be4afa758d5202606f0d17f9'],
    }),
]

moduleclass = 'lib'
