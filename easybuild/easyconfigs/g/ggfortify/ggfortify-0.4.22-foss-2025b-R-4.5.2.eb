easyblock = 'Bundle'

name = 'ggfortify'
version = '0.4.22'
versionsuffix = '-R-%(rver)s'

homepage = 'https://github.com/sinhrks/ggfortify'
description = """Data Visualization Tools for Statistical Analysis Results. ggfortify offers a single
plotting interface for these analysis results and plots in a unified style using 'ggplot2'."""

toolchain = {'name': 'foss', 'version': '2025b'}

dependencies = [
    ('R', '4.5.2'),
    ('R-bundle-CRAN', '2025.11'),
]

exts_defaultclass = 'RPackage'
exts_default_options = {
    'sources': ['%(name)s_%(version)s.tar.gz'],
    'source_urls': [
        'https://cran.r-project.org/src/contrib/Archive/%(name)s',  # package archive
        'https://cran.r-project.org/src/contrib/',  # current version of packages
        'https://cran.freestatistics.org/src/contrib',  # mirror alternative for current packages
    ],
}

exts_filter = ("R -q --no-save", "library(%(ext_name)s)")

exts_list = [
    ('gbutils', '0.5.1', {
        'checksums': ['097b1479760828d2e715a675a7dfe52dbe803ac352faafd6be3e176620cd517b'],
    }),
    ('cvar', '0.6.1', {
        'checksums': ['1bdd5f89c14f6d269238371337fdd18933d68b282c6ab083d560bfc614ca764f'],
    }),
    ('fGarch', '4052.93', {
        'checksums': ['ecd8e673f2303aaba02c9a8d3408369a6992d68ac7fc2a181fe522d299dbdecd'],
    }),
    ('KFAS', '1.6.0', {
        'checksums': ['48268eb44fd548cacd93bdb16473d0869e4b87947b6c582c0fd8118bacf1e987'],
    }),
    ('lfda', '1.1.3', {
        'checksums': ['636380e538f8fa41041fd4312bc6c3edf29b1ecd87bb0b3f171a32d26502646a'],
    }),
    ('vars', '1.6-1', {
        'checksums': ['9b3df03232fbedd30a89af10b20b540fce20ddd36602853857d47242d66f14c5'],
    }),
    (name, version, {
        'checksums': ['e02057b1073245dd4232494c68e4189d3607c837b664e1e4191f619ffbcf5098'],
    }),
]

modextrapaths = {'R_LIBS_SITE': ''}

sanity_check_paths = {
    'files': [],
    'dirs': [name],
}

moduleclass = 'vis'
