easyblock = 'PythonPackage'

name = 'gmx_MMPBSA'
version = '1.6.5'
versionsuffix = '-CUDA-12.8.0'

homepage = 'https://github.com/Valdes-Tresanco-MS/gmx_MMPBSA'
description = """gmx_MMPBSA performs end-state free-energy calculations with GROMACS files using
AmberTools' MMPBSA.py methods."""

toolchain = {'name': 'foss', 'version': '2025a'}

sources = ['gmx_mmpbsa-%(version)s.tar.gz']
patches = ['gmx_MMPBSA-1.6.5-foss-2025a_python313-deps.patch']
checksums = [
    {'gmx_mmpbsa-1.6.5.tar.gz': '59525eecad280406e77c3dcb78ebaffc05a50c0cbc29376ffcf79f25f0c0b9b6'},
    {'gmx_MMPBSA-1.6.5-foss-2025a_python313-deps.patch':
     '91af68361ae04dc7b92771fde0f4f105e25d57a140e8f0474dc65771657d7fd5'},
]

options = {'modulename': 'GMXMMPBSA'}

dependencies = [
    ('CUDA', '12.8.0', '', SYSTEM),
    ('Python', '3.13.1'),
    ('SciPy-bundle', '2025.06'),
    ('matplotlib', '3.10.3'),
    ('Seaborn', '0.13.2'),
    ('mpi4py', '4.1.0'),
    ('tqdm', '4.67.1'),
    ('AmberTools', '25.2'),
    ('GROMACS', '2025.3', '-CUDA-12.8.0'),
]

sanity_check_commands = [
    "python -c 'import GMXMMPBSA, parmed, seaborn, tqdm'",
    'gmx_MMPBSA --help',
    'gmx_MMPBSA_test --help',
    'gmx --version',
    'which sander',
]

moduleclass = 'chem'
