easyblock = 'Toolchain'

name = 'gmpich'
version = '2026.1'

homepage = '(none)'
description = """gcc and GFortran based compiler toolchain,
 including MPICH for MPI support."""

toolchain = SYSTEM

local_gccver = '15.2.0'

dependencies = [
    ('GCC', local_gccver),
    ('MPICH', '5.0.1', '', ('GCC', local_gccver)),
]

moduleclass = 'toolchain'
