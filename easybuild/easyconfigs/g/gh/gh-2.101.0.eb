easyblock = 'GoPackage'

name = 'gh'
version = '2.101.0'

homepage = 'https://github.com/cli/'
description = "GitHub’s official command line tool"

toolchain = SYSTEM

source_urls = ['https://github.com/cli/cli/archive']
sources = [V_VERSION_TAR_GZ]
checksums = ['a266fe8575c0e061b987920c1831a15f71bf0036a8729a5ebb93c2fb0164899c']

builddependencies = [
    ('Go', '1.26.7')
]

installopts = './cmd/%(name)s'

sanity_check_paths = {
    'files': ['bin/%(name)s'],
    'dirs': []
}

sanity_check_commands = ['%(name)s --version']

moduleclass = 'tools'
