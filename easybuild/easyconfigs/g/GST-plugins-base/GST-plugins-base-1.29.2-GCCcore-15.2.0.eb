easyblock = 'MesonNinja'

name = 'GST-plugins-base'
version = '1.29.2'

homepage = 'https://gstreamer.freedesktop.org/'
description = """GStreamer is a library for constructing graphs of media-handling
 components. The applications it supports range from simple
 Ogg/Vorbis playback, audio/video streaming to complex audio
 (mixing) and video (non-linear editing) processing."""

toolchain = {'name': 'GCCcore', 'version': '15.2.0'}

source_urls = ['https://gstreamer.freedesktop.org/src/gst-plugins-base']
sources = [SOURCELOWER_TAR_XZ]
checksums = ['eaaaa0bb455812e2277d14c9be8dd3136e2c607e34efd401a33d4b384b2f0253']

builddependencies = [
    ('binutils', '2.45'),
    ('Meson', '1.10.2'),
    ('Ninja', '1.13.2'),
    ('GObject-Introspection', '1.86.0'),
    ('gettext', '0.26'),
    ('pkgconf', '2.5.1'),
    ('Bison', '3.8.2'),
]

dependencies = [
    ('zlib', '2.3.2'),
    ('GLib', '2.89.0'),
    ('GStreamer', '1.29.2'),
    ('Gdk-Pixbuf', '2.44.6'),
    ('X11', '20260518'),
    ('OpenGL', '2026.05'),
    ('Graphene', '1.10.8'),
    ('alsa-lib', '1.2.15.3'),
    ('libogg', '1.3.6'),
    ('libopus', '1.6.1'),
    ('libvorbis', '1.3.7'),
    ('Pango', '1.57.1'),
]

modextrapaths = {
    'GST_PLUGIN_PATH': 'lib/gstreamer-1.0',
}

sanity_check_paths = {
    'files': [f'bin/gst-{x}-1.0' for x in ['discoverer', 'play', 'device-monitor']] +
             [f'lib/libgst{x}-1.0.{SHLIB_EXT}' for x in ['app', 'audio', 'video']],
    'dirs': ['include', 'share']
}

moduleclass = 'vis'
