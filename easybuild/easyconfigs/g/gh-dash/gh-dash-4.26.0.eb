easyblock = 'GoPackage'

name = 'gh-dash'
version = '4.26.0'

homepage = 'https://github.com/dlvhdr/gh-dash'
description = "A rich terminal UI for GitHub that doesn't break your flow."

toolchain = SYSTEM

source_urls = ['https://github.com/dlvhdr/gh-dash/archive/refs/tags/']
sources = [V_VERSION_TAR_GZ]
checksums = ['401847f58a3edfdeda95d0aeabc47658078448724d652566f6c9a04f1513543d']

builddependencies = [
    ('Go', '1.26.7')
]

#installopts = './cmd/%(name)s'

sanity_check_paths = {
    'files': ['bin/%(name)s'],
    'dirs': []
}

sanity_check_commands = ['%(name)s --version']

moduleclass = 'tools'
