easyblock = 'MesonNinja'

name = 'gtkmm4'
version = '4.22.0'  # note: even minor versions are stable

homepage = 'https://gtkmm.gnome.org'
description = "gtkmm is the official C++ interface for the popular GUI library GTK."

toolchain = {'name': 'GCCcore', 'version': '15.2.0'}

source_urls = ['https://download.gnome.org/sources/gtkmm/%(version_major_minor)s/']
sources = ['gtkmm-%(version)s.tar.xz']
checksums = ['2e8a21b4b0725f620e33aaee0cd343ed121b533275b632896619b1c89e96de67']

builddependencies = [
    ('binutils', '2.45'),
    ('Meson', '1.10.2'),
    ('Ninja', '1.13.2'),
    ('mm-common', '1.0.7'),
]
dependencies = [
    ('GTK4', '4.22.5'),
    ('libsigc++', '3.8.1'),
    ('cairomm', '1.19.1'),
    ('pangomm', '2.56.1'),
]

configopts = "-Ddefault_library=both -Dbuild-tests=false -Dbuild-demos=false"


sanity_check_paths = {
    'files': ['lib/libgtkmm-4.0.so', 'lib/libgtkmm-4.0.a'],
    'dirs': ['include'],
}

moduleclass = 'lib'
