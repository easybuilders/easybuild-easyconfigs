# Barcelona Supercomputing Center - Spain

easyblock = 'PythonBundle'

name = 'geopy'
version = '2.5.0'

homepage = 'https://geopy.readthedocs.io/'
description = """geopy is a Python client for several popular geocoding web services.
geopy makes it easy for Python developers to locate the coordinates of
addresses, cities, countries, and landmarks across the globe using third-party
geocoders and other data sources."""

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}

builddependencies = [
    ('binutils', '2.44'),
]

dependencies = [
    ('Python', '3.13.5'),
]

exts_list = [
    ('geographiclib', '2.1', {
        'checksums': ['6a6545e6262d0ed3522e13c515713718797e37ed8c672c31ad7b249f372ef108'],
    }),
    (name, version, {
        'checksums': ['7b6c849f18108dcce4faa3d614e2801107b465f7b05fd3c1db9db12e225ae950'],
    }),
]

moduleclass = 'geo'
