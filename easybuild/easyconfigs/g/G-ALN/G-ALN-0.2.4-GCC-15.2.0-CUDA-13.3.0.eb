easyblock = 'CMakeMake'

name = 'G-ALN'
version = '0.2.4'
versionsuffix = '-CUDA-%(cudaver)s'

homepage = 'https://github.com/bilalbioinfo/galn'

description = """
G-ALN is a GPU implementation of BWA-aln and its indexing algorithm that produces byte-identical results while significantly improving performance.
More information at https://github.com/bilalbioinfo/galn
"""

toolchain = {'name': 'GCC', 'version': '15.2.0'}

source_urls = ['https://github.com/bilalbioinfo/galn/archive']
sources = [V_VERSION_TAR_GZ]
patches = [
    'G-ALN-0.2.4_fix_ffp-contract_for_non_GNU.patch',
    'G-ALN-0.2.4_add_install_directive.patch',
]
checksums = [
    {'v0.2.4.tar.gz': '1a2b8ae6916d39257d625d97fbc6a49af145badb0e44419f0726ee80f55065f3'},
    {'G-ALN-0.2.4_fix_ffp-contract_for_non_GNU.patch':
     '6cca39be35299d3fbba48f6ebe2a882fbdaac7450741dd5db55c6542c7173f79'},
    {'G-ALN-0.2.4_add_install_directive.patch': '2e79e3ee28e753ba19fbfa3faf67bad3cffd47cc0083bf93449d8a1052d2e60e'},
]

builddependencies = [
    ('CMake', '4.2.1'),
]

dependencies = [
    ('CUDA', '13.3.0', '', SYSTEM),
]

sanity_check_paths = {
    'files': ['bin/galn'],
    'dirs': [],
}

moduleclass = 'bio'
