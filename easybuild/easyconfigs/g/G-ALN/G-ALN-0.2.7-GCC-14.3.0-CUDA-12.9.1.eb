easyblock = 'CMakeMake'

name = 'G-ALN'
version = '0.2.7'
versionsuffix = '-CUDA-%(cudaver)s'

homepage = 'https://github.com/bilalbioinfo/galn'
description = 'GPU implementation of bwa aln and bwa index with byte-identical output to BWA 0.7.19'

toolchain = {'name': 'GCC', 'version': '14.3.0'}

source_urls = ['https://github.com/bilalbioinfo/galn/archive/refs/tags/']
sources = [V_VERSION_TAR_GZ]

builddependencies = [
    ('CMake', '4.0.3'),
    ('googletest', '1.17.0'),
]

dependencies = [
    ('CUDA', '12.9.1', '', SYSTEM),
]

skipsteps = ['install']
postinstallcmds = [
    'mkdir -p %(installdir)s/bin',
    'cp galn %(installdir)s/bin',
]

sanity_check_paths = {
    'files': ['bin/galn'],
    'dirs': [],
}

moduleclass = 'bio'
