easyblock = "PythonPackage"

name = 'GPAW'
version = '26.7.0'
_aseversion = '3.29.0'
versionsuffix = '-ASE-' + _aseversion

homepage = 'https://wiki.fysik.dtu.dk/gpaw/'
description = """GPAW is a density-functional theory (DFT) Python code based on the projector-augmented wave (PAW)
 method and the atomic simulation environment (ASE). It uses real-space uniform grids and multigrid methods or
 atom-centered basis-functions."""

toolchain = {'name': 'intel', 'version': '2025b'}
toolchainopts = {'usempi': True, 'openmp': False}

source_urls = ['https://gitlab.com/gpaw/gpaw/-/archive/%(version)s/']
sources = [SOURCELOWER_TAR_GZ]
patches = ['GPAW-26.7.0-Fix-intel-compiler-name.patch']
checksums = [
    {'gpaw-26.7.0.tar.gz': 'a1623c0575a37a662c64bad708b8a1caa6b505c105d9d494e3371575f6905386'},
    {'GPAW-26.7.0-Fix-intel-compiler-name.patch': '9566e9f0ba236b77940d4a25ca78effadae50635c1e3536e8485722ececcdaff'},
]

dependencies = [
    ('Python', '3.13.5'),
    ('Python-bundle-PyPI', '2025.07'),
    ('SciPy-bundle', '2025.07'),
    ('ASE', _aseversion),
    ('pybind11', '3.0.0'),
    ('libxc', '7.0.0'),
    # ('libvdwxc', '0.5.0'),  # libvdwxc is not compatible with the Intel Math Kernel Library.
    ('ELPA', '2025.06.002'),
    ('PyYAML', '6.0.2'),
    ('gpaw-data', '1.0.1'),
]

prebuildopts = 'GPAW_CONFIG=doc/platforms/Linux/EasyBuild/config_intel.py'
preinstallopts = prebuildopts

testinstall = True
runtest = 'gpaw test && PRTE_MCA_rmaps_default_mapping_policy=:oversubscribe gpaw -P 4 test'

sanity_check_paths = {
    'files': ['bin/gpaw%s' % x for x in ['', '-analyse-basis', '-basis', '-plot-parallel-timings',
                                         '-runscript', '-setup', '-upfplot']],
    'dirs': ['lib/python%(pyshortver)s/site-packages']
}

moduleclass = 'chem'
