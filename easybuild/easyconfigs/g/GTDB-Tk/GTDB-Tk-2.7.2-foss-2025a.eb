easyblock = 'PythonBundle'

name = 'GTDB-Tk'
version = '2.7.2'

homepage = 'https://github.com/Ecogenomics/GTDBTk'
description = "A toolkit for assigning objective taxonomic classifications to bacterial and archaeal genomes."

toolchain = {'name': 'foss', 'version': '2025a'}

dependencies = [
    ('Python', '3.13.1'),
    ('DendroPy', '5.0.8'),
    ('matplotlib', '3.10.3'),
    ('prodigal', '2.6.3'),
    ('HMMER', '3.4'),
    ('pplacer', '1.1.alpha19', '', SYSTEM),
    ('skani', '0.4.0'),
    ('FastTree', '2.2'),
    ('Mash', '2.3'),
    ('tqdm', '4.67.1'),
    ('pydantic', '2.11.7'),
]

exts_list = [
    ('gtdbtk', version, {
        'checksums': ['786493c1b89a83b73e6b77d82eb8d0e0e1f0df0e2540b1a6f2ba334b82b172cc'],
    }),
]

sanity_check_paths = {
    'files': ['bin/gtdbtk'],
    'dirs': ['lib/python%(pyshortver)s/site-packages'],
}

sanity_check_commands = ["gtdbtk --help"]

moduleclass = 'bio'
