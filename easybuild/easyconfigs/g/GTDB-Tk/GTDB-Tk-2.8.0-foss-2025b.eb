easyblock = 'PythonBundle'

name = 'GTDB-Tk'
version = '2.8.0'

homepage = 'https://github.com/Ecogenomics/GTDBTk'
description = "A toolkit for assigning objective taxonomic classifications to bacterial and archaeal genomes."

toolchain = {'name': 'foss', 'version': '2025b'}

dependencies = [
    ('Python', '3.13.5'),
    ('DendroPy', '5.0.8'),
    ('matplotlib', '3.10.5'),
    ('prodigal', '2.6.3'),
    ('HMMER', '3.4'),
    ('pplacer', '1.1.alpha19', '', SYSTEM),
    ('skani', '0.4.0'),
    ('FastTree', '2.2'),
    ('Mash', '2.3'),
    ('tqdm', '4.67.1'),
    ('pydantic', '2.11.9'),
]

exts_list = [
    ('gtdbtk', version, {
        'preinstallopts': 'sed -i "s/~=/>=/g" setup.py &&',
        'checksums': ['42e9b04db4490ff12ce5288d07d76b0148649a6b019cd32c7d4728b5d61779e2'],
    }),
]

sanity_check_paths = {
    'files': ['bin/gtdbtk'],
    'dirs': ['lib/python%(pyshortver)s/site-packages'],
}

sanity_check_commands = ["gtdbtk --help"]

moduleclass = 'bio'
