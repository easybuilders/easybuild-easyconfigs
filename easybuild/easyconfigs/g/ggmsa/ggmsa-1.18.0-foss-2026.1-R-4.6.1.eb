easyblock = 'Bundle'

name = 'ggmsa'
version = '1.18.0'
versionsuffix = '-R-%(rver)s'
local_biocver = '3.23'

homepage = 'https://www.bioconductor.org/packages/3.23/bioc/html/ggmsa.html'
description = """A visual exploration tool for multiple sequence alignments and associated data. Supports DNA,
 RNA and protein sequences using ggplot2, including sequence logos, sequence bundles, RNA secondary structures
 and detection of sequence recombinations."""

toolchain = {'name': 'foss', 'version': '2026.1'}

dependencies = [
    ('R', '4.6.1'),
    ('R-bundle-Bioconductor', local_biocver, versionsuffix),
]

exts_default_options = {
    'source_urls': [
        'https://bioconductor.org/packages/%s/bioc/src/contrib/' % local_biocver,
        'https://bioconductor.org/packages/%s/bioc/src/contrib/Archive/%%(name)s' % local_biocver,
        'https://bioconductor.org/packages/%s/data/annotation/src/contrib/' % local_biocver,
        'https://bioconductor.org/packages/%s/data/experiment/src/contrib/' % local_biocver,
        'https://cran.r-project.org/src/contrib/Archive/%(name)s',  # package archive
        'https://cran.r-project.org/src/contrib/',  # current version of packages
        'https://cran.freestatistics.org/src/contrib',  # mirror alternative for current packages
    ],
    'sources': ['%(name)s_%(version)s.tar.gz'],
}

exts_defaultclass = 'RPackage'

exts_filter = ("R -q --no-save", "library(%(ext_name)s)")

exts_list = [
    ('R4RNA', '1.40.0', {
        'checksums': ['1358d0c00c5cce34d6443dbb81ec4d074a92583cc9e3208fbb26fafba05c65c5'],
    }),
    ('seqmagick', '0.1.8', {
        'checksums': ['259591499edc61d947e135a44f0ef91f6fc002104172974b0cfd991c5df387b8'],
    }),
    (name, version, {
        'checksums': ['c6f55d47cde41e81f19e83c1a6084004fe139f5a8850eb0ab11b29055630d82c'],
    }),
]

modextrapaths = {'R_LIBS_SITE': ''}

sanity_check_paths = {
    'files': [],
    'dirs': [name],
}

moduleclass = 'bio'
