easyblock = 'Tarball'

name = 'git-credential-manager'
version = '2.9.1'

homepage = ''
description = """Secure, cross-platform Git credential storage with authentication to GitHub, Azure Repos, and other
popular Git hosting services."""

toolchain = SYSTEM

source_urls = ['https://github.com/git-ecosystem/git-credential-manager/releases/download/v%(version)s/']
local_arch = {'x86_64': 'x64'}.get(ARCH, ARCH)
sources = [f'gcm-linux-{local_arch}-%(version)s.tar.gz']
checksums = [{
    'gcm-linux-arm64-%(version)s.tar.gz': 'cf3806b7528b5a5af16bd4bd0683202fc432d9008dd91d20c4c6744b24a033b5',
    'gcm-linux-x64-%(version)s.tar.gz': '31fc151c3b111ffe25616a4356bd9a50bdcdbd0922c5e11990fb220c6caf1ce1',
}]

modextrapaths = {'PATH': '.'}

sanity_check_paths = {
    'files': ['git-credential-manager'],
    'dirs': [],
}

sanity_check_commands = ['git-credential-manager -h']

moduleclass = 'tools'
