easyblock = 'CMakeMake'

name = 'GauXC'
version = '1.1'
versionsuffix = '-CUDA-%(cudaver)s'

homepage = 'https://github.com/wavefunction91/GauXC'
description = """GauXC is a modern, modular C++ library for the evaluation of quantities related to the
exchange-correlation (XC) energy (e.g. potential, etc) in the Gaussian basis set discretization of Kohn-Sham density
function theory (KS-DFT) on heterogenous architectures."""

toolchain = {'name': 'foss', 'version': '2025b'}

source_urls = ['https://github.com/wavefunction91/GauXC/archive/refs/tags/']
# Prefetch old HighFive version, required due for tests to pass due to incorrect storage
# ref. https://github.com/wavefunction91/GauXC/pull/234
sources = [
    V_VERSION_TAR_GZ,
    {
        'filename': 'https://github.com/highfive-devs/highfive/archive/805f0e1.tar.gz',
        'extract_cmd': 'mkdir -p highfive-src && tar xf %s --strip-components=1 -C highfive-src',
    },
]
patches = [
    'GauXC-%(version)s_external_cereal.patch',
    'GauXC-%(version)s_linalg_cmake.patch',
    'GauXC-%(version)s_cereal.patch',
]
#checksums = ['17de077fb23e44d03b0ed14dcd8117c01e5b3431fbefa2352d751639ada7f91c']

builddependencies = [
    ('binutils', '2.44'),
    ('CMake', '4.0.3'),
    ('pkgconf', '2.4.3'),
    ('ExchCXX', '1.0.0', versionsuffix), # Only static libraries
    ('IntegratorXX', '1.0.0'),  # Only static libraries
    ('Catch2', '2.13.10'),
    ('Cereal', '1.3.2'),
    ('Eigen', '3.4.0'),
]

dependencies = [
    ('HDF5', '1.14.6'),
    ('libxc', '7.0.0'),
    ('CUDA', '12.9.1', '', SYSTEM),
    ('NCCL', '2.27.7', versionsuffix),
    ('magma', '2.9.0', versionsuffix),
]

configopts = ' '.join([
   '-DFETCHCONTENT_FULLY_DISCONNECTED=ON',  # ensure we don't download deps
   '-DFETCHCONTENT_BASE_DIR=%(builddir)s',
   '-DCMAKE_POLICY_VERSION_MINIMUM=3.5',  # for old highfive
   '-DGAUXC_ENABLE_CUDA=ON',
   '-DGAUXC_ENABLE_MAGMA=ON',
])

runtest = 'test'

sanity_check_paths = {
    'files': [f'lib/libgauxc.a'],
    'dirs': ['include/gauxc'],
}

moduleclass = 'chem'
