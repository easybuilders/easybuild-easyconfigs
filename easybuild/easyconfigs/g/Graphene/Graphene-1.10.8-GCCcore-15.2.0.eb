easyblock = 'MesonNinja'

name = 'Graphene'
version = '1.10.8'

homepage = 'https://ebassi.github.io/graphene/'
description = "Graphene is a thin layer of types for graphic libraries"

toolchain = {'name': 'GCCcore', 'version': '15.2.0'}

github_account = 'ebassi'
source_urls = [GITHUB_LOWER_SOURCE]
sources = ['%(version)s.tar.gz']
checksums = ['922dc109d2dc5dc56617a29bd716c79dd84db31721a8493a13a5f79109a4a4ed']

builddependencies = [
    ('binutils', '2.45'),
    ('Meson', '1.10.2'),
    ('Ninja', '1.13.2'),
    ('pkgconf', '2.5.1'),
    ('GObject-Introspection', '1.86.0'),
]
dependencies = [('GLib', '2.89.0')]

configopts = "-Dgobject_types=true -Dintrospection=enabled"

sanity_check_paths = {
    'files': [f'lib/libgraphene-1.0.{SHLIB_EXT}', 'share/gir-1.0/Graphene-1.0.gir'],
    'dirs': ['include/graphene-1.0', 'lib/pkgconfig'],
}

moduleclass = 'lib'
