# This file is an EasyBuild reciPY as per https://github.com/easybuilders/easybuild

easyblock = 'PerlBundle'

name = 'GDGraph'
version = '1.56'

homepage = 'https://metacpan.org/release/GDGraph'
description = "GDGraph is a Perl package to generate charts"

toolchain = {'name': 'GCCcore', 'version': '15.2.0'}

builddependencies = [
    ('binutils', '2.45'),
    ('pkgconf', '2.5.1'),
]

dependencies = [
    ('Perl', '5.42.0'),
    ('libwebp', '1.6.0'),
    ('libaom', '3.14.0'),
    ('LERC', '4.1.0'),
    ('LibTIFF', '4.7.1'),
    ('libpng', '1.6.56'),
    ('libjpeg-turbo', '3.1.4.1'),
    ('libheif', '1.22.2'),
    ('libgd', '2.3.3'),
    ('GD', '2.86'),
]

exts_list = [
    ('ExtUtils::PkgConfig', '1.16', {
        'source_urls': ['https://cpan.metacpan.org/authors/id/X/XA/XAOC/'],
        'sources': ['ExtUtils-PkgConfig-%(version)s.tar.gz'],
        'checksums': ['bbeaced995d7d8d10cfc51a3a5a66da41ceb2bc04fedcab50e10e6300e801c6e'],
    }),
    ('Capture::Tiny', '0.50', {
        'sources': ['Capture-Tiny-0.50.tar.gz'],
        'source_urls': ['https://cpan.metacpan.org/authors/id/D/DA/DAGOLDEN/'],
        'checksums': ['ca6e8d7ce7471c2be54e1009f64c367d7ee233a2894cacf52ebe6f53b04e81e5'],
    }),
    ('Sub::Uplevel', '0.2800', {
        'sources': ['Sub-Uplevel-%(version)s.tar.gz'],
        'source_urls': ['https://cpan.metacpan.org/authors/id/D/DA/DAGOLDEN/'],
        'checksums': ['b4f3f63b80f680a421332d8851ddbe5a8e72fcaa74d5d1d98f3c8cc4a3ece293'],
    }),
    ('Test::Exception', '0.43', {
        'sources': ['Test-Exception-%(version)s.tar.gz'],
        'source_urls': ['https://cpan.metacpan.org/authors/id/E/EX/EXODIST/'],
        'checksums': ['156b13f07764f766d8b45a43728f2439af81a3512625438deab783b7883eb533'],
    }),
    ('GD::Text', '0.86', {
        'source_urls': ['https://cpan.metacpan.org/authors/id/M/MV/MVERB/'],
        'sources': ['GDTextUtil-%(version)s.tar.gz'],
        'checksums': ['886ecbf85cfe94f4135ee5689c4847a9ae783ecb99e6759e12c734f2dd6116bc'],
    }),
    ('GD::Graph', version, {
        'source_urls': ['https://cpan.metacpan.org/authors/id/B/BP/BPS/'],
        'sources': ['GDGraph-%(version)s.tar.gz'],
        'checksums': ['6f49cc4e59015480db9c9b6b18afd8c50be30886687b69411513d06f38971113'],
    }),
]

sanity_check_paths = {
    'files': [
        'lib/perl5/site_perl/%(perlver)s/GD/Graph.pm',
        'lib/perl5/site_perl/%(perlver)s/GD/Text.pm',
    ],
    'dirs': ['lib/perl5/site_perl/%(perlver)s/GD/Graph', 'man'],
}

sanity_check_commands = ["perl -e 'use GD; use GD::Graph; use GD::Text'"]

moduleclass = 'bio'
