# Author: sreenivasamurthy kolam <sreenivasamurthy.kolam@amd.com>

easyblock = 'ROCmComponent'

name = 'hipBLAS-common'
version = '1.4.0'
_rocm_version = '7.2.3'

homepage = 'https://github.com/ROCm/hipBLAS-common'
description = """hipBLAS-common is a header-only library that provides common files for hipBLAS and hipBLASLt."""

toolchain = {'name': 'rocm-compilers', 'version': f'22.0.0-ROCm-{_rocm_version}'}

github_account = 'ROCm'
local_repo_name = 'rocm-libraries'
source_urls = [f'https://github.com/{github_account}/{local_repo_name}/archive']
sources = [{
    'download_filename': f'rocm-{_rocm_version}.tar.gz',
    'filename': f'{local_repo_name}-rocm-{_rocm_version}.tar.gz',
}]
checksums = ['300cc50720d40bad7c7ed1f6d67e8c5ebecaba62c07a6ea1cc5813c0ea2e41b5']

builddependencies = [
    ('CMake', '3.31.8'),
]

# Build from the projects/hipblas-common subdirectory
start_dir = 'projects/hipblas-common'

sanity_check_paths = {
    'files': ['lib/cmake/hipblas-common/hipblas-common-config.cmake',
              'include/hipblas-common/hipblas-common.h'],
    'dirs': ['lib/cmake/hipblas-common',
             'share/doc/hipblas-common',
             'include/hipblas-common'],
}

moduleclass = 'lib'
