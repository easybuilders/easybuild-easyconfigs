# Author: sreenivasamurthy kolam <sreenivasamurthy.kolam@amd.com>

easyblock = 'Tarball'

name = 'half'
version = '1.12.0'

homepage = 'https://sourceforge.net/projects/half/'
description = """This is a C++ header-only library to provide an IEEE 754 conformant 16-bit
half-precision floating point type along with corresponding arithmetic
operators, type conversions and common mathematical functions. It aims for both
efficiency and ease of use, trying to accurately mimic the behaviour of the
builtin floating point types at the best performance possible."""
docurls = ['http://half.sourceforge.net']

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}

source_urls = [SOURCEFORGE_SOURCE]
sources = [SOURCELOWER_ZIP]
checksums = ['cdd70d3bf3fe091b688e7ab3f48471c881a197d2c186c95cca8bf156961fb41c']

postinstallcmds = [
    'mkdir -p %(installdir)s/include',
    'cp include/half.hpp %(installdir)s/include/',
    # Create half subdirectory and symlink for MIOpen compatibility
    'mkdir -p %(installdir)s/include/half',
    'ln -s %(installdir)s/include/half.hpp %(installdir)s/include/half/half.hpp',
]

sanity_check_paths = {
    'files': ['include/half.hpp'],
    'dirs': ['include'],
}

moduleclass = 'lib'
