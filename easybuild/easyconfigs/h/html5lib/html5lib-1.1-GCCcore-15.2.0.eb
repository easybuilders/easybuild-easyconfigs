easyblock = 'PythonBundle'

name = 'html5lib'
version = '1.1'

homepage = 'https://github.com/html5lib/html5lib-python'
description = """html5lib is a pure-python library for parsing HTML.
It is designed to conform to the WHATWG HTML specification, as is implemented by all major web browsers."""

toolchain = {'name': 'GCCcore', 'version': '15.2.0'}

builddependencies = [
    ('binutils', '2.45'),
]

dependencies = [
    ('Python', '3.14.2'),
    ('Python-bundle-PyPI', '2026.04'),
]

exts_list = [
    ('webencodings', '0.6.1', {
        'checksums': ['565f9ad031c702dae404e27a099e3e09186a3ab1b9520f06d215502b651fd910'],
    }),
    (name, version, {
        'patches': ['html5lib-1.1_fix-deprecated-AST-check.patch'],
        'checksums': [
            {'html5lib-1.1.tar.gz': 'b2e5b40261e20f354d198eae92afc10d750afb487ed5e50f9c4eaf07c184146f'},
            {'html5lib-1.1_fix-deprecated-AST-check.patch':
             '58cd96f537ec948c59d36247e18ab7074e7f60c730efb20eb6469cc4e3d6f2f2'},
        ],
    }),
]

moduleclass = 'lib'
