From ef8c35a1b34a07e04c48e5da5b9d913ad776b9f2 Mon Sep 17 00:00:00 2001
From: Afzal Patel <122491982+afzpatel@users.noreply.github.com>
Date: Tue, 25 Nov 2025 14:50:37 -0500
Subject: [PATCH 3/3] Update projects/hipblaslt/CMakeLists.txt

Co-authored-by: Braden Stefanuk <121893577+bstefanuk@users.noreply.github.com>
---
 projects/hipblaslt/CMakeLists.txt | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/projects/hipblaslt/CMakeLists.txt b/projects/hipblaslt/CMakeLists.txt
index 206642ad1d26..e4178cbcab6e 100644
--- a/projects/hipblaslt/CMakeLists.txt
+++ b/projects/hipblaslt/CMakeLists.txt
@@ -116,7 +116,13 @@ if(HIPBLASLT_ENABLE_HOST)
     endif()
     if(HIPBLASLT_ENABLE_MARKER)
         find_library(rocTracer roctx64 REQUIRED)
-        find_path(ROCTRACER_INCLUDE_DIR "roctracer/roctx.h" REQUIRED)
+        get_filename_component(ROCTRACER_LIB_DIR ${rocTracer} DIRECTORY)
+        get_filename_component(ROCTRACER_ROOT_DIR ${ROCTRACER_LIB_DIR} DIRECTORY)
+    
+        find_path(ROCTRACER_INCLUDE_DIR "roctracer/roctx.h" 
+            HINTS ${ROCTRACER_ROOT_DIR}
+            PATH_SUFFIXES include
+            REQUIRED)
     else()
         set(rocTracer)
     endif()
