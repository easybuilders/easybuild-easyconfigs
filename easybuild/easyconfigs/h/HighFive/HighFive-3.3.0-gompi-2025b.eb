easyblock = 'CMakeMake'

name = 'HighFive'
version = '3.3.0'

homepage = 'https://github.com/highfive-devs/highfive'
description = """HighFive is a modern, user-friendly, header-only, C++14 interface for libhdf5."""

toolchain = {'name': 'gompi', 'version': '2025b'}

github_account = 'highfive-devs'
source_urls = [GITHUB_SOURCE]
sources = [V_VERSION_TAR_GZ]
checksums = ['325cfbcf0c0296a6dd26f3b088801b7ebb8d6f109c0565c11d2d8c4af3253bff']

builddependencies = [
    ('CMake', '4.0.3'),
    ('binutils', '2.44'),
]

dependencies = [
    ('HDF5', '1.14.6'),
    ('Boost', '1.88.0'),
    ('Eigen', '3.4.0'),
]

sanity_check_paths = {
    'files': ['include/highfive/H5File.hpp'],
    'dirs': [],
}

configopts = ' '.join([
    '-DHIGHFIVE_UNIT_TESTS=OFF',
    '-DHIGHFIVE_EXAMPLES=OFF',
    '-DHIGHFIVE_BUILD_DOCS=OFF',
    '-DHIGHFIVE_USE_EIGEN=ON',
    '-DHIGHFIVE_PARALLEL_HDF5=ON',
])

moduleclass = 'lib'
