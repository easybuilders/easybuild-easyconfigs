# Author: sreenivasamurthy kolam <sreenivasamurthy.kolam@amd.com>

easyblock = 'ROCmComponent'

name = 'hipTensor'
version = '2.2.0'
_rocm_version = '7.2.3'

homepage = 'https://github.com/ROCm/hipTensor'
description = """hiptensor is AMD's C++ library for accelerating tensor primitives
using GPU matrix cores on AMD's latest discrete GPUs."""
docurls = ['https://rocm.docs.amd.com/projects/hipTensor/en/latest/']

toolchain = {'name': 'rocm-compilers', 'version': f'22.0.0-ROCm-{_rocm_version}'}

github_account = 'ROCm'
local_repo_name = 'rocm-libraries'
source_urls = [f'https://github.com/{github_account}/{local_repo_name}/archive']
sources = [{
    'download_filename': f'rocm-{_rocm_version}.tar.gz',
    'filename': f'{local_repo_name}-rocm-{_rocm_version}.tar.gz',
}]
checksums = ['300cc50720d40bad7c7ed1f6d67e8c5ebecaba62c07a6ea1cc5813c0ea2e41b5']

builddependencies = [
    ('CMake', '3.31.8'),
]

dependencies = [
    ('HIP', _rocm_version),
    ('composable_kernel', '1.2.0'),
]

# Build from the projects/hiptensor subdirectory
start_dir = 'projects/hiptensor'

sanity_check_paths = {
    'files': ['lib/cmake/hiptensor/hiptensorConfig.cmake',
              'include/hiptensor/hiptensor.hpp',
              'bin/hiptensor/bench/scripts/BenchmarkReduction.sh'],
    'dirs': ['lib/cmake/hiptensor',
             'share/doc/hiptensor',
             'include/hiptensor'],
}

moduleclass = 'lib'
