# Author: sreenivasamurthy kolam <sreenivasamurthy.kolam@amd.com>

easyblock = 'CMakeMake'

name = 'hipfort'
version = '7.2.3'
_rocm_version = '7.2.3'

homepage = 'https://github.com/ROCm/hipfort'
description = """Fortran Interface For GPU Kernel Libraries.
hipfort is a Fortran interface library for accessing GPU Kernels."""
docurls = ['https://rocm.docs.amd.com/projects/hipfort/en/latest/']

toolchain = {'name': 'rocm-compilers', 'version': f'22.0.0-ROCm-{_rocm_version}'}

source_urls = ['https://github.com/ROCm/hipfort/archive/refs/tags/']
sources = [{
    'download_filename': f'rocm-{_rocm_version}.tar.gz',
    'filename': f'hipfort-rocm-{_rocm_version}.tar.gz',
}]
checksums = ['21cb7049a1696a3f91666e5dcae184c496846c26618da3263affb7659fa659f5']

builddependencies = [
    ('CMake', '3.31.8'),
    ('rocm-cmake', '0.14.0'),
]

dependencies = [
    ('HIP', _rocm_version),
]

preconfigopts = 'export ROCM_PATH=$EBROOTHIP && '
preconfigopts += 'export FC=$EBROOTROCMMINLLVM/bin/amdflang && '

configopts = '-DHIPFORT_COMPILER=$EBROOTROCMMINLLVM/bin/amdflang '
configopts += '-DHIPFORT_COMPILER_FLAGS="-ffree-form -cpp" '

sanity_check_paths = {
    'files': ['lib/libhipfort-amdgcn.a', 'lib/libhipfort-nvptx.a',
              'include/hipfort/amdgcn/hipfort.mod', 'include/hipfort/nvptx/hipfort.mod'],
    'dirs': ['lib', 'include/hipfort/amdgcn', 'include/hipfort/nvptx'],
}

moduleclass = 'lib'
