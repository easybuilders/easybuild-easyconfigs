easyblock = 'PythonPackage'

name = 'hatch-mypyc'
version = '0.16.0'

homepage = 'https://pypi.org/project/hatch-mypyc/'
description = """This provides a build hook plugin for Hatch that compiles code with Mypyc."""

toolchain = {'name': 'GCCcore', 'version': '15.2.0'}

builddependencies = [
    ('binutils', '2.45'),
    ('pytest', '9.1.1'),
    ('build', '1.4.4'),
]
dependencies = [
    ('Python', '3.14.2'),
    ('hatchling', '1.33.0'),
    ('mypy', '2.4.1'),
]

source_urls = [PYPI_LOWER_SOURCE]
sources = ["hatch_mypyc-%(version)s.tar.gz"]
checksums = ['6e3aa99634d81142cab993358698eaae823de91fe87ee85029a82f2e737c3ded']

runtest = 'pytest'
testopts = "-k 'not (test_no_exclusion or test_exclusion or test_separation or test_src_layout or test_dependency " \
           "or test_build_dir or test_default_exclude or test_exclude)'"
testinstall = True

moduleclass = 'tools'
