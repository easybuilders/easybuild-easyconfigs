easyblock = 'PythonBundle'

name = 'Hydra'
version = '1.3.7'

homepage = "https://hydra.cc/"
description = """
Hydra is an open-source Python framework that simplifies the development of
research and other complex applications. The key feature is the ability to
dynamically create a hierarchical configuration by composition and override it
through config files and the command line. The name Hydra comes from its
ability to run multiple similar jobs - much like a Hydra with multiple heads.
"""

github_account = 'facebookresearch'

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}

builddependencies = [
    ('binutils', '2.44'),
    ('Java', '17', '', SYSTEM),  # needed by ANTLR runtime
]

dependencies = [
    ('Python', '3.13.5'),
    ('Python-bundle-PyPI', '2025.07'),
    ('PyYAML', '6.0.2'),  # needed by omegaconf
]

exts_list = [
    # This version needs to be 4.9.x
    ('antlr4-python3-runtime', '4.9.3', {
        'modulename': 'antlr4',
        'checksums': ['f224469b4168294902bb1efa80a8bf7855f24c99aef99cbefc1bcd3cce77881b'],
    }),
    ('omegaconf', '2.3.1', {
        'checksums': ['e5e7de64aeebeddaf8e6d3f7a783b32ac2a01c0fbd9c878012caecb891a1f42a'],
    }),
    ('hydra-core', version, {
        'modulename': 'hydra.core',
        'checksums': ['d4ff629c7e23b64a9db5fe5b027cf7c55b633b737f03be51ef41b77ed016f75e'],
    }),
]

moduleclass = 'data'
