easyblock = 'PythonBundle'

name = 'hdf5plugin'
version = '7.0.0'

homepage = 'https://hdf5plugin.readthedocs.io'
description = """hdf5plugin provides HDF5 compression filters (namely: Blosc, Blosc2, BitShuffle,
 BZip2, FciDecomp, LZ4, Sperr, SZ, SZ3, Zfp, ZStd) and makes them usable from h5py."""

toolchain = {'name': 'foss', 'version': '2025b'}

dependencies = [
    ('Python', '3.13.5'),
    ('py-cpuinfo', '9.0.0'),
    ('h5py', '3.14.0'),
]

exts_list = [
    (name, version, {
        'checksums': ['e6e6b1f8b0c4d2ca87e616ddc31d08330b36207e466357040f95269e5e0401c8'],
    }),
]

moduleclass = 'data'
