# Author: sreenivasamurthy kolam <sreenivasamurthy.kolam@amd.com>

easyblock = 'ROCmComponent'

name = 'hipCUB'
version = '4.2.0'
_rocm_version = '7.2.3'

homepage = 'https://github.com/ROCm/hipCUB'
description = """hipCUB is a thin wrapper library on top of rocPRIM or CUB.
You can use it to port a CUB project into HIP so you can use AMD hardware (and ROCm software)."""
docurls = ['https://rocm.docs.amd.com/projects/hipCUB/en/latest/']

toolchain = {'name': 'rocm-compilers', 'version': f'22.0.0-ROCm-{_rocm_version}'}

github_account = 'ROCm'
local_repo_name = 'rocm-libraries'
source_urls = [f'https://github.com/{github_account}/{local_repo_name}/archive']
sources = [{
    'download_filename': f'rocm-{_rocm_version}.tar.gz',
    'filename': f'{local_repo_name}-rocm-{_rocm_version}.tar.gz',
}]
checksums = ['300cc50720d40bad7c7ed1f6d67e8c5ebecaba62c07a6ea1cc5813c0ea2e41b5']

builddependencies = [
    ('CMake', '3.31.8'),
]
dependencies = [
    ('HIP', _rocm_version),
    ('rocPRIM', '4.2.0')
]

# Build from the projects/hipcub subdirectory
start_dir = 'projects/hipcub'

sanity_check_paths = {
    'files': ['lib/cmake/hipcub/hipcub-config.cmake',
              'include/hipcub/hipcub.hpp'],
    'dirs': ['lib/cmake/hipcub',
             'share/doc/hipcub',
             'include/hipcub'],
}

moduleclass = 'lib'
