# Author: sreenivasamurthy kolam <sreenivasamurthy.kolam@amd.com>

easyblock = 'ROCmComponent'

name = 'hipSOLVER'
version = '3.2.0'
_rocm_version = '7.2.3'

homepage = 'https://github.com/ROCm/hipSOLVER'
description = """hipSOLVER is a LAPACK marshalling library with multiple supported backends.
It sits between your application and a 'worker' LAPACK library, where it marshals inputs
to the backend library and marshals results to your application. hipSOLVER exports an
interface that doesn't require the client to change, regardless of the chosen backend.
Currently, hipSOLVER supports rocSOLVER and cuSOLVER backends."""
docurls = ['https://rocm.docs.amd.com/projects/hipSOLVER/en/latest/']

toolchain = {'name': 'rocm-compilers', 'version': f'22.0.0-ROCm-{_rocm_version}'}

github_account = 'ROCm'
local_repo_name = 'rocm-libraries'
source_urls = [f'https://github.com/{github_account}/{local_repo_name}/archive']
sources = [{
    'download_filename': f'rocm-{_rocm_version}.tar.gz',
    'filename': f'{local_repo_name}-rocm-{_rocm_version}.tar.gz',
}]
checksums = ['300cc50720d40bad7c7ed1f6d67e8c5ebecaba62c07a6ea1cc5813c0ea2e41b5']

builddependencies = [
    ('CMake', '3.31.8'),
]

dependencies = [
    ('HIP', _rocm_version),
    ('rocSOLVER', '3.32.0'),
    ('rocBLAS', '5.2.0'),
]

# Build from the projects/hipsolver subdirectory
start_dir = 'projects/hipsolver'

sanity_check_paths = {
    'files': ['include/hipsolver/hipsolver.h',
              f'lib/libhipsolver.{SHLIB_EXT}',
              'lib/cmake/hipsolver/hipsolver-config.cmake'],
    'dirs': ['share/doc/hipsolver',
             'include/hipsolver'],
}

moduleclass = 'lib'
