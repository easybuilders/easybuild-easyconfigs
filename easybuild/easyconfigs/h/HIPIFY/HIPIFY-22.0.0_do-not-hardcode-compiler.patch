Remove hard-coded compiler path based on found Clang/LLVM, as this interferes
with our rpath wrapping

Author: Jan Andre Reuter (jan@zyten.de)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 1234567..abcdefg 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -123,8 +123,10 @@ if(HIPIFY_BUILD_WITH_LLVM_PACKAGE)
   else()
     # Overriding CMAKE_CXX_COMPILER/CMAKE_C_COMPILER below is sketchy - could
     # that be removed or reworked instead?
-    set(CMAKE_CXX_COMPILER ${LLVM_TOOLS_BINARY_DIR}/clang++)
-    set(CMAKE_C_COMPILER ${LLVM_TOOLS_BINARY_DIR}/clang)
+    # With EasyBuild, we set these things externally, so no need to hard-code this.
+    # It also breaks building with rpath wrappers.
+    # set(CMAKE_CXX_COMPILER ${LLVM_TOOLS_BINARY_DIR}/clang++)
+    # set(CMAKE_C_COMPILER ${LLVM_TOOLS_BINARY_DIR}/clang)
   endif()

   # Link against LLVM and CLANG libraries.
