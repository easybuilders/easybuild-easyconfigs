# Updated by: Stamen Miroslavov, BSC 2026

easyblock = 'PythonPackage'

name = 'healpy'
version = '1.20.1'

homepage = 'https://healpy.readthedocs.io'
description = """healpy is a Python package to handle pixelated data on the sphere. It is
 based on the Hierarchical Equal Area isoLatitude Pixelization (HEALPix) scheme and
 bundles the HEALPix C++ library."""

toolchain = {'name': 'gfbf', 'version': '2025b'}
toolchainopts = {'pic': True}

sources = [SOURCE_TAR_GZ]
checksums = ['000203dafd09f6cb864147b8308661b405a0f8a9dba10bc0842b7ddfb40717fe']

builddependencies = [
    ('pkgconf', '2.4.3'),
    ('Cython', '3.1.2'),
    ('meson-python', '0.18.0'),
]

dependencies = [
    ('Python', '3.13.5'),
    ('Python-bundle-PyPI', '2025.07'),
    ('SciPy-bundle', '2025.07'),
    ('matplotlib', '3.10.5'),
    ('astropy', '7.1.0'),
    ('CFITSIO', '4.6.2'),
    ('HEALPix', '3.83'),
]

moduleclass = 'numlib'
