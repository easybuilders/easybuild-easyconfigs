easyblock = 'CMakeMake'

name = 'nghttp3'
version = '1.13.1'

homepage = 'https://github.com/ngtcp2/nghttp3'
description = """ nghttp3 is an implementation of RFC 9114 HTTP/3
mapping over QUIC and RFC 9204 QPACK in C.
It does not depend on any particular QUIC transport implementation."""

toolchain = {'name': 'GCCcore', 'version': '14.2.0'}
toolchainopts = {'pic': True}

source_urls = ['https://github.com/ngtcp2/nghttp3/releases/download/v%(version)s/']
sources = ['%(name)s-%(version)s.tar.xz']
checksums = ['020836668c711d5c166969f8b165fbfd989e6967d0601947bf608f29e2158518']

builddependencies = [
    ('binutils', '2.42'),
    ('CMake', '3.31.3'),
    ('pkgconf', '2.3.0'),
    ('CUnit', '2.1-3'),
]

runtest = 'check'

sanity_check_paths = {
    'files': ['lib/libnghttp3.a', f'lib/libnghttp3.{SHLIB_EXT}'],
    'dirs': ['include/nghttp3'],
}

moduleclass = 'lib'
