easyblock = 'PackedBinary'

name = 'NetLogo'
version = '7.0.4'
versionsuffix = '-64'

homepage = 'https://ccl.northwestern.edu/netlogo/'
description = """NetLogo is a multi-agent programmable modeling environment. It
is used by tens of thousands of students, teachers and researchers worldwide.
It also powers HubNet participatory simulations. It is authored by Uri Wilensky
and developed at the CCL."""

# NetLogo is precompiled and needs no particular toolchain.
# It even comes with its own Java.
toolchain = SYSTEM

source_urls = ['https://downloads.netlogo.org/%(version)s/']
sources = ['%(name)s-%(version)s%(versionsuffix)s.tgz']
checksums = ['e64293fe89e6012ea56f2eabcba61318']

#Even though NetLogo includes a copy of the Java 17 runtime. NetLogo can run using a different Java installed on your system of version 11 or higher.
#This is why java 25 has been added as dependancy.
dependencies = [('Java', '25')]

sanity_check_paths = {
    'files': ['bin/NetLogo', 'bin/NetLogo3D'],
    'dirs': ['extensions', 'models', 'lib', 'bin'],
}

moduleclass = 'math'
