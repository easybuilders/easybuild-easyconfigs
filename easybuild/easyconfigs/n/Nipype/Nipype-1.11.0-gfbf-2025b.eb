        'checksums': ['9355b139f1ef796f74ca039e37d58b9d9d83f1820678d65ab03dc3e864ed0c0d'],
    }),
    ('ci-info', '0.4.0', {
        'checksums': ['34d5a18726b3780abdf985234b871ac33124d64dd8e294870b8cc5b410c18418'],
    }),
    ('etelemetry', '0.3.1', {
        'source_tmpl': '%(name)s-%(version)s-py3-none-any.whl',
        'checksums': ['a64f09bcd55cbfa5684e4d9fb6d1d6a018ab99d2ea28e638435c4c26e6814a6b'],
    }),
    ('looseversion', '1.3.0', {
        'checksums': ['ebde65f3f6bb9531a81016c6fef3eb95a61181adc47b7f949e9c0ea47911669e'],
    }),
    ('acres', '0.5.0', {
        'patches': ['acres-0.5.0-fix-pdm-version.patch'],
