easyblock = 'PythonPackage'

name = 'NanoPlot'
version = '1.44.1'

homepage = 'https://github.com/wdecoster/NanoPlot'
description = "Plotting suite for long read sequencing data and alignments"

toolchain = {'name': 'foss', 'version': '2025b'}

sources = [SOURCE_TAR_GZ]
checksums = ['c9d6b3c807d46fb3eb293bc826a94b699d17f50fb7fd0dcc3f17f56b0cee8e57']

dependencies = [
    ('Python', '3.13.5'),
    ('SciPy-bundle', '2025.07'),
    ('Biopython', '1.86'),
    ('Pysam', '0.23.3'),
    ('nanomath', '1.4.0'),
    ('nanoget', '1.19.4'),
    ('plotly.py', '6.5.0'),
    ('statsmodels', '0.14.6'),
    ('Arrow', '22.0.0'),  # for pyarrow
    ('Kaleido', '0.2.1'),
]

sanity_check_paths = {
    'files': ['bin/NanoPlot'],
    'dirs': ['lib/python%(pyshortver)s/site-packages'],
}

sanity_check_commands = ["NanoPlot --help"]

moduleclass = 'bio'
