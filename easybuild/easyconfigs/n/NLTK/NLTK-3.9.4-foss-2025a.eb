easyblock = 'PythonBundle'

name = 'NLTK'
version = '3.9.4'

homepage = 'https://www.nltk.org/'
description = "NLTK is a leading platform for building Python programs to work with human language data."

toolchain = {'name': 'foss', 'version': '2025a'}

builddependencies = [('Cython', '3.1.1')]
dependencies = [
    ('Python', '3.13.1'),
    ('SciPy-bundle', '2025.06'),
    ('scikit-learn', '1.7.0'),
    ('matplotlib', '3.10.3'),
    ('tqdm', '4.67.1'),
]

exts_list = [
    ('python-crfsuite', '0.9.12', {
        'modulename': 'pycrfsuite',
        'checksums': ['db37fccc3bd8f0c49c28a7697ca79c89d67b3fd5bf119122866169240ac4c480'],
    }),
    ('nltk', version, {
        'checksums': ['ed03bc098a40481310320808b2db712d95d13ca65b27372f8a403949c8b523d0'],
    }),
]

sanity_check_paths = {
    'files': ['bin/%(namelower)s'],
    'dirs': ['lib/python%(pyshortver)s/site-packages/%(namelower)s'],
}

sanity_check_commands = [('%(namelower)s', '--version')]

modloadmsg = """
NLTK data is not included with this module.

Download the punkt_tab tokenizer data to your home directory with:
  python -s -m nltk.downloader -d "$HOME/nltk_data" punkt_tab

To download the complete NLTK data collection:
  python -s -m nltk.downloader -d "$HOME/nltk_data" all
  
If you download NLTK data to another location, set:
  export NLTK_DATA=/path/to/nltk_data
"""

moduleclass = 'devel'
