name = 'Nim'
version = '2.2.10'

homepage = 'https://nim-lang.org/'
description = "Nim is a systems and applications programming language."

toolchain = {'name': 'GCCcore', 'version': '15.2.0'}

source_urls = ['https://nim-lang.org/download/']
sources = [SOURCELOWER_TAR_XZ]
checksums = ['7957b7ed004206bcf10bcc4f3b4744153878e62f2431552a9a8e9d3f40e8d5d5']

builddependencies = [('binutils', '2.45')]

dependencies = [('libreadline', '8.3')]

sanity_check_paths = {
    'files': ['bin/nim', 'bin/nimble'],
    'dirs': ['lib/system'],
}

sanity_check_commands = [
    "nim --version",
    "nim --help",
    "nim --eval:'echo 1'",
]

moduleclass = 'lang'
