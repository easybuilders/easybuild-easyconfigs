easyblock = 'MakeCp'

name = 'ngsLD'
version = '1.2.0'

homepage = 'https://github.com/fgvieira/ngsLD'
description = """ngsLD is a program to estimate pairwise linkage disequilibrium (LD) taking the uncertainty of
genotype's assignation into account. It does so by avoiding genotype calling and using genotype likelihoods or
posterior probabilities."""

toolchain = {'name': 'GCC', 'version': '15.2.0'}

github_account = 'fgvieira'
source_urls = [GITHUB_SOURCE]
sources = [V_VERSION_TAR_GZ]
checksums = ['d3ed7500590973266efbe94837edd2d2f49442a7877bfd9256c4aeb9b994c1a1']

dependencies = [
    ('zlib', '2.3.2'),
    ('GSL', '2.8'),
]

skipsteps = ['configure']

files_to_copy = [
    (['ngsLD'], 'bin'),
]

sanity_check_paths = {
    'files': ['bin/ngsLD'],
    'dirs': [],
}

sanity_check_commands = ['ngsLD 2>&1 | grep "version: %(version)s"']

moduleclass = 'bio'
