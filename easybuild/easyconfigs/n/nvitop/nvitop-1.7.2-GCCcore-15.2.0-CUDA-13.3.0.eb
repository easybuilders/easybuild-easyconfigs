easyblock = 'PythonBundle'

name = 'nvitop'
version = '1.7.2'
versionsuffix = '-CUDA-%(cudaver)s'

homepage = 'https://nvitop.readthedocs.io.'
description = """An interactive NVIDIA-GPU process viewer and beyond, the one-stop
solution for GPU process management."""

toolchain = {'name': 'GCCcore', 'version': '15.2.0'}

builddependencies = [
    ('binutils', '2.45'),
]

dependencies = [
    ('Python', '3.14.2'),
    ('Python-bundle-PyPI', '2026.04'),
    ('CUDA', '13.3.0', '', SYSTEM),
]

exts_list = [
    ('nvidia-ml-py', '13.615.71', {
        'modulename': 'pynvml',
        'checksums': ['bebe4e48f51b1dc75028c0815cb7bfa14a31a5bb80be70c9d980c6036953fc3d'],
    }),
    (name, version, {
        'checksums': ['90b9d6dd3f61227acb2a8c9fdeb59f9a7c3cfa08196e0fe3bfd3877633cd4699'],
    }),
]

moduleclass = 'vis'
