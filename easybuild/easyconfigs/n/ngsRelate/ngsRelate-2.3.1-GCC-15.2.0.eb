easyblock = 'MakeCp'

name = 'ngsRelate'
version = '2.3.1'

homepage = 'https://github.com/angsd/ngsrelate'
description = """ngsRelate can be used to infer relatedness, inbreeding coefficients and many other summary statistics
for pairs of individuals from low coverage Next Generation Sequencing (NGS) data by using genotype likelihoods instead
of called genotypes."""

toolchain = {'name': 'GCC', 'version': '15.2.0'}

source_urls = ['https://github.com/ANGSD/NgsRelate/archive/refs/tags/']
sources = [V_VERSION_TAR_GZ]
checksums = ['f3cf1c88f8f8855c60fc72f891eaa3c5ca32961f8ec41a473669cf0b0971f3ff']

dependencies = [
    ('HTSlib', '1.23.1'),
]

skipsteps = ['configure']

files_to_copy = [
    (['ngsRelate'], 'bin'),
]

sanity_check_paths = {
    'files': ['bin/ngsRelate'],
    'dirs': [],
}

sanity_check_commands = ['ngsRelate']

moduleclass = 'bio'
