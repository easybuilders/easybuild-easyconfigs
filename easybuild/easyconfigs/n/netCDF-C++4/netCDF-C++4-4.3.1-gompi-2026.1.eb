easyblock = 'ConfigureMake'

name = 'netCDF-C++4'
version = '4.3.1'

homepage = 'https://www.unidata.ucar.edu/software/netcdf/'
description = """NetCDF (network Common Data Form) is a set of software libraries
 and machine-independent data formats that support the creation, access, and sharing of array-oriented
 scientific data."""

toolchain = {'name': 'gompi', 'version': '2026.1'}
toolchainopts = {'pic': True}

source_urls = ['https://github.com/Unidata/netcdf-cxx4/archive/']
sources = ['v%(version)s.tar.gz']
patches = ['netCDF-C++4_fix-nc-set-log-level.patch']
checksums = [
    {'v4.3.1.tar.gz': 'e3fe3d2ec06c1c2772555bf1208d220aab5fee186d04bd265219b0bc7a978edc'},
    {'netCDF-C++4_fix-nc-set-log-level.patch': '8ebd7727dca11350a8f1805a959f45828389df979e18c5088f303b53e7ac6dbf'},
]

dependencies = [('netCDF', '4.10.0')]

runtest = 'check'

sanity_check_paths = {
    'files': ['include/netcdf', 'lib/libnetcdf_c++4.a', f'lib/libnetcdf_c++4.{SHLIB_EXT}'],
    'dirs': [],
}

moduleclass = 'data'
