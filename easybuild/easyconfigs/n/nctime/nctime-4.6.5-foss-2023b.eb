easyblock = 'PythonBundle'

name = 'nctime'
version = '4.6.5'

homepage = 'https://github.com/ESPRI-Mod/nctime'
description = """Toolbox checking NetCDF time description"""

toolchain = {'name': 'foss', 'version': '2023b'}

builddependencies = [
    ('Cython', '3.0.10'),  # for 'netcdftime'
]

dependencies = [
    ('Python', '3.11.5'),
    ('SciPy-bundle', '2023.11'),
    ('networkx', '3.2.1'),
    ('cftime', '1.6.4'),
    ('netcdf4-python', '1.7.1.post2'),
    ('pynco', '1.1.2'),
    ('Levenshtein', '0.25.1'),
    ('ESGConfigParser', '0.1.17'),
]

