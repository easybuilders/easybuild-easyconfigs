easyblock = 'PythonPackage'

name = 'zip-recompress'
version = '0.1.0'

homepage = 'https://github.com/c3se/zip-recompress'
description = "Simple Python-based CLI tool to recompress a zip file with a new compression."

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}

dependencies = [
    ('binutils', '2.44'),
    ('Python', '3.13.5'),
]

github_account = "c3se"
source_urls = [GITHUB_SOURCE]
sources = [V_VERSION_TAR_GZ]
checksums = ['9150935edb252a858c09199ad135d94f1af8be072058ab4cb0c1e2342ce92131']

moduleclass = 'data'
