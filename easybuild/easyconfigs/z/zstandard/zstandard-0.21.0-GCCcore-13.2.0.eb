# Author: Lara Peeters
# Org: Ghent University
easyblock = 'PythonPackage'

name = 'zstandard'
version = '0.21.0'

homepage = 'https://github.com/indygreg/python-zstandard'
description = '''This project provides Python bindings for interfacing with the Zstandard compression library.
A C extension and CFFI interface are provided.'''

toolchain = {'name': 'GCCcore', 'version': '13.2.0'}

sources = [SOURCE_TAR_GZ]
checksums = ['f08e3a10d01a247877e4cb61a82a319ea746c356a3786558bed2481e6c405546']

builddependencies = [
    ('binutils', '2.40'),
]

dependencies = [
    ('Python', '3.11.5'),
    ('cffi', '1.15.1'),
    ('zstd', '1.5.5')
]

moduleclass = 'bio'
