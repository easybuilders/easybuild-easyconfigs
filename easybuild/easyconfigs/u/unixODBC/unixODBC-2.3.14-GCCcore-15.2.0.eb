# Easyconfig for unixODBC
# Author: Lykle Voort
# SURFsara, Amsterdam, The Netherlands
# Updated: Petr Král (INUITS)

easyblock = 'ConfigureMake'

name = 'unixODBC'
version = '2.3.14'

homepage = 'https://www.unixodbc.org'
description = """unixODBC provides a uniform interface between
application and database driver"""

toolchain = {'name': 'GCCcore', 'version': '15.2.0'}

source_urls = ['https://www.%(namelower)s.org/']
sources = [SOURCE_TAR_GZ]
checksums = ['4e2814de3e01fc30b0b9f75e83bb5aba91ab0384ee951286504bb70205524771']

builddependencies = [
    ('binutils', '2.45'),
]


sanity_check_paths = {
    'files': ['lib/libodbc.so', 'lib/libodbccr.so', 'lib/libodbcinst.so'],
    'dirs': [],
}

moduleclass = 'data'
