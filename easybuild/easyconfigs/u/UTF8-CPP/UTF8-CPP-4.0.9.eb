easyblock = 'CMakeMake'

name = 'UTF8-CPP'
version = '4.0.9'

homepage = 'https://github.com/nemtrif/utfcpp'
description = """UTF-8 with C++ in a Portable Way
A small, C++98 compatible generic library in order to handle UTF-8 encoded strings.
For anybody used to work with STL algorithms and iterators, it should be easy and natural to use.
The code is freely available for any purpose under BSL 1.0"""

toolchain = SYSTEM

source_urls = ['https://github.com/nemtrif/utfcpp/archive/refs/tags']
sources = [V_VERSION_TAR_GZ]
checksums = ['397a9a2a6ed5238f854f490b0177b840abc6b62571ec3e07baa0bb94d3f14d5a']

# Header-only library, no runtime dependencies
builddependencies = [
    ('CMake', '3.31.8'),
]

sanity_check_paths = {
    'files': ['include/utf8cpp/utf8.h'],
    'dirs': ['share/utf8cpp/cmake'],
}

moduleclass = 'tools'
