easyblock = 'CMakeMake'

name = 'utfcpp'
version = '5.0.0'

homepage = 'https://github.com/nemtrif/utfcpp'
description = """UTF-8 with C++ in a Portable Way"""

toolchain = {'name': 'GCCcore', 'version': '15.2.0'}

source_urls = ['https://github.com/nemtrif/utfcpp/archive/refs/tags/']
sources = [V_VERSION_TAR_GZ]
checksums = ['42c36e1ef1307b1186996e4644f9999970e26325670b99019f3408bf0d3c952a']

builddependencies = [
    ('binutils', '2.45'),
    ('CMake', '4.2.1'),
]

sanity_check_paths = {
    'files': ['include/utf8cpp/utf8.h'],
    'dirs': ['share'],
}

moduleclass = 'lib'
