Only pass the GCC-specific -Wno-use-after-free / -Wno-mismatched-new-delete flags when building with GCC:
Clang rejects them as unknown warning options, which -Werror turns into a hard error.
author: Simon Pinches (ITER Organization)
--- UDA-2.9.3.orig/CMakeLists.txt
+++ UDA-2.9.3/CMakeLists.txt
@@ -100,7 +100,7 @@
     set( CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -std=gnu99" )
     set( CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -std=c++11" )
 
-    if( NOT APPLE AND NOT ("${CMAKE_CXX_COMPILER_ID}" STREQUAL "Intel" OR "${CMAKE_CXX_COMPILER_ID}" STREQUAL "IntelLLVM") )
+    if( "${CMAKE_CXX_COMPILER_ID}" STREQUAL "GNU" )
       set( CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -Wno-use-after-free" )
     endif()
   endif()
--- UDA-2.9.3.orig/source/CMakeLists.txt
+++ UDA-2.9.3/source/CMakeLists.txt
@@ -7,7 +7,7 @@
 
 # Hack to build on GCC/12.2.0
 if( NOT WIN32 OR MINGW )
-  if ( NOT APPLE AND NOT ("${CMAKE_CXX_COMPILER_ID}" STREQUAL "Intel" OR "${CMAKE_CXX_COMPILER_ID}" STREQUAL "IntelLLVM") )
+  if( "${CMAKE_CXX_COMPILER_ID}" STREQUAL "GNU" )
     set( CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -Wno-use-after-free -Wno-mismatched-new-delete" )
   endif()
 endif()
