easyblock = 'PythonBundle'

name = 'qc-gbasis'
version = '0.1.0'

homepage = 'https://github.com/theochem/gbasis'
description = """Pure-Python package for analytical integration and evaluation of
Gaussian-type orbitals and their related quantities."""

toolchain = {'name': 'gfbf', 'version': '2026.1'}

dependencies = [
    ('Python', '3.14.2'),
    ('Python-bundle-PyPI', '2026.04'),
    ('SciPy-bundle', '2026.05'),
    ('sympy', '1.14.0'),
]

exts_list = [
    (name, version, {
        'modulename': 'gbasis',
        'runtest': 'pytest -v',
        'testinstall': True,
        'checksums': ['d30a2b6a618409d532cac3501abc80407b8f2e6e4bb82141233b60c656f9df5d'],
    }),
]

moduleclass = 'tools'
