builddependencies = [
    ('binutils', '2.42'),
    ('pkgconf', '2.3.0'),
    # deps for QtWebEngine
    ('Bison', '3.8.2'),
    ('flex', '2.6.4'),
    ('gperf', '3.3'),
    ('Ninja', '1.12.1'),
    ('Python', '3.13.1'),
