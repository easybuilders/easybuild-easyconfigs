dependencies = [
    ('double-conversion', '3.3.1'),
    ('GLib', '2.85.1'),
    ('PCRE2', '10.45'),
    ('libpng', '1.6.48'),
    ('HarfBuzz', '11.2.1'),
    ('graphite2', '1.3.14'),
    # deps for QtWebEngine
    ('X11', '20250521'),
