easyblock = 'CMakeMake'

name = 'QCMaquis'
version = '4.0.0'

homepage = "https://github.com/qcscine/qcmaquis"
description = """QCMaquis parallelizes the computationally heavy steps of
a DMRG simulation with shared-memory parallelism (OpenMP)."""

toolchain = {'name': 'iimkl', 'version': '2025a'}

source_urls = ['https://github.com/qcscine/qcmaquis/archive']
sources = [{'download_filename': 'v%(version)s.tar.gz', 'filename': SOURCE_TAR_GZ}]
checksums = ['47278e6af537cbd244d6284f7f5164b8169d8d76c0e150aca4774571dde5cda3']

builddependencies = [
    ('CMake', '3.31.3'),
    ('Eigen', '3.4.0'),
    ('pybind11', '2.13.6'),
]

dependencies = [
    ('HDF5', '1.14.6', '-serial'),
    ('GSL', '2.8'),
    ('Boost', '1.88.0'),
    ('Python', '3.13.1'),
    ('SciPy-bundle', '2025.06'),  # numpy needed for scine_qcmaquis
    ('h5py', '3.14.0', '-serial'),
]

preconfigopts = (
    # Make CMake install qcmaquis binary
    "sed -i '/target_link_libraries(qcmaquis /a install(TARGETS qcmaquis RUNTIME DESTINATION bin)' "
    "%(start_dir)s/src/applications/CMakeLists.txt && "
    # Do not pin exact pybind11 version
    "sed -i 's/find_package(pybind11 2.10.4 EXACT QUIET)/find_package(pybind11 2.10.4 QUIET)/' "
    "%(start_dir)s/src/cmake/ImportPybind11.cmake && "
    # Remove too strict version requirement
    "sed -i 's/numpy>=1.23.5,<2.3.0/numpy>=1.23.5/' "
    "%(start_dir)s/pyproject.toml && "
)

# preprocess fortran sources by -fpp
configopts = '-DBUILD_OPENMOLCAS_INTERFACE=ON -DCMAKE_Fortran_FLAGS="$FFLAGS -fpp" -DQCMAQUIS_TESTS=ON'

runtest = True

# Install python bindings
exts_defaultclass = 'PythonPackage'
exts_list = [
    ('scine-qcmaquis', version, {
        'nosource': True,
        # reset global preconfigopts
        'preconfigopts': '',
    }),
]

# Fix OpenMolcas 25.06 installation with DMRG
# https://github.com/qcscine/qcmaquis/issues/33
# https://github.com/qcscine/qcmaquis/issues/34
_cfg_path = '%(installdir)s/share/cmake/MAQUIS_DMRGConfig.cmake'
_solib_path = '%(installdir)s/lib/libmaquis_dmrg.so'
postinstallcmds = [
    # make GSL a proper dependency
    f"sed -i -e '1i include(CMakeFindDependencyMacro)' -e '2i find_dependency(GSL REQUIRED)' {_cfg_path} && "
    # ensure variable includes the core first (helps non-target consumers)
    f"sed -i 's|^set(MAQUIS_DMRG_LIBRARIES |set(MAQUIS_DMRG_LIBRARIES {_solib_path} |' {_cfg_path} && "
    # ensure the imported target pulls core + C++ runtime transitively
    f"sed -i '$a target_link_libraries(qcmaquis-driver INTERFACE {_solib_path} stdc++)' {_cfg_path}"
]

sanity_check_paths = {
    'files': ['bin/dmrg_meas', 'bin/qcmaquis', 'include/maquis_dmrg.h', f'lib/libmaquis_dmrg.{SHLIB_EXT}'],
    'dirs': ['include', 'share/%(namelower)s', 'lib/python%(pyshortver)s/site-packages/scine_qcmaquis'],
}

sanity_check_commands = [
    'dmrg_meas --help',
    'qcmaquis --help',
    'python -c "import scine_qcmaquis"',
]

moduleclass = 'chem'
