    ('Python', '3.14.2'),
    ('Python-bundle-PyPI', '2026.04'),  # pathspec, CacheControl, requests, rich
    ('black', '26.10.1'),
    ('ruamel.yaml', '0.19.1'),
    ('RDFlib', '7.6.0'),
]

