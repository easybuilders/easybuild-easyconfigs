easyblock = 'Tarball'

name = 'snippy'
version = '4.6.0'

homepage = 'https://github.com/tseemann/snippy'
description = "Rapid haploid variant calling and core genome alignment"

toolchain = {'name': 'GCC', 'version': '14.2.0'}

# https://github.com/tseemann/snippy
github_account = 'tseemann'
source_urls = [GITHUB_SOURCE]
sources = ['v%(version)s.zip']
checksums = ['777b9b608fe84665c933e36115c34b8e09e967c5cdf0487ca75a0bfa574f8d2f']

dependencies = [
    ('Perl', '5.40.0'),
    ('BioPerl', '1.7.8'),
    ('Java', '21', '', SYSTEM),
    ('SAMtools', '1.22.1'),
]


sanity_check_paths = {
    'files': ['bin/%(name)s'],
    'dirs': [],
}

sanity_check_commands = [
    "%(name)s -h",
    "%(name)s --check",
]

modextrapaths = {'PATH': ''}

moduleclass = 'bio'
