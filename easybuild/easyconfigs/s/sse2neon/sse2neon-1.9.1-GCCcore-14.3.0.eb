easyblock = 'ConfigureMake'

name = 'sse2neon'
version = '1.9.1'

homepage = 'https://github.com/DLTcollab/sse2neon'
description = 'A translator from Intel SSE intrinsics to Arm/Aarch64 NEON implementation'

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}

source_urls = ['https://github.com/DLTcollab/sse2neon/archive/refs/tags/']
sources = [V_VERSION_TAR_GZ]
checksums = ['6b70e7cb8c5ce4641002b85deaafe97efdf9ade9b49884edeaf678b35f0e132f']

builddependencies = [
    ('binutils', '2.44'),
]

skipsteps = ['configure']
runtest = 'check-main'
install_cmd = 'mkdir %(installdir)s/include && cp sse2neon.h %(installdir)s/include/'

sanity_check_paths = {
    'files': ['include/sse2neon.h'],
    'dirs': [],
}

moduleclass = 'devel'
