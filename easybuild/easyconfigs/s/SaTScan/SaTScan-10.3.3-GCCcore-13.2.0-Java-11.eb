# Author: Stamen Miroslavov <stamen.miroslavov@bsc.es>
# Barcelona Supercomputing Center 2026

easyblock = 'Rpm'

name = 'SaTScan'
version = '10.3.3'
versionsuffix = '-Java-%(javaver)s'

homepage = 'https://www.satscan.org'
description = """SaTScan™ is a free software that analyzes spatial, temporal and space-time data
 using the spatial, temporal, or space-time scan statistics."""

toolchain = {'name': 'GCCcore', 'version': '13.2.0'}

# !! The package has to be downloaded manually !!
source_urls = ['https://www.satscan.org/download_satscan_for_linux.html']
sources = ['%(namelower)s.%(version)s.rpm']
checksums = ['d7b754d97f83fa40e74630b2ac983248e1726f7808eeb1a14e17c5ae6430c9de']
download_instructions = f"""{name} requires a manual download from {source_urls}
Required download: {' '.join(sources)}"""

builddependencies = [
    ('rpmrebuild', '2.21', '', SYSTEM),
    ('binutils', '2.40'),
]

dependencies = [
    ('Java', '11', '', SYSTEM),
]

prepend_to_path = ['opt/satscan/bin']

sanity_check_paths = {
    'files': ['opt/satscan/bin/SaTScan'],
    'dirs': ['opt/satscan/lib/%s' % x for x in ['app', 'runtime']],
}

moduleclass = 'math'
