easyblock = 'Cargo'

name = 'Salmon'
version = '2.7.0'

homepage = 'https://combine-lab.github.io/salmon'
description = """Salmon is a wicked-fast program to produce highly-accurate, transcript-level
quantification estimates from RNA-seq data. Version 2.x is a from-scratch Rust reimplementation
(New index format, salmon-alevin removed)."""

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}

github_account = 'COMBINE-lab'
source_urls = [GITHUB_LOWER_SOURCE]
sources = [{'download_filename': 'v%(version)s.tar.gz', 'filename': SOURCELOWER_TAR_GZ}]
