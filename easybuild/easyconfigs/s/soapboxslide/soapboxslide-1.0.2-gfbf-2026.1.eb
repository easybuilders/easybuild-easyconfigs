easyblock = 'PythonBundle'

name = 'soapboxslide'
version = '1.0.2'

homepage = 'https://github.com/molmod/soapboxslide'
description = """A Computational Soap Box Slide. Written by Toon Verstraelen for students of the course
"Python for Scientists" (C004212) of the B.Sc. Physics and Astronomy at Ghent University."""

toolchain = {'name': 'gfbf', 'version': '2026.1'}

dependencies = [
    ('Python', '3.14.2'),
    ('Python-bundle-PyPI', '2026.04'),
    ('SciPy-bundle', '2026.05'),
    ('matplotlib', '3.10.9'),
]

exts_list = [
    (name, version, {
        'checksums': ['1aa73e6c7bfc4b5a5140427bbb9d15f5f4b87b5384bcf47508eccaaeca4545ee'],
    }),
]

moduleclass = 'tools'
