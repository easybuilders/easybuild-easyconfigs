easyblock = 'Bundle'

name = 'scMetabolism'
local_commit = 'fbae0b7d49ba87cd616c80ac7b2906185b52cea1'
# see DESCRIPTION to determine version,
# but add date stamp of commit since version is not always bumped
version = '0.2.1-20260820'
versionsuffix = '-R-%(rver)s'

homepage = 'https://github.com/wu-yc/scMetabolism'
description = "R package for quantifying metabolism activity at the single-cell resolution."

toolchain = {'name': 'foss', 'version': '2025b'}

dependencies = [
    ('R', '4.5.2'),
    ('R-bundle-Bioconductor', '3.22', versionsuffix),
    ('libsodium', '1.0.20'),
]

exts_defaultclass = 'RPackage'
exts_default_options = {
    'source_urls': [
        'https://cran.r-project.org/src/contrib/Archive/%(name)s',
        'https://cran.r-project.org/src/contrib/',
        'https://cran.freestatistics.org/src/contrib',
    ],
    'source_tmpl': '%(name)s_%(version)s.tar.gz',
}

exts_filter = ("R -q --no-save", "library(%(ext_name)s)")

exts_list = [
    ('loe', '1.1', {
        'checksums': ['cc100c98bee78f6d11bc6227c8585bdc8bb7d55e4bf69ec4b16ca7d7ddbb26d8'],
    }),
    ('iotools', '0.3-5', {
        'checksums': ['9cf917ca6bf779b527462f127cd02e3da9624c1ea68a6555d74572a5c270b48b'],
    }),
    ('wordspace', '0.2-9', {
        'checksums': ['121efed3eccec88d2f3422553506e3a1f23bd74d3da6143dd9ca8906f9848f5b'],
    }),
    ('sodium', '1.4.0', {
        'checksums': ['937d53d5e401f9f7007949e150d7c09c6230fb255c95116b89b5c3237c501acd'],
    }),
    ('plumber', '1.3.0', {
        'checksums': ['3ac859f2fc16aed144c578a571f363b47084d49d07a8383d0b162fbd2bfd2d7d'],
    }),
    ('wesanderson', '0.3.7', {
        'checksums': ['c92e5604e1e149e00f49fd236c6ab8cd09d96106eb14479f7839e6996bf95e4e'],
    }),
    ('VISION', '2.1.0', {
        'source_urls': ['https://github.com/YosefLab/VISION/archive'],
        'sources': [{'download_filename': 'v%(version)s.tar.gz', 'filename': 'VISION-%(version)s.tar.gz'}],
        'checksums': ['c07c207cdccda9a5937373327540c5a0d23d1adf017de6ec33f9fb1ad93f9abb'],
    }),
    (name, version, {
        'source_urls': ['https://github.com/wu-yc/scMetabolism/archive'],
        'sources': [{
            'download_filename': f'{local_commit}.tar.gz',
            'filename': SOURCE_TAR_GZ,
        }],
        'checksums': ['8815fcb22d20b928acd8a0d78b9d476e20e3136806972d245fabe67cb311e311'],
    }),
]

modextrapaths = {'R_LIBS_SITE': ''}

sanity_check_paths = {
    'files': [],
    'dirs': [name],
}

moduleclass = 'bio'
