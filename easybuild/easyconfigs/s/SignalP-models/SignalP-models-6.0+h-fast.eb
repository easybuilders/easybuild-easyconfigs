easyblock = 'Dataset'

name = 'SignalP-models'
version = '6.0+h'
_download_version = '6.0h'
_suffix = 'fast'
versionsuffix = '-' + _suffix

homepage = 'https://services.healthtech.dtu.dk/software.php'
description = """Model weights (~1.6GB) for SignalP 6.0 'fast' mode."""

toolchain = SYSTEM

download_instructions = f"""
SignalP requires registration and acceptance of licence terms (academic use only).
 [1] go to: https://services.healthtech.dtu.dk/service.php?SignalP-6.0
 [2] navigate to the "Downloads" tab
 [3] select "{_suffix}" type under version "{_download_version}"
 [4] complete the form; you should receive a download link via email
"""

_model_file = 'distilled_model_signalp6.pt'
_tar_path = f'signalp6_fast/signalp-6-package/models/{_model_file}'

data_sources = [{
    'filename': f'signalp-{_download_version}.{_suffix}.tar.gz',
    'extract_cmd': f'tar xzf %s --no-same-owner --strip-components=3 {_tar_path}',
    'alt_location': 'SignalP',
}]
checksums = ['4afe3c004e23a1d6518cefb23448b4d5ede5f1c5b276db541f839f0615822125']

sanity_check_paths = {
    'files': [_model_file],
    'dirs': [],
}

moduleclass = 'bio'
