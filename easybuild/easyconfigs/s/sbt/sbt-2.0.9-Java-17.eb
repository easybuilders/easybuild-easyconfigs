easyblock = 'Tarball'

name = 'sbt'
version = '2.0.9'
versionsuffix = '-Java-%(javaver)s'

homepage = 'http://www.scala-sbt.org/'
description = "sbt is a build tool for Scala, Java, and more."

toolchain = SYSTEM

source_urls = ['https://github.com/sbt/sbt/releases/download/v%(version)s']
sources = [SOURCE_TGZ]
checksums = ['351087fb5ad0d8b271f21b4c6f8e4912c8f6dbf81e1d06fe215bb165f14668b3']

dependencies = [('Java', '17')]

sanity_check_paths = {
    'files': ['bin/sbt'],
    'dirs': [],
}

sanity_check_commands = ["sbt --version"]

moduleclass = 'tools'
