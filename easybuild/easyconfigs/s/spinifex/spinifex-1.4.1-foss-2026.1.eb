easyblock = 'PythonBundle'

name = 'spinifex'
version = '1.4.1'

homepage = 'https://git.astron.nl/RD/spinifex'
description = """Spinifex provides tools to calculate ionospheric Faraday rotation and TEC from GNSS (IONEX)
data and models, for use in radio astronomy. This is used by LINC to correct for ionospheric effects.
Note that LINC requires spinifex 1.x (<2.0)."""

toolchain = {'name': 'foss', 'version': '2026.1'}

# New easyconfig: LINC 5.2 replaces RMextract by spinifex (LINC requires spinifex < 2.0)
builddependencies = [
    ('hatchling', '1.29.0'),  # also provides hatch-vcs
    ('poetry', '2.3.4'),  # provides poetry-core, the build backend of the fortranformat extension
]
dependencies = [
    ('Python', '3.14.2'),
    ('Python-bundle-PyPI', '2026.04'),
    ('SciPy-bundle', '2026.05'),
    ('astropy', '8.0.1'),
    ('h5py', '3.16.0'),
    ('matplotlib', '3.10.9'),
    ('netcdf4-python', '1.7.4'),
    ('opt-einsum', '3.4.0'),
    ('pydantic', '2.13.4'),
    ('python-casacore', '3.8.1'),
]

exts_list = [
    ('eval-type-backport', '0.4.0', {
        'modulename': 'eval_type_backport',
        'source_tmpl': 'eval_type_backport-%(version)s.tar.gz',
        'checksums': ['8397d25e6524c2e67b9576bb0636be27dea2192017711220c534ec2de921e9b0'],
    }),
    ('nest-asyncio', '1.6.0', {
        'modulename': 'nest_asyncio',
        'source_tmpl': 'nest_asyncio-%(version)s.tar.gz',
        'checksums': ['6f172d5449aca15afd6c646851f4e31e02c598d553a667e38cafa997cfec55fe'],
    }),
    ('ppigrf', '2.1.0', {
        'checksums': ['4e0f7eccaae7c793fce92ab1f953fae15ec02e24fd0af6c2a3f77db08fc0fb3e'],
    }),
    ('fortranformat', '2.0.3', {
        'checksums': ['1e765c01a66208d54d75cae140ba9f1adda0548aaad8538cba8da39e69ac178c'],
    }),
    ('pyiri', '0.1.7', {
        # the package installs as 'PyIRI', not 'pyiri'
        'modulename': 'PyIRI',
        'checksums': ['f30098cfaf73a916f8363e752f1f1bfb2015b19b915bf707b797640c473300c3'],
    }),
    ('unlzw3', '0.2.3', {
        'checksums': ['ede5d928c792fff9da406f20334f9739693327f448f383ae1df1774627197bbb'],
    }),
    (name, version, {
        'checksums': ['5a7d5099fca84fef54d31f71bdd05f11e63c56432b1774b26d021622329cbd7e'],
    }),
]

sanity_check_commands = ["python -c 'import spinifex'"]

moduleclass = 'astro'
