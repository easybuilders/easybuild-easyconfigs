easyblock = 'PythonBundle'

name = 'scikit-image'
version = '0.26.0'

homepage = 'https://scikit-image.org/'
description = "scikit-image is a collection of algorithms for image processing."

toolchain = {'name': 'foss', 'version': '2026.1'}

builddependencies = [
    ('Cython', '3.2.4'),
    ('meson-python', '0.19.0'),
]

dependencies = [
    ('Python', '3.14.2'),
    ('matplotlib', '3.10.9'),
    ('Pillow', '12.2.0'),
    ('networkx', '3.6.1'),
    ('dask', '2026.7.1'),
    ('imageio', '2.37.4'),
]

exts_list = [
    ('tifffile', '2026.9.15', {
        'checksums': ['2ad086262b5bd3b3804f2d044926e5f63d8f6ae72b235d8b774f164b79f587c4'],
    }),
    ('lazy_loader', '0.5', {
        'checksums': ['717f9179a0dbed357012ddad50a5ad3d5e4d9a0b8712680d4e687f5e6e6ed9b3'],
    }),
    (name, version, {
        'modulename': 'skimage',
        'source_tmpl': 'scikit_image-%(version)s.tar.gz',
        'checksums': ['f5f970ab04efad85c24714321fcc91613fcb64ef2a892a13167df2f3e59199fa'],
    }),
]

moduleclass = 'vis'
