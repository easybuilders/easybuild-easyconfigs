easyblock = 'PythonBundle'

name = 'S3QL'
version = '6.4.0'

homepage = 'https://www.rath.org/s3ql-docs'
description = """S3QL is a file system that stores all its data online using storage services like Google Storage,
Amazon S3, or OpenStack. S3QL effectively provides a virtual drive of dynamic, infinite capacity that can be accessed
from any computer with internet access."""

toolchain = {'name': 'GCCcore', 'version': '15.2.0'}

builddependencies = [
    ('binutils', '2.45'),
    ('Cython', '3.2.4'),
    ('hatchling', '1.29.0'),
    ('PDM', '2.28.0'),
]

dependencies = [
    ('Python', '3.14.2'),
    ('Python-bundle-PyPI', '2026.04'),
    ('SQLite', '3.51.1'),
    ('pydantic', '2.13.4'),
    ('cryptography', '47.0.0'),
    ('FUSE', '3.18.2'),
]

