# This file is an EasyBuild reciPY as per https://easybuilders.github.io/easybuild/
# Author: Pablo Escobar Lopez
# sciCORE - University of Basel
# SIB Swiss Institute of Bioinformatics

easyblock = 'PythonPackage'

name = 'SignalP'
version = '6.0h'
_suffix = 'fast'
versionsuffix = '-' + _suffix

homepage = 'https://services.healthtech.dtu.dk/software.php'
description = """SignalP predicts the presence  and  location of signal peptide  cleavage sites
in  amino acid  sequences  from  different organisms"""

toolchain = {'name': 'foss', 'version': '2024a'}

download_instructions = f"""
SignalP requires registration and acceptance of licence terms (academic use only).
 [1] go to: https://services.healthtech.dtu.dk/service.php?SignalP-6.0
 [2] navigate to the "Downloads" tab
 [3] select "{_suffix}" type under version "%(version)s"
 [4] complete the form; you should receive a download link via email
"""

sources = [f'%(namelower)s-%(version)s.{_suffix}.tar.gz']
checksums = ['4afe3c004e23a1d6518cefb23448b4d5ede5f1c5b276db541f839f0615822125']

unpack_options = '--strip-components=1'

dependencies = [
    ('Python', '3.12.3'),
    ('SciPy-bundle', '2024.05'),    # numpy > 1.19.2
    ('tqdm', '4.66.5'),             # tqdm > 4.46.1
    ('PyTorch', '2.6.0'),          # torch > 1.7.0
    ('matplotlib', '3.9.2'),        # matplotlib > 3.3.2
]

preinstallopts = "sed -i 's/torch.*/torch/g' requirements.txt && "

extension_name = 'signalp6'

# Install the model_weights
_weights_dir = 'lib/python%(pyshortver)s/site-packages/%(namelower)s/model_weights'
postinstallcmds = [
    f'mkdir -p %(installdir)s/{_weights_dir}',
    f'cp -r %(start_dir)s/models/* %(installdir)s/{_weights_dir}/',
]

_bin = f'%(namelower)s{version[0]}'
sanity_check_paths = {
    'files': [f'bin/{_bin}'],
    'dirs': ['lib/python%(pyshortver)s/site-packages/%(namelower)s', _weights_dir],
}

sanity_check_commands = [f'{_bin} --help']

moduleclass = 'bio'
