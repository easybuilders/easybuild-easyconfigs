# On RISC-V with OpenBLAS, small numerical differences in the SVD
# computed by the default `gesdd` driver can cause the maximum relative
# error to slightly exceed the original tolerance. The observed error
# (~9.01e-6) is marginally above 9e-6, while alternative LAPACK
# backends and the `gesvd` driver pass. 
# Relax the tolerance slightlyt o accommodate these backend-dependent floating-point differences.
# Author: Julian Morillo
--- scipy/interpolate/tests/test_bary_rational.py.ORIG	2026-10-14 13:21:48.746129265 +0200
+++ scipy/interpolate/tests/test_bary_rational.py	2026-10-14 13:22:30.134250371 +0200
@@ -266,7 +266,7 @@
         r = AAA(z, f)
 
         zz = np.logspace(-15, 0, 500)
-        assert_allclose(r(zz), np.sqrt(zz), rtol=9e-6)
+        assert_allclose(r(zz), np.sqrt(zz), rtol=9.1e-6)
 
 
 class BatchFloaterHormann:
