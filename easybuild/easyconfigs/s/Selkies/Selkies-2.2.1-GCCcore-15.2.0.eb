easyblock = 'CargoPythonBundle'

name = 'Selkies'
version = '2.2.1'

homepage = 'https://github.com/selkies-project/selkies'
description = """Selkies is an open-source low-latency high-performance Linux-native GPU/CPU-accelerated HTML5
remote desktop streaming platform, for self-hosting, containers, Kubernetes, or Cloud/HPC platforms"""

toolchain = {'name': 'GCCcore', 'version': '15.2.0'}

