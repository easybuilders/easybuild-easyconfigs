easyblock = 'PythonBundle'

name = 'statsmodels'
version = '0.15.0'

homepage = 'https://www.statsmodels.org/'
description = """Statsmodels is a Python module that allows users to explore data, estimate statistical models,
and perform statistical tests."""

toolchain = {'name': 'gfbf', 'version': '2026.1'}

builddependencies = [('Cython', '3.2.4')]

dependencies = [
    ('Python', '3.14.2'),
    ('SciPy-bundle', '2026.05'),
]

exts_list = [
    ('patsy', '1.0.3', {
        'checksums': ['79ebf4c93ff4d296e58a9d5be2b2ee31bd49d737cf11d70ffbd8a44b2de42e65'],
    }),
    (name, version, {
        'preinstallopts': """sed -i 's/url=URL,/url=URL, version="%(version)s",/g' setup.py && """,
        'checksums': ['5d257fe58d0772bc46a557880ca78e2a8e07fec7bfd9d11074aef8e33e1aecbc'],
    }),
]

moduleclass = 'math'
