easyblock = 'CMakeMake'

name = 'shapelib'
version = '1.6.3'

homepage = 'http://shapelib.maptools.org/'
description = """The Shapefile C Library provides the ability to write simple C
programs for reading, writing and updating (to a limited extent) ESRI
Shapefiles, and the associated attribute file (.dbf)."""

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}
toolchainopts = {'pic': True}

source_urls = ['https://github.com/OSGeo/shapelib/archive/refs/tags/']
sources = ['v%(version)s.tar.gz']
checksums = ['3f9cb7526332144ccc83bb56ead6cd3a6765761a611481901a431458a1899dec']

builddependencies = [
    ('binutils', '2.44'),
    ('CMake', '4.0.3'),
]

local_executables = [
    'Shape_PointInPoly',
    'csv2shp',
    'dbfadd',
    'dbfcat',
    'dbfcreate',
    'dbfdump',
    'dbfinfo',
    'shpadd',
    'shpcat',
    'shpcentrd',
    'shpcreate',
    'shpdata',
    'shpdump',
    'shpdxf',
    'shpfix',
    'shpinfo',
    'shprewind',
    'shpsort',
    'shptreedump',
    'shpwkb',
]

sanity_check_paths = {
    'files': [f'bin/{exec}' for exec in local_executables] + ['include/shapefil.h', 'lib/libshp.%s' % SHLIB_EXT],
    'dirs': ['bin', 'include', 'lib/pkgconfig', 'share'],
}

sanity_check_commands = ['shpcreate shp_test_file point']

moduleclass = 'lib'
