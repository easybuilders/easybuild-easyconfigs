easyblock = 'PythonBundle'

name = 'SymEngine-python'
version = '0.14.1'

homepage = 'https://github.com/symengine/symengine.py'
description = "Python wrappers to the C++ library SymEngine, a fast C++ symbolic manipulation library."

toolchain = {'name': 'foss', 'version': '2026.1'}

builddependencies = [
    ('CMake', '4.2.1'),
    ('Cython', '3.2.4'),
]

dependencies = [
    ('Python', '3.14.2'),
    ('Python-bundle-PyPI', '2026.04'),
    ('SymEngine', '0.15.0'),
]

exts_list = [
    ('symengine', version, {
        'source_urls': ['https://github.com/symengine/symengine.py/archive/refs/tags/'],
        'sources': [V_VERSION_TAR_GZ],
        'checksums': ['3e79d39af5e9f024cd4b8d1372314ac2b83cace7d49cdbad482b4aec5b04c37b'],
    }),
]

moduleclass = 'lib'
