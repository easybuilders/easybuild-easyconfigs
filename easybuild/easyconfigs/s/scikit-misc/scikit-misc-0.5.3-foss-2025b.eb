easyblock = 'PythonBundle'

name = 'scikit-misc'
version = '0.5.3'

homepage = 'https://github.com/has2k1/scikit-misc'
description = "Miscellaneous tools for data analysis and scientific computing"

toolchain = {'name': 'foss', 'version': '2025b'}

builddependencies = [
    ('pkgconf', '2.4.3'),
    ('Cython', '3.1.2'),
    ('meson-python', '0.18.0'),
]

dependencies = [
    ('Python', '3.13.5'),
    ('SciPy-bundle', '2025.07'),
]

exts_list = [
    ('scikit_misc', version, {
        'modulename': 'skmisc',
        'checksums': ['ae1bd75c9f903295dd4e90af8d28d09d31a5e6432909f89927da231b3fbcc1e1'],
    }),
]

moduleclass = 'lib'
