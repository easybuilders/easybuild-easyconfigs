easyblock = 'RPackage'

name = 'SeuratData'
local_commit = '3e51f44303069b64f5dc4d68e6a3d4a343f55c39'
version = '0.2.2.9002-20250304'
versionsuffix = '-R-%(rver)s'

homepage = 'https://github.com/satijalab/seurat-data'
description = "Dataset distribution for Seurat"

toolchain = {'name': 'foss', 'version': '2026.1'}

source_urls = ['https://github.com/satijalab/seurat-data/archive/']
sources = [{'download_filename': '%s.tar.gz' % local_commit, 'filename': SOURCE_TAR_GZ}]
checksums = ['881ebe70a2a6c6574916925d9e3a70b66c32806ddc38a472d03f90e0a146fc00']

dependencies = [
    ('R', '4.6.1'),
    ('R-bundle-Bioconductor', '3.23', versionsuffix),
]

sanity_check_paths = {
    'files': [],
    'dirs': [name],
}

moduleclass = 'bio'
