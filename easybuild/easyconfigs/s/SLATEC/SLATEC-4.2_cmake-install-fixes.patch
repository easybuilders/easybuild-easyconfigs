Fix and extend the CMake install:
* install the per-subdirectory component libraries alongside libslatec: as shipped,
  the installed libslatec.so has DT_NEEDED entries on the eleven component libraries,
  which are never installed, so it cannot be loaded from the install tree;
* honour BUILD_SHARED_LIBS instead of hard-coding SHARED in every add_library call,
  so that static libraries can be built as well; the option defaults to ON to
  preserve upstream's shared-library behaviour;
* generate and install pkg-config files (lib/pkgconfig/slatec.pc for shared linking,
  slatec-static.pc for static linking). Both list all component libraries explicitly,
  since ld does not resolve symbols through transitive DT_NEEDED entries and
  libslatec.a is only a stub around slatec.f90. The static variant uses -l:lib*.a
  syntax (plain -l would pick the shared libraries) and appends the BLAS/LAPACK link
  flags detected by CMake.
Note: the top-level CMakeLists.txt has CRLF line endings, the src/ ones are plain LF.
author: Simon Pinches (ITER Organization)
diff -ruN a/CMakeLists.txt c/CMakeLists.txt
--- a/CMakeLists.txt	2025-11-14 08:00:11.000000000 +0100
+++ c/CMakeLists.txt	2026-08-15 14:25:37.996132589 +0200
@@ -6,6 +6,8 @@
   LANGUAGES Fortran
 )
 
+option( BUILD_SHARED_LIBS "Build shared libraries" ON )
+
 set( slatec_MAJOR_VERSION 4 )
 set( slatec_MINOR_VERSION 2 )
 set( slatec_VERSION  ${slatec_MAJOR_VERSION}.${slatec_MINOR_VERSION} )
@@ -57,6 +59,13 @@
 
 find_package( LAPACK REQUIRED )
 
+# generate and install pkg-config files
+string( REPLACE ";" " " SLATEC_LAPACK_LIBS "${LAPACK_LIBRARIES}" )
+configure_file( slatec.pc.in slatec.pc @ONLY )
+configure_file( slatec-static.pc.in slatec-static.pc @ONLY )
+install( FILES "${CMAKE_CURRENT_BINARY_DIR}/slatec.pc" "${CMAKE_CURRENT_BINARY_DIR}/slatec-static.pc"
+         DESTINATION lib/pkgconfig )
+
 add_subdirectory( src )
 
 enable_testing()
