name = 'SEPP'
version = '4.5.6'

homepage = 'https://github.com/smirarab/sepp'
description = """SATe-enabled Phylogenetic Placement - addresses the problem of phylogenetic
placement of short reads into reference alignments and trees."""

toolchain = {'name': 'foss', 'version': '2025a'}

github_account = 'smirarab'
source_urls = [GITHUB_LOWER_SOURCE]
sources = ['v%(version)s.tar.gz']
checksums = ['e4aae4908b33d54d34c8796bc1f5aed38e8969c411102d713da075a0d7832560']

builddependencies = [
    ('hatchling', '1.27.0'),
]

dependencies = [
    ('Python', '3.13.1'),
    ('DendroPy', '5.0.8'),
]

fix_python_shebang_for = ['bin/*.py']

# Replace broken split_sequences.py console script generated by pip
# with the actual script provided in the SEPP sources.
postinstallcmds = [
    "install -m 755 %(start_dir)s/split_sequences.py %(installdir)s/bin/split_sequences.py",
]

local_bin_files = ['run_sepp.py', 'run_upp.py', 'split_sequences.py']

sanity_check_paths = {
    'files': ['bin/%s' % f for f in local_bin_files],
    'dirs': ['lib/python%(pyshortver)s/site-packages/sepp'],
}

sanity_check_commands = ["%s --help" % f for f in local_bin_files]

moduleclass = 'bio'
