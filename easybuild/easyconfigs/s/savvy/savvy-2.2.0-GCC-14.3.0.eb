# This easyconfig was created by Simon Branford of the BEAR Software team at the University of Birmingham.

easyblock = 'CMakeMake'

name = 'savvy'
version = '2.2.0'

homepage = 'https://github.com/statgen/savvy'
description = "Interface to various variant calling formats."

toolchain = {'name': 'GCC', 'version': '14.3.0'}
toolchainopts = {'pic': True}

source_urls = ['https://github.com/statgen/%(name)s/archive']
sources = [V_VERSION_TAR_GZ]
checksums = ['f96585faddeba9dd6bbf22f828ecb9f866cc7075947dd25f89c1a618cb9f3bb5']

builddependencies = [
    ('binutils', '2.44'),
    ('CMake', '4.0.3'),
]

dependencies = [
    ('bzip2', '1.0.8'),
    ('cURL', '8.14.1'),
    ('HTSlib', '1.22.1'),
    ('shrinkwrap', '1.2.0'),
    ('XZ', '5.8.1'),
    ('zstd', '1.5.7'),
]

configopts = '-DCMAKE_POLICY_VERSION_MINIMUM=3.5'

sanity_check_paths = {
    'files': ['bin/sav'],
    'dirs': [],
}

sanity_check_commands = ['sav --help']

moduleclass = 'data'
