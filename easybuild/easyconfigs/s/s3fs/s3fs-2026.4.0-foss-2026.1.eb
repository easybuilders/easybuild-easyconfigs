easyblock = 'PythonPackage'

name = 's3fs'
version = '2026.4.0'

homepage = 'https://github.com/fsspec/s3fs/'
description = "S3FS builds on aiobotocore to provide a convenient Python filesystem interface for S3."

toolchain = {'name': 'foss', 'version': '2026.1'}

sources = [SOURCE_TAR_GZ]
checksums = ['5bdce0abb00b0435ee150807a45fea727451dbc22de4cbc116464f8504ab9d37']

# s3fs 2026.4.0 uses setuptools so hatchling is no longer needed
dependencies = [
    ('Python', '3.14.2'),
    ('Python-bundle-PyPI', '2026.04'),
    ('aiohttp', '3.14.3'),
    ('wrapt', '2.2.1'),
]

moduleclass = 'tools'
