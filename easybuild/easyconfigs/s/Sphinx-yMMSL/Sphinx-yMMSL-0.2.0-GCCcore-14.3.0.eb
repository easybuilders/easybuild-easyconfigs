easyblock = 'PythonBundle'

name = 'Sphinx-yMMSL'
version = '0.2.0'

homepage = 'https://github.com/multiscale/sphinx-ymmsl'
description = """Sphinx plugin for documenting yMMSL models, as used by the
 MUSCLE3 multiscale coupling library."""

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}

builddependencies = [('binutils', '2.44')]

dependencies = [
    ('Python', '3.13.5'),
    ('Python-bundle-PyPI', '2025.07'),
    ('PyYAML', '6.0.2'),
]

exts_list = [
    ('mdit-py-plugins', '0.4.2', {
        'source_tmpl': 'mdit_py_plugins-%(version)s.tar.gz',
        'checksums': ['5f2cd1fdb606ddf152d37ec30e46101a60512bc0e5fa1a7002c36647b09e26b5'],
    }),
    ('myst-parser', '4.0.1', {
        'source_tmpl': 'myst_parser-%(version)s.tar.gz',
        'checksums': ['5cfea715e4f3574138aecbf7d54132296bfd72bb614d31168f48c477a830a7c4'],
    }),
    ('yatiml', '0.12.0', {
        'checksums': ['30eb62a51b9f60df095ff709a881c576b0c720b6dcd10994dde73872c4a1e1f4'],
