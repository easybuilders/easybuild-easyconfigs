easyblock = 'PythonBundle'

name = 'stacie'
version = '1.2.1'

homepage = 'https://github.com/molmod/stacie'
description = """Algorithm that computes time integrals of autocorrelation functions.
It is primarily designed for post-processing molecular dynamics simulations."""

toolchain = {'name': 'gfbf', 'version': '2026.1'}

dependencies = [
    ('Python', '3.14.2'),
    ('Python-bundle-PyPI', '2026.04'),
    ('SciPy-bundle', '2026.05'),
    ('matplotlib', '3.10.9'),
]

exts_list = [
    (name, version, {
        'checksums': ['837af0b077771d0c64837dec7a961677cc239cf8b88ef902e42b36df578247b9'],
    }),
]

moduleclass = 'tools'
