easyblock = 'ConfigureMake'

name = 'socat'
version = '1.8.1.3'

homepage = 'http://www.dest-unreach.org/socat/'
description = """Socat is a relay for bidirectional data transfer between two independent
data channels. Each of these data channels may be a file, pipe, device (serial line etc.
or a pseudo terminal), a socket (UNIX, IP4, IP6 - raw, UDP, TCP), an SSL socket, proxy CONNECT
connection, a file descriptor (stdin etc.), the GNU line editor (readline), a program, or a
combination of two of these."""

toolchain = {'name': 'GCCcore', 'version': '14.2.0'}

source_urls = ['http://www.dest-unreach.org/socat/download/']
sources = [SOURCE_TAR_GZ]
checksums = ['06602ffd591e98c75b3dc1d66f0f19136cc666b0b2d95caad987d6ab2cb28097']

builddependencies = [
    ('binutils', '2.42'),
]

dependencies = [
    ('OpenSSL', '3', '', SYSTEM),
    ('libreadline', '8.2'),
]

sanity_check_paths = {
    'files': ['bin/socat', 'bin/filan', 'bin/procan'],
    'dirs': [],
}

sanity_check_commands = ["socat -V"]

moduleclass = 'tools'
