easyblock = 'ConfigureMake'

name = 'scikit-bio-binaries'
version = '1.1.0'

homepage = 'https://github.com/scikit-bio/scikit-bio-binaries'
description = """scikit-bio-binaries is an open-source, BSD-licensed package providing optimized algorithms for
bioinformatics in support of scikit-bio."""

toolchain = {'name': 'gfbf', 'version': '2025b'}

source_urls = ['https://github.com/scikit-bio/scikit-bio-binaries/archive/refs/tags/']
sources = [V_VERSION_TAR_GZ]
patches = ['%(name)s-%(version)s_test_before_install.patch']
checksums = [
    {'v1.1.0.tar.gz': '25ae78bd24de9ab4e94a6c5a0d6cbc891472398a17ad6ac171b0f6f953073a61'},
    {'scikit-bio-binaries-1.1.0_test_before_install.patch':
     '913f6d85c0f85ffdf43952d4015b0903c3ddcc28499fccd72c8b3221f8e6d106'},
]

dependencies = [
]

skipsteps = ['configure']

prebuildopts = 'PREFIX="%(installdir)s" '
buildopts = 'BLASLIB="-llapacke $LIBBLAS"'
runtest = 'test'
installopts = prebuildopts

sanity_check_paths = {
    'files': [f'lib/libskbb.{SHLIB_EXT}'],
    'dirs': ['include'],
}

moduleclass = 'bio'
