@@ -1330,6 +1332,36 @@ void qSlicerCoreApplication::handleCommandLineArguments()
       pythonArgv[i + 1] = QStringToPythonWCharPointer(scriptArgs.at(i));
     }
 
+#if PY_VERSION_HEX >= 0x030D0000
+    // Python 3.13 no longer exposes the private interpreter configuration
+    // functions used below. Set sys.argv directly instead. Unlike replacing
+    // the interpreter configuration, this leaves the runtime-modified
+    // sys.path untouched.
+    PyObject* sysArgv = PyList_New(pythonArgc);
+    if (!sysArgv)
+    {
+      PyErr_Print();
+      qSlicerCoreApplication::terminate(EXIT_FAILURE);
+    }
+    for (int i = 0; i < pythonArgc; ++i)
+    {
+      PyObject* arg = PyUnicode_FromWideChar(pythonArgv[i], -1);
+      if (!arg)
+      {
+        Py_DECREF(sysArgv);
+        PyErr_Print();
+        qSlicerCoreApplication::terminate(EXIT_FAILURE);
+      }
+      PyList_SET_ITEM(sysArgv, i, arg);
+    }
+    if (PySys_SetObject("argv", sysArgv) < 0)
+    {
+      Py_DECREF(sysArgv);
+      PyErr_Print();
+      qSlicerCoreApplication::terminate(EXIT_FAILURE);
+    }
+    Py_DECREF(sysArgv);
+#else
     PyConfig config;
     PyConfig_InitPythonConfig(&config);
     // Retrieve a copy of the current interpreter configuration.
@@ -1371,6 +1403,7 @@ void qSlicerCoreApplication::handleCommandLineArguments()
     }
 
     PyConfig_Clear(&config);
+#endif
 
