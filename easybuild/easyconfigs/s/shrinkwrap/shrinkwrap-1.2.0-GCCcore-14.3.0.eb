# This easyconfig was created by Simon Branford of the BEAR Software team at the University of Birmingham.
easyblock = 'CMakeMake'

name = 'shrinkwrap'
version = '1.2.0'

homepage = 'https://github.com/jonathonl/shrinkwrap'
description = "A std::streambuf wrapper for compression formats."

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}

source_urls = ['https://github.com/jonathonl/%(name)s/archive']
sources = [V_VERSION_TAR_GZ]
checksums = ['aa15583079c3dfccb118cf36fae9bc6353920b99d0204a9e349dad027b531286']

builddependencies = [
    ('binutils', '2.44'),
    ('CMake', '4.0.3'),
]

dependencies = [
    ('XZ', '5.8.1'),
    ('zstd', '1.5.7'),
]

configopts = '-DCMAKE_POLICY_VERSION_MINIMUM=3.5'

sanity_check_paths = {
    'files': [f'include/shrinkwrap/{x}' for x in ['istream.hpp', 'stdio.hpp', 'zstd.hpp']],
    'dirs': [],
}

moduleclass = 'data'
