easyblock = 'CMakeMake'

name = 'EveryBeam'
version = '0.8.5'

homepage = 'https://everybeam.readthedocs.io/'
description = """Library that provides the antenna response pattern for several instruments,
such as LOFAR (and LOBES), SKA (OSKAR), MWA, JVLA, etc."""

toolchain = {'name': 'foss', 'version': '2026.1'}

sources = [
    {
        'filename': SOURCE_TAR_XZ,
        # Repo uses git submodules, which are not included in the release tarballs.
        # Thus, we let EasyBuild download directly from the git repository.
        'git_config': {
            'url': 'https://git.astron.nl/RD',
            'repo_name': '%(name)s',
            'tag': 'v%(version)s',
            'clone_into': '%(name)s',
            'recursive': True,
        },
    },
]
patches = ['%(name)s-0.5.4_python_metadata.patch']
checksums = [
    {SOURCE_TAR_XZ: '8e74f3602d12ab4d1172f10e1a6aa0b450f3be75974d07e4813f705009dd7415'},
    {'%(name)s-0.5.4_python_metadata.patch': '63c42e85d1b63cbf5887d10ec158be9b69e2c63cf3b209e9c1944f46c01810ac'},
]

builddependencies = [
    ('CMake', '3.31.11'),
    ('wget', '1.25.0'),
]
dependencies = [
    ('casacore', '3.8.1'),
    ('Boost', '1.90.0'),
    ('CFITSIO', '4.6.4'),
    ('WCSLIB', '8.10'),
    ('GSL', '2.8'),
    ('HDF5', '2.1.1'),
    ('Python', '3.14.2'),
    ('libxml2', '2.15.1'),
]

configopts = "-DBUILD_WITH_PYTHON=ON "

# Note: we need to create a dir %(builddir)s/EveryBeam/everybeam for the pip install to complete successfully
postinstallcmds = [
    "mkdir -p %(builddir)s/%(name)s/%(namelower)s && pip install %(builddir)s/%(name)s --prefix=%(installdir)s",
]

sanity_check_paths = {
    'files': ['include/%(name)s/beamformer.h', f'lib/libeverybeam.{SHLIB_EXT}'],
    'dirs': [],
}

# Check if Python support was built correctly, and can be found by pip
sanity_check_commands = [
    'python3 -c "import %(namelower)s"',
    "pip list | grep %(namelower)s",
]

modextravars = {'EVERYBEAM_DATADIR': '%(installdir)s/share/%(namelower)s'}

moduleclass = 'lib'
