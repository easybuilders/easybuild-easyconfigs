easyblock = 'PythonBundle'

name = 'esgf-qa'
version = '0.6.0'

homepage = 'https://esgf.github.io/esgf-qa'
description = """esgf-qa provides a flexible quality assurance (QA) workflow for
 evaluating dataset compliance using the ioos/compliance-checker framework (including CF
 compliance checks) and any community plugins (cc-plugins), such as ESGF/cc-plugin-wcrp
 and euro-cordex/cc-plugin-cc6."""

toolchain = {'name': 'foss', 'version': '2025b'}

builddependencies = [
    ('pkgconf', '2.4.3'),
    ('Cython', '3.1.2'),
]

dependencies = [
    ('Python', '3.13.5'),
    ('Python-bundle-PyPI', '2025.07'),
    ('SciPy-bundle', '2025.07'),
    ('xarray', '2025.10.0'),
    ('dask', '2025.9.1'),
    ('cftime', '1.6.4.post1'),
    ('cf-xarray', '0.10.11'),
    ('netcdf4-python', '1.7.2'),
    ('textual', '8.1.1'),
    ('compliance-checker', '6.1.0'),
    ('pyfive', '1.1.2'),
    ('pydantic', '2.11.9'),
    ('esgvoc', '7.2.0'),
]

exts_list = [
    ('cc_plugin_cc6', '0.4.3', {
        'checksums': ['1ff26c05787429b23e09f0f88cad4c40f0713e7aada5bb61644cd79c8018bd68'],
    }),
    ('cc_plugin_wcrp', '2.3.0', {
        'checksums': ['bf037a00748749598380ddc8e7efa20677cc6452da96a94ada7aa7648175d3e1'],
        # Relax version requirements for pydantic:
        'preinstallopts': 'sed -i "s/pydantic>=2.12.5/pydantic>=2.11.9/" pyproject.toml && ',
        'modulename': 'plugins',
    }),
    ('esgf_qa', version, {
        'checksums': ['3ad40127828ac593029fe5b86b8f484da312ba35dab6af60341e7d1201ec218b'],
    }),
]

moduleclass = 'geo'
