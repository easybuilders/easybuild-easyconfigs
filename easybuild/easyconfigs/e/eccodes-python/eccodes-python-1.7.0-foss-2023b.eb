easyblock = 'PythonBundle'

name = 'eccodes-python'
version = '1.7.0'

homepage = 'https://github.com/ecmwf/eccodes-python'
description = "Python 3 interface to decode and encode GRIB and BUFR files via the ECMWF ecCodes library."

toolchain = {'name': 'foss', 'version': '2023b'}

dependencies = [
    ('Python', '3.11.5'),
    ('SciPy-bundle', '2023.11'),
    ('cffi', '1.15.1'),
    ('ecCodes', '2.31.0'),
]

exts_list = [
    ('findlibs', '0.0.5', {
        'checksums': ['7a801571e999d0ee83f9b92cbb598c21f861ee26ca9dba74cea8958ba4335e7e'],
    }),
    ('eccodes', version, {
        'checksums': ['0f233009eac228b99be6e40e5f7cc175b477d322bd91c0dac6bf226f0222cb17'],
    }),
]

moduleclass = 'tools'
