        'checksums': ['72f6db669b5fe3b42a158073753786951803544d38810f64fd5909237784fa4e'],
    }),
    ('fckitlib', '0.14.1.8', {
        'source_tmpl': '%(name)s-%(version)s-cp313-cp313-manylinux_2_28_x86_64.whl',
