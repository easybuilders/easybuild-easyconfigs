easyblock = 'CMakeMake'

name = 'ExchCXX'
version = '1.0.0'

homepage = 'https://github.com/wavefunction91/ExchCXX'
description = 'Exchange correlation (XC) library for density functional theory (DFT) calculations in modern C++'

toolchain = {'name': 'GCC', 'version': '14.3.0'}

source_urls = ['https://github.com/wavefunction91/ExchCXX/archive/refs/tags']
sources = [V_VERSION_TAR_GZ]
checksums = ['0ea38aab563ea5d11a03d80dc1bf909821091d903eb852c5cb350484753a847a']

builddependencies = [
    ('binutils', '2.44'),
    ('CMake', '4.0.3'),
]

dependencies = [
    ('libxc', '7.0.0'),
]

# Tests require using patched internal libxc
# runtest = 'test'

sanity_check_paths = {
    'files': [f'lib/libexchcxx.a'],
    'dirs': [],
}

moduleclass = 'chem'
