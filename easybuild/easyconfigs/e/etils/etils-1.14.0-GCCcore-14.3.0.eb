easyblock = 'PythonPackage'

name = 'etils'
version = '1.14.0'

homepage = 'https://github.com/google/etils'
description = """etils (eclectic utils) is an open-source collection of utils for python.
Each top-level submodule is a self-contained independent module (with its own BUILD rule),
meant to be imported individually.

etils[epath] version
"""

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}

sources = [SOURCE_TAR_GZ]
checksums = ['8136e7f4c4173cd0af0ca5481c4475152f0b8686192951eefa60ee8711e1ede4']

builddependencies = [('binutils', '2.44')]
dependencies = [
    ('Python', '3.13.5'),
    ('Python-bundle-PyPI', '2025.07'),
    ('typing-extensions', '4.14.1'),
]

moduleclass = 'tools'
