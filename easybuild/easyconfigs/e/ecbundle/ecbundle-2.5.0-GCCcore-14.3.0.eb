easyblock = 'PythonPackage'

name = 'ecbundle'
version = '2.5.0'

homepage = 'https://github.com/ecmwf/ecbundle'
description = """ecbundle is a set of python tools that help in configuring, building and installing packages in a
consistent manner to build a standalone program or service. ecbundle-compatible packages are required to be nestable
CMake projects."""

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}

sources = [SOURCE_TAR_GZ]
patches = ['%(name)s-%(version)s_drop-pathlib.patch']
checksums = [
    {'ecbundle-2.5.0.tar.gz': '13ce93ccddcae9bbc08a122125a22f6373d776274102d39d3bce504c1c9c3c88'},
    {'ecbundle-2.5.0_drop-pathlib.patch': '91b12baf6d2d54043236881f0de9d897ff5bcb98df680abf60c8f4f37cba1ad9'},
]

builddependencies = [
    ('binutils', '2.44'),
]

dependencies = [
    ('Python', '3.13.5'),
    ('Python-bundle-PyPI', '2025.07'),
    ('ruamel.yaml', '0.18.14'),
]

moduleclass = 'devel'
