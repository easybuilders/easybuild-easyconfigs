easyblock = 'PythonPackage'

name = 'ecbundle'
version = '2.5.0'

homepage = 'https://github.com/ecmwf/ecbundle'
description = """ecbundle is a set of python tools that help in configuring, building and installing packages in a
consistent manner to build a standalone program or service. ecbundle-compatible packages are required to be nestable
CMake projects."""

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}

sources = [SOURCE_TAR_GZ]
checksums = ['13ce93ccddcae9bbc08a122125a22f6373d776274102d39d3bce504c1c9c3c88']

dependencies = [
    ('Python', '3.13.5'),
]

moduleclass = 'devel'
