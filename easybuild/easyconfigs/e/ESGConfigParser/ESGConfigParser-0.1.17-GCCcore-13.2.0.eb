easyblock = 'PythonBundle'

name = 'ESGConfigParser'
version = '0.1.17'

homepage = 'https://github.com/ESGF/esgf-config-parser'
description = """ESGF configuration ESGConfigParser for INI files"""

toolchain = {'name': 'GCCcore', 'version': '13.2.0'}

builddependencies = [
    ('binutils', '2.40'),
]

dependencies = [
    ('Python', '3.11.5'),
]

exts_list = [
    ('configparser', '7.2.0', {
        'checksums': ['b629cc8ae916e3afbd36d1b3d093f34193d851e11998920fdcfc4552218b7b70'],
    }),
    (name, version, {
        'patches': ['ESGConfigParser-0.1.17_adapt-to-python-3.patch'],
        'checksums': [
            {'ESGConfigParser-0.1.17.tar.gz':
             '5fdac5572308d1144507a445b1be055e2431f412985700f8e9d7a051b504318b'},
            {'ESGConfigParser-0.1.17_adapt-to-python-3.patch':
             '4df917e7ae2186973a0ee225606236ccd30888a3308f15e0220b6491b89a88ed'},
        ],
        'modulename': 'ESGConfigParser',  # otherwise sanity fails
    }),
]

moduleclass = 'data'
