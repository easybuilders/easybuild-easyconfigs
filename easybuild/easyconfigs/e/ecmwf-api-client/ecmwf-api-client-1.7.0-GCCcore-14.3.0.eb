easyblock = 'PythonBundle'

name = 'ecmwf-api-client'
version = '1.7.0'

homepage = 'https://github.com/ecmwf/ecmwf-api-client'
description = """Python client for ECMWF web services API."""

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}

builddependencies = [
    ('binutils', '2.44'),
]

dependencies = [
    ('Python', '3.13.5'),
]

exts_list = [
    ('ecmwf_api_client', version, {
        'checksums': ['1971a047c01cc50cfc893f13fdfa710cf56fb872f1c04685b13c6f1d18431164'],
        'modulename': 'ecmwfapi'
    }),
]

moduleclass = 'lib'
