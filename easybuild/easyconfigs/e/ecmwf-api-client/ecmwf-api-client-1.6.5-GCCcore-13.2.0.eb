easyblock = 'PythonBundle'

name = 'ecmwf-api-client'
version = '1.6.5'

homepage = 'https://github.com/ecmwf/ecmwf-api-client'
description = """Python client for ECMWF web services API."""

toolchain = {'name': 'GCCcore', 'version': '13.2.0'}

builddependencies = [
    ('binutils', '2.40'),
]

dependencies = [
    ('Python', '3.11.5'),
]

exts_list = [
    ('ecmwf_api_client', version, {
        'checksums': ['33d5747fe210d41e4a329afef2232c9d1258847094b87a2a96efffbef223fae8'],
        'modulename': 'ecmwfapi'
    }),
]

moduleclass = 'lib'
