easyblock = 'PythonBundle'

name = 'Elephant'
version = '1.2.1'

homepage = 'https://neuralensemble.org/elephant/'
description = """
Elephant (Electrophysiology Analysis Toolkit) is an open-source, community
centered library for the analysis of electrophysiological data in the Python
programming language. The focus of Elephant is on generic analysis functions
for spike train data and time series recordings from electrodes, such as the
local field potentials (LFP) or intracellular voltages.
"""

toolchain = {'name': 'foss', 'version': '2025b'}

dependencies = [
    ('Python', '3.13.5'),
    ('mpi4py', '4.1.0'),
    ('SciPy-bundle', '2025.07'),
    ('Python-bundle-PyPI', '2025.07'),
    ('scikit-learn', '1.7.1'),
    ('statsmodels', '0.14.6'),
    ('tqdm', '4.67.1'),
    ('neo', '0.14.5'),
]

exts_list = [
    ('elephant', version, {
        'checksums': ['8af766f828afd59bcb23cbac7aa7185fe15d00ad47d753984455a0e32bad3522'],
    }),
]

moduleclass = 'bio'
