easyblock = 'PythonBundle'

name = 'esgvoc'
version = '6.2.0'

homepage = 'https://esgf.github.io/esgf-vocab'
description = """ESGVOC is a Python library designed to simplify interaction with
 controlled vocabularies (CVs) used in WCRP climate data projects. It supports querying,
 caching, and validating terms across various CV repositories like the universe and
 project-specific repositories (e.g., CMIP6Plus, CMIP6, etc.)"""

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}

builddependencies = [
    ('binutils', '2.44'),
    ('hatchling', '1.27.0'),
]

dependencies = [
    ('Python', '3.13.5'),
    ('Python-bundle-PyPI', '2025.07'),
    ('pydantic', '2.11.9'),
    ('SQLAlchemy', '2.0.41'),
    ('PyYAML', '6.0.2'),
    ('PyLD', '3.0.0'),
    ('PDM', '2.25.5'),
]

exts_list = [
    ('sqlmodel', '0.0.37', {
        'checksums': ['d2c19327175794faf50b1ee31cc966764f55b1dedefc046450bc5741a3d68352'],
    }),
    ('annotated-doc', '0.0.5', {
        'checksums': ['c7e58ce09192557605d8bbd92836d7e1d520ac9580096042c0bfd197efacf1bb'],
    }),
    ('typer', '0.27.1', {
        'checksums': ['a79bef8469a79c45498e7b814ecf8d603cc7644e9acbd9e19cac0334240b18df'],
    }),
    (name, version, {
        'checksums': ['0d84e2bd49b5f3b79c7801472ba34620f869a34d68ecd4e8006d69a8cf27340a'],
    }),
]

moduleclass = 'data'
