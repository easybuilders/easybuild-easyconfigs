easyblock = 'PythonBundle'

name = 'eQuilibrator'
version = '0.7.0'

homepage = 'https://gitlab.com/equilibrator/equilibrator-api/'
description = """A thermodynamics calculator for biochemical reactions"""
# software_license = 'LicenseMIT'

toolchain = {'name': 'foss', 'version': '2025a'}

dependencies = [
    ('Python', '3.13.1'),
    ('python-slugify', '8.0.4'),
    ('uncertainties', '3.2.3'),
    ('Pint', '0.24.4'),
    ('SQLAlchemy', '2.0.41'),
    ('tqdm', '4.67.1'),
]

exts_list = [
    ('equilibrator-cache', '0.7.1', {
        'sources': ['equilibrator_cache-%(version)s-py2.py3-none-any.whl'],
        'checksums': ['e09f46ab2656fcd97f6df60fe44639ccc70d727c37da0f59846f7a209eb9a48f'],
    }),
    ('path', '16.7.1', {
        'checksums': ['2b477f5887033f3cbea1cfd8553ee6a6a498eb2540a19f4aa082822aadcea30a'],
    }),
    ('component-contribution', '0.7.0', {
        'sources': ['component_contribution-%(version)s-py2.py3-none-any.whl'],
        'checksums': ['e33b5a7a9f37c1f711407f5ab5eafb3a7ef3837400403d83e4b7549b826cab40'],
    }),
    ('pyparsing', '3.3.2', {
        'checksums': ['c777f4d763f140633dcb6d8a3eda953bf7a214dc4eff598413c070bcdc117cbc'],
        # workaround for: ValueError: invalid pyproject.toml config: project.license
        'preinstallopts': "sed -i '/^license  *=/d' pyproject.toml && ",
