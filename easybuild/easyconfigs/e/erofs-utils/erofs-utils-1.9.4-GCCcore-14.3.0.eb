easyblock = 'ConfigureMake'

name = 'erofs-utils'
version = '1.9.4'

homepage = 'https://github.com/erofs/erofs-utils'
description = """Userspace tools for the EROFS filesystem, currently including:

  mkfs.erofs    Filesystem formatter
  mount.erofs   Mount helper for EROFS
  erofsfuse     FUSE daemon alternative
  dump.erofs    Filesystem analyzer
  fsck.erofs    Filesystem compatibility and consistency checker,
                also capable of extracting filesystem contents
"""

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}

source_urls = ['https://github.com/erofs/erofs-utils/archive/refs/tags/']
sources = [V_VERSION_TAR_GZ]
checksums = ['7d135aa2550326a5acf20f53c518aea5a8900015ce50700044e40f818c31dd80']

builddependencies = [
    ('binutils', '2.44'),
    ('Autotools', '20250527'),
    ('pkgconf', '2.4.3'),
]

dependencies = [
    ('FUSE', '3.17.4'),
    ('util-linux', '2.41'),
    ('lz4', '1.10.0'),
    ('XZ', '5.8.1'),
    ('zstd', '1.5.7'),
    ('zlib', '1.3.1'),
    ('xxHash', '0.8.3'),
    # For s3/oci support:
    ('cURL', '8.14.1'),
    ('json-c', '0.18'),
    ('libxml2', '2.14.3'),
    ('OpenSSL', '3', '', SYSTEM),
]

preconfigopts = './autogen.sh &&'

configopts = ' '.join([
  '--enable-fuse',
  '--enable-s3',
  '--enable-oci',
  # '--enable-fanotify',  # Requires very new kernel
])

sanity_check_paths = {
    'files': [f'bin/{x}' for x in ['mkfs.erofs', 'erofsfuse', 'dump.erofs', 'fsck.erofs']],
    'dirs': [],
}

sanity_check_commands = ['mkfs.erofs -h']

moduleclass = 'tools'
