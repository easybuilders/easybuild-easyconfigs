easyblock = 'PythonBundle'

name = 'KDEpy'
version = '1.1.12'

homepage = 'https://kdepy.readthedocs.io'
description = """This Python 3.8+ package implements various Kernel Density Estimators (KDE).
 Three algorithms are implemented through the same API: NaiveKDE, TreeKDE and FFTKDE.
 The FFTKDE outperforms other popular implementations, see the comparison page."""

toolchain = {'name': 'foss', 'version': '2025b'}

builddependencies = [
    ('Cython', '3.1.2'),
]

dependencies = [
    ('Python', '3.13.5'),
    ('Python-bundle-PyPI', '2025.07'),
    ('SciPy-bundle', '2025.07'),
]

exts_list = [
    ('kdepy', version, {
        'checksums': ['eb3a62abc5a982f5a30ec0a3560e2f9cbd3d19bc4f721b2ebbde06949d52af61'],
        'modulename': 'KDEpy',
    }),
]

moduleclass = 'math'
