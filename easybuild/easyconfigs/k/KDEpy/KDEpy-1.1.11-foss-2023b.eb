easyblock = 'PythonBundle'

name = 'KDEpy'
version = '1.1.11'

homepage = 'https://kdepy.readthedocs.io'
description = """This Python 3.8+ package implements various Kernel Density Estimators (KDE).
 Three algorithms are implemented through the same API: NaiveKDE, TreeKDE and FFTKDE.
 The FFTKDE outperforms other popular implementations, see the comparison page."""

toolchain = {'name': 'foss', 'version': '2023b'}

# Cython is not needed for version 1.1.11 because it already includes the cythonized file

dependencies = [
    ('Python', '3.11.5'),
    ('Python-bundle-PyPI', '2023.10'),
    ('SciPy-bundle', '2023.11'),
]

exts_list = [
    ('kdepy', version, {
        'patches': ['KDEpy-1.1.11-fix-cython.patch'],
        'checksums': [
            {'kdepy-1.1.11.tar.gz':
             '603cc3cd1c80bb0a7a9b0b74ebae117d312e37cee8fc1c637b46888e48d91085'},
            {'KDEpy-1.1.11-fix-cython.patch':
             '546098104f723a0abf2ad3c2dc57a54dd7e6220c5c90300f19abca5896f7874c'},
        ],
        'modulename': 'KDEpy',
    }),
]

moduleclass = 'math'
