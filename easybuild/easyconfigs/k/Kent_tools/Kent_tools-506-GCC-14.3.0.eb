easyblock = 'MakeCp'

name = 'Kent_tools'
version = '506'

homepage = 'https://genome.cse.ucsc.edu/'
description = """Kent utilities: collection of tools used by the UCSC genome browser."""

_cflags = '-Wno-int-conversion -Wno-implicit-function-declaration' # -Wno-implicit-int -Wno-return-mismatch'
toolchain = {'name': 'GCC', 'version': '14.3.0'}
toolchainopts = {'extra_cflags': _cflags}

source_urls = [
    'https://hgdownload.cse.ucsc.edu/admin/exe/',
    'https://hgdownload.cse.ucsc.edu/admin/exe/userApps.archive/',
    'http://hgdownload.cse.ucsc.edu/admin/exe/userApps.archive/',  # http fallback
]
sources = ['userApps.v%(version)s.src.tgz']
checksums = ['24fffa2072727de6e517ef6a5bc5b8d56ad7816a5971154affff8876356c02fd']

dependencies = [
    ('MariaDB', '12.3.2'),
    ('libpng', '1.6.50'),
    ('zlib', '1.3.1'),
    ('util-linux', '2.41'),
    ('OpenSSL', '3', '', SYSTEM),
    ('freetype', '2.13.3'),
    ('cURL', '8.14.1'),
    ('HTSlib', '1.22.1'),
]

prebuildopts = 'sed -i "s/rsync -a /cp -a /" %(builddir)s/userApps/kent/src/parasol/makefile && '
prebuildopts += 'sed -i "/.*submoduleSetup/d" %(builddir)s/userApps/kent/src/makefile && '

buildopts = 'CC="$CC" COPT="$CFLAGS -fcommon" PNGLIB="-L$EBROOTLIBPNG/lib -lpng" ZLIB="-L$EBROOTZLIB/lib -lz" '
buildopts += 'SSL_DIR="$EBROOTOPENSSL" SSLDIR="$EBROOTOPENSSL" MYSQLLIBS="-L$EBROOTMARIADB/lib -lmariadb -lstdc++" '
# add libiconv to fix build error "undefined reference to symbol 'libiconv_open'"
buildopts += 'ICONVLIB="-L$EBROOTLIBICONV/lib -liconv" '

local_binaries = ['blat', 'bedPartition', 'getRna', 'liftOver', 'mafGene', 'splitFile', 'twoBitToFa']

files_to_copy = [(['bin/*'], 'bin'), 'licenseBlat.txt', 'licenseUcscGenomeBrowser.txt']

sanity_check_paths = {
    'files': [f'bin/{x}' for x in local_binaries],
    'dirs': [],
}

sanity_check_commands = [f"{x} 2>&1 | grep '^usage:'" for x in local_binaries]

moduleclass = 'bio'
