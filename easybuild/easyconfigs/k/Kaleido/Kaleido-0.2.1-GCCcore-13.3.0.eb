easyblock = 'PythonPackage'

name = 'Kaleido'
version = '0.2.1'

homepage = 'https://github.com/plotly/Kaleido'
description = "Fast static image export for web-based visualization libraries with zero dependencies"

toolchain = {'name': 'GCCcore', 'version': '13.3.0'}

if ARCH == 'aarch64':
    local_manylinux = 'manylinux2014'
else:
    local_manylinux = 'manylinux1'

sources = [f'%(namelower)s-%(version)s-py2.py3-none-{local_manylinux}_%(arch)s.whl']
checksums = [{
    'kaleido-0.2.1-py2.py3-none-manylinux1_x86_64.whl':
        'aa21cf1bf1c78f8fa50a9f7d45e1003c387bd3d6fe0a767cfbbf344b95bdc3a8',
    'kaleido-0.2.1-py2.py3-none-manylinux2014_aarch64.whl':
        '845819844c8082c9469d9c17e42621fbf85c2b237ef8a86ec8a8527f98b6512a',
}]

builddependencies = [
    ('binutils', '2.42'),
]
dependencies = [
    ('Python', '3.12.3'),
]

moduleclass = 'vis'
