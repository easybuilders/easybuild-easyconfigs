easyblock = 'Cargo'

name = 'denet'
version = '0.11.2'

homepage = 'https://github.com/btraven00/denet'
description = """denet is a streaming process monitor: it tracks CPU, memory, I/O, threads and network bytes
of a process and its children, with adaptive sampling and JSON output. Aimed at benchmarking and HPC jobs.
Built with NVIDIA GPU monitoring support (needs the NVIDIA driver library libnvidia-ml.so.1 at run time only),
and without eBPF profiling (which requires root privileges)."""

toolchain = {'name': 'GCCcore', 'version': '15.2.0'}

source_urls = ['https://github.com/btraven00/denet/archive/refs/tags/']
sources = [V_VERSION_TAR_GZ]
