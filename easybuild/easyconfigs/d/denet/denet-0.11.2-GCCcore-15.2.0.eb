builddependencies = [
    ('binutils', '2.45'),
    ('Rust', '1.94.1'),
]

# only build & install the denet CLI (not the ebpf_diag and test_nvml developer tools)
buildopts = '--features gpu --bin denet --locked'
testopts = '--features gpu --locked'
installopts = '--features gpu --bin denet --locked'

postinstallcmds = ['install -D -m 644 %(start_dir)s/docs/denet.1 %(installdir)s/share/man/man1/denet.1']

sanity_check_paths = {
    'files': ['bin/denet', 'share/man/man1/denet.1'],
    'dirs': [],
}

sanity_check_commands = [
    "denet --version | grep 'features: gpu'",
    "denet --help",
]

moduleclass = 'tools'
