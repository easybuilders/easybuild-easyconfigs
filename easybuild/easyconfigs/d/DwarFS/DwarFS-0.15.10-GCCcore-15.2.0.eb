easyblock = 'CMakeMake'

name = 'DwarFS'
version = '0.15.10'

homepage = 'https://github.com/mhx/dwarfs'
description = 'A fast high-compression read-only file system for Linux, FreeBSD, macOS and Windows'

toolchain = {'name': 'GCCcore', 'version': '15.2.0'}

source_urls = ['https://github.com/mhx/dwarfs/archive/refs/tags/']
sources = [V_VERSION_TAR_GZ]
checksums = ['9fc0cf95fdecba534703610296102db60eb22f6b55c4a17e9b7d18b51794153d']

builddependencies = [
    ('binutils', '2.45'),
    ('CMake', '4.2.1'),
    ('pkgconf', '2.5.1'),
    ('git', '2.52.0'),
    ('utfcpp', '5.0.0'),
]

dependencies = [
    ('FUSE', '3.18.2'),
    ('Brotli', '1.2.0'),
    ('FLAC', '1.5.0'),
    ('lz4', '1.10.0'),
    ('XZ', '5.8.2'),
    ('fmt', '12.2.0'),
    ('Boost', '1.90.0'),
    ('Parallel-Hashmap', '2.1.0'),
    ('xxHash', '0.8.3'),
    ('nlohmann_json', '3.12.0'),
]

configopts = ' '.join([
    '-DNIXPKGS_DWARFS_VERSION_OVERRIDE=v%(version)s',
    '-DWITH_MAN_OPTION=OFF',
    '-DWITH_MAN_PAGES=OFF',
])

sanity_check_paths = {
    'files': [f'bin/{x}' for x in ['dwarfs', 'dwarfsck', 'dwarfsextract', 'mkdwarfs']],
    'dirs': [],
}

sanity_check_commands = ['dwarfs -h']

moduleclass = 'tools'
