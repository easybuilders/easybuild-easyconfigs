dependencies = [
    ('Python', '3.14.2'),
    ('Python-bundle-PyPI', '2026.04'),
    ('SciPy-bundle', '2026.05'),
    ('PyYAML', '6.0.3'),
    ('bokeh', '3.10.0'),
]

