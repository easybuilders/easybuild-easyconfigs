easyblock = 'Tarball'

name = 'DBeaver'
version = '26.2.0'

homepage = 'https://dbeaver.io'
description = 'Database tool for developers, SQL programmers, database administrators and analysts'

toolchain = SYSTEM

source_urls = ['https://github.com/dbeaver/dbeaver/releases/download/%(version)s/']
sources = [f'dbeaver-ce-%(version)s-linux-{ARCH}.tar.gz']
checksums = [{
    'dbeaver-ce-%(version)s-linux-aarch64.tar.gz': '6ada803a39c072fc8f1c7770669298e92a3501744a6e1ff919794a0dedf95963',
    'dbeaver-ce-%(version)s-linux-x86_64.tar.gz': 'f504e70a74763aa02e0b63d6842b85ca64526f682be457b3f30e330cc10748ed',
}]

dependencies = [
    ('Java', '21'),
]

sanity_check_paths = {
    'files': ['bin/dbeaver'],
    'dirs': [],
}

sanity_check_commands = ['dbeaver -h']

moduleclass = 'vis'
