Damaris overwrites CMAKE_CXX_FLAGS instead of appending to it, so every flag
supplied on the cmake command line or through the environment is discarded:
the site's optarch (-mcpu=native), EasyBuild's own CXXFLAGS, and any include
path needed to reach an MPI that is not provided through the compiler wrapper.

Keeps the original flags and appends to them.

Etienne Ndamlabin, 2026-10-07
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -90,7 +90,7 @@
 endif(ENABLE_FORTRAN)
 
 #----------------------------------------------------------------------------#
-set(CMAKE_CXX_FLAGS "-Wno-unused-variable -Wno-unused-parameter -Wall -rdynamic")
+set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -Wno-unused-variable -Wno-unused-parameter -Wall -rdynamic")
 #set (CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -Wextra") # for development only
 
 #----------------------------------------------------------------------------#
