# Author: J. Saßmannshausen (Imperial College London/UK)

easyblock = 'CMakeMake'

name = 'doctest'
version = '2.5.2'

homepage = 'https://github.com/doctest/doctest'
description = """
doctest is a new C++ testing framework but is by far the fastest both in compile
times (by orders of magnitude) and runtime compared to other feature-rich
alternatives.
It brings the ability of compiled languages such as D / Rust / Nim to have tests
written directly in the production code thanks to a fast, transparent and
flexible test runner with a clean interface.
"""

toolchain = {'name': 'gompi', 'version': '2025b'}

source_urls = [GITHUB_SOURCE]
github_account = 'doctest'
sources = ['v%(version)s.tar.gz']
checksums = ['9189960c2bbbc4f3382ce0773b2bb5f13e3afd8fed47f55f193e11e85a4f9854']

builddependencies = [
    ('binutils', '2.44'),
    ('CMake', '4.0.3'),
]

runtest = 'test'

sanity_check_paths = {
    'files': ['include/doctest/doctest.h'],
    'dirs': ['lib'],
}

moduleclass = 'tools'
