easyblock = 'PythonPackage'

name = 'dependency-groups'
version = '1.3.2'

homepage = 'https://github.com/pypa/dependency-groups'
description = """An implementation of Dependency Groups (PEP 735). This is a library which is
able to parse dependency groups, following includes, and provide that data as output."""

toolchain = {'name': 'GCCcore', 'version': '14.2.0'}

sources = ['dependency_groups-%(version)s.tar.gz']
checksums = ['c81831f43828dbc3987ee247eb198241a0152b8e7ceab10977cc3808eb388ac7']

builddependencies = [
    ('binutils', '2.42'),
    ('flit-core', '3.12.0'),
]

dependencies = [
    ('Python', '3.13.1'),
]

moduleclass = 'tools'
