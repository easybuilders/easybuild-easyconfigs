easyblock = 'PythonPackage'

name = 'dpdata'
version = '1.1.0'

homepage = 'https://github.com/deepmodeling/dpdata'
description = """Turn atomistic simulation outputs into interoperable, machine-learning-ready
datasets."""

toolchain = {'name': 'foss', 'version': '2025a'}

sources = [SOURCE_TAR_GZ]
checksums = ['27a56ac7425bcd8c911ae0a4830867e1ac3cc9273f9591d8e18ff3c3ff824e7f']

builddependencies = [
    ('setuptools-scm', '9.2.2'),
    ('setuptools', '80.9.0'),
]

dependencies = [
    ('Python', '3.13.1'),
    ('SciPy-bundle', '2025.06'),
    ('PyYAML', '6.0.2'),
    ('h5py', '3.14.0'),
    ('monty', '2026.10.21'),
    ('wcmatch', '11.2'),
    ('lmdb', '3.0.0'),
    ('msgpack', '1.2.3'),
]

moduleclass = 'tools'
