easyblock = 'MakeCp'

name = 'Delly'
version = '2.8.2'

homepage = 'https://github.com/dellytools/delly/'
description = """Delly is an integrated structural variant (SV)
and copy-number variant (CNV) prediction method that can discover,
genotype and visualize deletions, insertions, tandem duplications,
inversions and translocations at single-nucleotide resolution in
short-read and long-read whole-genome sequencing data. It uses
paired-ends, split-reads and read-depth to discover and
genotype SVs in the genome."""

toolchain = {'name': 'GCC', 'version': '14.3.0'}
toolchainopts = {'pic': True}

github_account = 'dellytools'
source_urls = [GITHUB_LOWER_SOURCE]
sources = ['v%(version)s.tar.gz']
checksums = ['9c870926df96772cca1f784aa3e92adfb2b0f510734f1c05fb197045077150e1']

dependencies = [
    ('Boost', '1.88.0'),
    ('bzip2', '1.0.8'),
    ('HTSlib', '1.22.1'),
    ('XZ', '5.8.1'),
    ('zlib', '1.3.1'),
]

build_cmd = 'make HTSLIBINCDIR=$EBROOTHTSLIB/include HTSLIBLIBDIR=$EBROOTHTSLIB/lib -B src/%(namelower)s'

files_to_copy = [(['src/%(namelower)s'], 'bin')]

sanity_check_paths = {
    'files': ['bin/%(namelower)s'],
    'dirs': [],
}

sanity_check_commands = ['%(namelower)s --version']

moduleclass = 'bio'
