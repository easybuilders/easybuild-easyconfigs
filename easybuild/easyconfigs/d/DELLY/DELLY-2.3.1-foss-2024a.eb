easyblock = 'MakeCp'

name = 'DELLY'
version = '2.3.1'

homepage = 'https://github.com/dellytools/delly'
description = """
DELLY is an integrated structural variant discovery method using paired-end,
split-read and read-depth evidence.
"""

toolchain = {'name': 'foss', 'version': '2024a'}

source_urls = ['https://github.com/dellytools/delly/archive/refs/tags/']
sources = ['v%(version)s.tar.gz']
checksums = ['4e2568b16039d40399f58e7cffc851bfdb17ae5eccbc0c2e1768502c0895e42e']

# Fill after downloading:

dependencies = [
    ('Boost', '1.85.0'),
    ('HTSlib', '1.21', '', ('GCC', '13.3.0')),
]

buildopts = 'PARALLEL=1'

files_to_copy = [
    (['src/delly'], 'bin'),
]

sanity_check_paths = {
    'files': ['bin/delly'],
    'dirs': [],
}

sanity_check_commands = [
    'delly --version',
    'delly --help',
    'delly sr --help',
    'delly lr --help',
]

moduleclass = 'bio'
