easyblock = 'CMakeMake'

name = 'DIAMOND'
version = '2.2.6'

homepage = 'https://github.com/bbuchfink/diamond'
description = "Accelerated BLAST compatible local sequence aligner"

toolchain = {'name': 'GCC', 'version': '15.2.0'}

github_account = 'bbuchfink'
source_urls = [GITHUB_LOWER_SOURCE]
sources = [V_VERSION_TAR_GZ]
checksums = ['4be3298f3331bece6a5a436987f2c9965b3807ade89fb808b89d905b6f6291e4']

builddependencies = [
    ('CMake', '3.31.11'),
]
dependencies = [
    ('zlib', '2.3.2'),
    ('zstd', '1.5.7'),
]

configopts = '-DWITH_ZSTD:BOOL="ON"'

sanity_check_paths = {
    'files': ['bin/%(namelower)s'],
    'dirs': [],
}

sanity_check_commands = ['%(namelower)s help']

moduleclass = 'bio'
