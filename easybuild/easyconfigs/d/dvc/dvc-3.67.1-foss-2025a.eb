easyblock = 'PythonBundle'

name = 'dvc'
version = '3.67.1'

homepage = 'https://dvc.org/'
description = """Manage data the way code is managed. Using a Git-like model we bring software engineering
best practices to data, AI/ML and data science teams"""
# software_license = 'LicenseApachev2'

toolchain = {'name': 'foss', 'version': '2025a'}

builddependencies = [
    ('binutils', '2.42'),
    ('hatchling', '1.27.0'),
]

