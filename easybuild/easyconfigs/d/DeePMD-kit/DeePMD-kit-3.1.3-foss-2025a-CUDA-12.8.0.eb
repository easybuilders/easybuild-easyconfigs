easyblock = 'PythonBundle'

name = 'DeePMD-kit'
version = '3.1.3'
versionsuffix = '-CUDA-%(cudaver)s'

homepage = 'https://github.com/deepmodeling/deepmd-kit/'
description = """A deep learning package for many-body potential energy representation and
molecular dynamics."""

toolchain = {'name': 'foss', 'version': '2025a'}

builddependencies = [
    ('scikit-build-core', '0.11.1'),
    ('hatchling', '1.27.0'),
    ('poetry', '2.1.2'),
    ('git', '2.49.0'),
    ('CMake', '3.31.3'),
    ('maturin', '1.8.3'),
    ('setuptools-scm', '9.2.2'),
    ('dependency-groups', '1.3.2'),
]
dependencies = [
    ('CUDA', '12.8.0', '', SYSTEM),
    ('Python', '3.13.1'),
    ('SciPy-bundle', '2025.06'),
    ('ml_dtypes', '0.5.1'),
    ('pydantic', '2.11.7'),
    ('PyYAML', '6.0.2'),
    ('PyTorch', '2.9.1', versionsuffix),
    ('h5py', '3.14.0'),
    ('mpi4py', '4.1.0'),
    ('Deprecated', '1.2.18'),
    ('SQLAlchemy', '2.0.41'),
    ('ruamel.yaml', '0.18.14'),
    ('wrapt', '1.17.2'),
    ('typing-extensions', '4.14.0'),
    ('typeguard', '4.6.0'),
    ('bracex', '3.2'),
    ('wcmatch', '11.2'),
    ('pyfiglet', '0.8.post1'),
    ('array-api-compat', '1.15.0'),
    ('monty', '2026.10.21'),
    ('dargs', '0.5.1'),
    ('dpdata', '1.1.0'),
    ('mendeleev', '1.1.0'),
]

local_torch_pkg_dir = '$EBROOTPYTORCH/lib/python%(pyshortver)s/site-packages/torch'

local_deepdm_configopts = '-DENABLE_PYTORCH=TRUE '
local_deepdm_configopts += '-DUSE_CUDA_TOOLKIT=ON '
local_deepdm_configopts += '-DCMAKE_PREFIX_PATH=' + local_torch_pkg_dir + ' '
# Have CMake's install-RPATH rewrite carry over the real link-time library paths
local_deepdm_configopts += '-DCMAKE_INSTALL_RPATH_USE_LINK_PATH=ON '

# Drop INSTALL_RPATH overwrite
local_fix_op_pt_rpath = 'sed -i \'/INSTALL_RPATH "\\$ORIGIN"/d\' '

local_deepmd_preinstallopts = local_fix_op_pt_rpath + 'source/op/pt/CMakeLists.txt && '
local_deepmd_preinstallopts += 'export CMAKE_ARGS=-DCMAKE_INSTALL_RPATH_USE_LINK_PATH=ON && '
local_deepmd_preinstallopts += 'export DP_VARIANT=cuda && export DP_ENABLE_TENSORFLOW=0 && '
local_deepmd_preinstallopts += 'export DP_ENABLE_PYTORCH=1 && '

local_deepmd_cpp_preconfigopts = local_fix_op_pt_rpath + '../deepmd_kit-%(version)s/source'
local_deepmd_cpp_preconfigopts += '/op/pt/CMakeLists.txt && '

components = [
    ('deepmd', version, {
        'easyblock': 'PythonPackage',
        'source_urls': ['https://pypi.python.org/packages/source/d/deepmd-kit/'],
        'sources': ['deepmd_kit-%(version)s.tar.gz'],
        'preinstallopts': local_deepmd_preinstallopts,
        'start_dir': 'deepmd_kit-%(version)s',
        'checksums': ['6aedb4aedc516a688d4bcee7f81a1ff2dbb46e5dba70851be6e77903af889bd0'],
    }),
    ('deepmd_cpp', version, {
        'easyblock': 'CMakeMake',
        'source_urls': ['https://pypi.python.org/packages/source/d/deepmd-kit/'],
        'sources': ['deepmd_kit-%(version)s.tar.gz'],
        'start_dir': 'deepmd_kit-%(version)s/source',
        'preconfigopts': local_deepmd_cpp_preconfigopts,
        'configopts': local_deepdm_configopts,
        'checksums': ['6aedb4aedc516a688d4bcee7f81a1ff2dbb46e5dba70851be6e77903af889bd0'],
    }),
]

sanity_check_paths = {
    'files': ['bin/dp', 'bin/dp_ipi', 'lib/libdeepmd_cc.so', 'lib/libdeepmd.so'],
    'dirs': ['lib/python%(pyshortver)s/site-packages', 'include/deepmd'],
}

sanity_check_commands = ['dp -h']

modextravars = {
    'DP_BACKEND': 'pytorch',
}

moduleclass = 'ai'
