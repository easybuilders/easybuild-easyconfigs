easyblock = 'PythonPackage'

name = 'dm-tree'
version = '0.1.10'

homepage = 'https://github.com/deepmind/tree'
description = """dm-tree provides tree, a library for working with nested data structures. In a way,
tree generalizes the builtin map function which only supports flat sequences, and
allows to apply a function to each "leaf" preserving the overall structure."""

toolchain = {'name': 'gfbf', 'version': '2026.1'}

sources = ['dm_tree-%(version)s.tar.gz']
patches = ['dm-tree-0.1.10_pybind11.patch']
checksums = [
    {'dm_tree-0.1.10.tar.gz': '22f37b599e01cc3402a17f79c257a802aebd8d326de05b54657650845956208a'},
    {'dm-tree-0.1.10_pybind11.patch': '20254b45f1f013a33d3ca197429c2535c53921c21c53303a5a7c55c0de15453f'},
]

builddependencies = [
    ('pybind11', '3.0.4'),
]
dependencies = [
    ('Python', '3.14.2'),
    ('absl-py', '2.4.0'),
    ('Abseil', '20260107.1'),
    ('SciPy-bundle', '2026.05'),
    ('wrapt', '2.2.1'),
]

options = {'modulename': 'tree'}

moduleclass = 'lib'
