easyblock = 'CMakeMake'

name = 'DP3'
version = '6.6'

homepage = 'https://dp3.readthedocs.io/'
description = "DP3: streaming processing pipeline for radio interferometric data."

toolchain = {'name': 'foss', 'version': '2026.1'}

sources = [
    {
        'filename': SOURCE_TAR_XZ,
        # Repo uses git submodules, which are not included in the release tarballs.
        # Thus, we let EasyBuild download directly from the git repository.
        'git_config': {
            'url': 'https://git.astron.nl/RD',
            'repo_name': '%(name)s',
            'tag': 'v%(version)s',
            'clone_into': '%(name)s',
            'recursive': True,
        },
    },
]
# The xsimd patch of DP3 6.2 is dropped: DP3 6.6 already uses xsimd 14.1.0 upstream.
# Backport of upstream commit 0a7def43 (after v6.6): the Clipper step wrote flags with unfiltered row indices, an
# out-of-bounds write that corrupted the heap ('corrupted size vs. prev_size', SIGABRT) in LINC's HBA_target workflow
patches = ['%(name)s-%(version)s_fix-clipper-filter-row-indices.patch']
checksums = [
    {SOURCE_TAR_XZ: 'a7db80cbf8519b0e311e2f6d4bc90f32438778d65ad30b7d37e99ccd7bae00e2'},
    {'%(name)s-%(version)s_fix-clipper-filter-row-indices.patch':
     'dd01e2868b281a0661eff0e2c6a0e587d300a37f4a1bf22f6466e48a18ce638c'},
]

builddependencies = [
    ('CMake', '3.31.11'),
]
dependencies = [
    ('casacore', '3.8.1'),  # was 3.5.0
    ('Boost', '1.90.0'),
    ('CFITSIO', '4.6.4'),
    ('WCSLIB', '8.10'),  # was 7.11
    ('GSL', '2.8'),
    ('HDF5', '2.1.1'),
    ('Python', '3.14.2'),
    ('EveryBeam', '0.8.5'),  # was 0.6.1; DP3 6.6 requires EveryBeam < 0.9, matches the version used by LINC 5.2
    ('Armadillo', '15.2.7'),
    ('AOFlagger', '3.5.1'),
    ('IDG', '1.3.0'),
]

# DP3 does not install any headers (the old check for include/include/dp3/base/DP3.h never existed): check bin and lib
sanity_check_paths = {
    'files': ['bin/%(name)s', 'bin/showsourcedb', 'lib/lib%(name)s.so'],
    'dirs': ['bin', 'lib'],
}

sanity_check_commands = [('%(name)s', '--version')]

moduleclass = 'astro'
