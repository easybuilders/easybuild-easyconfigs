Update DSSP 4.4.10 for the CMake package naming used by libmcfp >= 1.4.

libmcfp 1.4 installs the CMake package as mcfp and exports the target
mcfp::mcfp rather than libmcfp::libmcfp.

Author: Pavel Tomanek (Inuits/UGent) with help from ChatGPT5.6
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -100 +100 @@
-find_package(libmcfp QUIET)
+find_package(mcfp 1.4 QUIET)
@@ -102 +102 @@
-if(NOT (libmcfp_FOUND OR TARGET libmcfp))
+if(NOT (mcfp_FOUND OR TARGET mcfp::mcfp))
@@ -144 +144 @@
-target_link_libraries(mkdssp PRIVATE libmcfp::libmcfp dssp::dssp)
+target_link_libraries(mkdssp PRIVATE mcfp::mcfp dssp::dssp)
