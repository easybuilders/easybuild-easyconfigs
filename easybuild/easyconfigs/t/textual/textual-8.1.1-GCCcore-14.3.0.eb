easyblock = 'PythonBundle'

name = 'textual'
version = '8.1.1'

homepage = 'https://textual.textualize.io'
description = """The lean application framework for Python. Build sophisticated user
 interfaces with a simple Python API. Run your apps in the terminal and a web browser."""

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}

builddependencies = [
    ('binutils', '2.44'),
    ('poetry', '2.1.3'),
]

dependencies = [
    ('Python', '3.13.5'),
    ('Python-bundle-PyPI', '2025.07'),
    ('typing-extensions', '4.14.1'),
    ('Pygments', '2.19.2'),
    ('rich', '15.0.0'),
]

exts_list = [
    ('mdit-py-plugins', '0.6.1', {
        'checksums': ['a2bca0f039f39dbd35fb74ae1b5f998608c437463371f0ff7f49a19a17a114d0'],
    }),
    (name, version, {
        'checksums': ['eef0256a6131f06a20ad7576412138c1f30f92ddeedd055953c08d97044bc317'],
    }),
]

moduleclass = 'tools'
