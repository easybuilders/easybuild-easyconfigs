easyblock = 'PythonBundle'

name = 'torchvision'
version = '0.24.1'
versionsuffix = '-CUDA-%(cudaver)s'

homepage = 'https://github.com/pytorch/vision'
description = " Datasets, Transforms and Models specific to Computer Vision"

toolchain = {'name': 'foss', 'version': '2025a'}

builddependencies = [('expecttest', '0.3.0')]  # tests
dependencies = [
    ('CUDA', '12.8.0', '', SYSTEM),
    ('Python', '3.13.1'),
    ('SciPy-bundle', '2025.06'),
    ('PyTorch', '2.9.1', versionsuffix),
    ('libjpeg-turbo', '3.1.0'),
    ('libpng', '1.6.48'),
    ('libwebp', '1.5.0'),
    ('Pillow', '11.3.0'),
]

exts_list = [
    ('pytest-mock', '3.14.1', {
        'checksums': ['159e9edac4c451ce77a5cdb9fc5d1100708d2dd4ba3c3df572f14097351af80e'],
    }),
    (name, version, {
        'source_urls': ['https://github.com/pytorch/vision/archive'],
        'sources': [{'download_filename': 'v%(version)s.tar.gz', 'filename': '%(name)s-%(version)s.tar.gz'}],
        'patches': ['torchvision-0.24.1_fix-TestAffine.patch'],
        'preinstallopts': 'export FORCE_CUDA=1 && ',
        'installopts': '-v',
        'runtest': 'pytest -m "not xfail"',  # don't run tests that are expected that they might fail
        'testinstall': True,
        'checksums': [
            {'torchvision-0.24.1.tar.gz': '071da2078600bfec4886efab77358c9329abfedcf1488b05879b556cb9b84ba7'},
            {'torchvision-0.24.1_fix-TestAffine.patch':
             '5e7ae4a5ebc0fb432cc3ee1f424aaf5b86e0dcac2a8682567c82875549ac0a24'},
        ],
    }),
]

moduleclass = 'vis'
