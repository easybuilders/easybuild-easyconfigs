easyblock = 'PythonBundle'

name = 'torchvision'
version = '0.24.0'
versionsuffix = '-CUDA-%(cudaver)s'

homepage = 'https://github.com/pytorch/vision'
description = "Datasets, transforms and models specific to computer vision"

toolchain = {'name': 'foss', 'version': '2025a'}
toolchainopts = {'cstd': 'c++17'}

builddependencies = [
    ('CMake', '3.31.3'),
]

dependencies = [
    ('CUDA', '12.8.0', '', SYSTEM),
    ('Python', '3.13.1'),
    ('Python-bundle-PyPI', '2025.04'),
    ('SciPy-bundle', '2025.06'),
    ('FFmpeg', '7.1.1'),
    ('Pillow', '11.3.0'),
    ('PyTorch', '2.9.1', versionsuffix),
    ('libwebp', '1.5.0'),
]

exts_list = [
    ('pytest-mock', '3.14.1', {
        'source_tmpl': 'pytest_mock-%(version)s.tar.gz',
        'checksums': ['159e9edac4c451ce77a5cdb9fc5d1100708d2dd4ba3c3df572f14097351af80e'],
    }),
    (name, version, {
        'source_urls': ['https://github.com/pytorch/vision/archive'],
        'sources': [{'download_filename': 'v%(version)s.tar.gz', 'filename': '%(name)s-%(version)s.tar.gz'}],
        'installopts': '-v',
        'testinstall': False,
        'checksums': [
            {'torchvision-0.24.0.tar.gz': 'f799cdd1d67a3edbcdc6af8fb416fe1b019b512fb426c0314302cd81518a0095'},
        ],
    }),
]

moduleclass = 'vis'
