easyblock = 'PythonBundle'

name = 'tinydft'
version = '1.0.0'

homepage = 'https://github.com/theochem/tinydft'
description = """Tiny DFT is a minimalistic atomic Density Functional Theory (DFT) code,
mainly for educational purposes."""

toolchain = {'name': 'gfbf', 'version': '2026.1'}

builddependencies = [('hatchling', '1.29.0')]
dependencies = [
    ('Python', '3.14.2'),
    ('Python-bundle-PyPI', '2026.04'),
    ('SciPy-bundle', '2026.05'),
    ('matplotlib', '3.10.9'),
]

exts_list = [
    ('pytest-regressions', '2.11.0', {
        'checksums': ['d4a86092f979eb25d2403c51b2b61039781c4c7c7a364a56b9fa838872a650f7'],
    }),
    ('pytest-datadir', '1.8.0', {
        'checksums': ['7a15faed76cebe87cc91941dd1920a9a38eba56a09c11e9ddf1434d28a0f78eb'],
    }),
    ('autograd', '1.9.1', {
        'checksums': ['7818c5c69ddf9efb7da74097bd741a4c7920133f41966f68537223a15ef798bc'],
    }),
    (name, version, {
        'runtest': "pytest -v --numprocesses %(parallel)s tests",
        'testinstall': True,
        'checksums': ['5a5dc6ca92582362c29560d79c20b185cde1cb3e5368e3942f94bcce6c5dd7a3'],
    }),
]

moduleclass = 'tools'
