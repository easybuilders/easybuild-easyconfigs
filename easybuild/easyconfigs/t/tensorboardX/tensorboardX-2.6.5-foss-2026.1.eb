easyblock = 'PythonBundle'

name = 'tensorboardX'
version = '2.6.5'

homepage = 'https://github.com/lanpa/tensorboardX'
description = "Tensorboard for PyTorch."

toolchain = {'name': 'foss', 'version': '2026.1'}

# tensorboardX v2.x works with tensorboards generated with TensorFlow 2,
# but TensorFlow is not needed to use tensorboardX
dependencies = [
    ('Python', '3.14.2'),
    ('SciPy-bundle', '2026.05'),
    ('protobuf-python', '7.35.0'),
]

exts_list = [
    (name, version, {
        'sources': [SOURCELOWER_TAR_GZ],
        'checksums': ['ca176db3997ee8c07d2eb77381225956a3fd1c10c91beafab1f17069adc47017'],
    }),
]

moduleclass = 'vis'
