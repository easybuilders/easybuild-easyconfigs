easyblock = 'PythonPackage'

name = 'typeguard'
version = '4.6.0'

homepage = 'https://typeguard.readthedocs.io/'
description = """This library provides run-time type checking for functions
defined with PEP 484 argument (and return) type annotations."""

toolchain = {'name': 'GCCcore', 'version': '14.2.0'}

sources = [SOURCE_TAR_GZ]
checksums = ['e7414f09111317de3e335de92cd397c5c0ca00b1cc1676de12e1d444a79b3f21']

builddependencies = [
    ('binutils', '2.42'),
    ('setuptools-scm', '9.2.2'),
    ('setuptools', '80.9.0'),
]

dependencies = [
    ('Python', '3.13.1'),
    ('typing-extensions', '4.14.0'),
]

moduleclass = 'tools'
