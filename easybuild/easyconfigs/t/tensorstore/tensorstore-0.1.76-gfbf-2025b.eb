            'https://storage.googleapis.com/tensorstore-bazel-mirror/github.com/morganwl/rules_nasm/archive/',
        ],
        'sources': [{
            'download_filename': f'{_rules_nasm_version}.tar.gz',
            'filename': f'rules_nasm-{_rules_nasm_version}.tar.gz',
            'extract_cmd': _extract_cmd + f'{_rules_nasm_version}.tar.gz',
        }],
        'checksums': [{
            f'rules_nasm-{_rules_nasm_version}.tar.gz':
            'cd79c1ccff2d290f91ea3d23b42df246865dc88e1247cf193999e3e1f4cd6886',
        }],
    }),
    ('rules_shell', _rules_shell_version, {
        'sources': [{
            'download_filename': f'v{_rules_shell_version}.tar.gz',
            'filename': f'rules_shell-{_rules_shell_version}.tar.gz',
            'extract_cmd': _extract_cmd + f'v{_rules_shell_version}.tar.gz',
        }],
        'checksums': [{
            f'rules_shell-{_rules_shell_version}.tar.gz':
            '3e114424a5c7e4fd43e0133cc6ecdfe54e45ae8affa14fadd839f29901424043',
        }],
    }),
]
# make any bazel download fail:
_preinstall_use_invalid_proxy = 'export HTTPS_PROXY=BAZEL_DOWNLOAD_DEP_FAIL &&'
# set system libs:
_preinstall_bazel_exports_syslibs = """export TENSORSTORE_SYSTEM_LIBS="%s"  && """ % ','.join(_systemlibs)
# set output_user_root:
_preinstall_bazel_exports_startup = "export TENSORSTORE_BAZEL_STARTUP_OPTIONS="
_preinstall_bazel_exports_startup += "'--output_user_root %(builddir)s/cache' &&"
# setup Bazel build options (pass CFLAGS, extra include paths and extra link paths for systemlibs:
_preinstall_bazel_exports_buildopts = 'export TENSORSTORE_BAZEL_BUILD_OPTIONS="'
_preinstall_bazel_exports_buildopts += '$(for i in  $CFLAGS;do echo --copt=$i; done) '  # pass CFLAGS to Bazel as copts
_preinstall_bazel_exports_buildopts += _bzl_syslib_opts
_preinstall_bazel_exports_buildopts += ' --distdir=%s' % _dist_dir
_preinstall_bazel_exports_buildopts += ' --distdir=%s' % _dist_dir_aws_c_cal
# pass $TMPDIR from host into sandbox used by Bazel,
# required when using RPATH linking because of RPATH wrapper scripts;
# see also https://github.com/bazelbuild/bazel/issues/19915
_preinstall_bazel_exports_buildopts += ' --sandbox_add_mount_pair=$TMPDIR'
_preinstall_bazel_exports_buildopts += ' --subcommands --verbose_failures'
_preinstall_bazel_exports_buildopts += '" &&'  # (end prebuild_bazel_exports_buildopts)

# put all together:
_preinstall_opts = _preinstall_use_invalid_proxy + ' '
_preinstall_opts += _preinstall_bazel_exports_startup + ' '
_preinstall_opts += _preinstall_bazel_exports_buildopts + ' '
_preinstall_opts += _preinstall_bazel_exports_syslibs + ' '

exts_list = [
    (name, version, {
        'installopts': '-v',
        'patches': ['tensorstore-0.1.69_bazelisk.patch'],
        'preinstallopts': _preinstall_opts,
        'testinstall': True,
        'runtest': 'python -s -m pytest -v python/tensorstore/tests',
        'checksums': [
            {'tensorstore-0.1.76.tar.gz': 'ed0d565e7a038a84b1b5b5d9f7397caec200b53941d8889f44b7f63dd6abffe7'},
            {'tensorstore-0.1.69_bazelisk.patch': 'f7bb3dc7265597c6ae999df8b17d6e7300c0c0ce307579909a2af8738d78026f'},
        ],
    }),
]

moduleclass = 'lib'
