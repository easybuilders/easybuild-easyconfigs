easyblock = 'PythonBundle'

name = 'tinyff'
version = '2.1.0'

homepage = 'https://github.com/molmod/tinyff'
description = """This is a minimalistic force-field engine written in pure Python, using vectorized NumPy code."""

toolchain = {'name': 'gfbf', 'version': '2026.1'}

builddependencies = [('numdifftools', '0.9.42')]
dependencies = [
    ('Python', '3.14.2'),
    ('Python-bundle-PyPI', '2026.04'),
    ('SciPy-bundle', '2026.05'),
]

exts_list = [
    ('npy-append-array', '0.9.19', {
        'checksums': ['7056e852cf597cca367d06b581068e99c18bb57499c524b4b2ffc7020f8f9477'],
    }),
    (name, version, {
        'runtest': "pytest -v",
        'testinstall': True,
        'checksums': ['4c126e6569f110b628c0947d114cc761cbc1ebfee7d74834987710c8304997e2'],
    }),
]

moduleclass = 'tools'
