easyblock = 'PythonBundle'

name = 'torchcodec'
version = '0.9.1'
versionsuffix = '-CUDA-%(cudaver)s'

homepage = 'https://github.com/meta-pytorch/torchcodec'
description = """PyTorch media decoding and encoding."""

toolchain = {'name': 'foss', 'version': '2025a'}

builddependencies = [
    ('CMake', '3.31.3'),
    ('pkgconf', '2.3.0'),
    ('pybind11', '2.13.6'),
]
dependencies = [
    ('CUDA', '12.8.0', '', SYSTEM),
    ('Python', '3.13.1'),
    ('PyTorch', '2.9.1', versionsuffix),
    ('FFmpeg', '7.1.1', versionsuffix),
]

exts_list = [
    (name, version, {
        'source_urls': ['https://github.com/meta-pytorch/torchcodec/archive'],
        'sources': [{'download_filename': 'v%(version)s.tar.gz', 'filename': '%(name)s-%(version)s.tar.gz'}],
        'patches': [
            'torchcodec-0.9.1_fix-BT709-full-range-CUDA12.patch',
        ],
        'preinstallopts': (
            'BUILD_VERSION=%(version)s '
            'ENABLE_CUDA=1 '
            'I_CONFIRM_THIS_IS_NOT_A_LICENSE_VIOLATION=1 '
            'CMAKE_BUILD_PARALLEL_LEVEL=%(parallel)s '
        ),
        'runtest': 'pytest -v test',
        'testinstall': True,
        'checksums': [
            {'torchcodec-0.9.1.tar.gz': '115e14811c01c49efe6d4a69224e73670961eddfdab7067b16122fa2352eb219'},
            {'torchcodec-0.9.1_fix-BT709-full-range-CUDA12.patch':
             'd050e1515b16e6ed3702a969a9b665945558b53eecc3908641ac77800d3d3932'},
        ],
    }),
]

moduleclass = 'ai'
