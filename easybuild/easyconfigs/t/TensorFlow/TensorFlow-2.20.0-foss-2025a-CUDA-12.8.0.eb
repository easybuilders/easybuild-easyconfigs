easyblock = 'PythonBundle'

name = 'TensorFlow'
version = '2.20.0'
versionsuffix = '-CUDA-%(cudaver)s'

homepage = 'https://www.tensorflow.org/'
description = "An open-source software library for Machine Intelligence"

toolchain = {'name': 'foss', 'version': '2025a'}
toolchainopts = {'pic': True}

builddependencies = [
    ('hatchling', '1.27.0'),
    ('Bazel', '7.4.1', '-Java-21'),
    # git 2.x required, see also https://github.com/tensorflow/tensorflow/issues/29053
    ('git', '2.49.0'),
    ('UnZip', '6.0'),
    ('NASM', '2.16.03'),
    # Required to build some of the extensions
    ('poetry', '2.1.2'),
    ('Cython', '3.1.1'),
]

dependencies = [
    ('CUDA', '12.8.0', '', SYSTEM),
    ('cuDNN', '9.10.1.4', versionsuffix, SYSTEM),
    ('NCCL', '2.27.7', versionsuffix),
    ('Python', '3.13.1'),
    ('SciPy-bundle', '2025.06'),
    ('h5py', '3.14.0'),
    ('dill', '0.4.0'),
    ('flatbuffers-python', '25.2.10'),
    ('ml_dtypes', '0.5.1'),
    ('grpcio', '1.76.0'),
    ('wrapt', '1.17.2'),
    ('absl-py', '2.3.1'),
    ('tensorboard', '2.20.0'),
    ('optree', '0.17.0'),
    ('typing-extensions', '4.14.0'),
    ('opt-einsum', '3.4.0'),
    ('protobuf-python', '6.31.1'),
]

exts_list = [
    ('astor', '0.8.1', {
        'checksums': ['6a6effda93f4e1ce9f618779b2dd1d9d84f1e32812c23a29b3fff6fd7f63fa5e'],
    }),
    ('termcolor', '2.5.0', {
        'checksums': ['998d8d27da6d48442e8e1f016119076b690d962507531df4890fcd2db2ef8a6f'],
    }),
    ('namex', '0.0.9', {
        'checksums': ['8adfea9da5cea5be8f4e632349b4669e30172c7859e1fd97459fdf3b17469253'],
    }),
    ('keras', '3.10.0', {
        'checksums': ['6e9100bf66eaf6de4b7f288d34ef9bb8b5dcdd62f42c64cfd910226bb34ad2d2'],
    }),
    ('google-pasta', '0.2.0', {
        'modulename': 'pasta',
        'checksums': ['c9f2c8dfc8f96d0d5808299920721be30c9eec37f2389f28904f454565c8a16e'],
    }),
    ('astunparse', '1.6.3', {
        'checksums': ['5ad93a8456f0d084c3456d059fd9a92cce667963232cbf763eac3bc5b7940872'],
    }),
    ('tblib', '3.0.0', {
        'checksums': ['93622790a0a29e04f0346458face1e144dc4d32f493714c6c3dff82a4adb77e6'],
    }),
    (name, version, {
        # Fix missing llvm::cast namespace qualifier in DTensor, which causes compilation failure and
        # fix missing MLIR namespace qualifiers in DTensor (both already fixed upstream).
        # Remove libclang python dependency
        'prebuildopts': (
            "sed -i '/libclang >= 13.0.0/d' tensorflow/tools/pip_package/setup.py.tpl && "
            "sed -i 's/ExtractGlobalOutputShape(cast</ExtractGlobalOutputShape(mlir::cast</' "
            "tensorflow/dtensor/mlir/shape_utils.cc && "
            "sed -i "
            "-e 's/ cast<mlir::BlockArgument>(resource)/ mlir::cast<mlir::BlockArgument>(resource)/' "
            "-e 's/if (isa<mlir::TF::ResourceType>/if (mlir::isa<mlir::TF::ResourceType>/' "
            "tensorflow/dtensor/mlir/spmd_expansion.cc && "
            # Ensure NCCL objects are linked to avoid undefined references caused by static library ordering.
            "sed -i '/^    name = \"nccl\",$/a\\    alwayslink = True,' "
            "third_party/xla/third_party/nccl/archive.BUILD && "
        ),
        # Fix GCC header-path canonicalization in Bazel's CUDA toolchain and missing OpenSSL link flags.
        'buildopts': (
            '--repo_env=ML_WHEEL_TYPE=release --nosubcommands '
            '--copt=-no-canonical-prefixes --copt=-fno-canonical-system-headers '
            '--host_copt=-no-canonical-prefixes --host_copt=-fno-canonical-system-headers '
            '--linkopt=-lssl --linkopt=-lcrypto'
        ),
        'patches': [
            'TensorFlow-2.4.0_dont-use-var-lock.patch',
            'TensorFlow-2.13.0_add-missing-system-protobuf-targets.patch',
            'TensorFlow-2.15.1_fix-flatbuffer-license.patch',
            'TensorFlow-2.18.1_fix-xnnpack.patch',
            'TensorFlow-2.18.1_fixedpoint.patch',
            'TensorFlow-2.18.1_increase-tolerance-Conv3DBackpropFilterV2GradTest.testGradient.patch',
            'TensorFlow-2.20.0_fix-pybind11-symbol-visibility.patch',
            'TensorFlow-2.20.0_fix-libdevice-search.patch',
        ],
        'source_tmpl': 'v%(version)s.tar.gz',
        'source_urls': ['https://github.com/tensorflow/tensorflow/archive/'],
        'test_max_parallel': 4,
        'test_script': 'TensorFlow-2.x_mnist-test.py',
        'test_tag_filters_cpu': '-gpu,-tpu,-no_cuda_on_cpu_tap,-no_pip,-no_oss,-oss_serial,-benchmark-test,-v1only',
        'test_tag_filters_gpu': (
            'gpu,-no_gpu,-nogpu,-gpu_cupti,-no_cuda11,'
            '-no_pip,-no_oss,-oss_serial,-benchmark-test,-v1only'
        ),
        'test_targets': [
            '//tensorflow/core/...',
            '-//tensorflow/core:example_java_proto',
            '-//tensorflow/core/example:example_protos_closure',
            '//tensorflow/cc/...',
            '//tensorflow/c/...',
            '//tensorflow/python/...',
            '-//tensorflow/c/eager:c_api_test_gpu',
            '-//tensorflow/c/eager:c_api_distributed_test',
            '-//tensorflow/c/eager:c_api_distributed_test_gpu',
            '-//tensorflow/c/eager:c_api_cluster_test_gpu',
            '-//tensorflow/c/eager:c_api_remote_function_test_gpu',
            '-//tensorflow/c/eager:c_api_remote_test_gpu',
            '-//tensorflow/core/common_runtime:collective_param_resolver_local_test',
            '-//tensorflow/core/kernels/mkl:mkl_fused_ops_test',
            '-//tensorflow/core/kernels/mkl:mkl_fused_batch_norm_op_test',
            '-//tensorflow/core/ir/importexport/tests/roundtrip/...',
        ],
        # Relax the generated gRPC warning and retry a scheduling-dependent TensorFlow test.
        'testopts': (
            '--test_size_filters=small '
            '--flaky_test_attempts=//tensorflow/python/framework:auto_control_deps_test@3 '
            '--flaky_test_attempts=//tensorflow/core/kernels:batch_kernels_auto_warmup_test@3 '
            "--per_file_copt='cygrpc[.]cpp@-Wno-error=unused-result' "
            '--copt=-no-canonical-prefixes --copt=-fno-canonical-system-headers '
            '--host_copt=-no-canonical-prefixes --host_copt=-fno-canonical-system-headers '
            '--linkopt=-lssl --linkopt=-lcrypto '
            # Avoid a known nonterminating thread-pool test on some clusters.
            '--test_env=GTEST_FILTER=-ThreadPool.Parallelism'
        ),
        'testopts_gpu': (
            '--test_size_filters=small '
            '--test_output=errors '
            '--test_env=CUDA_HOME '
            '--run_under=//tensorflow/tools/ci_build/gpu_build:parallel_gpu_execute '
            '--copt=-no-canonical-prefixes --copt=-fno-canonical-system-headers '
            '--host_copt=-no-canonical-prefixes --host_copt=-fno-canonical-system-headers '
            '--linkopt=-lssl --linkopt=-lcrypto'
        ),
        'with_xla': True,
        'checksums': [
            {'v2.20.0.tar.gz': 'a640d1f97be316a09301dfc9347e3d929ad4d9a2336e3ca23c32c93b0ff7e5d0'},
            {'TensorFlow-2.4.0_dont-use-var-lock.patch':
             'b14f2493fd2edf79abd1c4f2dde6c98a3e7d5cb9c25ab9386df874d5f072d6b5'},
            {'TensorFlow-2.13.0_add-missing-system-protobuf-targets.patch':
             '77d8c8a5627493fc7c38b4de79d49e60ff6628b05ff969f4cd3ff9857176c459'},
            {'TensorFlow-2.15.1_fix-flatbuffer-license.patch':
             '2c04d5095977a628a238dbf93c5fada7159c86752a7183e64e0cf7c7ab00caf4'},
            {'TensorFlow-2.18.1_fix-xnnpack.patch': 'baf81d7b2b61b5a923cf1f171d5e2400df6b8bd9073d3afa7a356e3bbe11984c'},
            {'TensorFlow-2.18.1_fixedpoint.patch': '5ea1eb3b32e7df5f9ae711a71778b4cae544b3380f18882186eea035873fb640'},
            {'TensorFlow-2.18.1_increase-tolerance-Conv3DBackpropFilterV2GradTest.testGradient.patch':
             '4f66f4a08e3ad65863fafb2f012ad8343e400df26754aae83030137ae5067f4e'},
            {'TensorFlow-2.20.0_fix-pybind11-symbol-visibility.patch':
             '2b8991cd9886aa8ee0437667fc3e6774f6e56012734ffbe7e63b818338bf08de'},
            {'TensorFlow-2.20.0_fix-libdevice-search.patch':
             'a53133ae50740cbb10a04ace14db1fa0715e0ddc28d4ee67e8ad26bc54b3451a'},
