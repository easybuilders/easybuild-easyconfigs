Replace dynamic versioning with a plain static version string. PyPI source
tarballs lack the Git repository data required by setuptools-git-versioning.
Author: Emik Lin (HKUMed CPOS)
diff --git a/pyproject.toml b/pyproject.toml
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -2,12 +2,11 @@
 build-backend = "setuptools.build_meta"
 requires = [
   "setuptools >=77",
-  "setuptools-git-versioning >=2.0",
 ]

 [project]
 name = "toolz"
-dynamic = ["version"]
+version = "1.1.0"
 description = "List processing tools and functional utilities"
 readme = "README.rst"
 requires-python = ">=3.9"
@@ -45,11 +44,6 @@
 documentation = "https://toolz.readthedocs.io/en/latest/"
 changelog = "https://github.com/pytoolz/toolz/releases"

-[tool.setuptools-git-versioning]
-enabled = true
-dev_template = "{tag}+{ccount}.g{sha}"
-dirty_template = "{tag}+{ccount}.g{sha}.dirty"
