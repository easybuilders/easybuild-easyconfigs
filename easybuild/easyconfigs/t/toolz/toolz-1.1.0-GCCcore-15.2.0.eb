easyblock = 'PythonPackage'

name = 'toolz'
version = '1.1.0'

homepage = 'https://github.com/pytoolz/toolz'
description = "List processing tools and functional utilities"

toolchain = {'name': 'GCCcore', 'version': '15.2.0'}

sources = [SOURCE_TAR_GZ]
patches = ['toolz-1.1.0_use-static-version.patch']
checksums = [
    {'toolz-1.1.0.tar.gz': '27a5c770d068c110d9ed9323f24f1543e83b2f300a687b7891c1a6d56b697b5b'},
    {'toolz-1.1.0_use-static-version.patch':
     '1e434379639461a114e24013196e8c96e60ff94295aad2b54be7bb3972a78b31'},
]

builddependencies = [('binutils', '2.45')]

dependencies = [('Python', '3.14.2')]

moduleclass = 'lib'
