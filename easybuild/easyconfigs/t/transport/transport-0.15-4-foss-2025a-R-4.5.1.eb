easyblock = 'RPackage'

name = 'transport'
version = '0.15-4'
versionsuffix = '-R-%(rver)s'

homepage = 'https://cran.r-project.org/package=transport'
description = 'Computation of optimal transport plans and Wasserstein distances.'

toolchain = {'name': 'foss', 'version': '2025a'}

source_urls = ['https://cran.r-project.org/src/contrib/']
sources = [{
    'download_filename': 'transport_%(version)s.tar.gz',
    'filename': SOURCE_TAR_GZ,
}]

checksums = ['4e9342f6fd65dc39c9dfed20cb0312d34899b9cb0648aa5a67516ce7711c20cf']

dependencies = [
    ('R', '4.5.1'),
    ('R-bundle-CRAN', '2025.10'),
]

sanity_check_paths = {
    'files': [],
    'dirs': ['%(namelower)s'],
}

options = {'modulename': '%(namelower)s'}

moduleclass = 'bio'
