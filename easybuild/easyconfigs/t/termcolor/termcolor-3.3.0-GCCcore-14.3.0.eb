easyblock = 'PythonPackage'

name = 'termcolor'
version = '3.3.0'

homepage = 'https://github.com/termcolor/termcolor'
description = """
ANSI color formatting for output in terminal
"""

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}

sources = [SOURCE_TAR_GZ]
checksums = ['348871ca648ec6a9a983a13ab626c0acce02f515b9e1983332b17af7979521c5']

builddependencies = [
    ('binutils', '2.44'),
    ('hatchling', '1.27.0'),
]
dependencies = [
    ('Python', '3.13.5'),
]

moduleclass = 'devel'
