easyblock = 'PythonBundle'

name = 'tyro'
version = '1.0.15'

homepage = 'https://brentyi.github.io/tyro/'
description = """tyro is a tool for generating CLI interfaces from type-annotated Python. It
can be used to parse command-line arguments for functions, or to instantiate
config objects defined with tools like dataclasses, pydantic, and attrs."""

toolchain = {'name': 'GCCcore', 'version': '13.3.0'}

builddependencies = [
    ('binutils', '2.42'),
    ('hatchling', '1.27.0'),
    ('flit-core', '3.12.0'),
]

dependencies = [
    ('Python', '3.12.3'),
]

exts_list = [
    ('typing-extensions', '4.16.0', {
        'source_tmpl': 'typing_extensions-%(version)s.tar.gz',
        'checksums': ['dc983d19a509c94dba722ee6abd33940f7c05a89e243c47e907eb4db6f1a43e5'],
    }),
    ('typeguard', '4.5.2', {
        'checksums': ['5a16dcac23502039299c97c8941651bc33d7ea8cc4b2f7d6bbb1b528f6eea423'],
    }),
    ('docstring-parser', '0.18.0', {
        'source_tmpl': 'docstring_parser-%(version)s.tar.gz',
        'checksums': ['292510982205c12b1248696f44959db3cdd1740237a968ea1e2e7a900eeb2015'],
    }),
    (name, version, {
        'checksums': ['3f1d60887723eecb9c489f195d11f079c4a1f33df74b723552ad31ec57c667bb'],
    }),
]

sanity_check_commands = ["python -c 'import tyro; tyro.cli'"]

moduleclass = 'lib'
