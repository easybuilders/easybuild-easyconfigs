easyblock = 'PythonBundle'

name = 'rasterio'
version = '1.5.2'

homepage = 'https://github.com/mapbox/rasterio'
description = "Rasterio reads and writes geospatial raster data."

toolchain = {'name': 'foss', 'version': '2026.1'}

builddependencies = [
    ('Cython', '3.2.4'),
]

dependencies = [
    ('Python', '3.14.2'),
    ('SciPy-bundle', '2026.05'),
    ('GDAL', '3.13.0'),
    ('matplotlib', '3.10.9'),  # plot extra
    ('boto3', '1.43.34'),  # s3 extra
]

exts_list = [
    ('affine', '2.4.0', {
        'checksums': ['a24d818d6a836c131976d22f8c27b8d3ca32d0af64c1d8d29deb7bafa4da1eea'],
    }),
    ('cligj', '0.7.2', {
        'checksums': ['a4bc13d623356b373c2c27c53dbd9c68cae5d526270bfa71f6c6fa69669c6b27'],
    }),
    # rasterio 1.5.0 has requirement click!=8.2.*,>=4.0
    ('click', '8.3.3', {
        'checksums': ['398329ad4837b2ff7cbe1dd166a4c0f8900c3ca3a218de04466f38f6497f18a2'],
    }),
    (name, version, {
        'use_pip_extras': 'plot,s3',
        'checksums': ['e65a15b7bd22ce8f8ce8159856669dc9fafabf66cde6156e8f8e71d55abcd515'],
    }),
]

fix_python_shebang_for = ['bin/jp.py', 'bin/rio']

sanity_check_paths = {
    'files': ['bin/rio'],
    'dirs': ['lib/python%(pyshortver)s/site-packages'],
}

sanity_check_commands = [
    "jp.py --help",
    "rio --help",
]

moduleclass = 'geo'
