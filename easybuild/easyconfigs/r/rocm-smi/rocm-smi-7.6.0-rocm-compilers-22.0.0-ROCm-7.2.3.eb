easyblock = 'ROCmComponent'

name = 'rocm-smi'
_rocm_version = '7.2.3'
version = '7.6.0'

homepage = 'https://github.com/ROCm/rocm_smi_lib'
description = """
The ROCm System Management Interface Library, or ROCm SMI library, is part of the Radeon Open Compute ROCm software
stack. It is a C library for Linux that provides a user space interface for applications to monitor and control
GPU applications."""
docurls = ['https://rocm.docs.amd.com/projects/rocm_smi_lib/en/latest/']

toolchain = {'name': 'rocm-compilers', 'version': f'22.0.0-ROCm-{_rocm_version}'}

source_urls = ['https://github.com/ROCm/rocm-systems/archive/']
sources = [{
    'download_filename': f'rocm-{_rocm_version}.tar.gz',
    'filename': f'rocm-systems-rocm-{_rocm_version}.tar.gz',
}]
checksums = ['e90cfd8694af28a56433c8827a581ee12a4ba835f0d952436741d9e0f3f8685b']

builddependencies = [
    ('CMake', '3.31.8'),
    ('pkgconf', '2.4.3'),
    # Needed as rocm-smi tries to find git to determine commit hash it was built from
    ('git', '2.54.0'),
    ('libdrm', '2.4.125'),
]

dependencies = [
    ('Python', '3.13.5'),  # Needed as rocm-smi is a python script
]

# rocm-smi-lib is located in projects/rocm-smi-lib within rocm-systems archive
srcdir = 'projects/rocm-smi-lib'

sanity_check_paths = {
    'files': [f'lib64/librocm_smi64.{SHLIB_EXT}',
              f'lib64/liboam.{SHLIB_EXT}',
              'include/rocm_smi/rocm_smi.h'],
    'dirs': ['lib64/cmake/rocm_smi',
             'share/doc/rocm-smi-lib']
}

modextravars = {
    'ROCM_SMI_LIB_PATH': f'%(installdir)s/lib/librocm_smi64.{SHLIB_EXT}'
}

# Other commands also return exit code 0, but require kernel modules
# to work correctly. So only check --help.
sanity_check_commands = [
    'rocm-smi --help',
]

moduleclass = 'lib'
