easyblock = 'Cargo'

name = 'RastQC'
version = '0.2.0'

homepage = 'https://github.com/Huang-lab/RastQC'
description = """A fast quality control tool for high-throughput sequencing data, written in Rust.
 Drop-in replacement for FastQC with identical QC modules, matching algorithms, and compatible output formats.
 Includes support for Oxford Nanopore Fast5 and POD5 inputs."""

toolchain = {'name': 'gompi', 'version': '2026.1'}

source_urls = ['https://github.com/Huang-lab/RastQC/archive/refs/tags/']
sources = [{'download_filename': 'v%(version)s.tar.gz', 'filename': SOURCE_TAR_GZ}]
patches = ['%(name)s-%(version)s-fix-hdf5-2-compatibility.patch']
