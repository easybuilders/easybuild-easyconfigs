name = 'Rmpi'
version = '0.7-3.4'

homepage = 'https://cran.r-project.org/web/packages/Rmpi'
description = "An interface (wrapper) to MPI. It also provides interactive R manager and worker environment."

toolchain = {'name': 'foss', 'version': '2025a'}

source_urls = ['https://cran.r-project.org/src/contrib/']
sources = ['Rmpi_%(version)s.tar.gz']
checksums = ['12096db54761e8b3337955b4f3ddb785d1ded2a1cce0b58e50e63e0bc659d464']

dependencies = [
    ('R', '4.5.1'),
]

sanity_check_paths = {
    'files': [f'Rmpi/libs/Rmpi.{SHLIB_EXT}'],
    'dirs': []
}

moduleclass = 'numlib'
