# Author: sreenivasamurthy kolam <sreenivasamurthy.kolam@amd.com>

easyblock = 'CMakeMake'

name = 'rocMLIR'
version = '1.0.0'
_rocm_version = '7.2.3'

homepage = 'https://github.com/ROCm/rocMLIR'
description = """rocMLIR is an MLIR-based convolution and GEMM kernel generator for ROCm.
It provides a high-performance backend for generating optimized GPU kernels."""

toolchain = {'name': 'rocm-compilers', 'version': f'22.0.0-ROCm-{_rocm_version}'}

source_urls = ['https://github.com/ROCm/rocMLIR/archive']
sources = [{
    'download_filename': f'rocm-{_rocm_version}.tar.gz',
    'filename': f'rocMLIR-rocm-{_rocm_version}.tar.gz',
}]
checksums = ['415eacd1fbd916e2f62cd7b8acad0bf8b66cdac0211ebce09eca931843c2dce2']

builddependencies = [
    ('CMake', '3.31.8'),
    ('Python', '3.13.5'),
]

dependencies = [
    ('HIP', _rocm_version),
]

configopts = '-DBUILD_FAT_LIBROCKCOMPILER=ON '

sanity_check_paths = {
    'files': ['lib/librockCompiler.a'],
    'dirs': ['include', 'lib'],
}

moduleclass = 'lib'
