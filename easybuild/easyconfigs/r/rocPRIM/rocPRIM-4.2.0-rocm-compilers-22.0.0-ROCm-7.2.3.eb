# Author: sreenivasamurthy kolam <sreenivasamurthy.kolam@amd.com>

easyblock = 'ROCmComponent'

name = 'rocPRIM'
version = '4.2.0'
_rocm_version = '7.2.3'

homepage = 'https://github.com/ROCm/rocPRIM'
description = """rocPRIM is a header-only library that provides HIP parallel primitives.
You can use this library to develop performant GPU-accelerated code on AMD ROCm platforms."""
docurls = ['https://rocm.docs.amd.com/projects/rocPRIM/en/latest/']

toolchain = {'name': 'rocm-compilers', 'version': f'22.0.0-ROCm-{_rocm_version}'}

github_account = 'ROCm'
local_repo_name = 'rocm-libraries'
source_urls = [f'https://github.com/{github_account}/{local_repo_name}/archive']
sources = [{
    'download_filename': f'rocm-{_rocm_version}.tar.gz',
    'filename': f'{local_repo_name}-rocm-{_rocm_version}.tar.gz',
}]
checksums = ['300cc50720d40bad7c7ed1f6d67e8c5ebecaba62c07a6ea1cc5813c0ea2e41b5']

builddependencies = [
    ('CMake', '3.31.8'),
]

dependencies = [
    ('HIP', _rocm_version),
]

# Build from the projects/rocprim subdirectory
start_dir = 'projects/rocprim'

sanity_check_paths = {
    'files': ['lib/cmake/rocprim/rocprim-config.cmake',
              'include/rocprim/rocprim.hpp'],
    'dirs': ['lib/cmake/rocprim',
             'share/doc/rocprim',
             'include/rocprim'],
}

moduleclass = 'lib'
