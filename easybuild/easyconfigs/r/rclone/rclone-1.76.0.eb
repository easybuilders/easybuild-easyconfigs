easyblock = 'GoPackage'

name = 'rclone'
version = '1.76.0'

homepage = 'https://rclone.org'

description = """
 Rclone is a command line program to sync files and directories to and from
 a variety of online storage services
"""

toolchain = SYSTEM

source_urls = [GITHUB_SOURCE]
sources = [V_VERSION_TAR_GZ]
checksums = ['8cb7e5d576fe9a3aef8b1a0785e2ffc6c1953f8ed109f42000b0b86718f6628b']

builddependencies = [('Go', '1.26.10')]

postinstallcmds = [
    "mkdir -p %(installdir)s/share/{doc,man/man1}",
    "cp README.* MANUAL.* %(installdir)s/share/doc/",
    "cp rclone.1 %(installdir)s/share/man/man1/",
]

sanity_check_paths = {
    'files': ['bin/rclone', 'share/doc/README.md', 'share/man/man1/rclone.1'],
    'dirs': []
}

sanity_check_commands = ['rclone --version']

moduleclass = 'tools'
