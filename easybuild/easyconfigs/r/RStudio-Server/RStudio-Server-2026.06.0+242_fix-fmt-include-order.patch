Prioritize the bundled fmt headers to match the bundled fmt library linked by RStudio.
This avoids undefined fmt::v12 symbols when another fmt version is present in the toolchain include paths.
Author: Emik Lin (HKUMed CPOS)
diff --git a/src/cpp/CMakeLists.txt b/src/cpp/CMakeLists.txt
index 8fd8f42..57494cb 100644
--- a/src/cpp/CMakeLists.txt
+++ b/src/cpp/CMakeLists.txt
@@ -451,7 +451,7 @@ endif()

 # external libraries
 add_subdirectory(ext)
-include_directories(SYSTEM "${FMT_SOURCE_DIR}/include")
+include_directories(BEFORE "${FMT_SOURCE_DIR}/include")

 # shared library
 add_subdirectory(shared_core)
