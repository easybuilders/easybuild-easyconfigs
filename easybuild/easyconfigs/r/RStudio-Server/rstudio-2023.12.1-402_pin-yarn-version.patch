Instead of installing the latest yarn, use a fixed version.

Author: Alexander Grund (TU Dresden)
diff -ur a/dependencies/common/install-yarn rstudio-2023.12.1-402/dependencies/common/install-yarn
--- a/dependencies/common/install-yarn	2026-10-20 12:20:12.015606564 +0200
+++ rstudio-2023.12.1-402/dependencies/common/install-yarn	2026-10-20 12:21:00.136166898 +0200
@@ -34,5 +34,5 @@
   YARN_VERSION=$(PATH="${INSTALL_PATH}" yarn --version)
   echo "yarn ${YARN_VERSION} already installed at '$(which yarn)'"
 else
-  npm install -g yarn
+  npm install -g yarn@1.19.0
 fi
diff -ur a/dependencies/common/install-yarn-linux-aarch64 rstudio-2023.12.1-402/dependencies/common/install-yarn-linux-aarch64
--- a/dependencies/common/install-yarn-linux-aarch64	2026-10-20 12:20:12.015606564 +0200
+++ rstudio-2023.12.1-402/dependencies/common/install-yarn-linux-aarch64	2026-10-20 12:21:05.315119583 +0200
@@ -24,7 +24,7 @@
 PATH="$(pwd)/${NODE_SUBDIR}/bin:${PATH}"
 
 # install via node
-npm install -g yarn
+npm install -g yarn@1.19.0
 
 # update INSTALL_PATH
 INSTALL_PATH="${HOME}/.yarn/bin:${HOME}/.config/yarn/global/node_modules/.bin:${PATH}"
