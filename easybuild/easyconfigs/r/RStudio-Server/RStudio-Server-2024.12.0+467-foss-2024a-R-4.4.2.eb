easyblock = 'CMakeNinja'

name = 'RStudio-Server'
version = '2024.12.0+467'
versionsuffix = '-R-%(rver)s'
local_git_rev = 'cf37a3e5488c937207f992226d255be71f5e3f41'

homepage = 'https://www.rstudio.com/'
description = """This is the RStudio Server version.
RStudio is a set of integrated tools designed to help you be more productive with R.

The server can be started with:
  rserver --server-daemonize=0 --www-port=8787

If you need a database config one can be created with:
  MYTMP=`mktemp -d` && echo -e "provider=sqlite\\ndirectory=${MYTMP}/sqlite" > "${MYTMP}/db.conf"
and then used with:
  rserver ... --database-config-file="${MYTMP}/db.conf"
"""

toolchain = {'name': 'foss', 'version': '2024a'}

source_urls = ['https://github.com/rstudio/rstudio/archive']
local_extract_cmd_tmpl = "mkdir -p '{0}' && tar --strip-components=1 -C '{0}' -xf %s"
sources = [
    'v%(version)s.tar.gz',
    {
        'source_urls': ['https://github.com/quarto-dev/quarto/archive'],
        # commit for https://github.com/quarto-dev/quarto/tree/release/rstudio-kousa-dogwood
        'filename': '7d1582d06250216d18696145879415e473a2ae4d.tar.gz',
        'extract_cmd': local_extract_cmd_tmpl.format(f"rstudio-{version.replace('+', '-')}/src/gwt/lib/quarto"),
    },
]
patches = [
    'rstudio-2023.12.1+402_pin-yarn-version.patch',
    'RStudio-Server-1.2.1335-fix_env.patch',
    'RStudio-Server-r_home-typo.patch',
]
checksums = [
    {'v%(version)s.tar.gz': '4f976a3b77f1c3b6a61b8e1a1850aeba0e0a847efbfc17b03b2fcb19fce13d6a'},
    '6ebf7739db234f68436969c4edcaa36d6867746ddd7a9c3fce78873645a56808',  # quarto
    {'rstudio-2023.12.1+402_pin-yarn-version.patch':
     '1eb0ad226fd440c8b0d5303ed6e0b98103fe46d09a64d818122ec3021f363385'},
    {'RStudio-Server-1.2.1335-fix_env.patch': 'a7b6edab4f5605f5695b5a987f2f1b229e90dbcfcb7a85cc2ea9341e8766941b'},
    {'RStudio-Server-r_home-typo.patch': '642a298a9e7342fca0de8bde233f80bedc9e9524b2fc2553e859925b09c5513f'},
]

builddependencies = [
    ('ant', '1.10.12', '-Java-%(javaver)s', SYSTEM),
    ('CMake', '3.29.3'),
    ('Ninja', '1.12.1'),
    ('pkgconf', '2.2.0'),
]

dependencies = [
    ('Boost', '1.85.0'),
    ('Java', '17', '', SYSTEM),
    ('R', '4.4.2'),
    ('R-bundle-CRAN', '2024.11'),
    ('SOCI', '4.0.3'),
    ('yaml-cpp', '0.8.0'),
    ('zlib', '1.3.1'),
]

osdependencies = [
    ('pam-devel', 'libpam0g-dev')
]

local_avoid_home_cmds = " && ".join(
    f"export {name}='%(builddir)s/.eb-{name}'" for name in (
        # $HOME/.npm
        'npm_config_cache',
        # $HOME/R
        'R_LIBS_USER',
        'R_USER_CACHE_DIR',
        'R_USER_CONFIG_DIR',
        'R_USER_DATA_DIR',
    )
)

preconfigopts = " && ".join([
    # Install dependencies via scripts. Done in subshell to preserve PWD
    "(export RSTUDIO_TOOLS_ROOT='%(builddir)s'",
    local_avoid_home_cmds,
    "cd '%(start_dir)s/dependencies/common'",
    "./install-cef",
    "./install-dictionaries",
    "./install-mathjax",
    "./install-quarto",  # Available for X86 and ARM
    "./install-npm-dependencies)",
    ""
])

configopts = " ".join([
    "-DRSTUDIO_TOOLS_ROOT='%(builddir)s'",
    "-DRSTUDIO_TARGET=Server",
    "-DRSTUDIO_USE_SYSTEM_BOOST=ON",
    "-DRSTUDIO_USE_SYSTEM_SOCI=ON",
    "-DRSTUDIO_USE_SYSTEM_YAML_CPP=ON",
    "-DQUARTO_ENABLED=ON",
    "-DRSTUDIO_GIT_REVISION_HASH=" + local_git_rev
])

prebuildopts = " && ".join([
    # fix for compatibility with Boost-1.85.0
    "sed -i 's/return afterResponse_;/return static_cast<bool>(afterResponse_);/' "
    "'%(start_dir)s/src/cpp/core/json/JsonRpc.cpp'",
    local_avoid_home_cmds,
    # Use Node downloaded by install-npm-dependencies
    """NODE_VERSION=$(bash -c "source '%(start_dir)s/dependencies/tools/rstudio-tools.sh'"""
    '&& echo $RSTUDIO_NODE_VERSION")',
    """export PATH="$PATH:"'%(start_dir)s'"/dependencies/common/node/$NODE_VERSION/bin" """,
    "",
])

sanity_check_commands = [
    # RSession requires environment variables R_HOME and R_DOC_DIR
    'R_HOME="$EBROOTR/lib64/R" R_DOC_DIR="$R_HOME/doc" rsession --verify-installation=1',
    # RServer requires a db conf (this may also be needed for live use)
    # Also create and set some dirs so it doesn't try to use $HOME
    ' '.join([
        'MYTMP=`mktemp -d`',
        '&& export RSTUDIO_CONFIG_DIR="$MYTMP"',
        '&& export XDG_DATA_HOME="$MYTMP/.data"',
        '&& export XDG_CACHE_HOME="$MYTMP/.cache"',
        '&& mkdir "$XDG_DATA_HOME" "$XDG_CACHE_HOME"',
        '&& export RS_LOG_DIR="$MYTMP/log"',
        '&& echo -e "provider=sqlite\\ndirectory=$MYTMP/db" >> "$MYTMP/db.conf"',
        '&& rserver',
        '--verify-installation=1',
        '--server-user="$USER"',
        '--database-config-file="$MYTMP/db.conf"',
        '--server-data-dir="$MYTMP/sdd"',
        '--secure-cookie-key-file="$MYTMP/secure-cookie-key"',
    ]),
]

sanity_check_paths = {
    'files': ['bin/rstudio-server'],
    'dirs': ['bin', 'extras', 'resources', 'www', 'www-symbolmaps', 'R'],
}

moduleclass = 'lang'
