# Author: sreenivasamurthy kolam <sreenivasamurthy.kolam@amd.com>

easyblock = 'ROCmComponent'

name = 'rocRAND'
version = '4.2.0'
_rocm_version = '7.2.3'

homepage = 'https://github.com/ROCm/rocRAND'
description = """The rocRAND project provides functions that generate pseudorandom and
quasirandom numbers. The rocRAND library is implemented in the HIP programming language
and optimized for AMD's latest discrete GPUs. It is designed to run on top of AMD's ROCm
runtime, but it also works on CUDA-enabled GPUs."""
docurls = ['https://rocm.docs.amd.com/projects/rocRAND/en/latest/']

toolchain = {'name': 'rocm-compilers', 'version': f'22.0.0-ROCm-{_rocm_version}'}

github_account = 'ROCm'
local_repo_name = 'rocm-libraries'
source_urls = [f'https://github.com/{github_account}/{local_repo_name}/archive']
sources = [{
    'download_filename': f'rocm-{_rocm_version}.tar.gz',
    'filename': f'{local_repo_name}-rocm-{_rocm_version}.tar.gz',
}]
checksums = ['300cc50720d40bad7c7ed1f6d67e8c5ebecaba62c07a6ea1cc5813c0ea2e41b5']

builddependencies = [
    ('CMake', '3.31.8'),
]

dependencies = [
    ('HIP', _rocm_version),
]

# Build from the projects/rocrand subdirectory
start_dir = 'projects/rocrand'

sanity_check_paths = {
    'files': ['lib/librocrand.so',
              'lib/cmake/rocrand/rocrand-config.cmake',
              'include/rocrand/rocrand.hpp'],
    'dirs': ['lib/cmake/rocrand',
             'share/doc/rocrand',
             'include/rocrand'],
}

moduleclass = 'lib'
