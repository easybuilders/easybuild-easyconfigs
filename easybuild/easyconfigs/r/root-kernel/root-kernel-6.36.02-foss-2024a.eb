easyblock = "Bundle"

name = 'root-kernel'
version = '6.36.02'


homepage = 'https://root.cern.ch'
description = """Environment to run the jupyter kernel provided by ROOT."""

toolchain = {'name': 'foss', 'version': '2024a'}

dependencies = [
    ('ROOT', version),
    ('jupyter-server', '2.14.2'),
    ('metakernel', '0.30.4'),
]

# sanity_check_commands = [
#     # Check that jupyter can find the kernel for ROOT
#     'jupyter kernelspec list 2>/dev/null | grep root; echo $?'
# ]

modextrapaths = {
    'JUPYTER_PATH': '$EBROOTROOT/etc/notebook/',
}

moduleclass = 'tools'
