# Author: sreenivasamurthy kolam <sreenivasamurthy.kolam@amd.com>

easyblock = 'ROCmComponent'

name = 'rocFFT'
version = '1.0.36'
versionsuffix = '-nompi'
_rocm_version = '7.2.3'

homepage = 'https://github.com/ROCm/rocFFT'
description = """rocFFT is a software library for computing fast Fourier transforms
(FFTs) written in the HIP programming language. It's part of AMD's software ecosystem
based on ROCm. The rocFFT library can be used with AMD and NVIDIA GPUs."""
docurls = ['https://rocm.docs.amd.com/projects/rocFFT/en/latest/']

toolchain = {'name': 'rocm-compilers', 'version': f'22.0.0-ROCm-{_rocm_version}'}

github_account = 'ROCm'
local_repo_name = 'rocm-libraries'
source_urls = [f'https://github.com/{github_account}/{local_repo_name}/archive']
sources = [{
    'download_filename': f'rocm-{_rocm_version}.tar.gz',
    'filename': f'{local_repo_name}-rocm-{_rocm_version}.tar.gz',
}]
checksums = ['300cc50720d40bad7c7ed1f6d67e8c5ebecaba62c07a6ea1cc5813c0ea2e41b5']

builddependencies = [
    ('CMake', '3.31.8'),
    ('Python', '3.13.5'),
]

dependencies = [
    ('HIP', _rocm_version),
    ('rocm-cmake', '0.14.0'),
    ('SQLite', '3.50.1'),
]

# Build from the projects/rocfft subdirectory
start_dir = 'projects/rocfft'

configopts = '-DSQLITE_USE_SYSTEM_PACKAGE=ON '

sanity_check_paths = {
    'files': ['include/rocfft/rocfft.h',
              f'lib/librocfft.{SHLIB_EXT}',
              'lib/cmake/rocfft/rocfft-config.cmake'],
    'dirs': ['share/doc/rocfft',
             'include/rocfft'],
}

moduleclass = 'lib'
