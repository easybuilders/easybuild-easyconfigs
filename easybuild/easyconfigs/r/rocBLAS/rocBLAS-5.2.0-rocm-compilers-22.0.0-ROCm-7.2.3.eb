# Author: sreenivasamurthy kolam <sreenivasamurthy.kolam@amd.com>

easyblock = 'ROCmComponent'

name = 'rocBLAS'
version = '5.2.0'
_rocm_version = '7.2.3'

homepage = 'https://github.com/ROCm/rocBLAS'
description = """rocBLAS is the ROCm Basic Linear Algebra Subprograms (BLAS) library.
rocBLAS is implemented in the HIP programming language and optimized for AMD GPUs."""
docurls = ['https://rocm.docs.amd.com/projects/rocBLAS/en/latest/']

toolchain = {'name': 'rocm-compilers', 'version': f'22.0.0-ROCm-{_rocm_version}'}

github_account = 'ROCm'
local_repo_name = 'rocm-libraries'
source_urls = [f'https://github.com/{github_account}/{local_repo_name}/archive']
sources = [{
    'download_filename': f'rocm-{_rocm_version}.tar.gz',
    'filename': f'{local_repo_name}-rocm-{_rocm_version}.tar.gz',
}]
checksums = ['300cc50720d40bad7c7ed1f6d67e8c5ebecaba62c07a6ea1cc5813c0ea2e41b5']

builddependencies = [
    ('CMake', '3.31.8'),
    ('Python', '3.13.5'),
    ('Tensile', '4.43.0'),
]
dependencies = [
    ('HIP', _rocm_version),
    ('rocTracer', '4.1.0'),
    ('hipBLASLt', '1.2.2'),
    ('hipBLAS-common', '1.4.0'),
]

# Build from the projects/rocblas subdirectory
start_dir = 'projects/rocblas'

configopts = '-DBUILD_WITH_PIP=OFF '
configopts += '-DBUILD_CLIENTS_TESTS=OFF '
configopts += '-DBUILD_CLIENTS_BENCHMARKS=OFF '
configopts += '-DBUILD_CLIENTS_SAMPLES=OFF '
configopts += '-DBUILD_CLIENTS=OFF '

sanity_check_paths = {
    'files': [f'lib/librocblas.{SHLIB_EXT}',
              'lib/cmake/rocblas/rocblas-config.cmake',
              'include/rocblas/rocblas.h'],
    'dirs': ['lib/cmake/rocblas',
             'share/doc/rocblas',
             'include/rocblas'],
}

moduleclass = 'lib'
