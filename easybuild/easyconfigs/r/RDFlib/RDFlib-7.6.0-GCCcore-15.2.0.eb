easyblock = 'PythonBundle'

name = 'RDFlib'
version = '7.6.0'

homepage = 'https://github.com/RDFLib/rdflib'
description = """RDFLib is a Python library for working with RDF, a simple yet powerful language
 for representing information."""

toolchain = {'name': 'GCCcore', 'version': '15.2.0'}

builddependencies = [
    ('binutils', '2.45'),
    ('poetry', '2.3.4'),
]

dependencies = [
    ('Python', '3.14.2'),
    ('Python-bundle-PyPI', '2026.04'),
]

exts_list = [
    ('isodate', '0.7.2', {
        'checksums': ['4cd1aa0f43ca76f4a6c6c0292a85f40b35ec2e43e315b59f06e6d32171a953e6'],
    }),
    ('rdflib', version, {
        'checksums': ['6c831288d5e4a5a7ece85d0ccde9877d512a3d0f02d7c06455d00d6d0ea379df'],
    }),
]

moduleclass = 'lib'
