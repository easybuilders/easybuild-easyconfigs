# Author: sreenivasamurthy kolam <sreenivasamurthy.kolam@amd.com>

easyblock = 'ROCmComponent'

name = 'rocThrust'
version = '4.2.0'
_rocm_version = '7.2.3'

homepage = 'https://github.com/ROCm/rocThrust'
description = """Thrust is a parallel algorithm library. It has been ported to HIP and ROCm,
which use the rocPRIM library. The HIP-ported library works on HIP and ROCm software.
Currently there is no CUDA backend in place."""
docurls = ['https://rocm.docs.amd.com/projects/rocThrust/en/latest/']

toolchain = {'name': 'rocm-compilers', 'version': f'22.0.0-ROCm-{_rocm_version}'}

github_account = 'ROCm'
local_repo_name = 'rocm-libraries'
source_urls = [f'https://github.com/{github_account}/{local_repo_name}/archive']
sources = [{
    'download_filename': f'rocm-{_rocm_version}.tar.gz',
    'filename': f'{local_repo_name}-rocm-{_rocm_version}.tar.gz',
}]
checksums = ['300cc50720d40bad7c7ed1f6d67e8c5ebecaba62c07a6ea1cc5813c0ea2e41b5']

builddependencies = [
    ('CMake', '3.31.8'),
]

dependencies = [
    ('HIP', _rocm_version),
    ('rocPRIM', '4.2.0'),
]

# Build from the projects/rocthrust subdirectory
start_dir = 'projects/rocthrust'

sanity_check_paths = {
    'files': ['lib/cmake/rocthrust/rocthrust-config.cmake',
              'include/thrust/rocthrust_version.hpp'],
    'dirs': ['lib/cmake/rocthrust',
             'share/doc/rocthrust',
             'include/thrust'],
}

moduleclass = 'lib'
