@@ -0,0 +1,32 @@
+// MIT License
+// Copyright 2023--present rgpot developers
+//
+// Prints the SHA-256 of folded displacements, or "skip" when this binary
+// was built for an instruction set the CPU cannot run.
+
+#include "minimage_hash_samples.hpp"
+
+#include <iostream>
+
+namespace {
+
+bool cpu_can_run() {
+#if defined(RGPOT_MINIMAGE_ISA_AVX512)
+  return __builtin_cpu_supports("avx512f");
+#elif defined(RGPOT_MINIMAGE_ISA_AVX2)
+  return __builtin_cpu_supports("avx2") && __builtin_cpu_supports("fma");
+#else
+  return true;
+#endif
+}
+
+} // namespace
+
+int main() {
+  if (!cpu_can_run()) {
+    std::cout << "skip\n";
+    return 0;
+  }
+  std::cout << rgpot::nlist::hashcheck::folded_displacement_hash() << '\n';
+  return 0;
+}
diff --git a/ci/gha/check_minimage_isa.sh b/ci/gha/check_minimage_isa.sh
new file mode 100755
index 0000000..b45b059
--- /dev/null
+++ b/ci/gha/check_minimage_isa.sh
@@ -0,0 +1,21 @@
+#!/bin/sh
+# Compare folded-displacement hashes from binaries built for different
+# instruction sets. A binary that prints "skip" cannot run on this CPU.
+set -eu
+golden=$1
+shift
+fail=0
+for exe in "$@"; do
+  out=$("$exe")
+  if [ "$out" = skip ]; then
+    echo "skip $exe"
+    continue
+  fi
+  if [ "$out" != "$golden" ]; then
+    echo "mismatch $exe got $out want $golden" >&2
+    fail=1
+  else
+    echo "match $exe"
+  fi
+done
+exit "$fail"
