easyblock = 'CMakeMake'

name = 'rocprofiler-register'
version = '0.6.0'
_rocm_version = '7.2.3'
versionsuffix = f'-ROCm-{_rocm_version}'

homepage = 'https://github.com/ROCm/rocprofiler-register'
description = """The rocprofiler-register library is a helper library that coordinates the
modification of the intercept API table(s) of the HSA/HIP/ROCTx runtime libraries by the
ROCprofiler (v2) library. The purpose of this library is to provide a consistent and automated
mechanism of enabling performance analysis in the ROCm runtimes which does not rely on
environment variables or unique methods for each runtime library."""
docurls = ['https://rocm.docs.amd.com/projects/rocprofiler-register/']

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}

source_urls = ['https://github.com/ROCm/rocm-systems/archive/']
sources = [{
    'download_filename': f'rocm-{_rocm_version}.tar.gz',
    'filename': f'rocm-systems-rocm-{_rocm_version}.tar.gz',
}]
patches = ['rocprofiler-register-0.6.0-ROCm-7.2.3_disable_packaging_external.patch']
checksums = [
    'e90cfd8694af28a56433c8827a581ee12a4ba835f0d952436741d9e0f3f8685b',  # rocm-systems-rocm-7.2.3.tar.gz
    # rocprofiler-register-0.6.0-ROCm-7.2.3_disable_packaging_external.patch
    '9796203fb7c16912f13e6f775a9632a81154432dd36fd08f3bea6535fea156d7',
]

# Source is in projects/rocprofiler-register within the rocm-systems archive
srcdir = 'projects/%(name)s'

configopts = '-DROCPROFILER_REGISTER_BUILD_GLOG=OFF '
configopts += '-DROCPROFILER_REGISTER_BUILD_FMT=OFF '

builddependencies = [
    ('binutils', '2.44'),
    ('CMake', '3.31.8'),
    ('git', '2.50.1'),
]

dependencies = [
    ('fmt', '11.2.0'),
    ('glog', '0.7.1'),
]

sanity_check_paths = {
    'files': ['lib/librocprofiler-register.so',
              'include/rocprofiler-register/rocprofiler-register.h'],
    'dirs': ['lib/cmake/rocprofiler-register',
             'include/rocprofiler-register/',],
}

moduleclass = 'lib'
