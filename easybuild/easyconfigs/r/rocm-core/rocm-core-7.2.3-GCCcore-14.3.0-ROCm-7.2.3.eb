# Author: sreenivasamurthy kolam <sreenivasamurthy.kolam@amd.com>

easyblock = 'CMakeMake'

name = 'rocm-core'
version = '7.2.3'
versionsuffix = '-ROCm-7.2.3'

homepage = 'https://github.com/ROCm/rocm-core'
description = """ROCm-core is a foundational package that provides ROCm release versioning
and installation path information via header files."""

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}

github_account = 'ROCm'
source_urls = [GITHUB_SOURCE]
sources = ['rocm-%(version)s.tar.gz']
checksums = ['eb3eb38ead3e85f23f01f37f17d114560dcad0a1f1b437ac464ef00cc19e8498']

builddependencies = [
    ('CMake', '3.31.8'),
    ('binutils', '2.44'),
]

configopts = "-DROCM_VERSION=%(version)s "

sanity_check_paths = {
    'dirs': ['include/rocm-core', '.info'],
    'files': [
        'include/rocm-core/rocm_version.h',
        'include/rocm-core/rocm_getpath.h',
        'lib/librocm-core.so',
        '.info/version'
    ]
}

moduleclass = 'lib'
