easyblock = 'PythonPackage'

name = 'REDItools3'
version = '3.7.1'

homepage = 'https://github.com/BioinfoUNIBA/REDItools3'
description = "A new REDItools implementation to speed-up the RNA editing profiling in massive RNAseq data"

toolchain = {'name': 'GCC', 'version': '15.2.0'}

source_urls = ['https://github.com/BioinfoUNIBA/REDItools3/archive/refs/tags/']
sources = ['v%(version)s-stable.tar.gz']
checksums = ['060d95f3719dab9b876ba136d1c074a3979e3d7275fd22a642010ec166e36f59']

dependencies = [
    ('Python', '3.14.2'),
    ('Python-bundle-PyPI', '2026.04'),
    ('Pysam', '0.24.0'),
]

options = {'modulename': 'reditools'}

moduleclass = 'bio'
