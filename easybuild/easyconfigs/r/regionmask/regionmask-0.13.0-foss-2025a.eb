easyblock = 'PythonBundle'

name = 'regionmask'
version = '0.13.0'

homepage = 'https://regionmask.readthedocs.io'
description = """regionmask creates masks of geographical regions. It determines to which
geographic region each grid point belongs."""

toolchain = {'name': 'foss', 'version': '2025a'}

dependencies = [
    ('Python', '3.13.1'),
    ('Python-bundle-PyPI', '2025.04'),
    ('SciPy-bundle', '2025.06'),
    ('geopandas', '1.1.2'),
    ('rasterio', '1.5.0'),
    ('Shapely', '2.1.1'),
    ('xarray', '2025.7.0'),
]

exts_list = [
    (name, version, {
        'checksums': ['56fd11986cd2f03bd3ac3ecb19399bff3e8cb79e151f7e33e18121735123abdf'],
    }),
]

moduleclass = 'geo'
