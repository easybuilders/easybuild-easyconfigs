# Author: sreenivasamurthy kolam <sreenivasamurthy.kolam@amd.com>

easyblock = 'ROCmComponent'

name = 'rocminfo'
version = '1.0.0'
_rocm_version = '7.2.3'

homepage = 'https://github.com/RadeonOpenCompute/rocminfo'
description = """ROCm Application for Reporting System Info"""
docurls = ['https://rocm.docs.amd.com/projects/rocminfo/']

toolchain = {'name': 'rocm-compilers', 'version': f'22.0.0-ROCm-{_rocm_version}'}

github_account = 'ROCm'
source_urls = ['https://github.com/ROCm/rocm-systems/archive/']
sources = [f"rocm-{_rocm_version}.tar.gz"]
checksums = ['e90cfd8694af28a56433c8827a581ee12a4ba835f0d952436741d9e0f3f8685b']

builddependencies = [
    ('CMake', '3.31.8'),
]

dependencies = [
    ('Python', '3.13.5'),  # Needed for 'rocm_agent_enumerator' which is a Python script
    ('glog', '0.7.1'),
]

# rocminfo is located in projects/rocminfo within rocm-systems archive
srcdir = 'projects/rocminfo'

sanity_check_paths = {
    'files': ['bin/rocminfo', 'bin/rocm_agent_enumerator'],
    'dirs': [],
}

moduleclass = 'tools'
