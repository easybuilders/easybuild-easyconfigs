easyblock = 'PythonBundle'

name = 'redis-py'
version = '7.4.1'

homepage = 'https://github.com/redis/redis-py'
description = "The Python interface to the Redis key-value store."

toolchain = {'name': 'GCCcore', 'version': '15.2.0'}

builddependencies = [
    ('binutils', '2.45'),
    ('hatchling', '1.29.0'),
]

dependencies = [
    ('Python', '3.14.2'),
    ('Redis', '8.2.9'),
]

exts_list = [
    (name, version, {
        'modulename': 'redis',
        'source_urls': ['https://github.com/redis/redis-py/archive/refs/tags/'],
        'sources': ['v%(version)s.tar.gz'],
        'checksums': ['caf8ac60196ca4e24749701e5c4b31d92c6d4f1a716a3ea1dda8ffec91c955b0'],
    }),
]

moduleclass = 'data'
