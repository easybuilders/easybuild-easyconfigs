Fix CMakeLists.txt to respect ROCPROFILER_BUILD_TESTS option from command line.
The original code unconditionally sets ROCPROFILER_BUILD_TESTS ON which overrides
any -D flag passed on the cmake command line.

diff --git a/projects/rocprofiler/CMakeLists.txt b/projects/rocprofiler/CMakeLists.txt
--- a/projects/rocprofiler/CMakeLists.txt
+++ b/projects/rocprofiler/CMakeLists.txt
@@ -87,10 +87,6 @@ endif()

 enable_testing()

-# Temporarily for CI to work
-set(ROCPROFILER_BUILD_TESTS ON)
-set(ROCPROFILER_BUILD_CI ON)
-
 if(ROCPROFILER_BUILD_CI)
     include(CTest)
 endif()
