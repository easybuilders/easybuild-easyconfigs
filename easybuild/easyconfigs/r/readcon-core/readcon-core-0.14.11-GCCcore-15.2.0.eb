builddependencies = [
    ('binutils', '2.45'),
    ('Rust', '1.94.1'),
    ('Meson', '1.10.2'),
    ('Ninja', '1.13.2'),
    ('pkgconf', '2.5.1'),
]

# The Meson build drives cargo on the vendored crates above, installs the
# shared and static library, the headers and readcon-core.pc, and its tests run
# the cargo unit tests and the C conformance goldens.
configopts = '-Dwith_tests=true'

runtest = 'meson'
testopts = 'test -C %(builddir)s/easybuild_obj --print-errorlogs'

sanity_check_paths = {
    'files': [
        'include/readcon-core.h',
        'include/readcon-core.hpp',
        'lib/libreadcon_core.a',
        'lib/libreadcon_core.%s' % SHLIB_EXT,
        'lib/pkgconfig/readcon-core.pc',
    ],
    'dirs': [],
}

sanity_check_commands = [
    "pkg-config --exists readcon-core",
    "pkg-config --modversion readcon-core",
]

moduleclass = 'lib'
