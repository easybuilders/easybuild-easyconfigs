easyblock = 'PythonBundle'

name = 'vdjtools'
version = '3.0.0'

homepage = 'https://docs.isalgo.dev/vdjtools/'
description = """TCR/BCR immune-repertoire analysis — a clean-room Python + C++ rewrite
of the legacy Groovy/Java vdjtools, standardised on the AIRR schema and polars
DataFrames with minimal object-orientation."""

toolchain = {'name': 'gfbf', 'version': '2026.1'}

builddependencies = [
    ('CMake', '4.2.1'),
    ('hatchling', '1.29.0'),
    ('PDM', '2.28.0'),
    ('pybind11', '3.0.4'),
    ('scikit-build-core', '0.12.2'),
]

dependencies = [
    ('Python', '3.14.2'),
    ('Python-bundle-PyPI', '2026.04'),
    ('SciPy-bundle', '2026.05'),
    ('polars', '1.41.2'),
    ('huggingface-hub', '1.24.0'),
]

exts_list = [
    ('typer', '0.20.0', {
        'checksums': ['1aaf6494031793e4876fb0bacfa6a912b551cf43c1e63c800df8b1a866720c37'],
    }),
    ('seqtree', '0.5.0', {
        'checksums': ['28cf00a64dba792b6c4b0f61d95db0cbf8e5f7695f594ac4faddf635f193e4d4'],
    }),
    ('arda-mapper', '2.5.5', {
        'sources': ['arda_mapper-%(version)s.tar.gz'],
        'modulename': 'arda',
        'checksums': ['3311d8bb171b72d80a07369dc8fdb3675b1cc114dd8c2736a72e930514d0b28b'],
    }),
    ('vdjmatch', '0.1.0', {
        'checksums': ['fe4c3308382c64585af661901cfaf671babffb7beaa61ed2b667d36cd667004b'],
    }),
    ('%(namelower)s', version, {
        'checksums': ['53bcd721649fff25bd6a7c053d86b9e339229717716cb187bea89633b6198fc7'],
    }),
]

sanity_check_paths = {
    'files': ['bin/arda', 'bin/vdjmatch', 'bin/vdjtools'],
    'dirs': [],
}

sanity_check_commands = [
    "vdjtools --help",
]

moduleclass = 'bio'
