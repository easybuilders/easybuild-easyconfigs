# Upstream vcflib uses the pkg-config imported target for tabixpp.  The
# EasyBuild tabixpp module provides the library and header but no pkg-config
# file, so link the explicitly discovered external target for vcflib 1.0.15.
--- vcflib-1.0.15.orig/CMakeLists.txt
+++ vcflib-1.0.15/CMakeLists.txt
@@ -437,3 +437,3 @@
 if (NOT tabixpp_LOCAL)
-  target_link_libraries(vcflib PkgConfig::tabixpp)
+  target_link_libraries(vcflib tabixpp_external fastahack sw fsom filevercmp)
 endif()
