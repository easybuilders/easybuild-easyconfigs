easyblock = 'CMakeMakeCp'

name = 'VASP'
version = '6.6.1'

homepage = 'http://www.vasp.at'
description = """The Vienna Ab initio Simulation Package (VASP) is a
computer program for atomic scale materials modelling, e.g. electronic
structure calculations and quantum-mechanical molecular dynamics,
from first principles.

This build includes HDF5 and the Wannier-90 functions."""

toolchain = {'name': 'foss', 'version': '2024a'}

download_instructions = """VASP is proprietary software, see http://www.vasp.at/index.php/faqs
on how to obtain a license for the software."""

local_vaspdev_ver = "6.6.x-r1"
sources = [
    '%(namelower)s.%(version)s.tgz',
    {
        'source_urls': [f'https://github.com/vasp-dev/cmake/releases/download/{local_vaspdev_ver}'],
        'filename': f'cmake-{local_vaspdev_ver}.tar.gz',
        'extract_cmd': 'tar xvzf %s',
    },
]

checksums = [
    {'vasp.%(version)s.tgz': '261f9c1fd730468106191afeb185821d67cb7a58c982f6e063824dd5432106b0'},
    {f'cmake-{local_vaspdev_ver}.tar.gz': '03ef2c3ec98dd67a58ff921c091e004256ce30dfd0389ed09aa92d33d25f8bd3'},
]

builddependencies = [
    ('CMake', '3.29.3'),
]
dependencies = [
    ('HDF5', '1.14.5'),
    ('Wannier90', '3.1.0'),
]

preconfigopts = 'mv ../cmake ../%(namelower)s.%(version)s/cmake && '
preconfigopts += 'chmod +x ../%(namelower)s.%(version)s/cmake/setup.sh && '
preconfigopts += '../%(namelower)s.%(version)s/cmake/setup.sh ../%(namelower)s.%(version)s && '
configopts = '-DVASP_OPENMP=ON -DVASP_HDF5=ON'
separate_build_dir = True

# Testing, can take a long time!
# Recommended to set ulimit -s to unlimited, as else segfaults will occure
# during some of the tests.
# https://www.vasp.at/wiki/index.php/Validation_tests

# Offloading to GPUs with NCCL requires 1 GPU per MPI-rank
# --bind-to-none: Open MPI fails to launch on build nodes with a restricted
# cpuset (e.g. inside a Slurm job) - binding is anyway not relevant for the test
_vasp_test_mpirun = "mpirun -np 1 --bind-to none"

_vasp_test_exe = '%(builddir)s/easybuild_obj/bin'

# skip tests that are too long
_vasp_test_skip = 'HEG_333_LW '

_vasp_test_env = [
    "export OMP_NUM_THREADS=1",
    "export OMP_STACKSIZE=512m",
    "ulimit -s unlimited",
    f"export VASP_TESTSUITE_EXE_STD='{_vasp_test_mpirun} {_vasp_test_exe}/vasp_std'",
    f"export VASP_TESTSUITE_EXE_NCL='{_vasp_test_mpirun} {_vasp_test_exe}/vasp_ncl'",
    f"export VASP_TESTSUITE_EXE_GAM='{_vasp_test_mpirun} {_vasp_test_exe}/vasp_gam'",
    f"export VASP_TESTSUITE_SKIP_TESTS='{_vasp_test_skip}'",
    "",
]

pretestopts = " && ".join(_vasp_test_env)
runtest = 'test'

_vasp_test_log = '%(builddir)s/easybuild_obj/testsuite/testsuite.log'
testopts = f"&& test -s {_vasp_test_log} && "
testopts += f"grep -q '^SUMMARY' {_vasp_test_log} && "
testopts += f"! grep -q 'The following tests failed' {_vasp_test_log}"

files_to_copy = [
    (['bin/vasp_std', 'bin/vasp_gam', 'bin/vasp_ncl'], 'bin'),
]

sanity_check_paths = {
    'files': ['bin/vasp_std', 'bin/vasp_gam', 'bin/vasp_ncl'],
    'dirs': [],
}

moduleclass = 'phys'
