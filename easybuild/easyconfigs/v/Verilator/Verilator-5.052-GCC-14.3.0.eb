easyblock = 'CMakeMake'

name = 'Verilator'
version = '5.052'

homepage = 'https://www.veripool.org/verilator/'
description = """Verilator is a free and open-source software tool that compiles Verilog and SystemVerilog hardware
description languages into fast, cycle-accurate C++ or SystemC code"""

toolchain = {'name': 'GCC', 'version': '14.3.0'}

source_urls = ['https://github.com/verilator/verilator/archive/refs/tags/']
sources = [V_VERSION_TAR_GZ]

builddependencies = [
    ('CMake', '4.0.3'),
    ('Bison', '3.8.2'),
]

builddependencies = [
    ('CMake', '4.0.3'),
    ('Python', '3.13.5'),
]

sanity_check_paths = {
    'files': ['bin/verilator'],
    'dirs': [],
}

sanity_check_commands = ['verilator --help']

moduleclass = 'tools'
