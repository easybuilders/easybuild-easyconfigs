easyblock = 'ConfigureMake'

name = 'Valgrind'
version = '3.27.1'

homepage = 'https://valgrind.org'
description = "Valgrind: Debugging and profiling tools"

toolchain = {'name': 'gompi', 'version': '2026.1'}
# -march=native compiles AVX-512 into the guest preload. VEX cannot decode it,
# so regtest dies with SIGILL in mempcpy (vg_replace_strmem.c).
# -O2 -ftree-vectorize is appended after the per-test -O the .exp files assume,
# so it deletes uninitialised-read reports and inlines Helgrind wrappers.
# RPATH makes ld.so allocate while it walks the search path, which DHAT counts.
toolchainopts = {'optarch': False, 'rpath': False}
preconfigopts = 'unset CFLAGS CXXFLAGS LDFLAGS && '
buildopts = 'CFLAGS= CXXFLAGS= LDFLAGS='
installopts = 'CFLAGS= CXXFLAGS= LDFLAGS='

source_urls = [
    'https://sourceware.org/pub/valgrind/',
    'https://www.mirrorservice.org/sites/sourceware.org/pub/valgrind/',
]
sources = [SOURCELOWER_TAR_BZ2]
# glibc 2.43 (the EESSI compat libc) is newer than Valgrind 3.27.1. sourceware
# valgrind master and VALGRIND_3_27_BRANCH have no glibc 2.43 fix after 3.27.1
# (b50f9a09c), so Valgrind-3.27.1_glibc-2.43.patch is a local backport:
# unversioned pthread redirects, hidden __libc_start_call_main and start_thread
# names, the wcscat IFUNC, fdleak/XML frame filters, a pthread_detach guard.
# madv_guard skips itself on kernels older than 6.13 (MADV_GUARD_INSTALL).
patches = ['Valgrind-3.27.1_glibc-2.43.patch']
checksums = [
    '5d589152eb8071c02feab8ce6ab719e431a1fbc3e2b1700f5432632a8b9264dc',
    '4dba19e7610e0c38183539153d4c8e092325c17ccb7347565ae8e54d0ca21e3f',
]

dependencies = [
    ('Perl', '5.42.0'),
    ('Python', '3.14.2'),
]

configopts = ' --with-mpicc="$MPICC"'

local_binaries = [
    'callgrind_annotate', 'callgrind_control', 'cg_annotate', 'cg_diff',
    'cg_merge', 'ms_print', 'valgrind', 'valgrind-listener', 'vgdb'
]
local_archs = ('amd64', 'arm64', 'ppc64le')

sanity_check_paths = {
    'files': ['bin/%s' % x for x in local_binaries] +
             [['lib/valgrind/libmpiwrap-%s-linux.%s' % (a, SHLIB_EXT) for a in local_archs]],
    'dirs': []
}

sanity_check_commands = [
    'callgrind_annotate --version 2>&1 | grep "%(version)s"',
    'cg_annotate --help',
    'ms_print --version 2>&1 | grep "%(version)s"',
    'valgrind --help',
    'vgdb --help',
]

moduleclass = 'debugger'
