# This file is an EasyBuild reciPY as per https://github.com/easybuilders/easybuild
# Author: Pablo Escobar Lopez
# sciCORE - University of Basel
# SIB Swiss Institute of Bioinformatics
# Update: Pavel Tománek (Inuits)

easyblock = 'CMakeMake'

name = 'OpenMM'
version = '8.5.2'
versionsuffix = '-CUDA-%(cudaver)s'

homepage = 'https://openmm.org'
description = "OpenMM is a toolkit for molecular simulation."

toolchain = {'name': 'foss', 'version': '2026.1'}
toolchainopts = {'opt': True}

source_urls = ['https://github.com/openmm/openmm/archive/']
sources = ['%(version)s.tar.gz']
checksums = ['c059133288e2d747ad12b7e265aad1636190e3b6cf858fb0637fe703b556ccb8']

builddependencies = [
    ('CMake', '4.2.1'),
    ('Doxygen', '1.17.0'),
    ('Cython', '3.2.4'),
    ('SWIG', '4.4.1'),
]

dependencies = [
    ('Python', '3.14.2'),
    ('SciPy-bundle', '2026.05'),
    ('CUDA', '12.9.1', '', SYSTEM),
]

configopts = "-DOPENMM_BUILD_CUDA_LIB=ON -DOPENMM_BUILD_CUDA_COMPILER_PLUGIN=ON"
# Set the OPENMM_CUDA_COMPILER variable to make sure that all tests use the right nvcc,
# Otherwise they will use the wrong path: `/usr/local/cuda/bin/nvcc`
pretestopts = ' export OPENMM_CUDA_COMPILER=${EBROOTCUDA}/bin/nvcc && '
pretestopts += " CTEST_OUTPUT_ON_FAILURE=1"
# Skip CudaCompiler test as it doesn't work when the OPENMM_CUDA_COMPILER variable is set
local_ignore_pattern = "(Integrator)|(Thermostat)|(Barostat)|(Rpmd)|(Amoeba)|(CudaCompiler)"
runtest = """test -e ARGS="-E \'%s\'" """ % local_ignore_pattern

preinstallopts = ' export OPENMM_INCLUDE_PATH=%(installdir)s/include && '
preinstallopts += ' export OPENMM_LIB_PATH=%(installdir)s/lib && '

# required to install the python API
exts_list = [
    (name, version, {
        'easyblock': 'PythonPackage',
        'nosource': True,
        'runtest': False,
        'start_dir': '%(builddir)s/easybuild_obj',
        'buildcmd': 'make PythonBdistWheel',
        'install_src': 'python/dist/%(namelower)s-%(version)s-*.whl',
    }),
]

sanity_check_paths = {
    'files': [f'lib/libOpenMM.{SHLIB_EXT}'],
    'dirs': ['lib/python%(pyshortver)s/site-packages']
}

sanity_check_commands = [
    "python -s -c 'import openmm'",
    "python -s -c 'import simtk.openmm'",
    "python -s -m openmm.testInstallation",
]

modextrapaths = {
    'OPENMM_INCLUDE_PATH': 'include',
    'OPENMM_LIB_PATH': 'lib',
}

moduleclass = 'bio'
