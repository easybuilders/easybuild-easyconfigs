easyblock = 'GoPackage'

name = 'OBITools4'
version = '4.5.0'

homepage = 'https://obitools4.metabarcoding.org/docs'
description = """A package for the management of analyses and data in DNA metabarcoding."""

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}

source_urls = ['https://github.com/metabarcoding/obitools4/archive/refs/tags/']
sources = ['Release_%(version)s.tar.gz']
checksums = ['e68b9cdfef6addc8ab30e93e86a284c518b496b8e9fea2ce646af7e6d414b109']

builddependencies = [
    ('binutils', '2.44'),
    ('Go', '1.26.4', '', SYSTEM)]

installopts = './cmd/...'

sanity_check_paths = {
    'files': [
        'bin/obiannotate',
        'bin/obiconvert',
        'bin/obicount',
        'bin/obigrep',
    ],
    'dirs': [],
}

sanity_check_commands = [
    'obiannotate --help',
    'obiconvert --help',
    'obigrep --help',
]

moduleclass = 'bio'
