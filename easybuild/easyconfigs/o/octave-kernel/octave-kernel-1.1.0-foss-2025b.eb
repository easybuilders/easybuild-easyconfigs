easyblock = 'PythonBundle'

name = 'octave-kernel'
version = '1.1.0'

homepage = 'https://github.com/Calysto/octave_kernel'
description = """An Octave kernel for IPython."""

toolchain = {'name': 'foss', 'version': '2025b'}

builddependencies = [
    ('hatchling', '1.27.0'),
]
dependencies = [
    ('Python', '3.13.5'),
    ('IPython', '9.4.0'),
    ('jupyter-server', '2.17.0'),
    ('metakernel', '1.0.0'),
    ('Octave', '11.1.0'),
    ('rpds-py', '2026.5.1'),
]

exts_list = [
    (name, version, {
        'checksums': ['2c6e907a126b2d1c9b37900460bf8c66442e7aea9071aaa7c4b4834d39554961'],
    }),
]

modextrapaths = {
    'JUPYTER_PATH': 'share/jupyter',
    'JUPYTER_CONFIG_PATH': 'etc/jupyter',
}

sanity_check_commands = [
    # Check that jupyter can find the kernel for octave
    'jupyter kernelspec list 2>/dev/null | grep octave; echo $?'
]

moduleclass = 'tools'
