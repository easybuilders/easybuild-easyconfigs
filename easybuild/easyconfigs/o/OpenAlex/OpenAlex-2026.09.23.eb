easyblock = 'Dataset'

name = 'OpenAlex'
version = '2026.09.23'

homepage = 'https://openalex.org/'
description = 'OpenAlex scholarly metadata snapshot in JSONL format'

toolchain = SYSTEM

# Reproducing the source archive:
#
#   aws s3 sync \
#       s3://openalex/data/jsonl/ \
#       OpenAlex-2026.09.23/data/jsonl/ \
#       --no-sign-request
#
#   aws s3 cp s3://openalex/LICENSE.txt \
#       OpenAlex-2026.09.23/LICENSE.txt --no-sign-request
#
#   aws s3 cp s3://openalex/RELEASE_NOTES.txt \
#       OpenAlex-2026.09.23/RELEASE_NOTES.txt --no-sign-request
#
#   tar -cf OpenAlex-2026.09.23.tar -C OpenAlex-2026.09.23 .
#
# The version corresponds to the snapshot date in data/jsonl/manifest.json

data_sources = ['OpenAlex-2026.09.23.tar']

checksums = ['4be9b400c218ef245f57c263c9e93b06e0570b8444b11300e91d01d0fb6b5f1a']

sanity_check_paths = {
    'files': [
        'LICENSE.txt',
        'RELEASE_NOTES.txt',
        'data/jsonl/manifest.json',
    ],
    'dirs': [
        'data/jsonl/works',
        'data/jsonl/authors',
        'data/jsonl/institutions',
        'data/jsonl/sources',
        'data/jsonl/publishers',
        'data/jsonl/funders',
        'data/jsonl/topics',
        'data/jsonl/domains',
        'data/jsonl/fields',
        'data/jsonl/subfields',
    ],
}

moduleclass = 'data'
