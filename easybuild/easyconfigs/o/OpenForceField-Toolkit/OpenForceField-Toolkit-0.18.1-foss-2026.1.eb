    ('openff-packmol', '0.1', {
        'modulename': 'openff.packmol',
        'preinstallopts': 'export SETUPTOOLS_SCM_PRETEND_VERSION=%(version)s && ',
        'source_urls': ['https://github.com/openforcefield/%(name)s/archive/'],
