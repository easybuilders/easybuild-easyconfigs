    ('openff-toolkit', version, {
        'modulename': 'openff.toolkit',
        'preinstallopts': f"{_toolkit_fix}{_fix_ambertools_version}",
        'source_urls': ['https://github.com/openforcefield/%(name)s/archive/'],
        'sources': [{'download_filename': '%(version)s.tar.gz', 'filename': '%(name)s-%(version)s.tar.gz'}],
        'checksums': ['710ea5d508bf27492ae57d8506f167fba20738afdff0e91eb9923e5291e615a9'],
    }),
