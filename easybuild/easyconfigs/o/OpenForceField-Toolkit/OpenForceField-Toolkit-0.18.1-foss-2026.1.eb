sanity_check_commands = [
    "python -s -c 'from openff.toolkit import Molecule, Topology, ForceField'",
    "python -s -c 'from openff.interchange import Interchange'",
    "python -s -c 'from openff.units import unit'",
    "python -s -c 'from openff.interchange.components.mdconfig import MDConfig'",
    "python -s -c 'from openff.interchange.models import TopologyKey'",
    "python -s -c 'from openff.toolkit.typing.engines.smirnoff import ForceField'",
]

moduleclass = 'bio'
