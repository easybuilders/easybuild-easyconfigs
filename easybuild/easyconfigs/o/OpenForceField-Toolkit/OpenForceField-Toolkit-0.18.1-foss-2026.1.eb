    ('pyedr', '0.8.0', {
        'source_tmpl': SOURCE_PY3_WHL,
        'checksums': ['3e61705d4460bae9fd1f4245a11bdd433ac7fc6084ebd0ab8b8f5b6bcfeb5ad0'],
