easyblock = 'CargoPythonPackage'

name = 'oxbow'
version = '0.8.1'

homepage = 'https://github.com/abdenlab/oxbow'
description = """Oxbow is a genomic data I/O library that models and translates next-generation sequencing
(NGS) file formats into Apache Arrow representations, opening up genomic data to a richer ecosystem of
computational tools."""

toolchain = {'name': 'gfbf', 'version': '2026.1'}

sources = [SOURCELOWER_TAR_GZ]

builddependencies = [
    ('Rust', '1.94.1'),
    ('maturin', '1.13.1'),
]

dependencies = [
    ('Python', '3.14.2'),
    ('SciPy-bundle', '2026.05'),
    ('Arrow', '24.0.0'),
    ('polars', '1.41.2'),
    ('arro3', '0.8.1'),
]

