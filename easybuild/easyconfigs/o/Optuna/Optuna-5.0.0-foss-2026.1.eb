easyblock = 'PythonBundle'

name = 'Optuna'
version = '5.0.0'

homepage = "https://optuna.org/"
description = """Optuna is an automatic hyperparameter optimization software framework,
particularly designed for machine learning. It features an imperative,
define-by-run style user API. Thanks to our define-by-run API, the code written
with Optuna enjoys high modularity, and the user of Optuna can dynamically
construct the search spaces for the hyperparameters."""

toolchain = {'name': 'foss', 'version': '2026.1'}

dependencies = [
    ('Python', '3.14.2'),
    ('Python-bundle-PyPI', '2026.04'),
    ('SciPy-bundle', '2026.05'),
    ('PyYAML', '6.0.3'),
    ('tqdm', '4.67.3'),
    ('SQLAlchemy', '2.0.51'),
    ('matplotlib', '3.10.9'),  # optional
    ('plotly.py', '7.0.0'),  # optional
    ('redis-py', '7.4.1'),  # optional
    ('scikit-learn', '1.8.0'),  # optional
]

exts_list = [
    ('colorlog', '6.10.1', {
        'checksums': ['eb4ae5cb65fe7fec7773c2306061a8e63e02efc2c72eba9d27b0fa23c94f1321'],
    }),
    ('optuna', version, {
        'checksums': ['358bb878b7b1e20e90dc944ac4261796dd3d5c2b7860aa960a08fc10e0b5beff'],
    }),
]

sanity_check_paths = {
    'files': ['bin/optuna'],
    'dirs': ['lib/python%(pyshortver)s/site-packages'],
}
sanity_check_commands = [('optuna', '--help')]

moduleclass = 'tools'
