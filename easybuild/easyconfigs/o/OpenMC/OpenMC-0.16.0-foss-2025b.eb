easyblock = 'CMakePythonPackage'

name = 'OpenMC'
version = '0.16.0'

homepage = 'https://openmc.org'
description = """OpenMC is a community-developed Monte Carlo neutron and photon transport simulation code.
 It is capable of performing fixed source, k-eigenvalue, and subcritical multiplication calculations on
 models built using either a constructive solid geometry or CAD representation. OpenMC supports both
 continuous-energy and multigroup transport."""

toolchain = {'name': 'foss', 'version': '2025b'}
toolchainopts = {'usempi': True}

github_account = 'openmc-dev'
source_urls = [GITHUB_SOURCE]
sources = [{'download_filename': 'v%(version)s.tar.gz', 'filename': SOURCE_TAR_GZ}]
checksums = ['cfdf10f8dc66e652668dbc94501d5ed99b3dfecabc11cf91989a29ba7984654f']

builddependencies = [
    ('CMake', '4.0.3'),
    ('pkgconf', '2.4.3'),
    ('pybind11', '3.0.0'),  # needed to build the endf extension
    ('Catch2', '3.11.0'),  # only needed to build the C++ unit tests
]

dependencies = [
    ('Python', '3.13.5'),
    ('SciPy-bundle', '2025.07'),
    ('matplotlib', '3.10.5'),
    ('h5py', '3.14.0'),
    ('HDF5', '1.14.6'),
    ('lxml', '6.0.0'),
    ('IPython', '9.4.0'),
    ('uncertainties', '3.2.3'),
    ('mpi4py', '4.1.0'),
    ('libpng', '1.6.50'),
    ('fmt', '11.2.0'),
    ('pugixml', '1.15'),
    # CAD geometry support and unstructured mesh tallies
    ('DAGMC', '3.2.4'),
    ('libMesh', '1.7.9'),
    # optional runtime dependency, loaded via dlopen (also exercised by the test_mcpl_stat_sum unit test)
    ('mcpl', '2.2.8'),
    # optional runtime dependency for thermal neutron scattering in crystals,
    # located via ncrystal-config on PATH and loaded via dlopen
    ('NCrystal', '4.4.6'),
]

# Create dummy vendor/pugixml/CMakeLists.txt to pass submodule existence check
# (pugixml, fmt and Catch2 are all provided as external dependencies via find_package)
preconfigopts = 'mkdir -p %(builddir)s/openmc-%(version)s/vendor/pugixml && '
preconfigopts += 'touch %(builddir)s/openmc-%(version)s/vendor/pugixml/CMakeLists.txt && '

# all optional capabilities enabled; NCrystal support is a pure runtime feature
# (dlopen via ncrystal-config on PATH) and needs no build-time configuration;
# OPENMC_USE_UWUW requires DAGMC built with BUILD_UWUW=ON
configopts = '-DOPENMC_USE_MPI=ON '
configopts += '-DOPENMC_USE_OPENMP=ON '
configopts += '-DOPENMC_USE_DAGMC=ON '
configopts += '-DOPENMC_USE_UWUW=ON '
configopts += '-DOPENMC_USE_LIBMESH=ON '
configopts += '-DHDF5_PREFER_PARALLEL=ON '
configopts += '-DOPENMC_BUILD_TESTS=ON '

runtest = True

# Install Python dependencies and bindings via extensions
exts_defaultclass = 'PythonPackage'
exts_list = [
    ('endf', '0.1.12', {
        'checksums': ['97ca1b7a248fcc26c58a9f6a825e48b6643c8a6e111733440ada0ae425d45a68'],
    }),
    ('openmc', version, {
        'nosource': True,
        'preinstallopts': 'SETUPTOOLS_SCM_PRETEND_VERSION=%(version)s ',
    }),
]

sanity_check_paths = {
    'files': ['bin/openmc', 'lib/libopenmc.%s' % SHLIB_EXT],
    'dirs': ['include/openmc', 'lib/python%(pyshortver)s/site-packages/openmc'],
}

sanity_check_commands = [
    'openmc --version',
    "python -s -c 'import openmc'",
]

moduleclass = 'phys'
