Keep the Python distribution name as onnxruntime for CUDA builds.

The CUDA build normally produces the distribution name onnxruntime-gpu.
Keep the distribution name as onnxruntime so packages that depend on
onnxruntime, such as faster-whisper, recognize the installed CUDA-enabled
build.

Author: Pavel Tomanek (Inuits/UGent) with help from ChatGPT5.6
--- a/setup.py
+++ b/setup.py
@@ -736,9 +736,8 @@ if local_version:
     version_number = version_number + local_version
 
 if wheel_name_suffix:
-    if not (enable_training and wheel_name_suffix == "gpu"):
-        # for training packages, local version is used to indicate device types
+    if wheel_name_suffix != "gpu":
         package_name = f"{package_name}-{wheel_name_suffix}"
 cmd_classes = {}