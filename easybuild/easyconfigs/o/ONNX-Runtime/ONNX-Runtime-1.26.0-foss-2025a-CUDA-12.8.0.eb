easyblock = 'PythonBundle'

name = 'ONNX-Runtime'
version = '1.26.0'
versionsuffix = '-CUDA-%(cudaver)s'

homepage = 'https://onnxruntime.ai'
description = """ONNX Runtime inference can enable faster customer experiences and lower costs,
supporting models from deep learning frameworks such as PyTorch and
TensorFlow/Keras as well as classical machine learning libraries such as
scikit-learn, LightGBM, XGBoost, etc. ONNX Runtime is compatible with different
hardware, drivers, and operating systems, and provides optimal performance by
leveraging hardware accelerators where applicable alongside graph optimizations
and transforms."""

toolchain = {'name': 'foss', 'version': '2025a'}

builddependencies = [
    ('CMake', '3.31.3'),
    ('Ninja', '1.12.1'),
]
dependencies = [
    ('CUDA', '12.8.0', '', SYSTEM),
    ('cuDNN', '9.10.1.4', versionsuffix, SYSTEM),
    ('Python', '3.13.1'),
    ('SciPy-bundle', '2025.06'),
    ('ONNX', '1.21.0'),
    ('Abseil', '20250512.1'),
    ('protobuf', '31.1'),
    ('protobuf-python', '6.31.1'),
    ('flatbuffers-python', '25.2.10'),
    ('sympy', '1.14.0'),
]

# CUSTOM BUILD for onnx-runtime wheels
local_onnx_buildcmd = """
./build.sh \
--config Release \
--update --build \
--parallel %(parallel)s \
--build_wheel \
--use_cuda \
--cuda_home="$EBROOTCUDA" \
--cudnn_home="$EBROOTCUDNN" \
--cuda_version=%(cudashortver)s \
--skip_tests \
--build_shared_lib \
--skip_submodule_sync \
--cmake_generator Ninja \
--compile_no_warning_as_error \
--cmake_extra_defines \
absl_DIR=$EBROOTABSEIL/lib/cmake/absl \
Protobuf_DIR=$EBROOTPROTOBUF/lib/cmake/protobuf \
ONNX_DIR=$EBROOTONNX/lib/cmake/ONNX \
onnxruntime_BUILD_UNIT_TESTS=OFF \
"CMAKE_CUDA_ARCHITECTURES=%(cuda_cc_cmake)s" \
ONNXRUNTIME_VERSION=%(version)s
"""

exts_list = [
    ('onnxruntime', version, {
        'buildcmd': local_onnx_buildcmd,
        'install_src': '%(start_dir)s/build/Linux/Release/dist/*.whl',
        'source_urls': ['https://github.com/microsoft/%(name)s/archive/'],
        'sources': [{'download_filename': 'v%(version)s.tar.gz', 'filename': SOURCE_TAR_GZ}],
        'patches': [
            'ONNX-Runtime-1.26.0_gpu-package-name.patch',
            'ONNX-Runtime-1.26.0_use-Abseil-20250512.patch',
        ],
        'checksums': [
            {'onnxruntime-1.26.0.tar.gz': '2a90eb9a306c1eeb29213f5b165a55008ac5cb7d27e0935c4458c51a49ef091d'},
            {'ONNX-Runtime-1.26.0_gpu-package-name.patch':
             '5832cd6785d769f7b42a0492a3abe224a082efbeffbbeaf8a0bee0040fc76503'},
            {'ONNX-Runtime-1.26.0_use-Abseil-20250512.patch':
             '9e8bbf3d967d24d9cfab4b8a6c294b66795c1268932ee5daf2c41c2614f77908'},
        ],
    }),
]

sanity_check_commands = [
    "python -s -c \"import onnx, onnxruntime as ort; "
    "assert 'CUDAExecutionProvider' in ort.get_available_providers()\"",
    "python -s -c 'import onnxruntime; import onnx'",
]

sanity_check_paths = {
    'files': [
        'lib/python%(pyshortver)s/site-packages/onnxruntime/capi/libonnxruntime_providers_cuda.so',
        'lib/python%(pyshortver)s/site-packages/onnxruntime/capi/libonnxruntime_providers_shared.so',
    ],
    'dirs': [
        'lib/python%(pyshortver)s/site-packages/onnxruntime',
    ],
}

moduleclass = 'devel'
