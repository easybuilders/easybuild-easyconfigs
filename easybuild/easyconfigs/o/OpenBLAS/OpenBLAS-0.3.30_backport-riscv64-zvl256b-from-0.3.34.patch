+STRSMKERNEL_RN	=  trsm_kernel_RN_rvv.c
+STRSMKERNEL_RT	=  trsm_kernel_RT_rvv.c
 
-DTRSMKERNEL_LN	= ../generic/trsm_kernel_LN.c
