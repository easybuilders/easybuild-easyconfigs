+int CNAME(BLASLONG m, BLASLONG n, BLASLONG k, FLOAT dummy1,
+#ifdef COMPLEX
+	   FLOAT dummy2,
+#endif
+	   FLOAT *a, FLOAT *b, FLOAT *c, BLASLONG ldc, BLASLONG offset){
+
+  FLOAT *aa, *cc;
+  BLASLONG  kk;
+  BLASLONG i, j;
+
+#ifndef COMPLEX
+#define PROCESS_RN_M_BLOCK(MB, NB) do { \
+    if (kk > 0) { \
+      GEMM_KERNEL((MB), (NB), kk, dm1, aa, b, cc, ldc); \
+    } \
+    solve((MB), (NB), \
+          aa + kk * (MB) * COMPSIZE, \
+          b  + kk * (NB) * COMPSIZE, \
+          cc, ldc); \
+    aa += (MB) * k * COMPSIZE; \
+    cc += (MB)     * COMPSIZE; \
+  } while (0)
+#else
+#define PROCESS_RN_M_BLOCK(MB, NB) do { \
+    if (kk > 0) { \
+      GEMM_KERNEL((MB), (NB), kk, dm1, ZERO, aa, b, cc, ldc); \
+    } \
+    solve((MB), (NB), \
+          aa + kk * (MB) * COMPSIZE, \
+          b  + kk * (NB) * COMPSIZE, \
+          cc, ldc); \
+    aa += (MB) * k * COMPSIZE; \
+    cc += (MB)     * COMPSIZE; \
+  } while (0)
+#endif
